// bhdl-sweep: skip — safety-engine fixture, not a layout target
// Phase-3 fault-campaign fixture (docs/spec/Functional_Safety.md §2.5):
// a resistive divider whose GLACIER DC solve converges, with declared
// faults the campaign RUNS — each fault mutates a clone of the netlist
// (short = merge nets, open = detach), re-solves, and evaluates every
// effect predicate on the FAULTED operating point.
//
// Healthy: V12=12V, mid node = 6V (1k/1k).
//   short(r_top)  → mid = 12V → overvoltage fires   (expectation MET)
//   short(r_bot)  → mid = 0V  → undervoltage fires  (expectation MET)
//   open(r_bot)   → mid pulled to 12V through r_top → overvoltage (MET)
//   open(r_top)   → declared expecting OVERvoltage, but physics gives
//                   0V through r_bot → UNDERvoltage fires instead —
//                   the campaign flags the EXPECTATION NOT MET: the
//                   safety argument claimed an effect the board does
//                   not produce. That finding is the demonstration.

import { Res } from "bhdl-stdlib/passives/resistor.bhdl";

// A BEHAVIORAL part: electrically the lower leg of the detection
// divider (10k to GND), but carrying VENDOR-DECLARED failure states
// with behaviors — what each state DOES, as a board-observable
// mutation. The campaign runs these states with their REAL FIT shares
// as λ weights (fit=X of Y is the vendor's mode split, not a guess).
// FIT numbers are FIXTURE values for the pipeline demo.
entity DemoSense(value: resistance = 10kΩ) {
    pin 1: signal inout;
    pin 2: signal inout;
    attribute component_class = "resistor";
    attribute resistance = value;
    attribute power_rating = 0.1W;
    attribute kicad_symbol = "Device:R";
    safety {
        failure_state sense_open  fit=6 of 10 source="FIXTURE — illustrative split" behavior="open(2)";
        failure_state sense_stuck fit=4 of 10 source="FIXTURE — illustrative split" behavior="short(1,2)";
    }
}

board FaultDemo {
    power V12 = 12V @ 1A;
    ground GND;

    @V12 -> r_top: Res(1kΩ).1; r_top.2 -> r_bot: Res(1kΩ).1; r_bot.2 -> @GND;

    // Detection divider — the stand-in PSM: flag node = mid/2, so
    // flag > 4V ⇔ mid > 8V (the overvoltage threshold).
    r_top.2 -> r_m1: Res(10kΩ).1; r_m1.2 -> sense: DemoSense().1; sense.2 -> @GND;
}

safety FaultDemo as brd {
    mission { ambient = 40degC; }

    goal SG_MID: ASIL_B "mid node stays in its window" (id="SG-FC-1") {
        effect overvoltage  = brd.r_bot.1 > 8V severity S2;
        effect undervoltage = brd.r_bot.1 < 4V severity S2;
    }

    // The detection divider IS the mechanism: detected_when is the
    // predicate the campaign evaluates on every FAULTED operating point
    // to MEASURE the diagnostic coverage (claimed 0.90 is a FIXTURE
    // number — the measurement is the point).
    // latency = the comparator path's declared reaction time — the FTTI
    // check compares interval+latency against each fault's `within`.
    mechanism brd.sense: psm(SG_MID, detects=[overvoltage],
                             detected_when = brd.sense.1 > 4V,
                             latency=1ms,
                             dc=0.90, source="FIXTURE claim — measured DC supersedes");

    fault short(brd.r_top.1, brd.r_top.2) expect SG_MID.overvoltage detected_by brd.sense within 10ms;   // 1ms ≤ 10ms → ⏱ OK
    fault short(brd.r_bot.1, brd.r_bot.2) expect SG_MID.undervoltage;
    fault open(brd.r_bot)                 expect SG_MID.overvoltage detected_by brd.sense within 500us;  // 1ms > 500µs → ⏱ FAILED
    fault open(brd.r_top)                 expect SG_MID.overvoltage;   // deliberately wrong — see header
    // Parametric fault: +200% drift on the top leg → 3kΩ/1kΩ divider,
    // mid = 3V < 4V → undervoltage. Declared-only (a universe drift
    // magnitude would be invented data).
    fault drift(brd.r_top, +200%)          expect SG_MID.undervoltage;

    // Vendor failure state, run through its declared behavior:
    // sense_stuck = short(1,2) collapses the flag node to GND — the
    // detector reads permanently low. No goal effect fires (the mid
    // node is untouched), no alarm: the campaign's latent probe is what
    // exposes it.
    fault state(brd.sense, "sense_stuck") expect SG_MID.overvoltage;   // deliberately wrong: the state is SILENT
}
