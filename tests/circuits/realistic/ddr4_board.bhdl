// DDR4 SDRAM support-network + speed-bin timing-context fixture.
//
// Two things are proven here:
//   1. The DDR4_SDRAM_x8 expansion emits the datasheet per-chip
//      support network (ZQ 240Ω, VPP/VDD/VDDQ/VREFCA decoupling).
//   2. The SPEED BIN carried on the entity (Micron Table 1, default
//      -083 = DDR4-2400, tCK 0.833ns) reaches the layout sign-off:
//      the matched DQ lane below is graded against its DECLARED
//      length_match tolerances, and the report appends a bin-context
//      row restating the worst measured group spread as % of the
//      bin's unit interval (UI = tCK/2 = 417ps). Report-only — the
//      declared tolerances gate, the bin row is context.
import { DDR4_SDRAM_x8 } from "bhdl-stdlib/actives/ddr4_sdram.bhdl";
import { Cap } from "bhdl-stdlib/passives/capacitor.bhdl";
import { Res } from "bhdl-stdlib/passives/resistor.bhdl";

// A single matched DDR-style data lane (2 DQ + strobe), constraint
// budgets declared where they belong: on the interface.
interface DdrLane {
    signal DQ0: inout;
    signal DQ1: inout;
    signal DQS: inout;
    constraints {
        DQ0 -> DQS: length_match 45ps;
        DQ1 -> DQS: length_match 45ps;
    }
}

entity DdrCtrl() {
    interface DdrLane lane;
    pin VCC: power in;
    pin GND: ground;
    attribute component_class = "ic";
}

layout DdrCtrl {
    package SOIC-8;
}

board DDR4Board {
    power VDD = 1.2V @ 2A;
    ground GND;
    u1: DDR4_SDRAM_x8();
    @VDD -> u1.VDD; @VDD -> u1.VDDQ; u1.VSS -> @GND; u1.VSSQ -> @GND;

    // Matched lane: controller drives series terminations (stand-in
    // sinks — the SDRAM's own DQ balls await the hierarchical
    // ball-map binding grammar noted in the entity header).
    u2: DdrCtrl();
    u2.VCC -> @VDD; u2.GND -> @GND;
    u2.lane.DQ0 -> rt0: Res(33Ω).1; rt0.2 -> @GND;
    u2.lane.DQ1 -> rt1: Res(33Ω).1; rt1.2 -> @GND;
    u2.lane.DQS -> rts: Res(33Ω).1; rts.2 -> @GND;
}
