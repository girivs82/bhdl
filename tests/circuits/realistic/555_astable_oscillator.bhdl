// 555 Timer Astable Oscillator Circuit
// Generates a square wave output with adjustable frequency and duty cycle.
// Rewritten to the v2 language: the v1 `component ... { pin 1: ... }` /
// `instance U1 of Timer555;` / `connect` dialect is retired — the timer is
// now a top-level entity with named pins and the board uses v2 flow
// statements.

import { Cap } from "bhdl-stdlib/passives/capacitor.bhdl";
import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
import { LED } from "bhdl-stdlib/optoelectronic/led.bhdl";

// 555 Timer IC (NE555, DIP8). Named pins map the v1 numbered pins:
// 1=GND 2=TRIG 3=OUT 4=RST 5=CTRL 6=THR 7=DISCH 8=VCC.
entity Timer555() {
    pin GND:   ground;
    pin TRIG:  signal in;
    pin OUT:   signal out;
    pin RST:   signal in;
    pin CTRL:  signal in;
    pin THR:   signal in;
    pin DISCH: signal out;
    pin VCC:   power in;

    attribute component_class = "timer";
    attribute spice_model = "timer_555";
    attribute package_name = "DIP8"; // (`package` is a v2 keyword)
}

board Oscillator555 {
    // Power supply
    power VCC = 5V @ 100mA;
    ground GND;

    // 555 Timer instance
    u1: Timer555();

    // Power connections
    @VCC -> u1.VCC;
    u1.GND -> @GND;

    // Reset pin tied high
    @VCC -> u1.RST;

    // Control voltage bypass capacitor
    u1.CTRL -> c_ctrl: Cap(10nF).1; c_ctrl.2 -> @GND;

    // Timing components for ~1kHz square wave
    // Frequency = 1.44 / ((R1 + 2*R2) * C)
    // With R1=1k, R2=10k, C=100nF: f ≈ 654 Hz

    // R1: Charge path resistor
    @VCC -> r1: Res(1k).1; r1.2 -> u1.DISCH;

    // R2: Charge/discharge resistor
    u1.DISCH -> r2: Res(10k).1; r2.2 -> u1.THR;

    // Connect threshold and trigger together
    u1.THR -> u1.TRIG;

    // Timing capacitor
    u1.TRIG -> c_t: Cap(100nF).1; c_t.2 -> @GND;

    // Output LED indicator
    u1.OUT -> r_led: Res(470).1; r_led.2 -> led1: LED(red).A; led1.K -> @GND;

    // Decoupling capacitor
    @VCC -> c_dec: Cap(100nF).1; c_dec.2 -> @GND;
}
