// Correct usage of net assignment pattern in BHDL v2.0
import { Cap } from "bhdl-stdlib/passives/capacitor.bhdl";

import { Fuse, TVSDiode } from "bhdl-stdlib/protection/tvs.bhdl";

board NetAssignmentTest {
    power VIN = 12V @ 1A;
    ground GND;

    c1: Cap(100µF, 50V);
    c2: Cap(0.1µF, 50V);
    fuse: Fuse(1A, 10mΩ);
    protected_vin: TVSDiode(15V);
    @VIN -> fuse.1;
    c1.1 -> c2.1;  // net net_protected_vin_K
    c1.1 -> fuse.2;  // net net_protected_vin_K
    c1.1 -> protected_vin.K;  // net net_protected_vin_K
}
