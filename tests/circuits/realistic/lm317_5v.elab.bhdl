    U1_C_in.2 -> @GND;
    U1_C_out.2 -> @GND;
    U1_R2.2 -> @GND;
    U1_R1.2 -> U1_R2.1;  // net U1_auto_8
    U1_R1.2 -> U1_u.ADJ;  // net U1_auto_8
    @VIN -> U1.VIN;
    @VIN -> U1_C_in.1;
    @VIN -> U1_u.VIN;
    @VOUT -> U1.VOUT;
    @VOUT -> U1_C_out.1;
    @VOUT -> U1_R1.1;
    @VOUT -> U1_u.VOUT;
