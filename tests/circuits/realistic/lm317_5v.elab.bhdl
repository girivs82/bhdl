import { Ldo_LM317 } from "bhdl-stdlib/power/lm317.bhdl";
import { Cap, Res } from "bhdl-stdlib/passives/capacitor.bhdl";

board LM317_5V_Test {
    power VIN = 12V @ 0.5A;
    power VOUT = 5V @ 0.5A;
    ground GND;

    U1: Ldo_LM317(5V, 500mA, 12V);
    attribute U1.expansion_applied = "true";
    U1_C_in: Cap(10µF, 50V);
    attribute U1_C_in.composed_parent = "U1";
    attribute U1_C_in.composed_role = "shunt";
    U1_C_out: Cap(22µF, 50V);
    attribute U1_C_out.composed_parent = "U1";
    attribute U1_C_out.composed_role = "shunt";
    U1_R1: Res(720.000, 5%, 0.25W);
    attribute U1_R1.composed_parent = "U1";
    attribute U1_R1.composed_role = "series";
    U1_R2: Res(240Ω, 5%, 0.25W);
    attribute U1_R2.composed_parent = "U1";
    attribute U1_R2.composed_role = "shunt";
    U1_u: LM317();
