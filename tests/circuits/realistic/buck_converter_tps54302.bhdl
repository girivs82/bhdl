// Buck Converter using TPS54302
// 12V to 5V @ 2A switching regulator

import { TPS54302 } from "bhdl-stdlib/power/tps54302.bhdl";
import { Capacitor } from "bhdl-stdlib/passives/capacitor.bhdl";
import { Resistor } from "bhdl-stdlib/passives/resistor.bhdl";
import { Inductor } from "bhdl-stdlib/passives/inductor.bhdl";

board BuckConverterTPS54302 {
    // Power domains
    power VIN = 12V @ 3A;
    power VOUT = 5V @ 2A;
    ground GND;
    
    // Main regulator IC
    @VIN -> c_in1: Capacitor(22uF, 25V, role="InputFilter").1;
    @VIN -> c_in2: Capacitor(100nF, 25V, role="InputBypass").1;
    
    // Connect input caps to ground
    c_in1.2 -> @GND;
    c_in2.2 -> @GND;
    
    // Buck converter IC
    @VIN -> u1: TPS54302(role="BuckController").VIN;
    @VIN -> u1.EN;  // Always enabled
    u1.GND -> @GND;
    
    // Bootstrap capacitor (between BOOT and PH pins)
    u1.BOOT -> c_boot: Capacitor(100nF, 10V, role="Bootstrap").1; c_boot.2 -> u1.PH;
    
    // Power stage - inductor from SW to output
    u1.SW -> l1: Inductor(4.7uH, 3A, role="PowerInductor").1;
    l1.2 -> @VOUT;
    
    // Output capacitors
    @VOUT -> c_out1: Capacitor(47uF, 10V, role="OutputFilter").1;
    @VOUT -> c_out2: Capacitor(100nF, 10V, role="OutputBypass").1;
    c_out1.2 -> @GND;
    c_out2.2 -> @GND;
    
    // Feedback voltage divider
    // Vout = 0.6V * (1 + R1/R2)
    // For 5V output: 5V = 0.6V * (1 + R1/R2)
    // R1/R2 = 7.33, using R1=22kohm, R2=3kohm
    @VOUT -> r_fb1: Resistor(22k, tolerance=1%, role="FeedbackTop").1;
    r_fb1.2 -> r_fb2: Resistor(3k, tolerance=1%, role="FeedbackBottom").1; r_fb2.2 -> @GND;
    r_fb1.2 -> u1.FB;
}