// bhdl-sweep: skip — decap-synthesis LIBRARY fixture, not a board.
// Candidate capacitors for `decouple ... from "<this file>"`.
// Real-Data: every candidate declares capacitance, ESR AND ESL — a
// cap without declared parasitics cannot place its anti-resonances
// and is skipped by the synthesizer, stated. All values are FIXTURE
// data standing in for a real vendor library (e.g. an MLCC series
// with datasheet ESR/ESL curves).

entity DecapBulk100u() {
    pin 1: signal inout;
    pin 2: signal inout;
    attribute component_class = "capacitor";
    attribute capacitance = 100µF;
    attribute esr = 20mΩ;
    attribute esl = 5nH;
    attribute voltage_rating = 25V; // FIXTURE
    attribute kicad_symbol = "Device:C";
}

entity DecapMid10u() {
    pin 1: signal inout;
    pin 2: signal inout;
    attribute component_class = "capacitor";
    attribute capacitance = 10µF;
    attribute esr = 5mΩ;
    attribute esl = 1nH;
    attribute voltage_rating = 16V; // FIXTURE
    attribute kicad_symbol = "Device:C";
}

entity DecapHf100n() {
    pin 1: signal inout;
    pin 2: signal inout;
    attribute component_class = "capacitor";
    attribute capacitance = 100nF;
    attribute esr = 10mΩ;
    attribute esl = 0.5nH;
    attribute voltage_rating = 16V; // FIXTURE
    attribute kicad_symbol = "Device:C";
}

// Deliberately unusable: no ESL declared — the synthesizer must skip
// it with a stated note, never treat the parasite as zero.
entity DecapNoEsl() {
    pin 1: signal inout;
    pin 2: signal inout;
    attribute component_class = "capacitor";
    attribute capacitance = 1µF;
    attribute esr = 8mΩ;
    attribute kicad_symbol = "Device:C";
}

// FIXTURE — a bulk part WITH a per-part DC-bias curve (the shape a
// vendor tool exports; the NUMBERS here are fixture data, labelled).
entity DecapBiased47u() {
    pin 1: power in;
    pin 2: ground;
    attribute capacitance = 47µF;
    attribute esr = 8mΩ;
    attribute esl = 1.2nH;
    attribute voltage_rating = 10V; // FIXTURE
    attribute dc_bias = "0V:47µF,2V:39µF,3.3V:31µF,5V:22µF"; // FIXTURE curve
    attribute source = "FIXTURE — dc-bias consumption test";
}

// Deliberately UNDERRATED: the largest capacitance in the library but
// rated only 3.3V — the voltage gate must EXCLUDE it on any higher
// rail (without the gate its size would make it the bulk pick).
entity DecapJumbo220uLow3v3() {
    pin 1: signal inout;
    pin 2: signal inout;
    attribute component_class = "capacitor";
    attribute capacitance = 220µF;
    attribute esr = 15mΩ;
    attribute esl = 4nH;
    attribute voltage_rating = 3.3V; // FIXTURE — the exclusion case
    attribute kicad_symbol = "Device:C";
}
