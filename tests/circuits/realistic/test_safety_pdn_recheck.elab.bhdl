// ELABORATED bhdl — generated from test_safety_pdn_recheck.bhdl; DO NOT EDIT.
// The round-trip gate re-synthesizes this file and requires the
// IDENTICAL netlist. Every synthesized element carries a
// provenance comment naming the intent that produced it.

// bhdl-sweep: skip — safety-engine probe, not a layout target
// PDN-recheck probe: the rail is fed through an INDUCTOR, so the
// load-step droop is carried by the decap bank — losing the bulk cap
// defeats the droop contract while remaining a DC no-op. FIXTURE
// numbers throughout.

import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
import { Ind } from "bhdl-stdlib/passives/inductor.bhdl";

entity PdnCap(value: capacitance, esr_v: resistance, esl_v: inductance) {
    pin 1: signal inout;
    pin 2: signal inout;
    attribute component_class = "capacitor";
    attribute capacitance = value;
    attribute esr = esr_v;
    attribute esl = esl_v;
    attribute kicad_symbol = "Device:C";
}

entity Soc() {
    pin 1: signal inout;
    pin 2: signal inout;
    attribute component_class = "resistor";
    attribute resistance = 10MΩ;
    attribute kicad_symbol = "Device:R";
    domain VDD pins="1" v=12V tol=5% i_nom=1A i_max=3A
        step=2A rise=1us dur=20us droop_max=4%
        pdn_r=1m pdn_l=1n
        source="FIXTURE — PDN-recheck probe";
}

safety PdnFaultProbe as brd {
    mission { ambient = 40degC; lifetime = 15000h; }
    assume pdn(brd.soc.VDD);
    goal SG: ASIL_B "rail stays in window" (id="SG-PDNRC-1") {
        effect uv = brd.r_load.1 < 10V severity S2;
    }
}

board PdnFaultProbe {
    power V12 = 12V @ 5A;
    ground GND;

    c_bulk: PdnCap(100µF, 20mΩ, 5nH);
    c_mid: PdnCap(10µF, 5mΩ, 1nH);
    l_feed: Ind(1µH, 3A);
    r_load: Res(12Ω, 5%, 0.25W);
    soc: Soc();
    c_bulk.2 -> @GND;
    c_mid.2 -> @GND;
    r_load.2 -> @GND;
    soc.2 -> @GND;
    @V12 -> l_feed.1;
    c_bulk.1 -> c_mid.1;  // net auto_l_feed_2
    c_bulk.1 -> l_feed.2;  // net auto_l_feed_2
    c_bulk.1 -> r_load.1;  // net auto_l_feed_2
    c_bulk.1 -> soc.1;  // net auto_l_feed_2
}
