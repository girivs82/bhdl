// Mixed-Signal Circuit with Timing and Signal Processing Intents
// Demonstrates delay, debounce, and anti-aliasing intents

board MixedSignalBoard {
    power VCC = 5V @ 500mA;
    ground GND;

    // Button input with debouncing
    module Button {
        pin OUT: signal out;
        pin GND: ground inout;
    }

    net button_raw: btn: Button().OUT;
    net button_debounced: @button_raw -> R1: Res(10k).1 -> R1.2 -> C1: Cap(1u).1 -> C1.2 -> @GND
        for debounce(time: 20ms);

    // Signal buffering for multiple loads
    net buffered_signal: @button_debounced -> buf: Buffer().IN -> buf.OUT
        for signal_buffering(fanout: 8, drive: high);

    // Fast digital path for immediate response
    net fast_path: @buffered_signal -> R2: Res(100).1 -> R2.2 -> led1: LED(red).A -> led1.K -> @GND
        for delay(10ns)
        for current_limiting(max: 20mA);

    // Slow digital path with delay
    net slow_path: @buffered_signal -> R3: Res(1k).1 -> C2: Cap(1u).1 -> R3.2 -> led2: LED(yellow).A -> led2.K -> @GND
        for delay(1ms)
        for current_limiting(max: 10mA);

    // Analog sensor path with anti-aliasing
    module AnalogSensor {
        pin OUT: signal out;
        pin VCC: power in;
        pin GND: ground inout;
    }

    @VCC -> sensor: AnalogSensor().VCC;
    sensor.GND -> @GND;

    // Anti-aliasing filter before ADC
    module ADC {
        pin IN: signal in;
        pin CLK: clock in;
        pin DATA: signal out;
        pin VCC: power in;
        pin GND: ground inout;
    }

    net sensor_filtered: sensor.OUT -> Rf: Res(1k).1 -> Rf.2 -> Cf: Cap(100n).1 -> Cf.2 -> @GND
        for anti_alias(before: adc, cutoff: 1kHz);

    @sensor_filtered -> adc: ADC().IN;
    @VCC -> adc.VCC;
    adc.GND -> @GND;

    // ADC output - debug only, not production
    net adc_data: adc.DATA -> R4: Res(1k).1
        for debug_only();
}
