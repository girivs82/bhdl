// route_bias STRICT corpus lock: a small all-THT board whose signal
// copper must live ENTIRELY on B.Cu with zero vias (the hand-routed
// single-sided idiom the ecc83 demo uses — the router detours around
// obstacles instead of jumping layers). This fixture exists so the
// strict tier stays exercised by the oracle gate without the GND-pour
// experiment: ecc83 itself completes strict only with the pour
// absorbing its ground routing.

import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
import { Cap } from "bhdl-stdlib/passives/capacitor.bhdl";
import { TerminalBlock_1x02 } from "bhdl-stdlib/connectors/pin_header.bhdl";

board TestRouteBiasStrict {
    power VIN = 12V @ 100mA;
    ground GND;

    J_IN:  TerminalBlock_1x02();
    J_OUT: TerminalBlock_1x02();
    @VIN -> J_IN.1; J_IN.2 -> @GND;
    J_OUT.2 -> @GND;

    // A two-stage RC divider chain — enough nets to force real
    // detour routing between the axial bodies.
    @VIN -> r1: Res(10kΩ).1;
    r1.2 -> r2: Res(10kΩ).1;
    r2.2 -> @GND;
    r1.2 -> c1: Cap(100nF).1;
    c1.2 -> @GND;
    r1.2 -> r3: Res(47kΩ).1;
    r3.2 -> J_OUT.1;
    J_OUT.1 -> c2: Cap(100nF).1;
    c2.2 -> @GND;
}

layout Res { package Axial-P7.62; }
layout Cap { package Disc-P5.00; }

layout TestRouteBiasStrict {
    layer_stackup 2;
    route_bias bottom strict;
    outline rect 40 30;
}
