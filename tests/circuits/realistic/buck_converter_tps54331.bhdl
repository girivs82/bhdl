// Buck Converter using the Buck_TPS54331 design block
// Tests the two-layer library model: the board wires the block's
// contract pins; the block composes the TPS54331 part + application circuit.
// 12V to 5V @ 2A

import { Buck_TPS54331 } from "bhdl-stdlib/power/tps54331.bhdl";
import { Cap } from "bhdl-stdlib/passives/capacitor.bhdl";
import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
import { TestPoint } from "bhdl-stdlib/connectors/testpoint.bhdl";

board BuckConverterTPS54331 {
    // Power domains
    power VIN = 12V @ 3A;
    port VOUT_5V: power out = 5V @ 2A;
    ground GND;
    
    // Input filtering (required but not part of virtual pin)
    VIN -> C_IN1: Cap(220µF, voltage=25V).1;
    C_IN1.2 -> GND;
    VIN -> C_IN2: Cap(0.1µF, voltage=25V).1;  
    C_IN2.2 -> GND;
    
    // Buck stage (design block; VOUT is its virtual contract pin)
    U1: Buck_TPS54331(v_out=5V);
    VIN -> U1.VIN;
    U1.GND -> GND;
    U1.EN -> VIN;  // Always enabled
    
    // Virtual pin connection - this should expand to:
    // - Output inductor (calculated ~15µH for 5V)
    // - Catch diode (the expansion mints it; a hand-authored D1 here
    //   would shadow U1_D_catch in parallel — ERC030)
    // - Bootstrap capacitor (100nF)
    // - Output capacitors (2×22µF)
    // - Feedback resistor divider
    // - Compensation network
    // - Soft-start capacitor
    U1.VOUT -> @VOUT_5V;
    
    // Load for testing (2.5Ω = 2A at 5V)
    @VOUT_5V -> R_LOAD: Res(2.5Ω, wattage=10W).1;
    R_LOAD.2 -> GND;
    
    // Optional: Add test points. SW and FB belong to the silicon INSIDE
    // the block (two-layer library model: U1 is Buck_TPS54331, the part
    // is U1.u) — reached through the hierarchical accessor.
    @VOUT_5V -> TP1: TestPoint();
    U1.u.SW -> TP2: TestPoint();
    U1.u.FB -> TP3: TestPoint();
}

// Module definition for test point (simple)
entity TestPoint() {
    pin 1: signal inout {
        description: "Test point connection"
    };
}