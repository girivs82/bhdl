// Buck converter with staged output banks + Type II compensation network —
// regenerated to v2 from the v1 dialect (alias Module controller, inline
// `X -> NAME(args).1` instantiation, type=/power= reserved-word args).
//
// 12V → 5V @ 3A, hand-wired TPS54302. The v1 board's discrete controller had
// a COMP pin for its Type II compensation network; the TPS54302 is internally
// compensated and has no COMP pin, so the v1 network (10k + 4.7nF series to
// ground, 47pF parallel) is preserved off the FB node as this fixture's RC
// subject — the values are the point, not loop math.

import { TPS54302 } from "bhdl-stdlib/power/tps54302.bhdl";
import { Cap, ElectrolyticCap } from "bhdl-stdlib/passives/capacitor.bhdl";
import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
import { Ind } from "bhdl-stdlib/passives/inductor.bhdl";

board BuckConverterStable {
    power VIN_12V = 12V @ 5A;
    power VOUT_5V = 5V @ 3A;
    ground GND;

    c_boot: Cap(100nF, 50V);
    c_comp1: Cap(4.7nF, 50V);
    c_comp2: Cap(47pF, 50V);
    c_in_bulk: ElectrolyticCap(470uF, 35V);
    c_in_hf: Cap(10uF, 35V);
    c_out_bulk: ElectrolyticCap(100uF, 16V);
    c_out_hf: Cap(10uF, 16V);
    c_out_mid: Cap(47uF, 16V);
    l1: Ind(8.2uH, 6A);
    r_comp: Res(10k, 5%, 0.25W);
    r_fb_bot: Res(3k, 1%, 0.25W);
    r_fb_top: Res(22k, 1%, 0.25W);
    r_load: Res(1.67, 5%, 50W);
    u1: TPS54302();
    c_comp1.2 -> @GND;
    c_in_bulk.neg -> @GND;
    c_in_hf.2 -> @GND;
    c_out_bulk.neg -> @GND;
    c_out_hf.2 -> @GND;
    c_out_mid.2 -> @GND;
    r_fb_bot.2 -> @GND;
    r_load.2 -> @GND;
    u1.GND -> @GND;
    @VIN_12V -> c_in_bulk.pos;
    @VIN_12V -> c_in_hf.1;
    @VIN_12V -> u1.EN;
    @VIN_12V -> u1.VIN;
    @VOUT_5V -> c_out_bulk.pos;
    @VOUT_5V -> c_out_hf.1;
    @VOUT_5V -> c_out_mid.1;
    @VOUT_5V -> l1.2;
    @VOUT_5V -> r_fb_top.1;
    @VOUT_5V -> r_load.1;
    c_boot.2 -> u1.PH;  // net auto_c_boot_2
    c_comp1.1 -> c_comp2.2;  // net auto_c_comp2_2
    c_comp1.1 -> r_comp.2;  // net auto_c_comp2_2
    c_comp2.1 -> r_comp.1;  // net auto_r_fb_top_2
    c_comp2.1 -> r_fb_bot.1;  // net auto_r_fb_top_2
    c_comp2.1 -> r_fb_top.2;  // net auto_r_fb_top_2
    c_comp2.1 -> u1.FB;  // net auto_r_fb_top_2
    c_boot.1 -> u1.BOOT;  // net auto_u1_BOOT
    l1.1 -> u1.SW;  // net auto_u1_SW
}
