// Simple 7805 voltage regulator test for CLI pipeline

import { Ldo_LM7805 } from "bhdl-stdlib/power/lm7805.bhdl";

board VoltageRegulator {
    // Power domains
    power VIN = 12V @ 500mA;
    port VOUT: power out = 5V @ 400mA;
    ground GND;
    
    // Simple regulator circuit with minimal components
    @VIN -> U1: Ldo_LM7805().VIN;
    U1.GND -> @GND;
    U1.VOUT -> @VOUT;
}