// STM32F103RB sensor-node core — the LQFP-64 R package on a 3.3 V
// rail. The deliberate point of this fixture: it WIRES PA0 and PC13,
// the two pins whose vendor-IBIS bindings ride the suffixed-name map
// entries (PA0 = PA0-WKUP, PC13 = PC13-ANTI_TAMP in ST's [Pin]
// table) — the C8 blue-pill fixture never exercised them, so the map
// path shipped unproven. Here PA0 is the classic wake button (pullup
// + header) and PC13 the RTC-domain LED; both must stamp real ST
// IO8TC buffers in the synthesis log. I²C1 rides PB6/PB7 as on the
// blue pill (gated pullups fire), and the SWD pins go to a header.

import { STM32F103Rx } from "bhdl-stdlib/actives/stm32f103rx.bhdl";
import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
import { LED } from "bhdl-stdlib/optoelectronic/led.bhdl";
import { Pin_Header_01x03 } from "bhdl-stdlib/connectors/pin_header.bhdl";
import { Pin_Header_01x04 } from "bhdl-stdlib/connectors/pin_header.bhdl";

board Stm32RbNode {
    power VDD = 3.3V @ 100mA;
    ground GND;

    mcu: STM32F103Rx();

    // Power: four digital VDD/VSS pairs on LQFP-64, one die rail.
    @VDD -> mcu.VDD_1;
    @VDD -> mcu.VDD_2;
    @VDD -> mcu.VDD_3;
    @VDD -> mcu.VDD_4;
    @VDD -> mcu.VDDA;
    mcu.VSS_1 -> @GND;
    mcu.VSS_2 -> @GND;
    mcu.VSS_3 -> @GND;
    mcu.VSS_4 -> @GND;
    mcu.VSSA  -> @GND;
    mcu.VBAT  -> @VDD;      // no backup battery

    // PA0-WKUP: wake button input — pullup to VDD, pin to header
    // (external switch pulls to GND).
    @VDD -> r_wkup: Res(10kΩ).1;
    r_wkup.2 -> WKUP;
    WKUP -> mcu.PA0;
    J_BTN: Pin_Header_01x03();
    WKUP -> J_BTN.1;
    J_BTN.2 -> @GND;
    J_BTN.3 -> @GND;

    // PC13-ANTI_TAMP: the RTC-domain LED (active-low, as on every
    // dev board — PC13 sinks; the LED hangs from VDD).
    @VDD -> r_led: Res(1kΩ).1;
    r_led.2 -> D_rtc: LED(color="green").A;
    D_rtc.K -> LED_C;
    LED_C -> mcu.PC13;

    // I²C1 out to a sensor header — gated pullups fire on PB6/PB7.
    mcu.PB6 -> SCL_BUS;
    mcu.PB7 -> SDA_BUS;
    J_I2C: Pin_Header_01x04();
    @VDD -> J_I2C.1;
    SCL_BUS -> J_I2C.2;
    SDA_BUS -> J_I2C.3;
    J_I2C.4 -> @GND;

    // SWD header.
    J_SWD: Pin_Header_01x04();
    @VDD -> J_SWD.1;
    mcu.PA13 -> J_SWD.2;    // SWDIO
    mcu.PA14 -> J_SWD.3;    // SWCLK
    J_SWD.4 -> @GND;
}

layout Stm32RbNode {
    layer_stackup 2;
    outline rect 50 40;
    place J_BTN at (2.6, 12);
    place J_I2C at (2.6, 30);
    place J_SWD at (47.4, 20);
}
