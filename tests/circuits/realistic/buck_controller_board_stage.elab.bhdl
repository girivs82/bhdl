    attribute u1_C_vcc_cap.vpin_parent = "u1";
    attribute u1_C_vcc_cap.vpin_role = "shunt";
    c_out.2 -> @GND;
    q_ls.S -> @GND;
    r_bot.2 -> @GND;
    r_load.2 -> @GND;
    u1.GND -> @GND;
    u1_C_in.2 -> @GND;
    u1_C_vcc_cap.2 -> @GND;
    @VCC_12V -> c_out.1;
    @VCC_12V -> l1.2;
    @VCC_12V -> r_load.1;
    @VCC_12V -> r_top.1;
    @VIN_24V -> q_hs.D;
    @VIN_24V -> u1.EN;
