// 7805 regulator circuit with proper type definitions
// Defines power/ground types and component types

// Type definitions for electrical signals
type power = electrical {
    voltage: 5V to 25V;
    current: 0A to 5A;
};

type ground = electrical {
    voltage: 0V;
    current: 0A to 10A;
};

// Component type definitions
component LM7805 {
    pin IN: power;
    pin OUT: power;
    pin GND: ground;
}

component Capacitor {
    parameter value: capacitance;
    parameter voltage: voltage = 16V;
    pin plus: power;
    pin minus: ground;
}

// Main board definition
board LinearRegulator {
    nets {
        power;
        power;
        ground;
    }
    
    components {
        component LM7805 REG1;
        component Capacitor CAP1 { 
            parameter value = 330uF;
            parameter voltage = 25V;
        }
        component Capacitor CAP2 {
            parameter value = 100nF;
            parameter voltage = 16V;
        }
    }
    
    connections {
        // Input section
        connect VIN -> CAP1.plus;
        connect CAP1.plus -> REG1.IN;
        connect CAP1.minus -> GND;
        
        // Regulator ground
        connect REG1.GND -> GND;
        
        // Output section
        connect REG1.OUT -> CAP2.plus;
        connect CAP2.plus -> VOUT;
        connect CAP2.minus -> GND;
    }
}