// Simple TPS54302 Buck Converter Test
// 12V to 5V buck converter using the canonical stdlib TPS54302 (which carries
// the §4 simulation { stress { } } device-stress model). Support parts are
// named l_out / c_out1 / c_in1 to match the part's stress-block references.

import { TPS54302 } from "bhdl-stdlib/power/tps54302.bhdl";

// Simplified passive stubs (the regulator is the canonical stdlib part).
entity Cap(value: capacitance) {
    pin 1: signal inout;
    pin 2: signal inout;
}

entity Res(value: resistance) {
    pin 1: signal inout;
    pin 2: signal inout;
}

entity Ind(value: inductance) {
    pin 1: signal inout;
    pin 2: signal inout;
}

board TPS54302_Buck {
    power VIN = 12V @ 3A;
    power VOUT = 5V @ 2A;
    ground GND;

    c_boot: Cap(100nF, 50V);
    c_in1: Cap(22uF, 50V);
    c_in2: Cap(100nF, 50V);
    c_out1: Cap(47uF, 50V);
    c_out2: Cap(22uF, 50V);
    l_out: Ind(4.7uH, 0A);
    r_fb1: Res(22k, 5%, 0.25W);
    r_fb2: Res(3k, 5%, 0.25W);
    reg: TPS54302();
    c_in1.2 -> @GND;
    c_in2.2 -> @GND;
    c_out1.2 -> @GND;
    c_out2.2 -> @GND;
    r_fb2.2 -> @GND;
    reg.GND -> @GND;
    @VIN -> c_in1.1;
    @VIN -> c_in2.1;
    @VIN -> reg.EN;
    @VIN -> reg.VIN;
    @VOUT -> c_out1.1;
    @VOUT -> c_out2.1;
    @VOUT -> l_out.2;
    @VOUT -> r_fb1.1;
    c_boot.2 -> l_out.1;  // net auto_c_boot_2
    c_boot.2 -> reg.PH;  // net auto_c_boot_2
    r_fb1.2 -> r_fb2.1;  // net auto_r_fb1_2
    r_fb1.2 -> reg.FB;  // net auto_r_fb1_2
    c_boot.1 -> reg.BOOT;  // net auto_reg_BOOT
}
