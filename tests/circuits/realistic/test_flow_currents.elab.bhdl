// ELABORATED bhdl — generated from test_flow_currents.bhdl; DO NOT EDIT.
// The round-trip gate re-synthesizes this file and requires the
// IDENTICAL netlist. Every synthesized element carries a
// provenance comment naming the intent that produced it.

// Flow-analysis fixture: a 5V rail feeding a HEAVY load (10Ω → 0.5A)
// and a LIGHT one (1kΩ → 5mA). With GLACIER-solved per-sink currents
// the power tree tapers by REAL draw — the trunk toward the heavy
// load is wide, the light branch stays thin. The equal-share
// approximation would size both branches identically.

import { Res } from "bhdl-stdlib/passives/resistor.bhdl";

entity PwrIn() {
    pin VOUT: power out;
    pin GND: ground;

    attribute component_class = "connector";
}

layout PwrIn {
    package SOT-223;
}

layout FlowDemo {
    layer_stackup 2;
    outline rect 26 20;
}

board FlowDemo {
    power VCC = 5V @ 0.6A;
    ground GND;

    j1: PwrIn();
    r_heavy: Res(10, 5%, 0.25W);
    r_light: Res(1000, 5%, 0.25W);
    j1.GND -> @GND;
    r_heavy.2 -> @GND;
    r_light.2 -> @GND;
    @VCC -> j1.VOUT;
    @VCC -> r_heavy.1;
    @VCC -> r_light.1;
}
