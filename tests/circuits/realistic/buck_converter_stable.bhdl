// Buck converter with staged output banks + Type II compensation network —
// regenerated to v2 from the v1 dialect (alias Module controller, inline
// `X -> NAME(args).1` instantiation, type=/power= reserved-word args).
//
// 12V → 5V @ 3A, hand-wired TPS54302. The v1 board's discrete controller had
// a COMP pin for its Type II compensation network; the TPS54302 is internally
// compensated and has no COMP pin, so the v1 network (10k + 4.7nF series to
// ground, 47pF parallel) is preserved off the FB node as this fixture's RC
// subject — the values are the point, not loop math.

import { TPS54302 } from "bhdl-stdlib/power/tps54302.bhdl";
import { Cap, ElectrolyticCap } from "bhdl-stdlib/passives/capacitor.bhdl";
import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
import { Ind } from "bhdl-stdlib/passives/inductor.bhdl";

board BuckConverterStable {
    power VIN_12V = 12V @ 5A;
    power VOUT_5V = 5V @ 3A;
    ground GND;

    // ── Input bank: bulk electrolytic + HF ceramic ──
    @VIN_12V -> c_in_bulk: ElectrolyticCap(470uF, 35V).pos;
    c_in_bulk.neg -> @GND;
    @VIN_12V -> c_in_hf: Cap(10uF, 35V).1; c_in_hf.2 -> @GND;

    // ── Regulator ──
    @VIN_12V -> u1: TPS54302().VIN;
    @VIN_12V -> u1.EN;              // always enabled
    u1.GND -> @GND;

    // Bootstrap: BOOT → 100nF → PH.
    u1.BOOT -> c_boot: Cap(100nF).1; c_boot.2 -> u1.PH;

    // ── Power stage: SW → 8.2µH → VOUT ──
    u1.SW -> l1: Ind(8.2uH, 6A).1;
    l1.2 -> @VOUT_5V;

    // ── Staged output bank: bulk electrolytic + mid/HF ceramics ──
    @VOUT_5V -> c_out_bulk: ElectrolyticCap(100uF, 16V).pos;
    c_out_bulk.neg -> @GND;
    @VOUT_5V -> c_out_mid: Cap(47uF, 16V).1; c_out_mid.2 -> @GND;
    @VOUT_5V -> c_out_hf: Cap(10uF, 16V).1; c_out_hf.2 -> @GND;

    // ── Feedback divider: Vout = 0.596V · (1 + 22k/3k) ≈ 5V ──
    @VOUT_5V -> r_fb_top: Res(22k, tolerance=1%).1;
    r_fb_top.2 -> u1.FB;
    u1.FB -> r_fb_bot: Res(3k, tolerance=1%).1; r_fb_bot.2 -> @GND;

    // ── Type II compensation network (v1 values, kept off the FB node) ──
    // Series R-C to ground (zero for phase boost) …
    u1.FB -> r_comp: Res(10k).1;
    r_comp.2 -> c_comp1: Cap(4.7nF).1; c_comp1.2 -> @GND;
    // … plus a parallel HF-pole cap across the same node.
    u1.FB -> c_comp2: Cap(47pF).1; c_comp2.2 -> r_comp.2;

    // ── Load ──
    @VOUT_5V -> r_load: Res(1.67, wattage=50W).1; r_load.2 -> @GND;
}
