// Cascaded Buck Converters - Realistic Multi-Rail Power System
// 24V -> 12V -> 5V -> 3.3V with proper decoupling

board CascadedBuckSystem {
    // Power declarations
    power VIN_24V = 24V @ 10A;
    power V12_RAIL = 12V @ 5A;
    power V5_RAIL = 5V @ 3A;
    power V3_3_RAIL = 3.3V @ 2A;
    ground GND;
    
    // === Stage 1: 24V to 12V Buck ===
    // Input filtering for 24V rail
    VIN_24V -> C1_IN(100uF, voltage=35V).1;
    C1_IN.2 -> GND;
    
    // Buck 1 power stage (simplified)
    VIN_24V -> SW1(Switch).1;
    SW1.2 -> L1(33uH, current=6A).1;
    L1.2 -> V12_RAIL;
    
    // Output caps for 12V rail
    V12_RAIL -> C1_OUT(330uF, voltage=16V, esr=30mOhm).1;
    C1_OUT.2 -> GND;
    V12_RAIL -> C1_OUT_HF(22uF, voltage=16V, type="X7R").1;
    C1_OUT_HF.2 -> GND;
    
    // === Stage 2: 12V to 5V Buck ===
    // Critical: Input cap for stage 2 (prevents interaction)
    V12_RAIL -> C2_IN(100uF, voltage=16V).1;
    C2_IN.2 -> GND;
    V12_RAIL -> C2_IN_HF(10uF, voltage=16V, type="X7R").1;
    C2_IN_HF.2 -> GND;
    
    // Buck 2 power stage
    V12_RAIL -> SW2(Switch).1;
    SW2.2 -> L2(22uH, current=4A).1;
    L2.2 -> V5_RAIL;
    
    // Output caps for 5V rail
    V5_RAIL -> C2_OUT(220uF, voltage=10V, esr=40mOhm).1;
    C2_OUT.2 -> GND;
    V5_RAIL -> C2_OUT_HF(47uF, voltage=10V, type="X7R").1;
    C2_OUT_HF.2 -> GND;
    
    // === Stage 3: 5V to 3.3V Buck ===
    // Input cap for stage 3
    V5_RAIL -> C3_IN(47uF, voltage=10V).1;
    C3_IN.2 -> GND;
    V5_RAIL -> C3_IN_HF(10uF, voltage=10V, type="X7R").1;
    C3_IN_HF.2 -> GND;
    
    // Buck 3 power stage
    V5_RAIL -> SW3(Switch).1;
    SW3.2 -> L3(15uH, current=3A).1;
    L3.2 -> V3_3_RAIL;
    
    // Output caps for 3.3V rail
    V3_3_RAIL -> C3_OUT(150uF, voltage=6.3V, esr=50mOhm).1;
    C3_OUT.2 -> GND;
    V3_3_RAIL -> C3_OUT_HF(22uF, voltage=6.3V, type="X7R").1;
    C3_OUT_HF.2 -> GND;
    
    // === Loads on each rail ===
    V12_RAIL -> LOAD_12V(12, power=12W).1;
    LOAD_12V.2 -> GND;
    
    V5_RAIL -> LOAD_5V(5, power=5W).1;
    LOAD_5V.2 -> GND;
    
    V3_3_RAIL -> LOAD_3V3(3.3, power=3.3W).1;
    LOAD_3V3.2 -> GND;
    
    // === Damping Networks for Stability ===
    // Add RC damper on 12V rail
    V12_RAIL -> RDAMP1(0.1).1;
    RDAMP1.2 -> CDAMP1(100uF).1;
    CDAMP1.2 -> GND;
    
    // Add RC damper on 5V rail
    V5_RAIL -> RDAMP2(0.1).1;
    RDAMP2.2 -> CDAMP2(100uF).1;
    CDAMP2.2 -> GND;
}