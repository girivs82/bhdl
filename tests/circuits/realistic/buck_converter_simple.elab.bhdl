// Simple Buck Converter for End-to-End Testing
// 12V to 5V @ 2A using LM2596 (assuming it's in the component library)

import { Cap } from "bhdl-stdlib/passives/capacitor.bhdl";
import { SchottkyDiode } from "bhdl-stdlib/passives/diode.bhdl";
import { Inductor } from "bhdl-stdlib/passives/inductor.bhdl";
import { Res } from "bhdl-stdlib/passives/resistor.bhdl";

import { LM2596 } from "bhdl-stdlib/components/power/switching_regulators/LM2596.bhdl";

board SimpleBuckConverter {
    power VIN = 12V @ 3A;
    power VOUT = 5V @ 2A;
    ground GND;

    C1: Cap(100µF, 25V);
    C2: Cap(0.1µF, 50V);
    C3: Cap(220µF, 10V);
    C4: Cap(0.1µF, 50V);
    D1: SchottkyDiode(SS34);
    // WARNING: no ctor signature for this entity — emitted bare; round-trip unverified
    L1: Inductor();
    R1: Res(10kΩ, 1%, 0.25W);
    R2: Res(3.24kΩ, 1%, 0.25W);
    RL: Res(2.5Ω, 5%, 10W);
    U1: LM2596(5V);
    attribute U1.expansion_applied = "true";
    attribute U1.expansion_skipped = "board-authored output path (virtual 'VOUT' unwired, [FB, SW] wired)";
    C1.2 -> @GND;
    C2.2 -> @GND;
    C3.2 -> @GND;
    C4.2 -> @GND;
    D1.A -> @GND;
    R2.2 -> @GND;
    RL.2 -> @GND;
    U1.GND -> @GND;
    @VIN -> C1.1;
    @VIN -> C2.1;
    @VIN -> U1.EN;
    @VIN -> U1.VIN;
    @VOUT -> C3.1;
    @VOUT -> C4.1;
    @VOUT -> L1.2;
    @VOUT -> R1.1;
    @VOUT -> RL.1;
    D1.K -> L1.1;  // net auto_D1_K
    D1.K -> U1.SW;  // net auto_D1_K
    R1.2 -> R2.1;  // net fb_node
    R1.2 -> U1.FB;  // net fb_node
}
