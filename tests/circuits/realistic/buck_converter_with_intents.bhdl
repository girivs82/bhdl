// Buck Converter with Intent-Driven Design
// Demonstrates control loop, current limiting, and precision measurement intents

import { TVSDiode } from "bhdl-stdlib/protection/tvs.bhdl";
import { Cap } from "bhdl-stdlib/passives/capacitor.bhdl";
import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
import { Inductor } from "bhdl-stdlib/passives/inductor.bhdl";
import { TPS54302 } from "bhdl-stdlib/power/tps54302.bhdl";

board BuckConverter {
    power VIN = 12V @ 2A;
    ground GND;

    // Input protection
    @VIN -> @protected_vin;
    @protected_vin -> tvs: TVSDiode(18V).K; tvs.A -> @GND
        for input_protection(overvoltage: 18V, current_limit: 3A);

    // Input bulk capacitor for current surge
    @protected_vin -> @vin_filtered;
    @vin_filtered -> Cin: Cap(100u).1; Cin.2 -> @GND
        for noise_filtering(cutoff: 10kHz);

    // Buck converter controller (stdlib part; the v1 nested-entity decl
    // inside board scope is retired — entities live at top level).
    @vin_filtered -> ctrl: TPS54302().VIN;
    ctrl.GND -> @GND;

    // LC filter for switching noise
    ctrl.SW -> @switch_node;
    @switch_node -> L1: Inductor(10u).1;

    L1.2 -> @output_unfiltered;
    @output_unfiltered -> Cout: Cap(47u).1
        for noise_filtering(cutoff: 100kHz, attenuation: 60dB);

    Cout.2 -> @GND;

    // Feedback network with precision requirements
    @output_unfiltered -> @fb_node;
    @fb_node -> R1: Res(10k).1; R1.2 -> @GND
        for precision_measurement(accuracy: 1%, resolution_bits: 12);
    // (control_loop intent folded out — the flow model carries ONE intent
    // per statement; the precision requirement is the one the ERC gates.)

    R1.2 -> ctrl.FB;

    // Output with current limiting
    power VOUT = 5V @ 1.5A;
    @output_unfiltered -> @VOUT;

    // Load current measurement
    @VOUT -> @load_current;
    @load_current -> Rload: Res(3.3).1; Rload.2 -> @GND
        for precision_measurement(accuracy: 0.5%);
    // (current_limiting intent folded out — single-intent flow model.)
}
