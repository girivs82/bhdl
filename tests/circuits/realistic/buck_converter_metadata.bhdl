// Buck converter with explicit pin metadata for component role detection
// This example shows how pin metadata improves SPICE analysis

board BuckConverterBoard {
    // Input power supply
    power VIN = 12V @ 2A;
    ground GND;
    
    // Buck controller with comprehensive pin metadata
    VIN -> U1: BuckController().VIN;
    U1.GND -> GND;
    U1.EN -> VIN;  // Always enabled
    
    // Switch node connections
    U1.SW -> @switch_node;
    @switch_node -> L1: Inductor(10uH).1;
    L1.2 -> @VOUT;
    
    // Freewheeling diode
    @switch_node -> D1: SchottkyDiode(SS34).K;
    D1.A -> GND;
    
    // Feedback network
    @VOUT -> R1: Res(10k, tolerance=1%).1;
    R1.2 -> @feedback_point;
    @feedback_point -> R2: Res(2.2k, tolerance=1%).1;
    R2.2 -> GND;
    @feedback_point -> U1.FB;
    
    // Compensation network
    @feedback_point -> R3: Res(15k).1;
    R3.2 -> @comp_net;
    @comp_net -> C3: Cap(10nF, type="C0G").1;
    C3.2 -> GND;
    @comp_net -> U1.COMP;
    
    // Input filtering
    VIN -> C1: Cap(100uF, voltage=25V).1;
    C1.2 -> GND;
    
    // Output filtering  
    @VOUT -> C2: Cap(220uF, voltage=10V).1;
    C2.2 -> GND;
    
    // Output power
    power VOUT = 3.3V @ 1A;
    
    // Load for testing
    VOUT -> Rload: Res(10).1;
    Rload.2 -> GND;
}

// Buck controller module with detailed pin metadata
entity BuckController() {
    // Power input with metadata
    pin VIN: power in @metadata(
        function="PowerIn",
        voltage_range="4.5V-40V",
        max_current="100mA"
    );
    
    // Switch node output with high dV/dt
    pin SW: power out @metadata(
        function="SwitchNode",
        max_voltage="42V",
        max_current="3A",
        slew_rate="fast",
        dv_dt="100V/us"
    );
    
    // Feedback input
    pin FB: signal in @metadata(
        function="Feedback", 
        voltage_range="0V-5V",
        impedance="high",
        threshold="0.8V"
    );
    
    // Compensation pin
    pin COMP: signal out @metadata(
        function="Compensation",
        voltage_range="0V-3.3V",
        impedance="10kohm"
    );
    
    // Enable input
    pin EN: signal in @metadata(
        function="Enable",
        voltage_range="0V-40V",
        threshold="1.2V",
        active="high"
    );
    
    // Ground reference
    pin GND: ground @metadata(
        function="Ground"
    );
}

// Supporting modules
entity SchottkyDiode(breakdown_voltage: voltage) {
    pin A: signal;
    pin K: signal;
}

entity Inductor(inductance: inductance) {
    pin 1: signal;
    pin 2: signal;
}