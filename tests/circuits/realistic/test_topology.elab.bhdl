// ELABORATED bhdl — generated from test_topology.bhdl; DO NOT EDIT.
// The round-trip gate re-synthesizes this file and requires the
// IDENTICAL netlist. Every synthesized element carries a
// provenance comment naming the intent that produced it.

// Topology + layer-rule fixture: CLK fans out star-style from the
// driver (every branch sourced at the root pin); EN daisy-chains
// through the loads nearest-neighbor; CLK is also locked to the top
// layer. All three constraints ride the shipped v0.8 intf_const
// attribute contract and are graded in the sign-off report.

import { Res } from "bhdl-stdlib/passives/resistor.bhdl";

entity ClkDriver() {
    pin CLK: signal out;
    pin EN: signal out;
    pin VCC: power in;
    pin GND: ground;

    attribute intf_const__CLK__topology = "star";
    attribute intf_const__CLK__layer = "top";
    attribute intf_const__EN__topology = "fly_by";
    attribute intf_const__EN__stub_max = "2mm";
}

layout ClkDriver {
    package SOIC-8;
}

layout TopoDemo {
    layer_stackup 2;
    outline rect 34 26;
    // Fly-by devices sit in a row — the chain runs straight and the
    // stub budget is meetable (a scattered placement makes the spur a
    // real stub, and the sign-off honestly FAILs it).
    place u1 at (6, 13) rot 0;
    place rd at (17, 13) rot 0;
    place re at (26, 13) rot 0;
}

board TopoDemo {
    power VCC = 3.3V @ 0.1A;
    ground GND;

    ra: Res(10000, 5%, 0.25W);
    rb: Res(10000, 5%, 0.25W);
    rc: Res(10000, 5%, 0.25W);
    rd: Res(10000, 5%, 0.25W);
    re: Res(10000, 5%, 0.25W);
    u1: ClkDriver();
    ra.2 -> @GND;
    rb.2 -> @GND;
    rc.2 -> @GND;
    rd.2 -> @GND;
    re.2 -> @GND;
    u1.GND -> @GND;
    @VCC -> u1.VCC;
    ra.1 -> rb.1;  // net auto_u1_CLK
    ra.1 -> rc.1;  // net auto_u1_CLK
    ra.1 -> u1.CLK;  // net auto_u1_CLK
    rd.1 -> re.1;  // net auto_u1_EN
    rd.1 -> u1.EN;  // net auto_u1_EN
}
