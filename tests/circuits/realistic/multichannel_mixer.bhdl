// KiCad demo transcription: multichannel_mixer (corpus board 93) —
// the official 4-channel mixer demo (~/Downloads/demos/multichannel),
// KiCad's showcase for repeated sub-sheets. Here the repeated sheet
// becomes what it wants to be: ONE ChannelStrip ENTITY instantiated
// four times — the bhdl channel-instance idiom.
//
// Netlist read from the demo's own .kicad_pcb pad-net bindings
// (channel A traced component-by-component; B/C/D are the same strip
// by construction). Topology per strip (single 12V supply, all
// opamp + inputs on a buffered half-rail vbias):
//   jack → 2.2µF → 10K → TL072-A inverting unity amp (10K‖100nF fb)
//   → active Baxandall 3-band stack around TL072-B:
//       mid:    R–[100nF across pot]–R,  wiper → 100nF → IN−
//       bass:   R–[100nF across pot]–R,  wiper → 10K  → IN−
//       treble: R–pot–R,                 wiper → 100nF → IN−
//       ground leg: 100nF + 10K → IN−
//   → volume pot as series rheostat → 10K → 2.2µF → MIX BUS
// The bus is the master amp's VIRTUAL-EARTH summing node (the demo
// nets it "/CH1/OUT" — it is the mix bus): IC1-A with 10K feedback,
// output coupled 2.2µF to the master jack. IC1-B buffers the
// R/R/2.2µF half-rail divider into vbias.
//
// Recorded design choices (absent in the source): pot resistance —
// the demo's pot Values are literally "Bass"/"Mid"/... (generic POT
// symbol, RK09K footprint); 10kΩ linear chosen, consistent with the
// all-10K design. Neutrik TS jacks + Cliff DC entry stand in as pin
// headers (package realism = the uno contract).
// Every R = 10K 1%, film 2.2µF 35V, MLCC 100nF 50V — the demo's own
// three part values, verbatim.

import { TL072 } from "bhdl-stdlib/actives/audio_opamps.bhdl";
import { Potentiometer } from "bhdl-stdlib/passives/potentiometer.bhdl";
import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
import { Cap, ElectrolyticCap } from "bhdl-stdlib/passives/capacitor.bhdl";
import { JackTS_NMJ6HCD2, DcJack_DC10A } from "bhdl-stdlib/connectors/audio_jacks.bhdl";

// One channel strip = the demo's repeated sheet, as an entity.
entity ChannelStrip() {
    // Relay pins (virtual): the strip is a COMPOSITION — its
    // expansion children are the physical parts, the parent owns no
    // copper. Non-virtual pins shipped four phantom SOIC-8s (one per
    // strip) that the demo BOM does not have.
    pin IN:    signal in    virtual;
    pin BUS:   signal inout virtual;   // AC-coupled feed into the master's virtual-earth node
    pin VCC:   power in     virtual;
    pin VBIAS: signal in    virtual;
    pin GND:   ground       virtual;

    attribute component_class = "ic"; // composite: expansion carries parts

    expansion {
        internal ni:   net;   // after input coupling
        internal a_in: net;   // TL072-A inverting input
        internal a_out: net;
        internal b_in: net;   // TL072-B inverting input
        internal b_out: net;
        internal mid_t: net;  // mid leg, pot CW end
        internal mid_b: net;  // mid leg, pot CCW end
        internal mid_w: net;
        internal bas_t: net;
        internal bas_b: net;
        internal bas_w: net;
        internal tre_t: net;
        internal tre_b: net;
        internal tre_w: net;
        internal gleg: net;   // ground stability leg
        internal vol_w: net;  // volume wiper (+ tied CCW end)
        internal vtap: net;   // after the 10K bus resistor

        // Dual opamp: A = input amp, B = tone amp; both + inputs ride
        // vbias; single supply (V− to GND like the demo).
        a_out -> U: TL072().OUT_A;
        a_in  -> U.IN_A_N;
        VBIAS -> U.IN_A_P;
        b_out -> U.OUT_B;
        b_in  -> U.IN_B_N;
        VBIAS -> U.IN_B_P;
        VCC -> U.V_PLUS;
        U.V_MINUS -> GND;
        VCC -> c_byp: Cap(100nF).1; c_byp.2 -> GND;

        // Input amp: IN -> 2.2µF -> 10K -> IN−; 10K ‖ 100nF feedback.
        IN -> c_in: ElectrolyticCap(2.2µF, 35V).neg; c_in.pos -> ni;
        ni -> r_in: Res(10kΩ).1; r_in.2 -> a_in;
        a_in -> r_fb: Res(10kΩ).1; r_fb.2 -> a_out;
        a_in -> c_fb: Cap(100nF).1; c_fb.2 -> a_out;

        // Mid leg.
        a_out -> r_m1: Res(10kΩ).1; r_m1.2 -> mid_t;
        mid_t -> c_m: Cap(100nF).1; c_m.2 -> mid_b;
        mid_t -> rv_m: Potentiometer(10kΩ).3;
        rv_m.1 -> mid_b;
        rv_m.2 -> mid_w;
        mid_w -> c_mw: Cap(100nF).1; c_mw.2 -> b_in;
        mid_b -> r_m2: Res(10kΩ).1; r_m2.2 -> b_out;

        // Bass leg.
        a_out -> r_b1: Res(10kΩ).1; r_b1.2 -> bas_t;
        bas_t -> c_b: Cap(100nF).1; c_b.2 -> bas_b;
        bas_t -> rv_b: Potentiometer(10kΩ).3;
        rv_b.1 -> bas_b;
        rv_b.2 -> bas_w;
        bas_w -> r_bw: Res(10kΩ).1; r_bw.2 -> b_in;
        bas_b -> r_b2: Res(10kΩ).1; r_b2.2 -> b_out;

        // Treble leg (pot in series, no cap across it).
        a_out -> r_t1: Res(10kΩ).1; r_t1.2 -> tre_t;
        tre_t -> rv_t: Potentiometer(10kΩ).3;
        rv_t.1 -> tre_b;
        rv_t.2 -> tre_w;
        tre_w -> c_tw: Cap(100nF).1; c_tw.2 -> b_in;
        b_out -> r_t2: Res(10kΩ).1; r_t2.2 -> tre_b;

        // Ground stability leg: GND -> 100nF -> 10K -> IN−.
        GND -> c_g: Cap(100nF).1; c_g.2 -> gleg;
        gleg -> r_g: Res(10kΩ).1; r_g.2 -> b_in;

        // Volume rheostat into the bus: pot CW at B-out, wiper (tied
        // to the CCW end like the demo) -> 10K -> 2.2µF -> BUS.
        b_out -> rv_v: Potentiometer(10kΩ).3;
        rv_v.1 -> vol_w;
        rv_v.2 -> vol_w;
        vol_w -> r_v: Res(10kΩ).1; r_v.2 -> vtap;
        vtap -> c_v: ElectrolyticCap(2.2µF, 35V).pos; c_v.neg -> BUS;
    }
}

board MultichannelMixer {
    power VCC = 12V @ 100mA;
    ground GND;

    // Input jacks: Neutrik NMJ6HCD2, wired exactly as the demo nets
    // them — tip = signal, ring AND sleeve grounded (mono use of the
    // stereo jack: a TS plug shorts ring to ground), switch normals
    // unconnected. Output jack: tip + sleeve only, ring floats (the
    // demo leaves J6's ring unconnected).
    J_CH1: JackTS_NMJ6HCD2();
    J_CH2: JackTS_NMJ6HCD2();
    J_CH3: JackTS_NMJ6HCD2();
    J_CH4: JackTS_NMJ6HCD2();
    J_OUT: JackTS_NMJ6HCD2();
    // Power entry: CLIFF FC68148 (DC-10A) — centre pin +12V, sleeve
    // and its NC switch contact grounded (the demo's binding).
    J_PWR: DcJack_DC10A();
    @VCC -> J_PWR.1; J_PWR.2 -> @GND; J_PWR.3 -> @GND;
    J_CH1.R -> @GND; J_CH1.S -> @GND;
    J_CH2.R -> @GND; J_CH2.S -> @GND;
    J_CH3.R -> @GND; J_CH3.S -> @GND;
    J_CH4.R -> @GND; J_CH4.S -> @GND;
    J_OUT.S -> @GND;

    // vbias: R/R half-rail + 2.2µF, buffered by IC1-B (follower).
    u_mst: TL072(erc_waive="ERC002: single-supply vbias follower — every opamp + input rides the buffered half-rail by design; P/N is opamp pin naming, not a differential pair");
    @VCC -> r_vb1: Res(10kΩ).1; r_vb1.2 -> u_mst.IN_B_P;
    u_mst.IN_B_P -> r_vb2: Res(10kΩ).1; r_vb2.2 -> @GND;
    u_mst.IN_B_P -> c_vb1: ElectrolyticCap(2.2µF, 35V).pos; c_vb1.neg -> @GND;
    u_mst.IN_B_N -> u_mst.OUT_B;          // unity follower = vbias
    u_mst.OUT_B -> c_vb2: ElectrolyticCap(2.2µF, 35V).pos; c_vb2.neg -> @GND;
    @VCC -> u_mst.V_PLUS; u_mst.V_MINUS -> @GND;
    @VCC -> c_mby: Cap(100nF).1; c_mby.2 -> @GND;

    // The four strips — the channel-instance idiom.
    ch1: ChannelStrip();
    ch2: ChannelStrip();
    ch3: ChannelStrip();
    ch4: ChannelStrip();
    J_CH1.T -> ch1.IN;
    J_CH2.T -> ch2.IN;
    J_CH3.T -> ch3.IN;
    J_CH4.T -> ch4.IN;
    @VCC -> ch1.VCC; @VCC -> ch2.VCC; @VCC -> ch3.VCC; @VCC -> ch4.VCC;
    u_mst.OUT_B -> ch1.VBIAS; u_mst.OUT_B -> ch2.VBIAS;
    u_mst.OUT_B -> ch3.VBIAS; u_mst.OUT_B -> ch4.VBIAS;
    ch1.GND -> @GND; ch2.GND -> @GND; ch3.GND -> @GND; ch4.GND -> @GND;

    // Master: virtual-earth mix amp (IC1-A) with 10K feedback; every
    // strip's BUS lands on the summing node.
    ch1.BUS -> u_mst.IN_A_N;
    ch2.BUS -> u_mst.IN_A_N;
    ch3.BUS -> u_mst.IN_A_N;
    ch4.BUS -> u_mst.IN_A_N;
    u_mst.OUT_B -> u_mst.IN_A_P;
    u_mst.IN_A_N -> r_mfb: Res(10kΩ).1; r_mfb.2 -> u_mst.OUT_A;
    u_mst.OUT_A -> c_mo: ElectrolyticCap(2.2µF, 35V).pos; c_mo.neg -> J_OUT.T;
}

// Demo passives are 1206 (R1206_10K / CC1206_100NF) — retarget the
// class default; the 2.2µF electrolytics get their own class block.
layout Res { package 1206; }
layout Cap { package 1206; }
// The 2.2µF are polarized radial cans in the demo (CAPPR family).
// Modeled part: Panasonic ECA-1HHG2R2I (NHG-A, 2.2µF/50V, Ø5×11
// can, taped variant with 2.5mm formed lead pitch — the in-stock
// SKU; native straight-lead F is 2.0). Datasheet: Panasonic NHG-A
// case table (ABA0000C1215).
layout ElectrolyticCap { package Radial-P2.50-D5; }

layout MultichannelMixer {
    layer_stackup 2;
    // Pour intent, the demo's own: GND on both faces (anti-bias
    // face + routing-face backfill; deterministic 0v/0unc on both
    // the free and rigid paths since the starving-pad 8-direction
    // relief fallback).
    pour GND;
    // pour u_mst.OUT_B; — the demo's vbias band. Machinery complete
    // (pin-cloud region, priority backfill, band apron, region-
    // clipped maroon test) but the BAND KNOT stands: pads of two
    // pour nets + every channel's crossings share one strip, and
    // each lever measured zero-sum (pour-home cost exemption let
    // vbias copper carve GND's fill: 12 unc; pad-attach rescue
    // chained stubs to unserved pads; wider margins displace more
    // ground). The structural fix is band-interior F.Cu discipline
    // — or the demo's own trick, a taller band from placement that
    // spreads its consumers. Declared once that closes.
    // Demo convention: THT-era mixer routes bottom-dominant
    // (reference board: 1768mm B.Cu vs 192mm of F.Cu jumpers).
    route_bias bottom;
    // NOT yet declared: the demo's 0.5/0.2 design rules. The
    // long-haul arc cut the wide-rules tail 17 -> 1 unc (the ladder's
    // empty-same-layer-attach early exit abandoned every off-side
    // pad); the last sink = a vbias pin-row knot from the classic
    // pad-fenced family (same-layer track 0.7mm away, gap filled by a
    // foreign run, shove ladder exhausted). Declaring waits on that
    // knot: the corpus gate is 0/0.
    // track_width 0.5; clearance 0.2;
    // Demo geometry verbatim: 110×111 outline, jack row along the
    // top, power entry on the right edge, one pot column per channel
    // (board-local coords read from multichannel_mixer.kicad_pcb;
    // channel↔jack mapping from the netlist trace: ch1=J1, ch2=J7,
    // ch3=J8, ch4=J9, master=J6, power=J5).
    outline rect 110 111;
    // Real Neutrik jacks with body-centered footprints, placed so
    // the TIP pad lands on the demo's own footprint origin (demo
    // coordinates minus its Edge.Cuts origin 89.46/43.66), contacts
    // running toward the top edge. J_CH4 is the
    // demo's J9: its switch-normal column lands at x = −12.9 — off
    // the board, exactly as in the demo, whose Neutrik bodies hang
    // over the panel edge (those pads are unconnected).
    place J_CH1 at (39.225, 14.125) rot 90;
    place J_CH2 at (17.225, 14.125) rot 90;
    place J_CH3 at (61.225, 14.125) rot 90;
    place J_CH4 at (-4.875, 14.125) rot 90;
    place J_OUT at (83.025, 14.075) rot 90;
    // CLIFF entry on the right edge, barrel opening grazing x=110
    // like the demo (local frame is already barrel-toward-+X).
    place J_PWR at (102.225, 44.925);
    // Front-panel pot grid, demo columns (x = 53/31/75/9 for
    // channels 1-4, rows bass/mid/treble/volume). Real RK09K
    // footprints: origin = terminal 1, rot 270 puts the terminal row
    // along +x and the body/shaft housing above the row — the
    // orientation that keeps the volume row's body on the board.
    place ch1_rv_b at (55.5, 46.7) rot 270;
    place ch1_rv_m at (55.5, 64.7) rot 270;
    place ch1_rv_t at (55.5, 82.7) rot 270;
    place ch1_rv_v at (55.5, 100.8) rot 270;
    place ch2_rv_b at (33.5, 46.7) rot 270;
    place ch2_rv_m at (33.5, 64.7) rot 270;
    place ch2_rv_t at (33.5, 82.7) rot 270;
    place ch2_rv_v at (33.5, 100.8) rot 270;
    place ch3_rv_b at (77.5, 46.7) rot 270;
    place ch3_rv_m at (77.5, 64.7) rot 270;
    place ch3_rv_t at (77.5, 82.7) rot 270;
    place ch3_rv_v at (77.5, 100.8) rot 270;
    place ch4_rv_b at (11.5, 46.7) rot 270;
    place ch4_rv_m at (11.5, 64.7) rot 270;
    place ch4_rv_t at (11.5, 82.7) rot 270;
    place ch4_rv_v at (11.5, 100.8) rot 270;
}
