// Simple TPS54302 Buck Converter Test
// 12V to 5V buck converter using the canonical stdlib TPS54302 (which carries
// the §4 simulation { stress { } } device-stress model). Support parts are
// named l_out / c_out1 / c_in1 to match the part's stress-block references.

import { TPS54302 } from "bhdl-stdlib/power/tps54302.bhdl";

board TPS54302_Buck {
    // Power domains
    power VIN = 12V @ 3A;
    power VOUT = 5V @ 2A;
    ground GND;
    
    // Input filtering
    @VIN -> c_in1: Cap(22uF).1; c_in1.2 -> @GND;
    @VIN -> c_in2: Cap(100nF).1; c_in2.2 -> @GND;
    
    // Main regulator (simplified as a module)
    @VIN -> reg: TPS54302().VIN;
    reg.GND -> @GND;
    @VIN -> reg.EN;  // Enable always high
    
    // Phase/switching node and inductor
    reg.PH -> l_out: Ind(4.7uH).1; l_out.2 -> @VOUT;
    
    // Output filtering
    @VOUT -> c_out1: Cap(47uF).1; c_out1.2 -> @GND;
    @VOUT -> c_out2: Cap(22uF).1; c_out2.2 -> @GND;
    
    // Feedback network
    @VOUT -> r_fb1: Res(22k).1; r_fb1.2 -> reg.FB;
    reg.FB -> r_fb2: Res(3k).1; r_fb2.2 -> @GND;
    
    // Bootstrap capacitor
    reg.BOOT -> c_boot: Cap(100nF).1; c_boot.2 -> reg.PH;
}

// Simplified passive stubs (the regulator is the canonical stdlib part).
entity Cap(value: capacitance) {
    pin 1: signal inout;
    pin 2: signal inout;
}

entity Res(value: resistance) {
    pin 1: signal inout;
    pin 2: signal inout;
}

entity Ind(value: inductance) {
    pin 1: signal inout;
    pin 2: signal inout;
}