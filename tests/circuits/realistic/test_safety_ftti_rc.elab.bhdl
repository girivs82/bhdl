// ELABORATED bhdl — generated from test_safety_ftti_rc.bhdl; DO NOT EDIT.
// The round-trip gate re-synthesizes this file and requires the
// IDENTICAL netlist. Every synthesized element carries a
// provenance comment naming the intent that produced it.

// bhdl-sweep: skip — safety-engine fixture, not a layout target
// Transient-FTTI fixture (docs/spec/Functional_Safety.md §2.5): the
// detection divider carries an RC FILTER, so the detection predicate
// settles a MEASURABLE time after the fault — the campaign times it
// with a transient solve from the healthy operating point instead of
// trusting the mechanism's declared latency claim.
//
// Healthy: mid = 6V (1k/1k from 12V), flag = 3V (10k/10k from mid).
//   short(r_top) → mid = 12V, flag charges toward 6V through
//   R_th = 10k∥10k = 5k into C = 100nF ⇒ τ = 0.5ms; the 4V detection
//   threshold is crossed at τ·ln((6−3)/(6−4)) ≈ 0.20ms.
//
// The verdict COMPOSES the measured board settle with the declared
// CHIP-INTERNAL latency (the comparator's reaction time — a path the
// board solve structurally cannot see):
//   within 500us → measured ~0.22ms board + 50µs chip = ~0.27ms → OK
//                  (the declared-budget-only argument could not verify
//                  the 0.22ms board term at all).
//   within 100us → the board path alone (~0.22ms) already exceeds the
//                  budget: MEASURED FAIL. Both directions demonstrated.

import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
import { Cap } from "bhdl-stdlib/passives/capacitor.bhdl";

safety FttiRc as brd {
    mission { ambient = 40degC; lifetime = 15000h; }

    goal SG_MID: ASIL_B "mid node stays below its ceiling" (id="SG-RC-1") {
        effect overvoltage = brd.r_bot.1 > 8V severity S2;
    }

    // latency = the CHIP-INTERNAL reaction time (comparator prop delay
    // + deglitch) — a path the board solve cannot see; it is COMPOSED
    // with the measured board settle, never replaced by it.
    mechanism brd.r_m2: psm(SG_MID, detects=[overvoltage],
                            detected_when = brd.r_m2.1 > 4V,
                            latency=50us,
                            dc=0.90, source="FIXTURE claim");

    fault short(brd.r_top.1, brd.r_top.2) expect SG_MID.overvoltage detected_by brd.r_m2 within 500us;
    fault open(brd.r_bot)                 expect SG_MID.overvoltage detected_by brd.r_m2 within 100us;
}

board FttiRc {
    power V12 = 12V @ 1A;
    ground GND;

    c_f: Cap(100nF, 50V);
    r_bot: Res(1kΩ, 5%, 0.25W);
    r_m1: Res(10kΩ, 5%, 0.25W);
    r_m2: Res(10kΩ, 5%, 0.25W);
    r_top: Res(1kΩ, 5%, 0.25W);
    c_f.2 -> @GND;
    r_bot.2 -> @GND;
    r_m2.2 -> @GND;
    @V12 -> r_top.1;
    c_f.1 -> r_m1.2;  // net auto_r_m1_2
    c_f.1 -> r_m2.1;  // net auto_r_m1_2
    r_bot.1 -> r_m1.1;  // net auto_r_top_2
    r_bot.1 -> r_top.2;  // net auto_r_top_2
}
