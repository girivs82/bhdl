// Intent-driven layout test with simplified stdlib
// Uses v2.0-compatible simplified components

import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
import { Cap, ElectrolyticCap } from "bhdl-stdlib/passives/capacitor.bhdl";
import { LED } from "bhdl-stdlib/optoelectronic/led.bhdl";
import { TVSDiode, Fuse } from "bhdl-stdlib/protection/tvs.bhdl";
import { LM7805 } from "bhdl-stdlib/power/regulator.bhdl";

board IntentDrivenPowerSupply {
    power VIN = 12V @ 1A;
    power VCC = 5V @ 500mA;
    ground GND;

    // LEFT ZONE: Input protection with intent
    VIN -> fuse: Fuse(1A).1; fuse.2 -> @protected_vin
        for input_protection(15V, 1A);

    @protected_vin -> tvs: TVSDiode(15V).K;
    tvs.A -> GND;

    // CENTER ZONE: Input filtering with intent
    @protected_vin -> c_in: ElectrolyticCap(100µF, 25V).pos; c_in.pos -> @filtered_in
        for noise_filtering(100Hz, 40dB);
    c_in.neg -> GND;

    // TOP ZONE: Voltage regulation with intent
    @filtered_in -> reg: LM7805().IN; reg.OUT -> @VCC
        for voltage_regulation(5V, 12V);
    reg.GND -> GND;

    // CENTER ZONE: Output filtering with intent
    @VCC -> c_out: ElectrolyticCap(10µF, 10V).pos; c_out.pos -> @filtered_out
        for noise_filtering(10kHz, 60dB);
    c_out.neg -> GND;

    // RIGHT ZONE: LED indicator with intent
    @filtered_out -> r_led: Res(330).1; r_led.2 -> led: LED("green").A; led.A -> @led_out
        for current_limiting(20mA);
    led.K -> GND;

    // BOTTOM ZONE: Current sensing with intent
    r_led.2 -> sense: Res(0.1).1; sense.2 -> @sensed
        for current_sensing(20mA, 1%);
    @sensed -> led.A;

    attribute title = "Intent-Driven Layout Demo";
    attribute description = "Demonstrates spatial zone placement based on design intent";
}
