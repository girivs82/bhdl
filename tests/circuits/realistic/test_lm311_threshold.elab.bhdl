// LM311 threshold detector — the datasheet's own single-supply logic
// configuration (SLCS007K §6.6 "VCC+ = 4.5 V, VCC− = 0" column):
// emitter grounded, collector pulled up 1k to the 5 V rail, so the
// output swings TTL levels (VOL 0.23 V typ at the 8 mA-class point;
// the 1k pullup asks ~4.8 mA when low). A 10k/10k divider sets the
// 2.5 V threshold on IN−, the signal enters IN+ through 10k, and 1M
// from the collector back to IN+ gives ~25 mV of hysteresis — the
// classic recipe. BALANCE and BAL/STRB stay open: that is the
// datasheet's characterization baseline (note 1), not an omission.

import { LM311 } from "bhdl-stdlib/actives/lm311.bhdl";
import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
import { Cap } from "bhdl-stdlib/passives/capacitor.bhdl";
import { Pin_Header_01x03 } from "bhdl-stdlib/connectors/pin_header.bhdl";

layout Lm311Threshold {
    layer_stackup 2;
    outline rect 40 28;
    place J_IN at (2.6, 13);
    place J_OUT at (37.4, 13);
}

board Lm311Threshold {
    power VCC = 5V @ 0.03A;
    ground GND;

    J_IN: Pin_Header_01x03();
    J_OUT: Pin_Header_01x03();
    U1: LM311(LM311P);
    c_vcc: Cap(100nF, 50V);
    r_hys: Res(1MΩ, 5%, 0.25W);
    r_in: Res(10kΩ, 5%, 0.25W);
    r_pu: Res(1kΩ, 5%, 0.25W);
    r_t1: Res(10kΩ, 5%, 0.25W);
    r_t2: Res(10kΩ, 5%, 0.25W);
    J_IN.3 -> @GND;
    J_OUT.3 -> @GND;
    U1.EMIT_OUT -> @GND;
    U1.V_MINUS -> @GND;
    c_vcc.2 -> @GND;
    r_t2.2 -> @GND;
    U1.IN_P -> r_hys.2;  // net INP
    U1.IN_P -> r_in.2;  // net INP
    J_OUT.2 -> U1.COL_OUT;  // net OUT
    J_OUT.2 -> r_hys.1;  // net OUT
    J_OUT.2 -> r_pu.2;  // net OUT
    J_IN.2 -> r_in.1;  // net SIG
    @VCC -> J_IN.1;
    @VCC -> J_OUT.1;
    @VCC -> U1.V_PLUS;
    @VCC -> c_vcc.1;
    @VCC -> r_pu.1;
    @VCC -> r_t1.1;
    U1.IN_N -> r_t1.2;  // net VTH
    U1.IN_N -> r_t2.1;  // net VTH
}
