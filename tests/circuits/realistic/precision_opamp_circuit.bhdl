// Precision op-amp circuit with topology-aware connections
// Shows how pin-to-pin connections preserve analog signal paths

board PrecisionAmplifier {
    power VCC = 12V @ 50mA;
    power VEE = -12V @ 50mA;
    ground GND;
    
    // Input signal conditioning
    module InputStage {
        // Input protection and filtering
        @INPUT -> R_IN.1 where trace_length < 20mm;
        R_IN: Res(1kΩ, tolerance=0.1%);
        R_IN.2 -> C_IN.1;
        C_IN: Cap(100nF, type="C0G");
        C_IN.2 -> @GND;
        
        // Input buffer with guard ring
        R_IN.2 -> U1: PrecisionOpAmp().IN_P where guard_ring, shielded;
        U1.IN_N -> U1.OUT;  // Unity gain buffer
        
        // Power supply bypassing - right at the IC
        @VCC -> C_VCC.1 where trace_length < 5mm;
        C_VCC: Cap(0.1uF, type="X7R", package="0603");
        C_VCC.2 -> U1.V+ where trace_length < 5mm;
        U1.V+ -> @VCC;
        
        @VEE -> C_VEE.1 where trace_length < 5mm;
        C_VEE: Cap(0.1uF, type="X7R", package="0603");
        C_VEE.2 -> U1.V- where trace_length < 5mm;
        U1.V- -> @VEE;
        
        // Output
        @BUFFERED: U1.OUT;
    }
    
    // Gain stage with precise resistor ratios
    module GainStage {
        // Non-inverting amplifier with gain = 1 + Rf/Rg = 10
        @BUFFERED -> U2: PrecisionOpAmp().IN_P;
        
        // Feedback network - critical for accuracy
        U2.OUT -> RF.1;
        RF: Res(90kΩ, tolerance=0.1%, tempco=25ppm);
        RF.2 -> RG.1;
        RG: Res(10kΩ, tolerance=0.1%, tempco=25ppm);
        RG.2 -> @GND;
        
        // Feedback to inverting input
        RF.2 -> U2.IN_N where trace_length < 15mm, away_from="noisy_signals";
        
        // Compensation capacitor for stability
        U2.OUT -> CC.1;
        CC: Cap(22pF, type="C0G");
        CC.2 -> U2.IN_N;
        
        // Output
        @AMPLIFIED: U2.OUT;
    }
    
    // Output filter and driver
    module OutputStage {
        // Low-pass filter to remove noise
        @AMPLIFIED -> R_FILT.1;
        R_FILT: Res(100Ω);
        R_FILT.2 -> C_FILT.1;
        C_FILT: Cap(1nF, type="C0G");
        C_FILT.2 -> @GND;
        
        // Output buffer with current limiting
        R_FILT.2 -> U3: PrecisionOpAmp().IN_P;
        U3.IN_N -> R_SENSE.1;
        R_SENSE: Res(10Ω, power=0.25W);
        R_SENSE.2 -> U3.OUT;
        
        // Output protection
        U3.OUT -> R_OUT.1;
        R_OUT: Res(50Ω);
        R_OUT.2 -> @OUTPUT;
        
        // Output clamp diodes
        @OUTPUT -> D1: SchottkyDiode().A;
        D1.K -> @VCC;
        @OUTPUT -> D2: SchottkyDiode().K;
        D2.A -> @VEE;
    }
    
    // Voltage reference for offset trimming
    module VoltageReference {
        // Precision voltage reference
        @VCC -> U_REF: VoltageReference(2.5V).VIN;
        U_REF.GND -> @GND;
        
        // Reference filter
        U_REF.VOUT -> R_REF.1;
        R_REF: Res(100Ω);
        R_REF.2 -> C_REF.1;
        C_REF: Cap(10uF, type="tantalum");
        C_REF.2 -> @GND;
        
        // Offset adjustment divider
        R_REF.2 -> R_TRIM1.1;
        R_TRIM1: Res(10kΩ);
        R_TRIM1.2 -> POT.1;
        POT: Potentiometer(10kΩ);
        POT.2 -> R_TRIM2.1;
        R_TRIM2: Res(10kΩ);
        R_TRIM2.2 -> @GND;
        
        // Trimmed reference output
        @VREF_TRIM: POT.wiper;
    }
}

// Group all sensitive analog signals
with routing(shielded = true, guard_trace = "GND") {
    // Input paths
    @INPUT -> R_IN.1;
    R_IN.2 -> U1.IN_P;
    
    // Feedback paths - most critical
    with trace_width = 0.2mm {
        RF.2 -> U2.IN_N;
        CC.2 -> U2.IN_N;
        U3.IN_N -> R_SENSE.1;
    }
}

// Star ground for analog stages
with routing(star_point = "C_VCC.2") {
    C_IN.2 -> @GND;
    RG.2 -> @GND;
    C_FILT.2 -> @GND;
    U_REF.GND -> @GND;
}

// Power distribution with Kelvin connections
with power(topology = "star", kelvin_sense = true) {
    // Each op-amp gets individual bypass caps
    @VCC -> C_VCC.1;
    @VCC -> C_VCC2.1;
    @VCC -> C_VCC3.1;
    
    // Sense lines back to regulator (if present)
    U1.V+ -> @VCC_SENSE where trace_width = 0.15mm;
}

// Thermal considerations
constraints thermal {
    // Power resistors need thermal relief
    place R_SENSE with thermal_pad;
    place R_OUT near edge for cooling;
    
    // Precision resistors need matching
    place RF, RG {
        thermal_coupling = true;
        orientation = "same";
        distance < 5mm;
    }
}

module PrecisionOpAmp() {
    pin IN_P: signal in;   // Non-inverting input
    pin IN_N: signal in;   // Inverting input
    pin OUT: signal out;   // Output
    pin V+: power in;      // Positive supply
    pin V-: power in;      // Negative supply
    
    // Characteristics for layout
    attribute input_bias_current = 50pA;
    attribute offset_voltage = 25uV;
    attribute CMRR = 120dB;
}

module VoltageReference(voltage: voltage) {
    pin VIN: power in;
    pin VOUT: signal out;
    pin GND: ground;
    
    attribute accuracy = 0.05%;
    attribute tempco = 10ppm;
}

module Potentiometer(resistance: resistance) {
    pin 1: signal;
    pin 2: signal;
    pin wiper: signal out;
}