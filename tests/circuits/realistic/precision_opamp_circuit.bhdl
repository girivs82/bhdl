// Precision op-amp signal chain on ±12V rails — regenerated to v2 from the
// v1 structural-entity dialect (nested entity blocks with embedded
// connections, `where` layout clauses, V+/V− pin names, type=/package=
// reserved-word args). The v1 offset-trim stage (Potentiometer +
// VoltageReference) is dropped pending stdlib entities for those parts.
//
// Chain: input RC conditioning → unity buffer → ×10 non-inverting gain
// (0.1% feedback pair, declared as a precision path) → output RC filter →
// buffered, current-sensed, clamped output.
// Exercises: negative rail declaration (`power VEE = -12V`), ERC023
// precision-path gating (0.1% parts in a 0.1% path — compliant), Schottky
// rail clamps.

import { OpAmp } from "bhdl-stdlib/actives/opamp.bhdl";
import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
import { Cap } from "bhdl-stdlib/passives/capacitor.bhdl";
import { SchottkyDiode } from "bhdl-stdlib/passives/diode.bhdl";
import { TestPoint } from "bhdl-stdlib/connectors/testpoint.bhdl";

board PrecisionAmplifier {
    power VCC = 12V @ 50mA;
    power VEE = -12V @ 50mA;
    ground GND;

    // ── Input conditioning: 1k / 100nF low-pass, then a unity buffer ──
    @SIG_IN -> r_in: Res(1k, tolerance=0.1%).1;
    r_in.2 -> c_in: Cap(100nF).1; c_in.2 -> @GND;

    u1: OpAmp();
    @VCC -> u1.VCC; @VEE -> u1.VEE;
    r_in.2 -> u1.INP;
    u1.INN -> u1.OUT;            // unity-gain buffer

    // Supply bypassing at the IC.
    @VCC -> c_vcc1: Cap(100nF).1; c_vcc1.2 -> @GND;
    @VEE -> c_vee1: Cap(100nF).1; c_vee1.2 -> @GND;

    // ── Gain stage: non-inverting, G = 1 + 90k/10k = 10 ──
    u2: OpAmp();
    @VCC -> u2.VCC; @VEE -> u2.VEE;
    u1.OUT -> u2.INP;

    u2.OUT -> r_f: Res(90k, tolerance=0.1%).1;
    r_f.2 -> r_g: Res(10k, tolerance=0.1%).1; r_g.2 -> @GND
        for precision_measurement(accuracy: 0.1%);
    r_f.2 -> u2.INN;
    u2.OUT -> c_comp: Cap(22pF).1; c_comp.2 -> u2.INN;

    // ── Output stage: RC noise filter → buffer with sense → clamped out ──
    u2.OUT -> r_filt: Res(100).1;
    r_filt.2 -> c_filt: Cap(1nF).1; c_filt.2 -> @GND;

    u3: OpAmp();
    @VCC -> u3.VCC; @VEE -> u3.VEE;
    r_filt.2 -> u3.INP;
    u3.INN -> r_sense: Res(10).1; r_sense.2 -> u3.OUT;

    u3.OUT -> r_out: Res(50).1;
    r_out.2 -> @SIG_OUT;

    // Board-edge access — the signal nets terminate at test points (a
    // single-member edge net is otherwise an honest ERC008 warning).
    @SIG_IN -> tp_in: TestPoint().1;
    @SIG_OUT -> tp_out: TestPoint().1;

    // Rail clamps on the output.
    @SIG_OUT -> d1: SchottkyDiode().A; d1.K -> @VCC;
    @SIG_OUT -> d2: SchottkyDiode().K; d2.A -> @VEE;
}
