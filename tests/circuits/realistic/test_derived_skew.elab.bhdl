// P3/P4 — DERIVED SKEW BUDGET, live: two scheduled IBIS edges drive
// the P/N of an interface pair that declares differential impedance
// but NO length_match. The lowering leaves length_match_ps unset, so
// the budget derives from the MEASURED 10-90% rise of the solved
// edge: t_rise/10, graded in routed delay. Remove the ibis_wave
// directives and the pair grades in millimeters again (Real-Data:
// no trace, no time budget).

import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
import { Cap } from "bhdl-stdlib/passives/capacitor.bhdl";

entity TestEdgeDriver() {
    pin VCC:  power in;
    pin OUT1: signal out;
    pin GND:  ground;

    attribute component_class = "ic_logic";
    attribute i_quiescent = 1mA;

    simulation {
        model {
            ibis "test_buffer.ibs" component "TESTCHIP" corner typ;
        }
    }
}

interface Pair {
    signal P: inout;
    signal N: inout;
    constraints {
        *: differential 100ohm;
    }
}

entity PairSink() {
    interface Pair pr;
    pin VCC: power in;
    pin GND: ground;

    attribute component_class = "ic";
}

layout PairSink {
    package SOIC-8;
}

layout DerivedSkew {
    layer_stackup 4;
    outline rect 30 20;
}

board DerivedSkew {
    power VCC = 5V @ 0.1A;
    ground GND;

    ps: PairSink();
    r1: Res(125Ω, 5%, 0.25W);
    r2: Res(125Ω, 5%, 0.25W);
    u1: TestEdgeDriver();
    u2: TestEdgeDriver();
    ps.GND -> @GND;
    r1.2 -> @GND;
    r2.2 -> @GND;
    u1.GND -> @GND;
    u2.GND -> @GND;
    @VCC -> ps.VCC;
    @VCC -> u1.VCC;
    @VCC -> u2.VCC;
    ps.pr.N -> r2.1;  // net sig_n
    ps.pr.N -> u2.OUT1;  // net sig_n
    ps.pr.P -> r1.1;  // net sig_p
    ps.pr.P -> u1.OUT1;  // net sig_p
}
