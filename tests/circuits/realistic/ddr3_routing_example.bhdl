// DDR3 memory interface with physical routing constraints
// Demonstrates matched-length routing and impedance control

board DDR3_Interface {
    power VDD_DDR = 1.5V @ 2A;
    power VDDQ = 1.5V @ 1A;
    ground GND;
    
    // DDR3 Controller (simplified pinout)
    CPU: DDR3Controller();
    
    // DDR3 Memory chip
    RAM: DDR3_4Gb();
    
    // Data byte lane 0 with matched routing
    with routing(impedance = 50Ω ± 5%, matched_length = true, layer = "inner") {
        CPU.DQ[0] -> RAM.DQ[0];
        CPU.DQ[1] -> RAM.DQ[1];
        CPU.DQ[2] -> RAM.DQ[2];
        CPU.DQ[3] -> RAM.DQ[3];
        CPU.DQ[4] -> RAM.DQ[4];
        CPU.DQ[5] -> RAM.DQ[5];
        CPU.DQ[6] -> RAM.DQ[6];
        CPU.DQ[7] -> RAM.DQ[7];
        
        // Data strobe for byte lane 0
        with differential(impedance = 100Ω) {
            CPU.DQS0_P -> RAM.DQS0_P;
            CPU.DQS0_N -> RAM.DQS0_N;
        }
        
        // Data mask
        CPU.DM[0] -> RAM.DM[0];
    }
    
    // Address and command with different constraints
    with routing(impedance = 40Ω ± 10%, matched_length = true) {
        // Address bus
        generate for i in 0..14 {
            CPU.A[i] -> RAM.A[i];
        }
        
        // Bank address
        CPU.BA[0] -> RAM.BA[0];
        CPU.BA[1] -> RAM.BA[1];
        CPU.BA[2] -> RAM.BA[2];
        
        // Command signals
        CPU.RAS_N -> RAM.RAS_N;
        CPU.CAS_N -> RAM.CAS_N;
        CPU.WE_N -> RAM.WE_N;
    }
    
    // Clock - most critical routing
    with routing(differential = true, impedance = 100Ω ± 5%) {
        CPU.CK_P -> RAM.CK_P where length = 45mm ± 0.5mm;
        CPU.CK_N -> RAM.CK_N where length = 45mm ± 0.5mm;
    }
    
    // Control signals with relaxed constraints
    with routing(impedance = 50Ω ± 10%) {
        CPU.CS_N -> RAM.CS_N;
        CPU.CKE -> RAM.CKE;
        CPU.ODT -> RAM.ODT;
    }
    
    // Reference voltage - special routing
    VREF_GEN: VoltageReference().out -> RAM.VREF where star_distribution;
    
    // Termination voltage
    VTT_REG: TerminationRegulator();
    @VDD_DDR -> VTT_REG.VIN;
    VTT_REG.VOUT -> @VTT;  // VTT = VDDQ/2
    
    // On-die termination power
    @VTT -> RAM.VTT where current_rating >= 500mA;
    
    // Power delivery with decoupling
    with power(decouple_per_pin = true) {
        @VDD_DDR -> RAM.VDD[0] where bypass = C1;
        @VDD_DDR -> RAM.VDD[1] where bypass = C2;
        @VDD_DDR -> RAM.VDD[2] where bypass = C3;
        @VDD_DDR -> RAM.VDD[3] where bypass = C4;
        
        @VDDQ -> RAM.VDDQ[0] where bypass = C5;
        @VDDQ -> RAM.VDDQ[1] where bypass = C6;
        @VDDQ -> RAM.VDDQ[2] where bypass = C7;
        @VDDQ -> RAM.VDDQ[3] where bypass = C8;
    }
    
    // Bulk decoupling capacitors
    generate for i in 1..8 {
        C[i]: Cap(0.1uF, package="0402", voltage=2.5V);
        C[i].2 -> @GND;
    }
    
    // Define write leveling flyby routing
    with routing(topology = "flyby", stub_length < 5mm) {
        CPU.DQS0_P -> RAM.DQS0_P;
        CPU.DQS1_P -> RAM.DQS1_P;
        CPU.DQS2_P -> RAM.DQS2_P;
        CPU.DQS3_P -> RAM.DQS3_P;
    }
}

// Nested routing groups for byte lanes
generate for lane in 0..3 {
    with routing(group = "byte_lane_${lane}", matched_length = true) {
        generate for bit in 0..7 {
            CPU.DQ[lane*8 + bit] -> RAM.DQ[lane*8 + bit];
        }
        
        // Each byte lane has its own DQS
        with differential(impedance = 100Ω) {
            CPU.DQS[lane]_P -> RAM.DQS[lane]_P;
            CPU.DQS[lane]_N -> RAM.DQS[lane]_N;
        }
    }
}

// Advanced constraints for length matching
constraints timing {
    // Clock to DQS matching
    skew(CK_P, DQS*_P) < 10ps;
    
    // DQ to DQS matching within byte lane
    for lane in 0..3 {
        skew(DQS[lane]_P, DQ[lane*8..(lane+1)*8-1]) < 5ps;
    }
    
    // Address/Command to Clock
    skew(CK_P, A[*]) < 40ps;
    skew(CK_P, RAS_N, CAS_N, WE_N) < 40ps;
}

// Modules (simplified)
module DDR3Controller() {
    // Data
    pin DQ[0..31]: signal inout;
    pin DQS[0..3]_P: signal inout;
    pin DQS[0..3]_N: signal inout;
    pin DM[0..3]: signal out;
    
    // Address/Command
    pin A[0..14]: signal out;
    pin BA[0..2]: signal out;
    pin RAS_N: signal out;
    pin CAS_N: signal out;
    pin WE_N: signal out;
    
    // Control
    pin CS_N: signal out;
    pin CKE: signal out;
    pin ODT: signal out;
    
    // Clock
    pin CK_P: clock out;
    pin CK_N: clock out;
}

module DDR3_4Gb() {
    // Matching pinout to controller
    pin DQ[0..31]: signal inout;
    pin DQS[0..3]_P: signal inout;
    pin DQS[0..3]_N: signal inout;
    pin DM[0..3]: signal in;
    
    pin A[0..14]: signal in;
    pin BA[0..2]: signal in;
    pin RAS_N: signal in;
    pin CAS_N: signal in;
    pin WE_N: signal in;
    
    pin CS_N: signal in;
    pin CKE: signal in;
    pin ODT: signal in;
    pin VREF: signal in;
    
    pin CK_P: clock in;
    pin CK_N: clock in;
    
    // Power
    pin VDD[0..3]: power in;
    pin VDDQ[0..3]: power in;
    pin VTT: power in;
    pin VSS[0..7]: ground;
}