// FPGA dev board — regenerated to v2 from the v1 100+-pin power-domain
// expansion dialect. Compact showcase: a local FPGA entity with bus power
// pins (VCCO[4]), a two-branch supply tree off VIN_5V (both rails
// chooser-picked, drawing from ONE shared input bank on VIN_5V),
// per-rail decoupling, and a blinky so signal nets exist.
// NOTE: bus pins are fully supported: the declaration (pin VCCO[4])
// expands to indexed pin instances (VCCO[0]..VCCO[3]) in the netlist,
// and v2 arrow statements accept per-index refs (fpga.VCCO[0]) — wired
// per-index below. A suffix-less ref (fpga.VCCO) still ties the whole
// bank to a net as a unit.
// Expected: 0 DRC violations.

import { Cap } from "bhdl-stdlib/passives/capacitor.bhdl";
import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
import { LED } from "bhdl-stdlib/optoelectronic/led.bhdl";
import { TestPoint } from "bhdl-stdlib/connectors/testpoint.bhdl";

entity FPGA() {
    pin VCCINT: power in;
    pin VCCAUX: power in;
    pin VCCO[4]: power in;
    pin GND: ground;
    pin CLK_IN: signal in;
    pin LED_OUT: signal out;
    pin DONE: signal out;

    attribute component_class = "fpga";
    attribute i_supply = 400mA;
}

entity Oscillator() {
    pin VCC: power in;
    pin GND: ground;
    pin OUT: signal out;

    attribute component_class = "oscillator";
    attribute i_supply = 10mA;
}

board FPGADevBoard {
    power VIN_5V = 5V @ 2A;
    power VCC_3V3 = 3.3V @ 1A;
    power VCC_1V2 = 1.2V @ 800mA;
    ground GND;

    // ── Supply tree: both rails from VIN_5V, sharing one input bank ──
    supply @VCC_3V3 from @VIN_5V {
        ripple_max: 30mV;
        profile: efficiency;
    }

    supply @VCC_1V2 from @VIN_5V {
        ripple_max: 20mV;
        profile: efficiency;
    }

    // ── FPGA power: 1.2V core, 3.3V aux + the four-bank VCCO bus ──
    fpga: FPGA();
    @VCC_1V2 -> fpga.VCCINT;
    @VCC_3V3 -> fpga.VCCAUX;
    @VCC_3V3 -> fpga.VCCO[0];    // four I/O banks, wired per-index
    @VCC_3V3 -> fpga.VCCO[1];
    @VCC_3V3 -> fpga.VCCO[2];
    @VCC_3V3 -> fpga.VCCO[3];
    fpga.GND -> @GND;

    // ── Clock source + blinky + DONE test point ──
    osc: Oscillator();
    @VCC_3V3 -> osc.VCC; osc.GND -> @GND;
    osc.OUT -> fpga.CLK_IN;

    fpga.LED_OUT -> r_led: Res(330).1;
    r_led.2 -> d_led: LED().A; d_led.K -> @GND;

    fpga.DONE -> tp_done: TestPoint().1;

    // ── Decoupling per rail ──
    @VIN_5V -> c_dec_5v: Cap(100nF).1; c_dec_5v.2 -> @GND;
    @VCC_3V3 -> c_dec_3v3: Cap(100nF).1; c_dec_3v3.2 -> @GND;
    @VCC_1V2 -> c_dec_1v2: Cap(100nF).1; c_dec_1v2.2 -> @GND;
}
