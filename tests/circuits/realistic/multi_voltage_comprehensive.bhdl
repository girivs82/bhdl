// Multi-voltage supply-tree showcase — regenerated to v2 from the v1
// wildcard/range-pattern dialect (sensor[*], led[0..7], distributed
// decoupling annotations). The v2 point: the ENTIRE power architecture is
// supply statements — 12V → 5V (named TPS54302), then 3.3V and 1.8V both
// cascaded from the 5V rail (chooser-selected, sharing one input bank on
// VCC_5V), with ERC016 rail budgets covering the declared loads PLUS each
// generated regulator's stamped input draw, and power-up order derived from
// the tree. Expected: 0 DRC violations.

import { Cap } from "bhdl-stdlib/passives/capacitor.bhdl";
import { TestPoint } from "bhdl-stdlib/connectors/testpoint.bhdl";

// ── Board-local load abstractions ──

entity Mcu() {
    pin VCC: power in;
    pin GND: ground;
    pin TX: signal out;
    pin STATUS: signal out;

    attribute component_class = "microcontroller";
    attribute i_supply = 150mA;
}

entity Radio() {
    pin VCC: power in;
    pin GND: ground;
    pin RX: signal in;

    attribute component_class = "transceiver";
    attribute i_supply = 80mA;
}

entity CoreLogic() {
    pin VCC: power in;
    pin GND: ground;
    pin EN: signal in;

    attribute component_class = "logic";
    attribute i_supply = 120mA;
}

board MultiVoltageSystem {
    power VIN_12V = 12V @ 4A;
    power VCC_5V = 5V @ 2A;
    power VCC_3V3 = 3.3V @ 1A;
    power VCC_1V8 = 1.8V @ 300mA;
    ground GND;

    // ── Power tree — all regulation auto-generated ──
    supply @VCC_5V from @VIN_12V {
        ripple_max: 50mV;
        using: TPS54302;
    }

    supply @VCC_3V3 from @VCC_5V {
        ripple_max: 30mV;
        profile: efficiency;
    }

    // profile: cost picks the LM317 here, which trips ERC017 (2V dropout
    // won't regulate 5V → 1.8V) — so let the chooser optimize efficiency.
    supply @VCC_1V8 from @VCC_5V {
        ripple_max: 20mV;
        profile: efficiency;
    }

    // ── Loads, one per generated rail ──
    // Mcu lives on 3.3V so its TX drives the radio in-domain (ERC004).
    mcu: Mcu();
    @VCC_3V3 -> mcu.VCC; mcu.GND -> @GND;

    radio: Radio();
    @VCC_3V3 -> radio.VCC; radio.GND -> @GND;
    mcu.TX -> radio.RX;

    core: CoreLogic();
    @VCC_1V8 -> core.VCC; core.GND -> @GND;
    @VCC_1V8 -> core.EN;             // enable strapped to its own rail
    @STATUS_LED_NET -> tp_status: TestPoint().1;
    mcu.STATUS -> @STATUS_LED_NET;

    // ── Decoupling per load rail ──
    @VCC_5V -> c_dec_5v: Cap(100nF).1; c_dec_5v.2 -> @GND;
    @VCC_3V3 -> c_dec_3v3: Cap(100nF).1; c_dec_3v3.2 -> @GND;
    @VCC_1V8 -> c_dec_1v8: Cap(100nF).1; c_dec_1v8.2 -> @GND;
}
