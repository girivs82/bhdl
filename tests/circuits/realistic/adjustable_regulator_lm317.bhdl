import { Ldo_LM317 } from "bhdl-stdlib/power/lm317.bhdl";
import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
import { LED } from "bhdl-stdlib/optoelectronic/led.bhdl";

// Test circuit for LM317 adjustable regulator with virtual pin expansion
// Configured for 9V output from 12V input

board AdjustableRegulatorBoard {
    power VIN = 12V @ 1A;
    port VOUT_9V: power out = 9V @ 500mA;
    ground GND;
    
    // LM317 configured for 9V output
    U1: Ldo_LM317(v_out=9V);
    
    // Input connections
    @VIN -> U1.VIN;
    
    // Virtual pin - expands to feedback network and capacitors
    U1.VOUT -> @VOUT_9V;
    
    // Note: GND connection is virtual - through R2 in the expansion
    
    // Load for testing
    @VOUT_9V -> R_LOAD: Res(18).1;  // 18Ω load = 500mA at 9V
    R_LOAD.2 -> @GND;
    
    // LED indicator
    @VOUT_9V -> R_LED: Res(470).1;
    R_LED.2 -> D_LED: LED("green").A;
    D_LED.K -> @GND;
}