// ELABORATED bhdl — generated from test_poly_planes.bhdl; DO NOT EDIT.
// The round-trip gate re-synthesizes this file and requires the
// IDENTICAL netlist. Every synthesized element carries a
// provenance comment naming the intent that produced it.

// Polygon-outline + planes fixture (P2 polygon fill clipping): the
// same L-shaped board as test_mech_poly but on a 4-layer stackup, so
// GND and VCC get real plane fills that must clip to the outline —
// no copper in the cutout notch, drop vias only inside the polygon.

import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
import { LED } from "bhdl-stdlib/optoelectronic/led.bhdl";

entity PwrJack() {
    pin VIN: power out;
    pin GND: ground;

    attribute component_class = "connector";
}

layout PwrJack {
    package SOT-223;
}

layout PolyPlanes {
    layer_stackup 4;
    // Same L-shape: 40x30 with the (28..40, 18..30) corner cut away.
    outline polygon (0,0) (40,0) (40,18) (28,18) (28,30) (0,30);
    place j_pwr at (4, 15) rot 90;
    mounting_hole (36, 4) drill 3.2 keepout 2.0;
    // Display SLOT: an elongated interior aperture — the plane fills
    // punch the exact rect (the old enclosing-circle punch would have
    // cost a 5mm-radius disc of copper).
    cutout rect (14, 10) (24, 12);
    // Near-edge aperture: its clearance-inflated punch CROSSES the
    // inset fill boundary — the fill must notch the boundary edge
    // around it (v1 skipped these and shipped under-clearing copper).
    cutout rect (0.7, 20) (3, 24);
}

board PolyPlanes {
    power VCC = 5V @ 0.1A;
    ground GND;

    j_pwr: PwrJack();
    led1: LED(green);
    led2: LED(red);
    r_led: Res(220, 5%, 0.25W);
    r_led2: Res(330, 5%, 0.25W);
    j_pwr.GND -> @GND;
    r_led.2 -> @GND;
    r_led2.2 -> @GND;
    @VCC -> j_pwr.VIN;
    @VCC -> led1.A;
    @VCC -> led2.A;
    led1.K -> r_led.1;  // net auto_led1_K
    led2.K -> r_led2.1;  // net auto_led2_K
}
