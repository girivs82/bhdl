// KiCad demo transcription: ecc83-pp (corpus board 92) — the SRPP
// (shunt-regulated push-pull) ECC83 line stage shipped with KiCad
// itself (~/Downloads/demos/ecc83). Netlist read from the demo's OWN
// .kicad_pcb pad-net bindings, section basing per the standard 12AX7
// noval map the demo uses (1=a1 2=g1 3=k1, 6=a2 7=g2 8=k2, 4+5/9
// heaters):
//
//   lower section: g1 <- IN (R4 47K grid leak), k1 -> R2 1.5K -> GND
//   upper section: a1 + g2 tied (the SRPP node), R1 1.5K from that
//     node up to k2, a2 -> B+ directly; OUTPUT taken at k2 through
//     C2 680nF into R3 100K
//   C1 10uF = B+ reservoir; P4 = 6.3V heater feed (both halves
//     parallel per the demo's 4+5 vs 9 wiring)
//
// GLACIER solves the stack with its native Koren triode device —
// this board is the triode model's first published-circuit fixture.
//
// Values not stated by the demo (recorded design choices, not data):
//   B+ = 250V (classic ECC83 SRPP operating point; the demo leaves
//   the PSU to the builder); C1 rated 630V, C2 rated 400V (standard
//   tube-B+ film/electrolytic ratings — the solve puts 250V across
//   the reservoir and 125.8V DC across the coupling cap, and the
//   2x-derate sign-off honestly flunked 50V class defaults);
//   r_htr rated 5W (1.89W dissipated at 6.3V);
//   heater load = 21Ω derived from the DATASHEET heater rating
//   6.3V/300mA (hot-equivalent resistance, V/I — keeps the heater
//   connector electrically live for the DC solve).
// Demo's Altech AK300 terminal blocks stand in as 2-pin headers
// (package realism is the uno contract, not per-fixture).

import { TriodeECC83 } from "bhdl-stdlib/actives/triode.bhdl";
import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
import { Cap, ElectrolyticCap } from "bhdl-stdlib/passives/capacitor.bhdl";
import { Pin_Header_01x02 } from "bhdl-stdlib/connectors/pin_header.bhdl";

board Ecc83Srpp {
    power VBB = 250V @ 20mA;
    power HTR = 6.3V @ 300mA;
    ground GND;

    // Connectors (demo: P1=IN, P2=OUT, P3=POWER, P4=heater).
    J_IN:  Pin_Header_01x02();
    J_OUT: Pin_Header_01x02();
    J_PWR: Pin_Header_01x02();
    J_HTR: Pin_Header_01x02();
    @VBB -> J_PWR.1; J_PWR.2 -> @GND;
    @HTR -> J_HTR.1; J_HTR.2 -> @GND;
    J_IN.2 -> @GND;
    J_OUT.2 -> @GND;

    // B+ reservoir (demo C1 10uF; 350V = chosen tube-B+ rating).
    @VBB -> c_res: ElectrolyticCap(10µF, 630V).pos;
    c_res.neg -> @GND;

    // Lower section: common cathode.
    v_lo: TriodeECC83();
    J_IN.1 -> v_lo.G;
    v_lo.G -> r_leak: Res(47kΩ).1; r_leak.2 -> @GND;     // demo R4
    v_lo.K -> r_klo: Res(1.5kΩ).1; r_klo.2 -> @GND;      // demo R2

    // Upper section stacked on the lower plate (the SRPP node):
    // a1 + g2 tied, R1 from that node to the upper cathode.
    v_hi: TriodeECC83();
    v_lo.P -> v_hi.G;
    v_hi.G -> r_kup: Res(1.5kΩ).1; r_kup.2 -> v_hi.K;    // demo R1
    v_hi.P -> @VBB;

    // Output off the upper cathode.
    v_hi.K -> c_out: Cap(680nF, 400V).1;                        // demo C2
    c_out.2 -> J_OUT.1;
    J_OUT.1 -> r_load: Res(100kΩ).1; r_load.2 -> @GND;   // demo R3

    // Heater load: 6.3V/300mA (datasheet, both halves parallel)
    // -> 21Ω hot-equivalent. Keeps J_HTR's rail solved.
    @HTR -> r_htr: Res(21Ω, 5%, 5W).1; r_htr.2 -> @GND;
}

layout Ecc83Srpp {
    layer_stackup 2;
    // Demo board outline (ecc83-pp.kicad_pcb Edge.Cuts bbox).
    outline rect 52 46;
    // Demo's own mounting holes + connector positions (board-local
    // coords read from ecc83-pp.kicad_pcb footprint origins).
    mounting_hole at (3.8, 3.8) drill 3.2;
    mounting_hole at (48.3, 3.8) drill 3.2;
    mounting_hole at (3.8, 42.5) drill 3.2;
    mounting_hole at (48.3, 42.5) drill 3.2;
    place J_IN at (45.1, 15.2) rot 90;
    place J_OUT at (7.0, 22.6) rot 270;
    place J_PWR at (7.0, 10.5) rot 270;
    place J_HTR at (24.3, 41.0) rot 0;
}
