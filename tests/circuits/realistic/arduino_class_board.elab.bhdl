// synthesized imports: expansion children reference these
import { LM317 } from "bhdl-stdlib/power/lm317.bhdl";
import { Res } from "bhdl-stdlib/passives/resistor.bhdl";

// End-to-end integration: a simplified Arduino-class board that
// chains every piece of infrastructure we built over the past few
// turns:
//
//   1. Power regulator with `design { }` + `expansion { }` recipe:
//      LM317 sized from v_out=5V → R1=720Ω, R2=240Ω feedback
//      divider + input/output bulk caps. (Tests phase 4.5 +
//      design→expansion value-binding loop.)
//
//   2. MCU with always-on `expansion { }`:
//      ATmega328P_DIP28 → decoupling caps on VCC/AVCC/AREF.
//      (Tests phase 4.5 expansion firing on imported stdlib
//      entities.)
//
//   3. MCU with conditionally-gated expansion:
//      Same chip — PC4 and PC5 are wired here (used as I²C bus),
//      so the chip's gated pullup children R_pu_sda / R_pu_scl
//      should fire. (Tests #89 conditional expansion gating.)
//
//   4. Cross-chip routing through the analyzer's net extraction.
//      VIN → LM317 → VCC rail → multiple chips on the same rail.
//
// Negative checks (things that must NOT appear):
//   - No false pullups on chips without I²C usage (none in this
//     fixture, but the gating logic stays exercised).

import { Ldo_LM317 } from "bhdl-stdlib/power/lm317.bhdl";
import { ATmega328P_DIP28 } from "bhdl-stdlib/actives/atmega328p.bhdl";
import { Cap, Res } from "bhdl-stdlib/passives/capacitor.bhdl";

board Arduino_Class_Board {
    power VCC = 5V @ 0.3A;
    power VIN = 12V @ 0.5A;
    ground GND;

    MCU: ATmega328P_DIP28("ATMEGA328P-PU");
    attribute MCU.expansion_applied = "true";
    MCU_C_aref: Cap(100nF, 50V);
    attribute MCU_C_aref.expansion_parent = "MCU";
    attribute MCU_C_aref.expansion_role = "series";
    attribute MCU_C_aref.vpin_parent = "MCU";
    attribute MCU_C_aref.vpin_role = "series";
    MCU_C_avcc: Cap(100nF, 50V);
    attribute MCU_C_avcc.expansion_parent = "MCU";
    attribute MCU_C_avcc.expansion_role = "series";
    attribute MCU_C_avcc.vpin_parent = "MCU";
    attribute MCU_C_avcc.vpin_role = "series";
    MCU_C_bulk: Cap(10µF, 50V);
    attribute MCU_C_bulk.expansion_parent = "MCU";
    attribute MCU_C_bulk.expansion_role = "series";
    attribute MCU_C_bulk.vpin_parent = "MCU";
    attribute MCU_C_bulk.vpin_role = "series";
    MCU_C_vcc: Cap(100nF, 50V);
    attribute MCU_C_vcc.expansion_parent = "MCU";
    attribute MCU_C_vcc.expansion_role = "series";
    attribute MCU_C_vcc.vpin_parent = "MCU";
    attribute MCU_C_vcc.vpin_role = "series";
    MCU_R_pu_scl: Res(4.7kΩ, 5%, 0.25W);
    attribute MCU_R_pu_scl.expansion_parent = "MCU";
    attribute MCU_R_pu_scl.expansion_role = "series";
    attribute MCU_R_pu_scl.vpin_parent = "MCU";
    attribute MCU_R_pu_scl.vpin_role = "series";
    MCU_R_pu_sda: Res(4.7kΩ, 5%, 0.25W);
    attribute MCU_R_pu_sda.expansion_parent = "MCU";
    attribute MCU_R_pu_sda.expansion_role = "series";
    attribute MCU_R_pu_sda.vpin_parent = "MCU";
    attribute MCU_R_pu_sda.vpin_role = "series";
    U_REG: Ldo_LM317(5V, 500mA, 12V);
    attribute U_REG.expansion_applied = "true";
    U_REG_C_in: Cap(10µF, 50V);
    attribute U_REG_C_in.composed_parent = "U_REG";
    attribute U_REG_C_in.composed_role = "shunt";
    U_REG_C_out: Cap(22µF, 50V);
    attribute U_REG_C_out.composed_parent = "U_REG";
    attribute U_REG_C_out.composed_role = "shunt";
    U_REG_R1: Res(720.000, 5%, 0.25W);
    attribute U_REG_R1.composed_parent = "U_REG";
    attribute U_REG_R1.composed_role = "series";
    U_REG_R2: Res(240Ω, 5%, 0.25W);
    attribute U_REG_R2.composed_parent = "U_REG";
    attribute U_REG_R2.composed_role = "shunt";
    U_REG_u: LM317();
    attribute U_REG_u.composed_parent = "U_REG";
    attribute U_REG_u.composed_role = "series";
    MCU.GND1 -> @GND;
    MCU.GND2 -> @GND;
    MCU_C_aref.2 -> @GND;
    MCU_C_avcc.2 -> @GND;
    MCU_C_bulk.2 -> @GND;
    MCU_C_vcc.2 -> @GND;
    U_REG.GND -> @GND;
    U_REG_C_in.2 -> @GND;
    U_REG_C_out.2 -> @GND;
    U_REG_R2.2 -> @GND;
    MCU.AREF -> MCU_C_aref.1;  // net MCU_AREF
    MCU.PC5 -> MCU_R_pu_scl.1;  // net SCL_BUS
    MCU.PC4 -> MCU_R_pu_sda.1;  // net SDA_BUS
    U_REG_R1.2 -> U_REG_R2.1;  // net U_REG_auto_8
    U_REG_R1.2 -> U_REG_u.ADJ;  // net U_REG_auto_8
    @VCC -> MCU.AVCC;
    @VCC -> MCU.VCC;
    @VCC -> MCU_C_avcc.1;
    @VCC -> MCU_C_bulk.1;
    @VCC -> MCU_C_vcc.1;
    @VCC -> MCU_R_pu_scl.2;
    @VCC -> MCU_R_pu_sda.2;
    @VCC -> U_REG.VOUT;
    @VCC -> U_REG_C_out.1;
    @VCC -> U_REG_R1.1;
    @VCC -> U_REG_u.VOUT;
    @VIN -> U_REG.VIN;
    @VIN -> U_REG_C_in.1;
    @VIN -> U_REG_u.VIN;
}
