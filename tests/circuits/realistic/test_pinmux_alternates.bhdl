// Pinmux alternates fixture (SoC arc increment 3) — an STM32-shaped
// MCU whose peripherals offer ALTERNATE pin bindings (`alt "AFn"
// { … }`, the vendor's alternate-function table transcribed; FIXTURE
// values with a realistic shape). The board wires UART + I2C + SPI;
// UART's default alternate (AF_A on PB6/PB7) collides with I2C's only
// home (PB6/PB7), so the solver must move UART to AF_B (PA9/PA10) —
// exactly the assignment a firmware engineer performs by hand from
// the AF table. The chosen mux lands as `mux__<field>` instance
// attributes and the survey prints every choice.

interface MuxUART {
    perspective dev  { signal TX: out; signal RX: in; }
    perspective host { signal TX: out; signal RX: in; }
    wires { dev.TX <-> host.RX; dev.RX <-> host.TX; }
}

interface MuxI2C {
    signal SDA: inout;
    signal SCL: inout;
}

interface MuxSPI {
    perspective master { signal SCK: out; signal MOSI: out; signal MISO: in; }
    perspective slave  { signal SCK: in;  signal MOSI: in;  signal MISO: out; }
}

entity MuxMcu() {
    pin VDDIO_A: power in;
    pin VDDIO_B: power in;
    pin PA4:  signal inout;
    pin PA5:  signal inout;
    pin PA6:  signal inout;
    pin PA7:  signal inout;
    pin PA9:  signal inout;
    pin PA10: signal inout;
    pin PB6:  signal inout;
    pin PB7:  signal inout;
    pin GND:  ground;
    attribute component_class = "mcu";
    attribute part_number = "FIXTURE-MUX-MCU";
    // Internal pull capability (increment 4b) — the datasheet's
    // per-pin programmable pulls (FIXTURE figures). The tool
    // configures them from the CONNECTIONS; configured pulls are
    // modelled as real resistors so the DC solve owns contradiction
    // detection (ERC036 ambiguous-band refusal).
    attribute internal_pull = "pins=PA4,PA9,PA10,PB6,PB7 pu=40kΩ pd=40kΩ source=FIXTURE";

    // IO BANKS (increment 4): each rail declares the SIGNAL pins it
    // powers — the vendor's bank table (FIXTURE values). ERC004 then
    // judges every banked pin at its own bank rail's net voltage;
    // ERC035 refuses using a pin whose bank rail is unpowered.
    domain BANK_A pins="VDDIO_A" v=3.3V i_nom=10mA i_max=50mA
        io_pins="PA4 PA5 PA6 PA7 PA9 PA10"
        source="FIXTURE — port A bank";
    domain BANK_B pins="VDDIO_B" v=3.3V i_nom=10mA i_max=50mA
        io_pins="PB6 PB7"
        source="FIXTURE — port B bank";

    // UART1: two homes (FIXTURE AF table — declaration order is the
    // solver's preference order)
    interface MuxUART:dev uart1 {
        alt "AF_A" {
            TX = PB6;
            RX = PB7;
        }
        alt "AF_B" {
            TX = PA9;
            RX = PA10;
        }
    }

    // I2C1: one home — and it is UART1's preferred one
    interface MuxI2C i2c1 {
        alt "AF_A" {
            SDA = PB7;
            SCL = PB6;
        }
    }

    // SPI1: fixed binding (no alternates) on PA5..PA7
    interface MuxSPI:master spi1 {
        SCK  = PA5;
        MISO = PA6;
        MOSI = PA7;
    }
}

entity MuxPeer() {
    pin RX:  signal in;
    pin TX:  signal out;
    pin INT: signal inout;
    pin SDA: signal inout;
    pin SCL: signal inout;
    pin SCK: signal in;
    pin SDI: signal in;
    pin SDO: signal out;
    pin GND: ground;
    attribute component_class = "ic";
    attribute part_number = "FIXTURE-MUX-PEER";
}

import { Res } from "bhdl-stdlib/passives/resistor.bhdl";

board PinmuxBoard {
    power VDD = 3.3V @ 1A;
    ground GND;

    mcu:  MuxMcu();
    peer: MuxPeer();
    mcu.GND -> @GND;
    peer.GND -> @GND;
    @VDD -> mcu.VDDIO_A;
    @VDD -> mcu.VDDIO_B;

    // all three peripherals wired — the solver must fit them
    mcu.uart1.TX -> peer.RX;
    peer.TX -> mcu.uart1.RX;
    mcu.i2c1.SDA -> peer.SDA;
    mcu.i2c1.SCL -> peer.SCL;
    // I2C pull-ups (ERC005)
    @VDD -> rp_sda: Res(4.7kΩ, tolerance = 1%).1; rp_sda.2 -> peer.SDA;
    @VDD -> rp_scl: Res(4.7kΩ, tolerance = 1%).1; rp_scl.2 -> peer.SCL;
    // open-drain IRQ from the peer: no external pull — the tool
    // configures the MCU's internal pull-up (idle-high, stated)
    peer.INT -> mcu.PA4;
    mcu.spi1.SCK -> peer.SCK;
    mcu.spi1.MOSI -> peer.SDI;
    peer.SDO -> mcu.spi1.MISO;
}
