// The round-trip gate re-synthesizes this file and requires the
// IDENTICAL netlist. Every synthesized element carries a
// provenance comment naming the intent that produced it.

// Mixed-Signal Circuit with Timing and Signal Processing Intents
// Demonstrates debounce, anti-aliasing, and current-limiting intents.
// Rewritten to the v2 language: board-nested entities hoisted to top level,
// one intent per flow statement, stdlib imports for the passives.

import { Cap } from "bhdl-stdlib/passives/capacitor.bhdl";
import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
import { LED } from "bhdl-stdlib/optoelectronic/led.bhdl";

// Board-local abstractions (no stdlib part) — top-level minimal entities.

entity Button() {
    pin OUT: signal out;
    pin GND: ground;

    attribute component_class = "switch";
}

entity Buffer() {
    pin IN: signal in;
    pin OUT: signal out;

    attribute component_class = "buffer";
}

entity AnalogSensor() {
    pin OUT: signal out;
    pin VCC: power in;
    pin GND: ground;

    attribute component_class = "sensor";
}

entity ADC() {
    pin IN: signal in;
    pin CLK: signal in;  // clock input (v2 pin types have no `clock` role)
    pin DATA: signal out;
    pin VCC: power in;
    pin GND: ground;

    attribute component_class = "adc";
}

board MixedSignalBoard {
    power VCC = 5V @ 0.5A;
    ground GND;

    C1: Cap(1u, 50V);
    attribute C1.stage_name = "debounce";
    C2: Cap(1u, 50V);
    Cf: Cap(100n, 50V);
    attribute Cf.stage_name = "anti_alias";
    R1: Res(10k, 5%, 0.25W);
    R2: Res(100, 5%, 0.25W);
    R3: Res(1k, 5%, 0.25W);
    R4: Res(1k, 5%, 0.25W);
    attribute R4.stage_name = "debug_only";
    Rf: Res(1k, 5%, 0.25W);
    adc: ADC();
    btn: Button();
    buf: Buffer();
    attribute buf.stage_name = "signal_buffering";
    led1: LED(red);
    attribute led1.stage_name = "current_limiting";
    led2: LED(yellow);
    attribute led2.stage_name = "current_limiting";
    sensor: AnalogSensor();
    C1.2 -> @GND;
    C2.2 -> @GND;
    Cf.2 -> @GND;
    adc.GND -> @GND;
    btn.GND -> @GND;
    led1.K -> @GND;
    led2.K -> @GND;
    sensor.GND -> @GND;
    @VCC -> adc.VCC;
    @VCC -> sensor.VCC;
    R4.1 -> adc.DATA;  // net adc_data
    C1.1 -> R1.2;  // net auto_R1_2
    R2.2 -> led1.A;  // net auto_R2_2
    C2.1 -> R3.2;  // net auto_R3_2
    C2.1 -> led2.A;  // net auto_R3_2
    Cf.1 -> Rf.2;  // net auto_Rf_2
    R1.1 -> btn.OUT;  // net buffered_signal
    R1.1 -> buf.IN;  // net buffered_signal
    Rf.1 -> adc.IN;  // net sensor_filtered
    Rf.1 -> sensor.OUT;  // net sensor_filtered
    R2.1 -> R3.1;  // net slow_path
    R2.1 -> buf.OUT;  // net slow_path
}
