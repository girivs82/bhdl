// Test circuit for generate block wildcard integration
// Demonstrates wildcard expansion with generate-created instances

board SensorArrayTest {
    // Create sensor array using generate block
    generate for i in 0..7 {
        sensor[i]: TempSensor();
    }

    // Manual instances for comparison
    led_0: LED(red);
    led_1: LED(green);
    led_2: LED(blue);

    // Power domain with wildcards
    // Should expand to: sensor[0]..sensor[7], led_0, led_1, led_2
    power_domain @VCC_3V3 = 3.3V @ 2A {
        distribution {
            // Wildcard should match all generated sensor instances
            sensor[*].VCC;

            // Wildcard should match all LED instances
            led[*].A;
        }

        decoupling {
            // Decoupling caps near each sensor
            near each sensor[*]: [100nF @ 1];

            // Distributed decoupling
            distributed: [10µF @ 4, 1µF @ 8];
        }
    }

    // Ground connection
    ground GND;
}
