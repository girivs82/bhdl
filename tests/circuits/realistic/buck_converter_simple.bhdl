// Simple Buck Converter for End-to-End Testing
// 12V to 5V @ 2A using LM2596 (assuming it's in the component library)

board SimpleBuckConverter {
    // Power domains
    power VIN = 12V @ 3A;
    power VOUT = 5V @ 2A;
    ground GND;
    
    // Input filtering
    VIN -> C1: Cap(100µF, voltage=25V).1;
    C1.2 -> GND;
    VIN -> C2: Cap(0.1µF).1;  
    C2.2 -> GND;
    
    // Buck controller
    VIN -> U1: LM2596().VIN;
    U1.GND -> GND;
    U1.EN -> VIN;  // Always enabled
    
    // Power stage
    U1.SW -> L1: Inductor(33µH).1;
    L1.2 -> VOUT;
    
    // Catch diode
    GND -> D1: SchottkyDiode(SS34).A;
    D1.K -> U1.SW;
    
    // Output filtering
    VOUT -> C3: Cap(220µF, voltage=10V).1;
    C3.2 -> GND;
    VOUT -> C4: Cap(0.1µF).1;
    C4.2 -> GND;
    
    // Feedback divider (5V output)
    VOUT -> R1: Res(10kΩ, tolerance=1%).1;
    R1.2 -> fb_node;
    fb_node -> R2: Res(1.87kΩ, tolerance=1%).1;
    R2.2 -> GND;
    fb_node -> U1.FB;
    
    // Load for testing
    VOUT -> RL: Res(2.5Ω, wattage=10W).1;
    RL.2 -> GND;
}