// bhdl-sweep: skip — safety-engine fixture, not a layout target
// PDN fixture (docs/spec/Functional_Safety.md §2.10): a SoC power
// domain's vendor contract — target-impedance mask Z(f) + load-step
// droop — checked against the board's ACTUAL decoupling network by a
// small-signal impedance sweep and a transient droop solve over the
// WHOLE tree. All domain numbers are FIXTURE values standing in for
// the customer's NDA'd vendor data.
//
// Tree: 12V —50mΩ— RAIL, decoupled by three ranks (bulk 100µF/20mΩ/5nH,
// mid 10µF/5mΩ/1nH, hf 100nF/10mΩ/0.5nH) into a 12Ω static load.

import { Res } from "bhdl-stdlib/passives/resistor.bhdl";

// Local cap with declared ESR/ESL — the anti-resonances between decap
// ranks are set by ESL (datasheet data, never guessed).
entity PdnCap(value: capacitance, esr_v: resistance, esl_v: inductance) {
    pin 1: signal inout;
    pin 2: signal inout;
    attribute component_class = "capacitor";
    attribute capacitance = value;
    attribute esr = esr_v;
    attribute esl = esl_v;
    attribute kicad_symbol = "Device:C";
}

// SoC stand-in: high-Z electrically; carries the vendor PDN contract.
entity Soc() {
    pin 1: signal inout;
    pin 2: signal inout;
    attribute component_class = "resistor";
    attribute resistance = 10MΩ;
    attribute kicad_symbol = "Device:R";
    // DESIGN contract (entity scope, not safety): the board must meet
    // this whether or not it is a safety product.
    domain VDD pins="1" v=12V tol=5% i_nom=1A i_max=12A
        zmask="100kHz:300m 1MHz:150m 10MHz:150m 50MHz:400m"
        step=2A rise=1us dur=20us droop_max=4%
        pdn_r=1m pdn_l=1n
        source="FIXTURE — stands in for NDA vendor data";
}

board PdnDemo {
    power V12 = 12V @ 5A;
    ground GND;

    @V12 -> rds: Res(50mΩ).1; rds.2 -> r_load: Res(12Ω).1; r_load.2 -> @GND;
    rds.2 -> c_bulk: PdnCap(100µF, 20mΩ, 5nH).1; c_bulk.2 -> @GND;
    rds.2 -> c_mid: PdnCap(10µF, 5mΩ, 1nH).1; c_mid.2 -> @GND;
    rds.2 -> c_hf: PdnCap(100nF, 10mΩ, 0.5nH).1; c_hf.2 -> @GND;

    rds.2 -> soc: Soc().1;
    soc.2 -> @GND;
}

safety PdnDemo as brd {
    mission { ambient = 40degC; lifetime = 15000h; }
    // the safety case CONSUMES the entity's design contract
    assume pdn(brd.soc.VDD);
    goal SG: ASIL_B "rail stays in window" (id="SG-PDN-1") {
        effect uv = brd.r_load.1 < 10V severity S2;
    }
}
