// ELABORATED bhdl — generated from intent_system_demo.bhdl; DO NOT EDIT.
// The round-trip gate re-synthesizes this file and requires the
// IDENTICAL netlist. Every synthesized element carries a
// provenance comment naming the intent that produced it.

// synthesized imports: expansion children reference these
import { LM7805 } from "bhdl-stdlib/power/lm7805.bhdl";

// BHDL Intent System Demonstration
// This circuit showcases the Intent System with examples from all categories.
// Rewritten to the v2 language: stdlib imports for the real parts, top-level
// minimal entities for the board-local abstractions, one intent per flow
// statement (the flow model carries a single intent), named nets as @nets.

import { Ldo_LM7805 } from "bhdl-stdlib/power/lm7805.bhdl";
import { Cap } from "bhdl-stdlib/passives/capacitor.bhdl";
import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
import { TVSDiode } from "bhdl-stdlib/protection/tvs.bhdl";
import { TestPoint } from "bhdl-stdlib/connectors/testpoint.bhdl";

// ============================================================================
// Board-local abstractions (no stdlib part) — minimal top-level entities.
// ============================================================================

entity CurrentSenseAmp() {
    pin IN: signal in;
    pin OUT: signal out;

    attribute component_class = "amplifier";
}

entity SupervisorIC() {
    pin PG_IN: signal in;
    pin PG_OUT: signal out;
    pin BOOT1: signal out;

    attribute component_class = "supervisor";
}

entity LDO_3V3() {
    pin IN: power in;
    pin OUT: power out;

    attribute component_class = "voltage_regulator";
}

entity MCU() {
    pin SDA: signal inout;
    pin SCL: signal inout;
    pin WDT_OUT: signal out;
    pin RESET: signal in;
    pin SCLK: signal out;
    pin CLK: signal in;
    pin BOOT_EN: signal in;
    pin BOOT_DONE: signal out;

    attribute component_class = "microcontroller";
}

entity TempSensor() {
    pin SDA: signal inout;
    pin SCL: signal inout;

    attribute component_class = "sensor";
}

entity WatchdogIC() {
    pin WDI: signal in;
    pin RST: signal out;

    attribute component_class = "supervisor";
}

entity SPIFlash() {
    pin SCLK: signal in;
    pin CLK: signal in;

    attribute component_class = "memory";
}

entity Oscillator(freq: frequency) {
    pin OUT: signal out;

    attribute component_class = "oscillator";
    attribute frequency = freq;
}

entity ClockBuffer() {
    pin IN: signal in;
    pin OUT1: signal out;
    pin OUT2: signal out;

    attribute component_class = "buffer";
}

entity Battery(v: voltage) {
    pin POS: power out;

    attribute component_class = "battery";
    attribute voltage_rating = v;
}

entity BuckConverter() {
    pin VIN: power in;
    pin VOUT: power out;

    attribute component_class = "voltage_regulator";
}

entity PowerMOSFET() {
    pin D: signal in;
    pin S: signal out;

    attribute component_class = "mosfet";
}

entity EMIFilter() {
    pin IN: signal in;
    pin OUT: signal out;

    attribute component_class = "filter";
}

entity Optocoupler() {
    pin IN: signal in;
    pin OUT: signal out;

    attribute component_class = "isolator";
}

entity PowerMux() {
    pin A: power in;
    pin B: power in;
    pin OUT: power out;

    attribute component_class = "power_mux";
}

entity Supercap(v: voltage) {
    pin POS: power out;

    attribute component_class = "capacitor";
    attribute voltage_rating = v;
}

entity Peripherals() {
    pin EN: signal in;

    attribute component_class = "peripheral";
}

board IntentSystemDemo {
    power VCC_3V3 = 3.3V @ 0.5A;
    power VCC_5V = 5V @ 1A;
    power VIN = 12V @ 2A;
    ground GND;

    backup: Supercap(5V);
    battery: Battery(3.7V);
    buf: ClockBuffer();
    attribute buf.stage_name = "clock_distribution";
    cfilter: Cap(100nF, 50V);
    attribute cfilter.stage_name = "precision_measurement";
    cin: Cap(100µF, 50V);
    attribute cin.stage_name = "noise_filtering";
    cout: Cap(10µF, 50V);
    attribute cout.stage_name = "low_noise";
    creset: Cap(1µF, 50V);
    attribute creset.stage_name = "reset_generation";
    dcdc: BuckConverter();
    attribute dcdc.stage_name = "power_optimization";
    emi_filter: EMIFilter();
    attribute emi_filter.stage_name = "emi_filtering";
    flash: SPIFlash();
    attribute flash.stage_name = "clock_distribution";
    iso: Optocoupler();
    attribute iso.stage_name = "isolation";
    mcu: MCU();
    attribute mcu.stage_name = "boot_sequencing";
    mosfet: PowerMOSFET();
    attribute mosfet.stage_name = "thermal_management";
    mux: PowerMux();
    attribute mux.stage_name = "redundancy";
    osc: Oscillator(50MHz);
    attribute osc.stage_name = "clock_distribution";
    peripherals: Peripherals();
    attribute peripherals.stage_name = "boot_sequencing";
    primary: Battery(3.7V);
    rc: Res(10k, 5%, 0.25W);
    rdiv1: Res(10k, 5%, 0.25W);
    rdiv2: Res(2k, 5%, 0.25W);
    attribute rdiv2.stage_name = "precision_measurement";
    reg3v3: LDO_3V3();
    attribute reg3v3.stage_name = "voltage_regulation";
    reg5v: Ldo_LM7805(5V, 500mA, 12V);
    attribute reg5v.expansion_applied = "true";
    attribute reg5v.stage_name = "voltage_regulation";
    reg5v_C_in: Cap(0.33µF, 50V);
    attribute reg5v_C_in.composed_parent = "reg5v";
    attribute reg5v_C_in.composed_role = "shunt";
    reg5v_C_out: Cap(0.1µF, 50V);
    attribute reg5v_C_out.composed_parent = "reg5v";
    attribute reg5v_C_out.composed_role = "shunt";
    reg5v_u: LM7805(5V);
    attribute reg5v_u.composed_parent = "reg5v";
    attribute reg5v_u.composed_role = "shunt";
    rfilter: Res(1k, 5%, 0.25W);
    rpull_scl: Res(4.7k, 5%, 0.25W);
    rpull_sda: Res(4.7k, 5%, 0.25W);
    rsense: Res(0.1, 5%, 0.25W);
    attribute rsense.stage_name = "current_sensing";
    rterm: Res(33, 5%, 0.25W);
    attribute rterm.stage_name = "communication_interface";
    sense_amp: CurrentSenseAmp();
    attribute sense_amp.stage_name = "current_sensing";
    sensor: TempSensor();
    attribute sensor.stage_name = "communication_interface";
    supervisor: SupervisorIC();
    attribute supervisor.stage_name = "boot_sequencing";
    tp_3v3: TestPoint();
    attribute tp_3v3.stage_name = "test_point";
    tp_5v: TestPoint();
    attribute tp_5v.stage_name = "test_point";
    tvs: TVSDiode(15V);
    attribute tvs.stage_name = "input_protection";
    wdt: WatchdogIC();
    attribute wdt.stage_name = "watchdog_monitoring";
    cfilter.2 -> @GND;
    cin.2 -> @GND;
    cout.2 -> @GND;
    creset.2 -> @GND;
    rdiv2.2 -> @GND;
    reg5v.GND -> @GND;
    reg5v_C_in.2 -> @GND;
    reg5v_C_out.2 -> @GND;
    reg5v_u.GND -> @GND;
    tvs.A -> @GND;
    @VCC_3V3 -> reg3v3.OUT;
    @VCC_3V3 -> rpull_scl.1;
    @VCC_3V3 -> rpull_sda.1;
    @VCC_3V3 -> tp_3v3.1;
    @VCC_5V -> cout.1;
    @VCC_5V -> dcdc.VOUT;
    @VCC_5V -> reg3v3.IN;
    @VCC_5V -> reg5v.VOUT;
    @VCC_5V -> reg5v_C_out.1;
    @VCC_5V -> reg5v_u.VOUT;
    @VCC_5V -> rsense.1;
    @VCC_5V -> supervisor.PG_IN;
    @VCC_5V -> tp_5v.1;
    @VIN -> cin.1;
    @VIN -> emi_filter.IN;
    @VIN -> mosfet.D;
    @VIN -> reg5v.VIN;
    @VIN -> reg5v_C_in.1;
    @VIN -> reg5v_u.VIN;
    backup.POS -> mux.B;  // net auto_backup_POS
    battery.POS -> dcdc.VIN;  // net auto_battery_POS
    buf.OUT1 -> mcu.CLK;  // net auto_buf_OUT1
    buf.OUT2 -> flash.CLK;  // net auto_buf_OUT2
    mcu.BOOT_DONE -> peripherals.EN;  // net auto_mcu_BOOT_DONE
    mcu.SCLK -> rterm.1;  // net auto_mcu_SCLK
    mcu.WDT_OUT -> wdt.WDI;  // net auto_mcu_WDT_OUT
    buf.IN -> osc.OUT;  // net auto_osc_OUT
    mux.A -> primary.POS;  // net auto_primary_POS
    creset.1 -> rc.2;  // net auto_rc_2
    cfilter.1 -> rfilter.2;  // net auto_rfilter_2
    mcu.SCL -> rpull_scl.2;  // net auto_rpull_scl_2
    mcu.SCL -> sensor.SCL;  // net auto_rpull_scl_2
    mcu.SDA -> rpull_sda.2;  // net auto_rpull_sda_2
    mcu.SDA -> sensor.SDA;  // net auto_rpull_sda_2
    rsense.2 -> sense_amp.IN;  // net auto_rsense_2
    flash.SCLK -> rterm.2;  // net auto_rterm_2
    mcu.BOOT_EN -> supervisor.BOOT1;  // net auto_supervisor_BOOT1
    mcu.RESET -> wdt.RST;  // net auto_wdt_RST
    rdiv1.2 -> rdiv2.1;  // net fb_node
}
