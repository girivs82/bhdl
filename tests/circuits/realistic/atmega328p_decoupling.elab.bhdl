// Test circuit: ATmega328P with auto-expanded decoupling.
//
// Uses explicit imports (the working pattern, mirrors
// test_7805_with_imports.bhdl) so the synthesizer's
// import_loader can pull the stdlib entity definitions —
// including the chip's `expansion { }` block.

import { ATmega328P_DIP28 } from "bhdl-stdlib/actives/atmega328p.bhdl";
import { Cap } from "bhdl-stdlib/passives/capacitor.bhdl";

board ATmega328P_Decoupling_Test {
    power VCC = 5V @ 0.2A;
    ground GND;

    mcu: ATmega328P_DIP28("ATMEGA328P-PU");
    attribute mcu.expansion_applied = "true";
    mcu_C_aref: Cap(100nF, 50V);
    attribute mcu_C_aref.expansion_parent = "mcu";
    attribute mcu_C_aref.expansion_role = "series";
    attribute mcu_C_aref.vpin_parent = "mcu";
    attribute mcu_C_aref.vpin_role = "series";
    mcu_C_avcc: Cap(100nF, 50V);
    attribute mcu_C_avcc.expansion_parent = "mcu";
    attribute mcu_C_avcc.expansion_role = "series";
    attribute mcu_C_avcc.vpin_parent = "mcu";
    attribute mcu_C_avcc.vpin_role = "series";
    mcu_C_bulk: Cap(10µF, 50V);
    attribute mcu_C_bulk.expansion_parent = "mcu";
    attribute mcu_C_bulk.expansion_role = "series";
    attribute mcu_C_bulk.vpin_parent = "mcu";
    attribute mcu_C_bulk.vpin_role = "series";
    mcu_C_vcc: Cap(100nF, 50V);
    attribute mcu_C_vcc.expansion_parent = "mcu";
    attribute mcu_C_vcc.expansion_role = "series";
    attribute mcu_C_vcc.vpin_parent = "mcu";
    attribute mcu_C_vcc.vpin_role = "series";
    mcu.GND1 -> @GND;
    mcu.GND2 -> @GND;
    mcu_C_aref.2 -> @GND;
    mcu_C_avcc.2 -> @GND;
    mcu_C_bulk.2 -> @GND;
    mcu_C_vcc.2 -> @GND;
    @VCC -> mcu.AVCC;
    @VCC -> mcu.VCC;
    @VCC -> mcu_C_avcc.1;
    @VCC -> mcu_C_bulk.1;
    @VCC -> mcu_C_vcc.1;
    mcu.AREF -> mcu_C_aref.1;  // net mcu_AREF
}
