// Single-supply stereo line buffer — the textbook single-rail audio
// stage: a stiff VCC/2 bias node (10k/10k divider, 10 µF hold-down),
// AC-coupled inputs biased to it, TL072 unity followers, AC-coupled
// outputs. Proves the audio-opamp entities end-to-end: the JFET
// followers load the bias node with picoamps (i_bias 65 pA — the
// divider needs no buffering, WHY this classic works), the draws
// model puts the 2.8 mA package draw on the rail, and the board
// routes through the standard gates.

import { TL072 } from "bhdl-stdlib/actives/audio_opamps.bhdl";
import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
import { Cap } from "bhdl-stdlib/passives/capacitor.bhdl";
import { ElectrolyticCap } from "bhdl-stdlib/passives/capacitor.bhdl";
import { Pin_Header_01x03 } from "bhdl-stdlib/connectors/pin_header.bhdl";

board LineBuffer {
    port VCC: power in = 9V @ 50mA;
    port GND: ground;

    // Power entry + decoupling.
    J_PWR: Pin_Header_01x03();
    @VCC -> J_PWR.1;
    J_PWR.2 -> @GND;
    J_PWR.3 -> @GND;
    @VCC -> c_bulk: ElectrolyticCap(100µF).1;
    c_bulk.2 -> @GND;
    @VCC -> c_op: Cap(100nF).1;
    c_op.2 -> @GND;

    // VCC/2 bias: 10k/10k divider held stiff by 10 µF. The TL072's
    // 65 pA inputs load this node by microvolts — the whole reason
    // the unbuffered divider is legitimate here.
    @VCC -> r_b1: Res(10kΩ).1;
    r_b1.2 -> VBIAS;
    VBIAS -> r_b2: Res(10kΩ).1;
    r_b2.2 -> @GND;
    VBIAS -> c_bias: ElectrolyticCap(10µF).1;
    c_bias.2 -> @GND;

    // Audio I/O header: L-in, R-in, GND.
    J_IN: Pin_Header_01x03();
    J_IN.1 -> in_l_raw;
    J_IN.2 -> in_r_raw;
    J_IN.3 -> @GND;

    U1: TL072();
    @VCC -> U1.V_PLUS;
    U1.V_MINUS -> @GND;

    // Left channel: AC-couple in, bias to VBIAS, unity follower,
    // AC-couple out.
    in_l_raw -> c_inl: Cap(1µF).1;
    c_inl.2 -> in_l;
    in_l -> r_bl: Res(100kΩ).1;
    r_bl.2 -> VBIAS;
    in_l -> U1.IN_A_P;
    U1.OUT_A -> U1.IN_A_N;             // unity feedback
    U1.OUT_A -> c_outl: ElectrolyticCap(10µF).1;
    c_outl.2 -> out_l;
    out_l -> r_ol: Res(100kΩ).1;       // output bleed
    r_ol.2 -> @GND;

    // Right channel, mirrored.
    in_r_raw -> c_inr: Cap(1µF).1;
    c_inr.2 -> in_r;
    in_r -> r_br: Res(100kΩ).1;
    r_br.2 -> VBIAS;
    in_r -> U1.IN_B_P;
    U1.OUT_B -> U1.IN_B_N;
    U1.OUT_B -> c_outr: ElectrolyticCap(10µF).1;
    c_outr.2 -> out_r;
    out_r -> r_or: Res(100kΩ).1;
    r_or.2 -> @GND;

    // Output header: L-out, R-out, GND.
    J_OUT: Pin_Header_01x03();
    out_l -> J_OUT.1;
    out_r -> J_OUT.2;
    J_OUT.3 -> @GND;
}

layout LineBuffer {
    layer_stackup 2;
    outline rect 45 30;
    place J_PWR at (5, 26) rot 90;
    place J_IN at (2.6, 12);
    place J_OUT at (42.4, 12);
}
