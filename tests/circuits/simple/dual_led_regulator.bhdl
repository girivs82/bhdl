// Dual LED circuit with voltage regulator
// 9V input → LM7805 → 5V → two parallel LED branches
import { Res } from "bhdl-stdlib/passive/resistor.bhdl";
import { Cap } from "bhdl-stdlib/passive/capacitor.bhdl";
import { LED } from "bhdl-stdlib/optoelectronic/led.bhdl";
import { LM7805 } from "bhdl-stdlib/power/regulator.bhdl";

board DualLedRegulator {
    power VIN = 9V @ 500mA;
    power VOUT = 5V @ 200mA;
    ground GND;

    // Input filter
    VIN -> c_in: Cap(100µF).1 for noise_filtering(100Hz, 40dB);
    c_in.2 -> GND;

    // Voltage regulation
    c_in.1 -> reg: LM7805().VI; reg.VO -> VOUT for voltage_regulation(5V, 9V);
    reg.GND -> GND;

    // Output filter
    VOUT -> c_out: Cap(10µF).1 for noise_filtering(10kHz, 60dB);
    c_out.2 -> GND;

    // LED branch 1: red
    VOUT -> r1: Res(220).1; r1.2 -> led_r: LED("red").A for current_limiting(20mA);
    led_r.K -> GND;

    // LED branch 2: green
    VOUT -> r2: Res(150).1; r2.2 -> led_g: LED("green").A for current_limiting(20mA);
    led_g.K -> GND;
}
