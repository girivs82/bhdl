// Simple intent-driven layout demo with real voltage regulator
// Uses LM7805 from the component database
import { Res } from "bhdl-stdlib/passive/resistor.bhdl";
import { Cap } from "bhdl-stdlib/passive/capacitor.bhdl";
import { LED } from "bhdl-stdlib/optoelectronic/led.bhdl";
import { TVSDiode } from "bhdl-stdlib/protection/tvs.bhdl";
import { LM7805 } from "bhdl-stdlib/power/regulator.bhdl";

board IntentLayoutDemo {
    power VIN = 12V @ 500mA;
    power VOUT = 5V @ 300mA;
    ground GND;

    // LEFT ZONE: Input protection
    net protected: VIN -> tvs: TVSDiode(15V).K for input_protection(15V, 500mA);
    tvs.A -> GND;

    // CENTER ZONE: Input filtering
    net filtered_in: tvs.K -> c1: Cap(100µF).1 for noise_filtering(100Hz, 40dB);
    c1.2 -> GND;

    // TOP ZONE: Voltage regulation
    net vin_filtered: c1.1 -> reg: LM7805().VI; reg.VO -> VOUT for voltage_regulation(5V, 12V);
    reg.GND -> GND;

    // CENTER ZONE: Output filtering
    net filtered_out: VOUT -> c2: Cap(10µF).1 for noise_filtering(10kHz, 60dB);
    c2.2 -> GND;

    // RIGHT ZONE: LED indicator with current sensing
    net indicator: VOUT -> r1: Res(330).1 for current_limiting(20mA);
    net sensed: r1.2 -> sense: Res(0.1).1; sense.2 -> led: LED("green").A for current_sensing(20mA, 1%);
    led.K -> GND;
}
