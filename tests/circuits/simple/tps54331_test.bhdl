import { Res } from "bhdl-stdlib/passive/resistor.bhdl";
import { Cap } from "bhdl-stdlib/passive/capacitor.bhdl";
import { LED } from "bhdl-stdlib/optoelectronic/led.bhdl";
import { Ind } from "bhdl-stdlib/passive/inductor.bhdl";
import { Diode } from "bhdl-stdlib/passive/diode.bhdl";
import { TPS54331_3V3 } from "bhdl-stdlib/power/tps54331.bhdl";

board TPS54331Test {
    power VIN = 12V @ 3A;
    power V3_3 = 3.3V @ 2A |> output_filtering(max_ripple: 10mV);
    ground GND;

    VIN -> c_in: Cap(10µF).1; c_in.2 -> GND;

    c_in.1 -> buck: TPS54331_3V3().VIN;
    buck.VOUT -> V3_3;
    buck.GND -> GND;
    buck.EN -> VIN;

    V3_3 -> r_led: Res(120).1 -> r_led.2 -> led: LED("green").A;
    led.K -> GND;
    V3_3 -> r_load: Res(1.65).1 -> r_load.2 -> GND;
}
