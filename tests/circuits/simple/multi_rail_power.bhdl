// Multi-rail power supply: 12V → 5V → 3.3V with indicator LEDs on each rail
// Tests: cascaded regulators, parallel branches at each rail, multiple shunts
import { Res } from "bhdl-stdlib/passive/resistor.bhdl";
import { Cap } from "bhdl-stdlib/passive/capacitor.bhdl";
import { LED } from "bhdl-stdlib/optoelectronic/led.bhdl";
import { LM7805, LM1117_33 } from "bhdl-stdlib/power/regulator.bhdl";

board MultiRailPower {
    power VIN = 12V @ 1A;
    power V5 = 5V @ 500mA;
    power V3_3 = 3.3V @ 300mA;
    ground GND;

    // Input filter
    VIN -> c_in: Cap(100µF).1 for noise_filtering(100Hz, 40dB);
    c_in.2 -> GND;

    // 12V → 5V regulation
    net vin_filt: c_in.1 -> reg5: LM7805().VI -> reg5.VO -> V5 for voltage_regulation(5V, 12V);
    reg5.GND -> GND;

    // 5V output filter
    V5 -> c5: Cap(10µF).1 for noise_filtering(10kHz, 60dB);
    c5.2 -> GND;

    // 5V indicator LED
    net led5_path: V5 -> r5_led: Res(330).1 -> r5_led.2 -> led5: LED("green").A for current_limiting(15mA);
    led5.K -> GND;

    // 5V → 3.3V regulation
    net v5_filt: V5 -> reg33: LM1117_33().VI -> reg33.VO -> V3_3 for voltage_regulation(3.3V, 5V);
    reg33.GND -> GND;

    // 3.3V output filter
    V3_3 -> c33: Cap(10µF).1 for noise_filtering(10kHz, 60dB);
    c33.2 -> GND;

    // 3.3V indicator LED
    net led33_path: V3_3 -> r33_led: Res(100).1 -> r33_led.2 -> led33: LED("blue").A for current_limiting(12mA);
    led33.K -> GND;
}
