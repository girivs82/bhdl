// Simple LED circuit
import { Res } from "bhdl-stdlib/passive/resistor.bhdl";
import { LED } from "bhdl-stdlib/optoelectronic/led.bhdl";

board SimpleLED {
    power VCC = 5V @ 100mA;
    ground GND;

    VCC -> r1: Res(330).1; r1.2 -> led1: LED("red").A for current_limiting(15mA);
    led1.K -> GND;
}
