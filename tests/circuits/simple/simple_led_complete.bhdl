// Simple LED circuit
import { Res } from "bhdl-stdlib/simple/resistor_simple.bhdl";
import { LED } from "bhdl-stdlib/simple/led_simple.bhdl";

board SimpleLED {
    power VCC = 5V @ 100mA;
    ground GND;

    net led_drive: VCC -> r1: Res(330).1 -> r1.2 -> led1: LED("red").A for current_limiting(15mA);
    led1.K -> GND;
}
