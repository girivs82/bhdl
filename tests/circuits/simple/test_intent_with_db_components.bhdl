// Intent-driven layout demo using actual database components
// This version uses components from the KiCad database
import { Res } from "bhdl-stdlib/passive/resistor.bhdl";
import { Cap } from "bhdl-stdlib/passive/capacitor.bhdl";
import { LED } from "bhdl-stdlib/optoelectronic/led.bhdl";
import { TVSDiode } from "bhdl-stdlib/protection/tvs.bhdl";
import { LM7805 } from "bhdl-stdlib/power/regulator.bhdl";

board IntentLayoutDemo {
    // LEFT ZONE: Input protection
    tvs: TVSDiode(15V).K for input_protection(15V, 500mA);
    tvs.A -> gnd1: GND();  // Ground symbol

    // CENTER ZONE: Input filtering
    tvs.K -> c1: Cap(100µF).1 for noise_filtering(100Hz, 40dB);
    c1.2 -> gnd2: GND();

    // TOP ZONE: Voltage regulation
    c1.1 -> reg: LM7805().VI for voltage_regulation(5V, 12V);
    reg.GND -> gnd3: GND();

    // CENTER ZONE: Output filtering
    reg.VO -> c2: Cap(10µF).1 for noise_filtering(10kHz, 60dB);
    c2.2 -> gnd4: GND();

    // RIGHT ZONE: LED indicator
    c2.1 -> r1: Res(330).1; r1.2 -> led: LED("green").A for current_limiting(20mA);
    led.K -> gnd5: GND();

    // BOTTOM ZONE: Current sensing
    r1.2 -> sense: Res(0.1).1; sense.2 -> led.A for current_sensing(20mA, 1%);
}
