// Complex Multi-Level Parallel Power Tree
//
// Topology:
//   VIN (24V @ 5A)
//     ├─ TVS protection (15V clamp)
//     ├─ Input filter cap (100µF)
//     │
//     ├── [BUCK] LM2596_5V (24V→5V, virtual pin → L+D+C auto-expansion)
//     │     V5_BUCK rail (2A)
//     │       ├─ Filter cap (10µF)
//     │       ├─ LED indicator (green, 330Ω)
//     │       ├─ Load resistor (10Ω ≈ 500mA)
//     │       └─ [LINEAR] LM1117_33 (5V→3.3V cascade)
//     │             V3_3 rail (300mA)
//     │               ├─ Filter cap (10µF)
//     │               ├─ LED indicator (blue, 150Ω)
//     │               └─ Load resistor (330Ω ≈ 10mA)
//     │
//     └── [LINEAR] LM7805 (24V→5V_AUX, parallel 5V path)
//           V5_AUX rail (500mA)
//             ├─ Filter cap (10µF)
//             ├─ LED indicator (red, 470Ω)
//             └─ [LINEAR] LM1117_18 (5V→1.8V, 3 levels deep)
//                   V1_8 rail (200mA)
//                     ├─ Filter cap (10µF)
//                     ├─ Load resistor (18Ω ≈ 100mA)
//                     └─ LED indicator (yellow, 56Ω)
//
// Exercises: metadata regulator decomposition, multi-level cascade current fixup,
// virtual pin expansion, GLACIER DC with nonlinear elements, physical selection,
// staged power flow ordering

import { Res } from "bhdl-stdlib/simple/resistor_simple.bhdl";
import { Cap } from "bhdl-stdlib/simple/capacitor_simple.bhdl";
import { LED } from "bhdl-stdlib/simple/led_simple.bhdl";
import { TVSDiode } from "bhdl-stdlib/simple/protection_simple.bhdl";
import { LM2596_5V, LM7805, LM1117_33, LM1117_18 } from "bhdl-stdlib/simple/regulator_simple.bhdl";

board ComplexPowerTree {
    power VIN = 24V @ 5A |> input_protection |> input_filtering(max_ripple: 50mV) |> regulation;
    power V5_BUCK = 5V @ 2A |> output_filtering |> loading;
    power V3_3 = 3.3V @ 300mA |> output_filtering |> loading;
    power V5_AUX = 5V @ 500mA |> output_filtering |> loading;
    power V1_8 = 1.8V @ 200mA |> output_filtering |> loading;
    ground GND;

    // === Input Stage ===

    // TVS protection across input (cathode to VIN, anode to GND)
    VIN -> tvs: TVSDiode(15V).K for input_protection(clamp: 15V);
    tvs.A -> GND;

    // Input filter cap is auto-created from |> input_filtering(max_ripple: 50mV) in stage chain
    // (no explicit cap needed — ripple target specified on stage chain)

    // === Branch 1: Buck Converter Path ===

    // Buck: 24V → 5V (virtual pin auto-expands inductor, catch diode, output cap)
    VIN -> buck: LM2596_5V().VIN for regulation();
    buck.VOUT -> V5_BUCK;
    buck.GND -> GND;

    // 5V buck output filter
    V5_BUCK -> c5b: Cap(10µF).1 for output_filtering(max_ripple: 50mV);
    c5b.2 -> GND;

    // 5V buck indicator LED (green)
    V5_BUCK -> r_led5b: Res(330).1 -> r_led5b.2 -> led5b: LED("green").A for loading(purpose: "indicator");
    led5b.K -> GND;

    // 5V buck load (10Ω ≈ 500mA)
    V5_BUCK -> r_load5b: Res(10).1 -> r_load5b.2 -> GND for loading(purpose: "main load");

    // Cascade: 5V → 3.3V
    V5_BUCK -> reg33: LM1117_33().VI for regulation();
    reg33.VO -> V3_3;
    reg33.GND -> GND;

    // 3.3V output filter
    V3_3 -> c33: Cap(10µF).1 for output_filtering();
    c33.2 -> GND;

    // 3.3V indicator LED (blue)
    V3_3 -> r_led33: Res(150).1 -> r_led33.2 -> led33: LED("blue").A for loading(purpose: "indicator");
    led33.K -> GND;

    // 3.3V load (330Ω ≈ 10mA)
    V3_3 -> r_load33: Res(330).1 -> r_load33.2 -> GND for loading(purpose: "load");

    // === Branch 2: Linear Regulator Path ===

    // Linear: 24V → 5V aux
    VIN -> reg5aux: LM7805().VI for regulation();
    reg5aux.VO -> V5_AUX;
    reg5aux.GND -> GND;

    // 5V aux output filter
    V5_AUX -> c5a: Cap(10µF).1 for output_filtering();
    c5a.2 -> GND;

    // 5V aux indicator LED (red)
    V5_AUX -> r_led5a: Res(470).1 -> r_led5a.2 -> led5a: LED("red").A for loading(purpose: "indicator");
    led5a.K -> GND;

    // Cascade: 5V aux → 1.8V (3 levels deep from VIN)
    V5_AUX -> reg18: LM1117_18().VI for regulation();
    reg18.VO -> V1_8;
    reg18.GND -> GND;

    // 1.8V output filter
    V1_8 -> c18: Cap(10µF).1 for output_filtering();
    c18.2 -> GND;

    // 1.8V load (18Ω ≈ 100mA)
    V1_8 -> r_load18: Res(18).1 -> r_load18.2 -> GND for loading(purpose: "main load");

    // 1.8V indicator LED (yellow)
    V1_8 -> r_led18: Res(56).1 -> r_led18.2 -> led18: LED("yellow").A for loading(purpose: "indicator");
    led18.K -> GND;
}
