// Complex Multi-Level Parallel Power Tree
//
// Topology:
//   VIN (24V @ 5A)
//     ├─ TVS protection (15V clamp)
//     ├─ Input filter cap (100µF)
//     │
//     ├── [BUCK] AP63205 (24V→5V, sync buck — no catch diode)
//     │     V5_BUCK rail (2A)
//     │       ├─ Filter cap (10µF)
//     │       ├─ LED indicator (green, 330Ω)
//     │       ├─ Load resistor (10Ω ≈ 500mA)
//     │       └─ [LDO] AP2112K (5V→3.3V cascade)
//     │             V3_3 rail (300mA)
//     │               ├─ Filter cap (10µF)
//     │               ├─ LED indicator (blue, 150Ω)
//     │               └─ Load resistor (330Ω ≈ 10mA)
//     │
//     └── [BUCK] TPS54331 (24V→5V_AUX, adjustable buck)
//           V5_AUX rail (500mA)
//             ├─ Filter cap (10µF)
//             ├─ LED indicator (red, 470Ω)
//             └─ [LDO] XC6206 (5V→1.8V, ultra-low Iq)
//                   V1_8 rail (200mA)
//                     ├─ Filter cap (10µF)
//                     ├─ Load resistor (18Ω ≈ 100mA)
//                     └─ LED indicator (yellow, 56Ω)
//
// Exercises: metadata regulator decomposition, multi-level cascade current fixup,
// expansion block expansion, GLACIER DC with nonlinear elements, physical selection,
// staged power flow ordering

import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
import { Cap } from "bhdl-stdlib/passives/capacitor.bhdl";
import { LED } from "bhdl-stdlib/optoelectronic/led.bhdl";
import { TVSDiode } from "bhdl-stdlib/protection/tvs.bhdl";
import { Buck_AP63205 } from "bhdl-stdlib/power/ap63205.bhdl";
import { TPS54331_5V } from "bhdl-stdlib/power/tps54331.bhdl";
import { AP2112K_3V3 } from "bhdl-stdlib/power/ap2112.bhdl";
import { XC6206P182 } from "bhdl-stdlib/power/xc6206.bhdl";

board ComplexPowerTree {
    power VIN = 24V @ 5A |> input_protection |> input_filtering(max_ripple: 50mV) |> regulation;
    power V5_BUCK = 5V @ 2A |> output_filtering(max_ripple: 50mV) |> loading;
    power V3_3 = 3.3V @ 300mA |> output_filtering |> loading;
    power V5_AUX = 5V @ 500mA |> output_filtering |> loading;
    power V1_8 = 1.8V @ 200mA |> output_filtering |> loading;
    ground GND;

    // === Input Stage ===

    // TVS protection across input (cathode to VIN, anode to GND)
    VIN -> tvs: TVSDiode(15V).K for input_protection(clamp: 15V);
    tvs.A -> GND;

    // Input filter cap is auto-created from |> input_filtering(max_ripple: 50mV) in stage chain
    // (no explicit cap needed — ripple target specified on stage chain)

    // === Branch 1: Synchronous Buck Converter Path ===

    // AP63205: 24V → 5V sync buck (expansion adds L, C_out, C_in, C_bst — no diode)
    VIN -> buck: Buck_AP63205().VIN for regulation();
    buck.VOUT -> V5_BUCK;
    buck.GND -> GND;

    // Output filter cap auto-created from |> output_filtering(max_ripple: 50mV) on V5_BUCK

    // 5V buck indicator LED (green)
    V5_BUCK -> r_led5b: Res(330).1; r_led5b.2 -> led5b: LED("green").A for loading(purpose: "indicator");
    led5b.K -> GND;

    // 5V buck load (10Ω ≈ 500mA)
    V5_BUCK -> r_load5b: Res(10).1; r_load5b.2 -> GND for loading(purpose: "main load");

    // Cascade: 5V → 3.3V via AP2112K LDO (expansion adds C_in + C_out)
    V5_BUCK -> reg33: AP2112K_3V3().VIN for regulation();
    reg33.VOUT -> V3_3;
    reg33.GND -> GND;

    // Output filter cap auto-created from |> output_filtering on V3_3

    // 3.3V indicator LED (blue)
    V3_3 -> r_led33: Res(150).1; r_led33.2 -> led33: LED("blue").A for loading(purpose: "indicator");
    led33.K -> GND;

    // 3.3V load (330Ω ≈ 10mA)
    V3_3 -> r_load33: Res(330).1; r_load33.2 -> GND for loading(purpose: "load");

    // === Branch 2: Adjustable Buck + Ultra-Low-Iq LDO Path ===

    // TPS54331: 24V → 5V aux buck (expansion adds L, D, C_out, R_fb, C_boot)
    VIN -> reg5aux: TPS54331_5V().VIN for regulation();
    reg5aux.VOUT -> V5_AUX;
    reg5aux.GND -> GND;

    // Output filter cap auto-created from |> output_filtering on V5_AUX

    // 5V aux indicator LED (red)
    V5_AUX -> r_led5a: Res(470).1; r_led5a.2 -> led5a: LED("red").A for loading(purpose: "indicator");
    led5a.K -> GND;

    // Cascade: 5V aux → 1.8V via XC6206 LDO (expansion adds C_in + C_out)
    V5_AUX -> reg18: XC6206P182().VIN for regulation();
    reg18.VOUT -> V1_8;
    reg18.GND -> GND;

    // Output filter cap auto-created from |> output_filtering on V1_8

    // 1.8V load (18Ω ≈ 100mA)
    V1_8 -> r_load18: Res(18).1; r_load18.2 -> GND for loading(purpose: "main load");

    // 1.8V indicator LED (yellow)
    V1_8 -> r_led18: Res(56).1; r_led18.2 -> led18: LED("yellow").A for loading(purpose: "indicator");
    led18.K -> GND;
}
