// Test bare CONNECTION_STMT syntax (no net keyword)
import { Res } from "bhdl-stdlib/simple/resistor_simple.bhdl";
import { LED } from "bhdl-stdlib/simple/led_simple.bhdl";

board BareLED {
    power VCC = 5V @ 100mA;
    ground GND;

    // Bare connection - no net keyword
    VCC -> r1: Res(330).1 -> r1.2 -> led1: LED("red").A;
    led1.K -> GND;
}
