// Triple fan-out: regulator output drives 3 parallel LED branches
// Tests: 3-way parallel detection, multiple demoted branches
entity Res(value: resistance) {
    pin 1: signal inout;
    pin 2: signal inout;
}

entity Cap(value: capacitance) {
    pin 1: signal inout;
    pin 2: signal inout;
}

entity LED(color: string) {
    pin A: signal in;
    pin K: signal in;
}

entity LM7805 {
    pin VI: power in;
    pin GND: ground;
    pin VO: power out;
}

board TripleFanOut {
    power VIN = 9V @ 500mA;
    power VOUT = 5V @ 300mA;
    ground GND;

    // Regulation
    VIN -> reg: LM7805().VI -> reg.VO -> VOUT for voltage_regulation(5V, 9V);
    reg.GND -> GND;

    // Output cap
    VOUT -> c_out: Cap(10µF).1;
    c_out.2 -> GND;

    // Branch 1: Red LED
    net red_path: VOUT -> r1: Res(220).1 -> r1.2 -> led_r: LED("red").A for current_limiting(20mA);
    led_r.K -> GND;

    // Branch 2: Green LED
    net green_path: VOUT -> r2: Res(150).1 -> r2.2 -> led_g: LED("green").A for current_limiting(25mA);
    led_g.K -> GND;

    // Branch 3: Blue LED
    net blue_path: VOUT -> r3: Res(100).1 -> r3.2 -> led_b: LED("blue").A for current_limiting(30mA);
    led_b.K -> GND;
}
