// Minimal hierarchical module test

entity SimplePWM {
    pin VCC: power in;
    pin OUT: signal out;
}

entity SimpleRegulator {
    pin VIN: power in;
    pin VOUT: power out;
    
    // Simple module instance
    pwm1: SimplePWM {
        VCC <- VIN;
        OUT -> VOUT;
    }
}

board SimpleBoard {
    power VDD = 5V;
    
    reg1: SimpleRegulator {
        VIN <- VDD;
        VOUT -> rail_out;
    }
}