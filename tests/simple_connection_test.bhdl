// Simple test for BHDL v2.0 connection flow
board SimpleTest {
    power VCC = 5V @ 1A;
    ground GND;
    
    // This should create:
    // 1. A resistor instance (with handle "r1")
    // 2. Connect VCC to resistor pin 1
    // 3. Connect resistor pin 2 to LED anode
    // 4. Connect LED cathode to GND
    VCC -> r1: Res(330Ω).1;
    r1.2 -> led: LED(red).A;
    led.K -> GND;
}