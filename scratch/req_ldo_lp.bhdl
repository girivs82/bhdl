import { LdoStage } from "bhdl-stdlib/power/stages.bhdl";
import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
board LdoProbe {
    power V5 = 5V @ 1A;
    port V3V3: power out = 3.3V @ 200mA;
    ground GND;
    @V5 -> u2: LdoStage(vout=3.3V, i_max=100mA, vin=5V, temp_min=-40degC, temp_max=85degC).VIN;
    u2.GND -> @GND; resolve u2 = Ldo_LP2985; u2.VOUT -> @V3V3;
    @V3V3 -> R_LOAD: Res(16.5Ω, wattage=1W).1; R_LOAD.2 -> @GND;
}
