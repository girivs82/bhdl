import { BuckExtStage } from "bhdl-stdlib/power/stages.bhdl";
import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
board ExtProbe {
    power VIN = 24V @ 10A;
    port V5: power out = 5V @ 8A;
    ground GND;
    @VIN -> u1: BuckExtStage(vout=5V, i_max=60A, vin=24V, phases=3).VIN;
    u1.GND -> @GND;
    resolve u1 = BuckController(hs_fet="BSC0902NS", ls_fet="BSC0902NS", fet_rds_on=2.3mΩ, fet_vds_max=30V, fet_id_max=30A, fet_vgs_th=2.4V, fet_p_rating=42W); u1.VOUT -> @V5;
    @V5 -> R_LOAD: Res(0.625Ω, wattage=50W).1; R_LOAD.2 -> @GND;
}
