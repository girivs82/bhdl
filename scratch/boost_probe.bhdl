import { BuckStage, LdoStage, BuckExtStage, PreregStage, BoostStage } from "bhdl-stdlib/power/stages.bhdl";
// Boost probe: a 12V rail fed from a 5V input — the tree must plan a
// STEP-UP stage (FIXTURE domain data).
entity Loady() {
    pin 1: power in;
    pin 2: ground;
    attribute component_class = "ic";
    domain VDD pins="1" v=12V tol=5% i_nom=0.2A i_max=0.3A
        source="FIXTURE — boost probe";
}
board BoostProbe {
    power VBAT = 5V @ 3A;
    power V12 = 12V;
    ground GND;
    @V12 -> ldy: Loady().1;
    ldy.2 -> @GND;


    // ── BEGIN GENERATED POWER TREE (bhdl powertree --emit — regenerate, never hand-edit) ──
    // option "max-efficiency" — bucks everywhere; noise rails get minimal-headroom intermediates + post-LDOs
    // assumptions are CONSERVATIVE ESTIMATES (stated per stage); the real part swapped in must MEET OR BEAT them

    u_v12: BoostStage(vout=12V, i_max=0.3A, vin=5V);
    @VBAT -> u_v12.VIN;
    u_v12.VOUT -> @V12;
    u_v12.GND -> @GND;
    attribute u_v12.powertree_eff_assumed_pct = "85.0";
    attribute u_v12.powertree_noise_assumed_uvrms = "500";
    attribute u_v12.powertree_rating_required_a = "0.900";
    attribute u_v12.powertree_basis = "estimate: conservative boost band at 0.20A; step-up 2.4:1 penalty 0pt; switch carries the INPUT current 0.72A = I_out·V_out/V_in";
    attribute u_v12.powertree_serves = "ldy.VDD";
    // ── END GENERATED POWER TREE ──
}
