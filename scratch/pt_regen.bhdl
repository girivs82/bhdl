import { LdoStage } from "bhdl-stdlib/power/stages.bhdl";
import { BuckStage, LdoStage, BuckExtStage, PreregStage, BoostStage } from "bhdl-stdlib/power/stages.bhdl";
entity Loady() {
    pin 1: power in;
    pin 2: ground;
    domain VDD pins="1" v=5V i_nom=0.5A i_max=0.8A source="FIXTURE — regen probe";
}
board PtRegen {
    power VIN12 = 12V @ 3A;
    port V5: power out = 5V @ 1A;
    ground GND;
    @V5 -> ld: Loady().1; ld.2 -> @GND;
    port V33: power out = 3.3V @ 100mA;
    @V5 -> u9: LdoStage(vout=3.3V, i_max=100mA, vin=5V).VIN;
    u9.GND -> @GND; u9.VOUT -> @V33;



    // ── BEGIN GENERATED POWER TREE (bhdl powertree --emit — regenerate, never hand-edit) ──
    // option "max-efficiency" — bucks everywhere; noise rails get minimal-headroom intermediates + post-LDOs
    // assumptions are CONSERVATIVE ESTIMATES (stated per stage); the real part swapped in must MEET OR BEAT them

    u_v5: BuckStage(vout=5V, i_max=0.8A, vin=12V);
    @VIN12 -> u_v5.VIN;
    u_v5.VOUT -> @V5;
    u_v5.GND -> @GND;
    attribute u_v5.powertree_eff_assumed_pct = "85.0";
    attribute u_v5.powertree_noise_assumed_uvrms = "500";
    attribute u_v5.powertree_rating_required_a = "1.000";
    attribute u_v5.powertree_basis = "estimate: conservative buck band at 0.50A; ratio 2.4:1 penalty 0pt";
    attribute u_v5.powertree_serves = "ld.VDD";
    // ── END GENERATED POWER TREE ──
}
