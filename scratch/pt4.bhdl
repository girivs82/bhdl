// bhdl-sweep: skip — powertree-harvest fixture, not a layout target.
// FUNCTION-FIRST partial board: parts instantiated and signal-wired,
// rails declared but UNDRIVEN — exactly the state the power tree is
// designed from. `bhdl-cli ... powertree` harvests the loads below;
// ERC028's undriven-rail findings are the same worklist. All domain
// numbers are FIXTURE values standing in for datasheet data.

import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
import { BuckStage, LdoStage, BuckExtStage, PreregStage } from "bhdl-stdlib/power/stages.bhdl";

entity SocCore() {
    pin 1: power in;
    pin 2: signal inout;
    pin 3: ground;
    pin 4: power in;
    attribute component_class = "ic";
    attribute kicad_symbol = "Device:U";
    domain VDD_CORE pins="1" v=1.0V tol=3% i_nom=2A i_max=4A
        source="FIXTURE — stands in for NDA vendor data";
    domain VDD_IO pins="4" v=3.3V tol=5% i_nom=0.4A i_max=0.6A
        source="FIXTURE — stands in for NDA vendor data";
}

// Analog part with a rail NOISE target — the input that drives
// buck-vs-LDO / post-regulation in the tree calculator.
entity PllBlock() {
    pin 1: power in;
    pin 2: ground;
    attribute component_class = "ic";
    attribute kicad_symbol = "Device:U";
    domain VDDA pins="1" v=1.8V tol=2% i_nom=50mA i_max=80mA noise=100uV
        source="FIXTURE — stands in for NDA vendor data";
}

board PowertreeDemo {
    power VIN = 12V @ 3A;
    power V1V0 = 1.0V;
    power V1V8 = 1.8V;
    power V3V3 = 3.3V;
    ground GND;

    @V1V0 -> soc: SocCore().1;
    @V3V3 -> soc.4;
    soc.3 -> @GND;
    @V1V8 -> pll: PllBlock().1;
    pll.2 -> @GND;

    // functional wiring exists — it never waits for the power tree
    soc.2 -> r_pull: Res(10kΩ).1;
    r_pull.2 -> @V1V8;

    // ── BEGIN GENERATED POWER TREE (bhdl powertree --emit — regenerate, never hand-edit) ──
    // option "max-efficiency" — bucks everywhere; noise rails get minimal-headroom intermediates + post-LDOs
    // assumptions are CONSERVATIVE ESTIMATES (stated per stage); the real part swapped in must MEET OR BEAT them

    u_v1v0: BuckStage(vout=1V, i_max=4A, vin=12V);
    @VIN -> u_v1v0.VIN;
    u_v1v0.VOUT -> @V1V0;
    u_v1v0.GND -> @GND;
    attribute u_v1v0.powertree_eff_assumed_pct = "84.0";
    attribute u_v1v0.powertree_noise_assumed_uvrms = "500";
    attribute u_v1v0.powertree_rating_required_a = "5.000";
    attribute u_v1v0.powertree_basis = "estimate: conservative buck band at 2.00A; ratio 12.0:1 penalty 4pt";
    attribute u_v1v0.powertree_serves = "soc.VDD_CORE";

    u_v3v3: BuckStage(vout=3.3V, i_max=0.68A, vin=12V);
    @VIN -> u_v3v3.VIN;
    u_v3v3.VOUT -> @V3V3;
    u_v3v3.GND -> @GND;
    attribute u_v3v3.powertree_eff_assumed_pct = "85.0";
    attribute u_v3v3.powertree_noise_assumed_uvrms = "500";
    attribute u_v3v3.powertree_rating_required_a = "0.850";
    attribute u_v3v3.powertree_basis = "estimate: conservative buck band at 0.45A";
    attribute u_v3v3.powertree_serves = "soc.VDD_IO, V1V8";

    u_v1v8: LdoStage(vout=1.8V, i_max=0.08A, vin=3.3V, noise=30uV);
    @V3V3 -> u_v1v8.VIN;
    u_v1v8.VOUT -> @V1V8;
    u_v1v8.GND -> @GND;
    attribute u_v1v8.powertree_eff_assumed_pct = "54.5";
    attribute u_v1v8.powertree_noise_assumed_uvrms = "30";
    attribute u_v1v8.powertree_rating_required_a = "0.100";
    attribute u_v1v8.powertree_basis = "physics: Vout/Vin";
    attribute u_v1v8.powertree_serves = "pll.VDDA";
    // ── END GENERATED POWER TREE ──
}
