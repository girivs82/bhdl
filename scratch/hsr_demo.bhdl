// bhdl-sweep: skip — safety-engine fixture, not a layout target
// Functional-safety surface fixture (docs/spec/Functional_Safety.md):
// a supervised 5V regulator ENTITY that is its own safety part, a board
// instantiating it twice, and the board-level safety block composing the
// instances. Parses + synthesizes today; `bhdl-cli safety` reports the
// Phase-1 model and gaps. No library goals yet (they come with the
// stdlib safety catalogue) — goals here are inline.

import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
import { Cap } from "bhdl-stdlib/passives/capacitor.bhdl";
import { LM317 } from "bhdl-stdlib/power/lm317.bhdl";
import { TVSDiode } from "bhdl-stdlib/protection/tvs.bhdl";

// Library safety catalogue (Phase 2b): parameterised goals and
// assumptions of use, imported like entities.
import { RailOvervoltage } from "bhdl-stdlib/safety/power_rails.bhdl";
import { ASM_SUPPLY_WITHIN_ABSMAX, ASM_LOAD_REACTS_TO_FLAG } from "bhdl-stdlib/safety/assumptions.bhdl";

// Minimal window supervisor stand-in (the stdlib part lands in Phase 2).
entity VoltageSupervisor(vlo: voltage = 4.5V, vhi: voltage = 5.5V) {
    pin VDD:   power in;
    pin SENSE: signal in;
    pin nOUT:  signal out;     // open-drain, low = out of window
    pin GND:   ground;
    attribute component_class = "supervisor";
    attribute data_source = "class-point: TI TPS3700 (window thresholds)";
    // Exported so the vendor-config validity check (spec §2.7 `config`)
    // can compare the declared configuration against each instance.
    attribute vlo = vlo;
    attribute vhi = vhi;

    // Entity safety DATA (spec §2.7). The numbers below are FIXTURE
    // VALUES for the plumbing test and say so in their source; a real
    // part carries the vendor's FIT report and failure-mode split.
    safety {
        failure_state output_stuck_high fit=8  of 40 source="FIXTURE — illustrative split, not vendor data";
        failure_state output_stuck_low  fit=8  of 40 source="FIXTURE — illustrative split, not vendor data";
        failure_state threshold_drift   fit=24 of 40 source="FIXTURE — illustrative split, not vendor data";
        terminal VDD range 1.8V..6.5V below_min="nOUT undefined";
        // The failure split above is valid for THIS configuration only —
        // a vendor FMEDA tool computes FIT per configuration. Checked
        // against every instance's vlo/vhi attributes.
        config vlo=4.5V vhi=5.5V source="FIXTURE — split valid for the default window config";
        assumption ASM_SUP_VDD "VDD stays within 1.8..6.5V";
    }
}

// ───────────────────────── the design ────────────────────────────────

entity SupervisedReg5V(vout: voltage = 5V) {
    // Composition: virtual pins, the expansion children are the copper
    // (same idiom as the mixer's ChannelStrip). This is what makes the
    // entity a real hierarchy level — every instance elaborates its own
    // reg/mon/r_fb_*, and a part added here belongs to every instance.
    pin VIN:    power in   virtual;
    pin VOUT:   power out  virtual;
    pin GND:    ground     virtual;
    pin nFAULT: signal out virtual;
    attribute component_class = "ic";   // composite: expansion carries parts

    expansion {
        internal adj: net;

        // The LM317 PART (bare silicon): this block authors its own
        // divider and output cap — the two-layer library model's
        // hand-wired use. (Ldo_LM317 is the reviewed block with the
        // divider inside; using it here would double the divider.)
        VIN  -> reg: LM317().VIN;
        reg.VOUT -> VOUT;
        reg.ADJ -> adj;
        VOUT -> r_fb_top: Res(240Ω).1; r_fb_top.2 -> adj;
        adj  -> r_fb_bot: Res(720Ω).1; r_fb_bot.2 -> GND;
        VOUT -> c_out: Cap(10µF).1; c_out.2 -> GND;

        VOUT -> mon: VoltageSupervisor(4.5V, 5.5V).VDD;
        VOUT -> mon.SENSE;
        mon.nOUT -> nFAULT;
        mon.GND -> GND;
        VOUT -> r_pu: Res(10kΩ).1; r_pu.2 -> nFAULT;
    }
}

// ───────────────────────── the safety part ───────────────────────────

safety SupervisedReg5V as dut {
    // Library goal (catalogue form): formals bound to design handles,
    // parameters substituted into the effects.
    SG_OV: RailOvervoltage(vmax=5.5V, level=ASIL_B)
               { RAIL: dut.VOUT; FLAG: dut.nFAULT; }
               (id="SG-REG-001", ftti=10ms, safe_state="nFAULT low; load shall disable");
    goal SG_UV: ASIL_A "Loss of VOUT is signalled" (id="SG-REG-002", ftti=50ms) {
        effect silent_uv = dut.VOUT < 4.5V && dut.nFAULT == 1   severity S2;
    }

    mechanism dut.mon: psm(SG_OV, detects=[overvoltage, silent_ov], dc=0.90,
                           source="TI TPS3700 datasheet §7.3 (threshold accuracy, no self-test)");
    mechanism dut.mon: psm(SG_UV, detects=[silent_uv], dc=0.90, source="TI TPS3700 datasheet §7.3");

    fault short(dut.r_fb_bot.1, dut.r_fb_bot.2) expect SG_OV.overvoltage detected_by dut.mon within 10ms;
    fault open(dut.r_fb_top)                    expect SG_OV.overvoltage detected_by dut.mon within 10ms;
    fault open(dut.r_pu)                        expect SG_UV.silent_uv;
    // (no `fault state(dut.reg, ...)`: the stdlib LM317 declares no vendor
    //  failure states yet — naming one would be a hard error, by design)
    fault state(dut.mon, "output_stuck_high")   expect SG_OV.silent_ov;

    waive dut.c_out qm "output cap: open -> ripple, short -> UV which SG_UV covers";

    // Library assumptions (catalogue form): arguments fill the
    // {placeholders} in the catalogue text.
    assume ASM_SUPPLY_WITHIN_ABSMAX(dut.VIN, 40V);
    assume ASM_LOAD_REACTS_TO_FLAG(dut.nFAULT, within=10ms);
}

// ───────────────────────── a board using it twice ────────────────────

board DualRail {
    power VBAT = 12V @ 3A;
    ground GND;
    power V5_A = 5V @ 1A;
    power V5_B = 5V @ 1A;

    @VBAT -> rail_a: SupervisedReg5V().VIN;  rail_a.VOUT -> @V5_A;  rail_a.GND -> @GND;
    @VBAT -> rail_b: SupervisedReg5V().VIN;  rail_b.VOUT -> @V5_B;  rail_b.GND -> @GND;
    @VBAT -> tvs: TVSDiode(24V).A; tvs.K -> @GND;
    rail_a.nFAULT -> r_flag_a: Res(10kΩ).1; r_flag_a.2 -> @GND;   // stand-in loads for the flags
    rail_b.nFAULT -> r_flag_b: Res(10kΩ).1; r_flag_b.2 -> @GND;
}

safety DualRail as brd {
    // Mission profile (spec §2.8): the environment every handbook FIT
    // equation evaluates against. Board-level, declared once.
    mission { ambient = 55degC; on_hours = 8760; }

    goal SG_SUPPLY: ASIL_B "Neither 5V rail overvolts undetected" (id="SG-SYS-010", ftti=10ms) {
        effect any_ov = brd.V5_A > 5.5V || brd.V5_B > 5.5V   severity S3;
    }
    brd.rail_a.SG_OV refines SG_SUPPLY;
    brd.rail_b.SG_OV refines SG_SUPPLY;

    brd.rail_a.ASM_SUPPLY_WITHIN_ABSMAX satisfied_by brd.tvs;
    brd.rail_b.ASM_SUPPLY_WITHIN_ABSMAX satisfied_by brd.tvs;
    brd.rail_a.ASM_LOAD_REACTS_TO_FLAG  waived "bench fixture: flags drive resistive loads, no consumer to disable";
    brd.rail_b.ASM_LOAD_REACTS_TO_FLAG  waived "bench fixture: flags drive resistive loads, no consumer to disable";
    // The supervisor's own assumption of use (from its entity safety data):
    // its VDD is the supervised rail itself, bounded by SG_OV/SG_UV.
    brd.rail_a.mon.ASM_SUP_VDD waived "VDD = VOUT, bounded by the rail's own goals";
    brd.rail_b.mon.ASM_SUP_VDD waived "VDD = VOUT, bounded by the rail's own goals";
}
