// bhdl-sweep: skip — DFA fixture (spec 2.13), not a layout target.
// The CLASSIC dependent failure: the supervisor divider is powered
// from the very rail it supervises — one supply fault produces the
// hazard AND blinds its detection. A second, independent LDO rail
// exists so the clean variant (test-generated: mon_top moved to
// V33B) shares supply only at the board input. FIXTURE numbers.

import { Ldo_LP2985 } from "bhdl-stdlib/power/lp2985.bhdl";
import { Res } from "bhdl-stdlib/passives/resistor.bhdl";

entity SeoocBox() {
    pin 1: signal inout;
    pin 2: ground;
    attribute component_class = "asic";
    safety {
        seooc lambda=120 spfm=0.92 lfm=0.7 source="FIXTURE vendor FMEDA — attested split";
    }
}

board DfaDemo {
    power VBAT = 5V @ 2A;
    port V33A: power out = 3.3V @ 100mA;
    port V33B: power out = 3.3V @ 100mA;
    ground GND;

    @VBAT -> uA: Ldo_LP2985(v_out=3.3V, i_out_max=100mA, v_in=5V).VIN;
    uA.VOUT -> @V33A; uA.GND -> @GND;
    @VBAT -> uB: Ldo_LP2985(v_out=3.3V, i_out_max=100mA, v_in=5V).VIN;
    uB.VOUT -> @V33B; uB.GND -> @GND;

    @V33A -> r_load: Res(66Ω).1; r_load.2 -> @GND;

    // the supervisor divider — powered from V33A: DEPENDENT (DF-SUPPLY)
    @V33A -> box: SeoocBox().1; box.2 -> @GND;
    @V33A -> mon_top: Res(10kΩ).1; mon_top.2 -> mon_bot: Res(10kΩ).1; mon_bot.2 -> @GND;
}

safety DfaDemo as brd {
    mission { ambient = 40degC; lifetime = 15000h; }
    goal SG: ASIL_B "rail A stays up" (id="SG-DFA-1") {
        effect uv = brd.r_load.1 < 3.0V severity S2;
    }
    mechanism brd.mon_top: psm(SG, detects=[uv], detected_when = brd.mon_top.2 < 1.5V,
                               dc=0.9, source="FIXTURE supervisor");
}
