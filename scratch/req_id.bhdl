import { PreregStage } from "bhdl-stdlib/power/stages.bhdl";
import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
board IdProbe {
    power VIN = 12V @ 10A;
    port V_PROT: power out = 12V @ 8A;
    ground GND;
    @VIN -> fe: PreregStage(vout=12V, i_max=8A, vin=12V, reverse_polarity="true", qual="AEC-Q100").VIN;
    fe.GND -> @GND; fe.VOUT -> @V_PROT;
    resolve fe = IdealDiode_LM74700(fet="BSC0902NS", fet_vds_max=30V, fet_id_max=30A, fet_rds_on=2.3mΩ, fet_vgs_th=2.4V, fet_p_rating=42W);
    @V_PROT -> R_LOAD: Res(1.5Ω, wattage=100W).1; R_LOAD.2 -> @GND;
}
