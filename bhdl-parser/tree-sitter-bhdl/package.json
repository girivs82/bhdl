{
  "name": "tree-sitter-bhdl",
  "version": "0.1.0",
  "description": "Bhdl grammar for tree-sitter",
  "repository": "",
  "license": "MIT",
  "author": {
    "name": "Your Name/Org"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "dependencies": {
    "node-addon-api": "^8.2.1",
    "node-gyp-build": "^4.8.2"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter-cli": "^0.25.3"
  },
  "peerDependencies": {
    "tree-sitter": "^0.21.1"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prebuild": "prebuildify --napi --strip",
    "build": "tree-sitter generate --napi",
    "pretest": "tree-sitter generate",
    "test": "tree-sitter test"
  },
  "tree-sitter": [
    {
      "scope": "source.bhdl",
      "file-types": [
        "bhdl",
        "bhdl"
      ]
    }
  ]
} 