// Simplified LED - v2.0 compatible
//
// `color` is deliberately NOT domain-constrained (`where color in ...`):
// the analyzer maps common colors (red/green/blue/white/yellow/ir) to a
// forward voltage, but the color space is OPEN — orange/amber/UV/RGB LEDs
// are all real, and an unlisted color falls to a sensible 2.0 V default,
// not a mistake. Constraining it would reject valid parts.

entity LED(color: string) {
    pin A: signal in;
    pin K: signal in;

    attribute component_class = "led";
    attribute color = color;
    attribute forward_voltage = 2.0V;
    attribute forward_current = 20mA;
    attribute max_current = 30mA;
    attribute kicad_symbol = "Device:LED";
}
