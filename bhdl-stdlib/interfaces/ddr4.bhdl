// DDR4 SDRAM interface stack (v0.8 hierarchical + parametric +
// constraints). Models a single-rank, x8 byte-laned DDR4 link
// between a memory controller and one or more SDRAM chips.
//
// The stack composes the three v0.8 interface features:
//
//   - DiffPair        — a reusable differential pair (CK, DQS).
//   - DDR4Data        — one x8 data group (8 DQ + DM + DQS pair).
//   - DDR4Ca          — the shared command/address bus (perspectives).
//   - DDR4<byte_lanes>— the controller-side bundle: one CA bus plus
//                       N data lanes, generated by `generate for`.
//
// Protocol-derived electrical rules (impedance class, signal class,
// length match, swizzle freedom) live in `constraints { }` blocks
// on the interfaces themselves — they come from the JEDEC DDR4 spec,
// not from any individual chip, so every chip using the interface
// inherits them. (See Interfaces.md §13.)
//
// Composition note: DDR4Data / DDR4Ca / DiffPair are deliberately
// NON-parametric so they can be used as sub-interface fields inside
// the parametric `DDR4<byte_lanes>` template. (The parametric
// resolver only rewrites use-sites at top level, not inside a
// template body — a non-parametric sub-interface needs no rewrite.)

// A differential pair. Intra-pair skew is a universal property; the
// *impedance* of the pair depends on its role (CK is 100Ω, DQS is
// 80Ω in DDR4), so that's declared by the containing interface at
// the point of use rather than baked into DiffPair.
interface DiffPair {
    signal P: inout;
    signal N: inout;
    constraints {
        P -> N: length_match 2ps;
    }
}

// One x8 data group — the data path for a single SDRAM chip / byte
// lane. DQ and DQS are bidirectional (driven by the controller on
// writes, by the SDRAM on reads), so no perspective split is
// needed. DM (data mask / DBI) is controller-driven.
interface DDR4Data {
    signal DQ0: inout;
    signal DQ1: inout;
    signal DQ2: inout;
    signal DQ3: inout;
    signal DQ4: inout;
    signal DQ5: inout;
    signal DQ6: inout;
    signal DQ7: inout;
    signal DM:  inout;
    interface DiffPair DQS;
    constraints {
        // POD12 single-ended 34Ω, 80Ω differential strobe.
        DQ0, DQ1, DQ2, DQ3, DQ4, DQ5, DQ6, DQ7: single_ended 34ohm, signal_class DATA;
        DM:    single_ended 34ohm, signal_class DM;
        DQS.*: differential 80ohm, signal_class STROBE;
        // Bit swizzle: the strobe latches all data lines together,
        // so the router may permute DQ0..DQ7 + DM within the byte.
        DQ0, DQ1, DQ2, DQ3, DQ4, DQ5, DQ6, DQ7, DM: swizzle_within_byte true;
        // Intra-byte DQ-to-DQS length match (JEDEC: ±?, typ ≤5ps).
        DQ0, DQ1, DQ2, DQ3, DQ4, DQ5, DQ6, DQ7: length_match 5ps within_group;
    }
}

// Command / address / control bus. Fly-by routed and shared across
// all chips on the rank. Controller drives every signal; the SDRAM
// receives. CK is a differential clock (declared as explicit P/N
// signals here rather than a DiffPair sub-interface, because the
// bus uses perspectives and perspective + sub-interface composition
// is kept out of this first stdlib).
interface DDR4Ca {
    perspective controller {
        signal CK_t:    out;
        signal CK_c:    out;
        signal A0:      out;
        signal A1:      out;
        signal A2:      out;
        signal A3:      out;
        signal BA0:     out;
        signal BA1:     out;
        signal BG0:     out;
        signal CS_n:    out;
        signal ACT_n:   out;
        signal CKE:     out;
        signal ODT:     out;
        signal RESET_n: out;
        signal ALERT_n: in;     // SDRAM → controller (CRC/parity error)
    }
    perspective sdram {
        signal CK_t:    in;
        signal CK_c:    in;
        signal A0:      in;
        signal A1:      in;
        signal A2:      in;
        signal A3:      in;
        signal BA0:     in;
        signal BA1:     in;
        signal BG0:     in;
        signal CS_n:    in;
        signal ACT_n:   in;
        signal CKE:     in;
        signal ODT:     in;
        signal RESET_n: in;
        signal ALERT_n: out;
    }
    constraints {
        CK_t, CK_c:  differential 100ohm, signal_class CLOCK, max_freq 1600MHz;
        A0, A1, A2, A3, BA0, BA1, BG0: single_ended 40ohm, signal_class ADDR;
        CS_n, ACT_n, CKE, ODT, RESET_n: single_ended 40ohm, signal_class CMD;
        // CA bus is fly-by routed: the topology hint flows to the router.
        A0, A1, A2, A3, BA0, BA1, BG0, CS_n, ACT_n, CKE, ODT: topology fly_by;
        // CK to address skew budget.
        CK_t -> A0: skew_max 100ps;
    }
}

// Controller-side DDR4 bundle: one CA bus + N x8 data lanes.
// `byte_lanes` defaults to 8 (a 64-bit DDR4 channel). The lanes
// are generated by unrolling — `generate for` is the same primitive
// used for board-level swizzle.
interface DDR4<byte_lanes: int = 8> {
    interface DDR4Ca ca;
    generate for i in 0..<byte_lanes> {
        interface DDR4Data lane<i>;
    }
    constraints {
        // Byte swizzle: byte lanes train independently and may be
        // reordered as whole units by the router.
        lane*: swizzle_across_bytes true;
    }
}
