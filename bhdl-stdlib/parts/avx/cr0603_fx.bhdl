// AVX CR0603-FX series — thick-film 1 % resistors in 0603.
//
// Third vendor option for the `Resistor<*, "1%", "0603">` class.
// Listing multiple equivalent families is the whole point of the
// class abstraction — the plugin picks one per board.

part_family AVX_CR0603_FX : Resistor<R: *, "1%", "0603"> {
    require R in E96(10Ω, 1MΩ);

    attribute manufacturer  = "AVX (KYOCERA AVX)";
    attribute mpn_template  = "CR0603-FX-{e96_code(R)}ELF";
    attribute datasheet     = "https://datasheets.kyocera-avx.com/CR-CRT_GP.pdf";
    attribute tc_ppm        = 100;
    attribute power_w       = 0.1;
}
