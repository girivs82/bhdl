// Yageo RC0603FR series — thick-film 1 % resistors in 0603.
//
// Phase 2 grammar exercise: full-shape `part_family` with a
// class pattern that includes generic-args (`R: *`, `"1%"`,
// `"0603"`), a `require` clause naming an E-series + value
// range, and an `mpn_template` interpolation.
//
// The catalog scan (Phase 4) walks declarations like this to
// build the candidate set for resistor classes. For Phase 2
// the parser just needs to accept the grammar — no downstream
// pass consumes it yet.

part_family Yageo_RC0603FR_07 : Resistor<R: *, "1%", "0603"> {
    require R in E96(1Ω, 10MΩ);

    attribute manufacturer  = "Yageo";
    attribute mpn_template  = "RC0603FR-07{e96_code(R)}L";
    attribute datasheet     = "https://www.yageo.com/datasheets/RC_thick_film.pdf";
    attribute tc_ppm        = 100;
    attribute power_w       = 0.1;
    attribute package       = "0603";
    attribute voltage_rating = 75;
}
