// Vishay CRCW1206 series — thick-film 1% resistors in 1206 (0.25 W).
//
// Higher-power resistor tier above the 0603/0.1 W families (Yageo
// RC0603FR, AVX, Panasonic). Same E96 value grid, but the larger 1206
// package carries 0.25 W and a higher working voltage — so a resistor
// whose dissipation exceeds the 0603 rating (with derating) is selected
// up to this part instead. Gives rating-aware selection a real
// size/power alternative to choose between.

part_family Vishay_CRCW1206 : Resistor<R: *, "1%", "1206"> {
    require R in E96(1Ω, 10MΩ);

    attribute manufacturer   = "Vishay";
    attribute mpn_template   = "CRCW1206{e96_code(R)}FKEA";
    attribute datasheet      = "https://www.vishay.com/docs/20035/dcrcwe3.pdf";
    attribute tc_ppm         = 100;
    attribute package        = "1206";
    attribute power_w        = 0.25;
    attribute voltage_rating = 200;
}
