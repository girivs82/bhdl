    reverse_voltage: 1000V,
    reverse_current: 5μA,
    capacitance: 15pF,
    recovery_time: null  // Standard recovery
};

// Resistor electrical characteristics
type ResistorParams = {
    resistance: resistance,
    tolerance: percentage,
    power_rating: power,
    temp_coefficient: float?,  // ppm/°C
    max_voltage: voltage?,
    impedance: ImpedanceCharacteristics?, // Impedance and power characteristics
};

