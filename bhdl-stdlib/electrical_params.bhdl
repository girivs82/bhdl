// BHDL Standard Library - Electrical Parameters
// This file defines common electrical parameter structures for components

// Standard electrical limits for components
type ElectricalLimits = {
    max_voltage: voltage?,         // Maximum voltage rating
    max_current: current?,         // Maximum current rating  
    max_power: power?,            // Maximum power dissipation
    min_voltage: voltage?,         // Minimum operating voltage
    operating_temp_min: temperature?,  // Minimum operating temperature
    operating_temp_max: temperature?,  // Maximum operating temperature
};

// LED electrical characteristics
type LEDParams = {
    forward_voltage: voltage,      // Typical Vf at nominal current
    forward_current: current,      // Nominal operating current
    max_current: current,          // Absolute maximum current
    max_reverse_voltage: voltage,  // Maximum reverse voltage
    dynamic_resistance: resistance, // Small signal resistance
    wavelength: float?,            // Peak wavelength in nm
    luminous_intensity: float?,    // Brightness in mcd
    viewing_angle: float?,         // Viewing angle in degrees
};

// Standard LED parameters by color
const LED_PARAMS_RED: LEDParams = {
    forward_voltage: 2.0V,
    forward_current: 20mA,
    max_current: 30mA,
    max_reverse_voltage: 5V,
    dynamic_resistance: 10Ω,
    wavelength: 630,
    luminous_intensity: 500,
    viewing_angle: 30
};

const LED_PARAMS_GREEN: LEDParams = {
    forward_voltage: 2.2V,
    forward_current: 20mA,
    max_current: 30mA,
    max_reverse_voltage: 5V,
    dynamic_resistance: 12Ω,
    wavelength: 525,
    luminous_intensity: 300,
    viewing_angle: 30
};

const LED_PARAMS_BLUE: LEDParams = {
    forward_voltage: 3.2V,
    forward_current: 20mA,
    max_current: 30mA,
