};

// Capacitor electrical characteristics
type CapacitorParams = {
    capacitance: capacitance,
    tolerance: percentage,
    voltage_rating: voltage,
    esr: resistance?,           // Equivalent series resistance
    ripple_current: current?,   // Max ripple current
    temp_coefficient: string?,  // NPO, X7R, etc.
    lifetime: time?,           // For electrolytics
    impedance: ImpedanceCharacteristics?, // Impedance and power characteristics
};

// Linear regulator characteristics
type LinearRegulatorParams = {
    output_voltage: voltage,
    output_current: current,
    dropout_voltage: voltage,
    quiescent_current: current,
    line_regulation: percentage,
    load_regulation: percentage,
    ripple_rejection: float,    // dB
    thermal_resistance: float,  // °C/W
    max_junction_temp: temperature,
    impedance: ImpedanceCharacteristics?, // Impedance and power characteristics
};

// Power source characteristics
type PowerSourceParams = {
    nominal_voltage: voltage,
    nominal_current: current,
    max_current: current,
    regulation: percentage?,     // Voltage regulation under load
    ripple: voltage?,           // Peak-to-peak ripple voltage
    impedance: ImpedanceCharacteristics?, // Impedance and power characteristics
};

// Ground characteristics
type GroundParams = {
    reference_voltage: voltage,  // Usually 0V
    impedance: ImpedanceCharacteristics?, // Impedance and power characteristics
};

// Fuse characteristics
type FuseParams = {
    rated_current: current,      // Nominal current rating
    rated_voltage: voltage,      // Maximum voltage rating
    breaking_capacity: current,  // Maximum fault current it can interrupt
    melting_time: time?,        // Time to blow at 200% rated current
    cold_resistance: resistance, // Resistance when not blown
    impedance: ImpedanceCharacteristics?, // Impedance and power characteristics
};

// TVS Diode characteristics
type TVSDiodeParams = {
    standoff_voltage: voltage,   // Maximum continuous voltage (VWM)
    breakdown_voltage: voltage,  // Voltage at which it starts conducting (VBR)
    clamping_voltage: voltage,   // Maximum voltage during surge (VC)
    peak_pulse_current: current, // Maximum surge current (IPP)
    peak_pulse_power: power,     // Maximum surge power
    capacitance: capacitance?,   // Junction capacitance at VWM
    response_time: time?,        // Time to clamp
    impedance: ImpedanceCharacteristics?, // Impedance and power characteristics
};

