    luminous_intensity: 500,
    viewing_angle: 30,
    // SPICE model parameters for sharp turn-on
    saturation_current: 10fA,     // 10 femtoamps - realistic LED Is
    emission_coefficient: 2.0,    // Typical for red LEDs
    thermal_voltage: 26mV,        // kT/q at room temperature
    impedance: {
        dc_resistance: null,  // Non-linear device
        output_impedance: null,
        input_impedance: null,
        can_source_current: false,
        can_sink_current: true,  // LEDs sink current
        max_source_current: null,
        max_sink_current: 30mA,
