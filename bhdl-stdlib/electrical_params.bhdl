// BHDL Standard Library - Electrical Parameters
// This file defines common electrical parameter structures for components

// Standard electrical limits for components
type ElectricalLimits = {
    max_voltage: voltage?,         // Maximum voltage rating
    max_current: current?,         // Maximum current rating  
    max_power: power?,            // Maximum power dissipation
    min_voltage: voltage?,         // Minimum operating voltage
    operating_temp_min: temperature?,  // Minimum operating temperature
    operating_temp_max: temperature?,  // Maximum operating temperature
};

// Power domain and impedance characteristics
type ImpedanceCharacteristics = {
    // Basic impedance properties
    dc_resistance: resistance?,     // DC resistance (for resistive components)
    output_impedance: resistance?,  // Output impedance for active components
    input_impedance: resistance?,   // Input impedance for active components
    
    // Power sourcing/sinking capabilities
    can_source_current: bool,      // Can provide current to other components
    can_sink_current: bool,        // Can accept current from other components
    max_source_current: current?,  // Maximum current it can provide
    max_sink_current: current?,    // Maximum current it can accept
    
    // Power domain propagation
    power_domain_isolation: bool,  // Does it isolate power domains (e.g., transformer)
    voltage_drop: voltage?,        // Voltage drop across component (e.g., diode Vf)
    current_limiting: bool,        // Does it limit current (e.g., fuse, resistor)
    
    // Dynamic properties
    transient_response: time?,     // Response time to load changes
    inrush_current: current?,      // Initial current spike (e.g., capacitors)
};

// LED electrical characteristics
type LEDParams = {
    forward_voltage: voltage,      // Typical Vf at nominal current
    forward_current: current,      // Nominal operating current
    max_current: current,          // Absolute maximum current
    max_reverse_voltage: voltage,  // Maximum reverse voltage
    dynamic_resistance: resistance, // Small signal resistance
    wavelength: float?,            // Peak wavelength in nm
    luminous_intensity: float?,    // Brightness in mcd
    viewing_angle: float?,         // Viewing angle in degrees
    // SPICE model parameters
    saturation_current: current,   // Is - reverse saturation current (typically 1e-14 to 1e-15 A)
    emission_coefficient: float,   // n - ideality factor (1.5-2.0 for LEDs)
    thermal_voltage: voltage,      // Vt - thermal voltage (kT/q ≈ 26mV at room temp)
    impedance: ImpedanceCharacteristics?, // Impedance and power characteristics
};

// Standard LED parameters by color
