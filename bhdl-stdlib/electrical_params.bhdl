    wavelength: 590,
    luminous_intensity: 400,
    viewing_angle: 30
};

const LED_PARAMS_IR: LEDParams = {
    forward_voltage: 1.4V,
    forward_current: 50mA,  // IR LEDs often use higher current
    max_current: 100mA,
    max_reverse_voltage: 5V,
    dynamic_resistance: 5Ω,
    wavelength: 940,
    luminous_intensity: null,  // Not visible
    viewing_angle: 20
};

// Diode electrical characteristics
type DiodeParams = {
    forward_voltage: voltage,      // Vf at nominal current
    forward_current: current,      // Nominal If
    max_forward_current: current,  // Maximum continuous forward current
    peak_forward_current: current, // Maximum peak forward current
    reverse_voltage: voltage,      // Maximum reverse voltage (PIV)
    reverse_current: current,      // Reverse leakage current
    capacitance: capacitance?,     // Junction capacitance
    recovery_time: time?,          // Reverse recovery time
};

// Common diode parameters
const DIODE_1N4148: DiodeParams = {
    forward_voltage: 0.7V,
    forward_current: 150mA,
    max_forward_current: 300mA,
    peak_forward_current: 450mA,
    reverse_voltage: 100V,
    reverse_current: 25nA,
    capacitance: 4pF,
    recovery_time: 4ns
};

const DIODE_1N4007: DiodeParams = {
    forward_voltage: 1.1V,
    forward_current: 1A,
    max_forward_current: 1A,
    peak_forward_current: 30A,  // For 8.3ms
    reverse_voltage: 1000V,
    reverse_current: 5μA,
    capacitance: 15pF,
    recovery_time: null  // Standard recovery
};

// Resistor electrical characteristics
type ResistorParams = {
    resistance: resistance,
    tolerance: percentage,
    power_rating: power,
    temp_coefficient: float?,  // ppm/°C
    max_voltage: voltage?,
};

// Standard resistor power ratings
const RESISTOR_0402_PARAMS: ResistorParams = {
    resistance: 0Ω,  // To be overridden
    tolerance: 5%,
    power_rating: 62.5mW,
    temp_coefficient: 100,
    max_voltage: 50V
};

const RESISTOR_0603_PARAMS: ResistorParams = {
    resistance: 0Ω,  // To be overridden
    tolerance: 5%,
    power_rating: 100mW,
    temp_coefficient: 100,
    max_voltage: 75V
};

const RESISTOR_0805_PARAMS: ResistorParams = {
    resistance: 0Ω,  // To be overridden
    tolerance: 5%,
    power_rating: 125mW,
    temp_coefficient: 100,
    max_voltage: 150V
};

const RESISTOR_1206_PARAMS: ResistorParams = {
    resistance: 0Ω,  // To be overridden
    tolerance: 5%,
    power_rating: 250mW,
    temp_coefficient: 100,
    max_voltage: 200V
};

// Capacitor electrical characteristics
type CapacitorParams = {
    capacitance: capacitance,
    tolerance: percentage,
    voltage_rating: voltage,
    esr: resistance?,           // Equivalent series resistance
    ripple_current: current?,   // Max ripple current
    temp_coefficient: string?,  // NPO, X7R, etc.
    lifetime: time?,           // For electrolytics
};

// Linear regulator characteristics
type LinearRegulatorParams = {
    output_voltage: voltage,
    output_current: current,
    dropout_voltage: voltage,
    quiescent_current: current,
    line_regulation: percentage,
    load_regulation: percentage,
    ripple_rejection: float,    // dB
    thermal_resistance: float,  // °C/W
    max_junction_temp: temperature,
};

// Export all parameter types and constants
export {
    ElectricalLimits,
    LEDParams, LED_PARAMS_RED, LED_PARAMS_GREEN, LED_PARAMS_BLUE, 
    LED_PARAMS_WHITE, LED_PARAMS_YELLOW, LED_PARAMS_IR,
    DiodeParams, DIODE_1N4148, DIODE_1N4007,
    ResistorParams, RESISTOR_0402_PARAMS, RESISTOR_0603_PARAMS,
    RESISTOR_0805_PARAMS, RESISTOR_1206_PARAMS,
    CapacitorParams,
    LinearRegulatorParams
};