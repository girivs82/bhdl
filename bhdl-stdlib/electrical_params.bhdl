// Export all parameter types and constants
// Crystal oscillator parameters
type CrystalParams = {
    frequency: frequency,
    load_capacitance: capacitance,
    series_resistance: resistance,
    frequency_tolerance: percentage,
    temperature_coefficient: float,    // ppm/°C
    aging_rate: float,                // ppm/year
    impedance: ImpedanceCharacteristics,
};

