// Switch parameters
type SwitchParams = {
    contact_current: current,
    contact_voltage: voltage,
    contact_resistance: resistance,
    bounce_time: time,
    mechanical_life: int,          // cycles
    electrical_life: int,          // cycles
    actuate_force: float,          // N
    impedance: ImpedanceCharacteristics,
};

