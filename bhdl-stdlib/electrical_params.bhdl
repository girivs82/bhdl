    pin_count: int,
    current_rating: current,
    voltage_rating: voltage,
    contact_resistance: resistance,
    insulation_resistance: resistance,
    mating_cycles: int,
    operating_temperature: temperature,
    impedance: ImpedanceCharacteristics,
};

