// Basic Components Module
// Provides commonly used components for circuit design

// Re-export commonly used components
import { Cap, Capacitor, ElectrolyticCap } from "./passives/capacitor.bhdl";
import { Res, Resistor } from "./passives/resistor.bhdl";
import { LED } from "./passives/led.bhdl";
import { LM7805 } from "./regulators/lm7805.bhdl";
import { TVSDiode, TVS } from "./passives/tvs_diode.bhdl";
import { Fuse } from "./passives/fuse.bhdl";

// Basic component aliases for short names
alias C = Cap;
alias R = Res;
alias D = LED;
alias U = LM7805;  // Common IC designation

// Export all for convenience
export { 
    Cap, Capacitor, ElectrolyticCap,
    Res, Resistor, 
    LED,
    LM7805,
    TVSDiode, TVS,
    Fuse,
    C, R, D, U
};