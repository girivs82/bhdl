// kicad_passthrough — opaque placeholder for KiCad symbols that
// don't (yet) have a real BHDL stdlib entity.
//
// Phase G of the KiCad-to-BHDL importer pipeline: when the
// importer encounters a lib_id that isn't in
// `kicad-symbol-mapping.toml`, it emits an instance of this
// entity carrying the original KiCad metadata (Value, Footprint,
// reference designator) so the connection structure is preserved.
//
// The `enrich` phase replaces these instances with real entities
// one symbol family at a time:
//
//   1. Identify a recurring passthrough (look at importer warnings).
//   2. Write a real entity in bhdl-stdlib (e.g. `ATmega328P.bhdl`).
//   3. Add a mapping entry in `kicad-symbol-mapping.toml`.
//   4. Re-import — the passthrough disappears, the netlist
//      stays bit-identical (verified by `compare()` in
//      `bhdl-kicad-import::canonical`).
//
// Pins: passthrough deliberately declares no pins. KiCad
// connections reference pins by string number ("1", "2", "RST",
// "VBUS", …) and the importer emits those as raw references at
// the connection site. A late-stage analyzer pass binds those
// references to the entity's pin list when it exists; for
// passthrough they remain dangling — recorded in the netlist but
// flagged for enrichment.
//
// Args:
//   value     — KiCad Value field (e.g. "10k", "ATmega328P-PU").
//   footprint — KiCad Footprint field (e.g. "Resistor_SMD:R_0805").
//   lib_id    — Original lib_id from the schematic (for traceability).

entity kicad_passthrough(
    value:     string = "",
    footprint: string = "",
    lib_id:    string = ""
) {
    // Generic pin set covering the range the KiCad importer
    // emits as numeric pin references (`U4.27`, `J3.5`, etc.).
    // The importer's KiCad-side reads pin NUMBERS from the
    // `.kicad_sch` library symbol; for parts without a real
    // stdlib entity yet, those numbers land here.
    //
    // 64 pins is generous headroom: the Arduino UNO's largest
    // un-enriched part (ATmega328P-PU) has 28 pins; USB-C
    // receptacles have 16. Pins that aren't referenced by any
    // connection get materialised as orphan PinInstances
    // (pi.net = None) and the netlist canonical extractor
    // filters those out, so they don't pollute equivalence
    // checks.
    //
    // When real entities ship for specific parts (Phase G
    // accretion), their mapping registry entries route there
    // instead of here, and the orphan-pin footprint shrinks
    // accordingly.
    pin 1:  signal inout;
    pin 2:  signal inout;
    pin 3:  signal inout;
    pin 4:  signal inout;
    pin 5:  signal inout;
    pin 6:  signal inout;
    pin 7:  signal inout;
    pin 8:  signal inout;
    pin 9:  signal inout;
    pin 10: signal inout;
    pin 11: signal inout;
    pin 12: signal inout;
    pin 13: signal inout;
    pin 14: signal inout;
    pin 15: signal inout;
    pin 16: signal inout;
    pin 17: signal inout;
    pin 18: signal inout;
    pin 19: signal inout;
    pin 20: signal inout;
    pin 21: signal inout;
    pin 22: signal inout;
    pin 23: signal inout;
    pin 24: signal inout;
    pin 25: signal inout;
    pin 26: signal inout;
    pin 27: signal inout;
    pin 28: signal inout;
    pin 29: signal inout;
    pin 30: signal inout;
    pin 31: signal inout;
    pin 32: signal inout;
    pin 33: signal inout;
    pin 34: signal inout;
    pin 35: signal inout;
    pin 36: signal inout;
    pin 37: signal inout;
    pin 38: signal inout;
    pin 39: signal inout;
    pin 40: signal inout;
    pin 41: signal inout;
    pin 42: signal inout;
    pin 43: signal inout;
    pin 44: signal inout;
    pin 45: signal inout;
    pin 46: signal inout;
    pin 47: signal inout;
    pin 48: signal inout;
    pin 49: signal inout;
    pin 50: signal inout;
    pin 51: signal inout;
    pin 52: signal inout;
    pin 53: signal inout;
    pin 54: signal inout;
    pin 55: signal inout;
    pin 56: signal inout;
    pin 57: signal inout;
    pin 58: signal inout;
    pin 59: signal inout;
    pin 60: signal inout;
    pin 61: signal inout;
    pin 62: signal inout;
    pin 63: signal inout;
    pin 64: signal inout;
    // ─── 65..128: extended range for larger ICs ─────────────
    // Arduino Mega 2560's ATMEGA2560 is a 100-pin TQFP; without
    // these higher-numbered pins, `U3.99` / `U3.100` etc. fail
    // to materialise pin_instances and the round-trip diff lists
    // every missing pin.
    pin 65:  signal inout;
    pin 66:  signal inout;
    pin 67:  signal inout;
    pin 68:  signal inout;
    pin 69:  signal inout;
    pin 70:  signal inout;
    pin 71:  signal inout;
    pin 72:  signal inout;
    pin 73:  signal inout;
    pin 74:  signal inout;
    pin 75:  signal inout;
    pin 76:  signal inout;
    pin 77:  signal inout;
    pin 78:  signal inout;
    pin 79:  signal inout;
    pin 80:  signal inout;
    pin 81:  signal inout;
    pin 82:  signal inout;
    pin 83:  signal inout;
    pin 84:  signal inout;
    pin 85:  signal inout;
    pin 86:  signal inout;
    pin 87:  signal inout;
    pin 88:  signal inout;
    pin 89:  signal inout;
    pin 90:  signal inout;
    pin 91:  signal inout;
    pin 92:  signal inout;
    pin 93:  signal inout;
    pin 94:  signal inout;
    pin 95:  signal inout;
    pin 96:  signal inout;
    pin 97:  signal inout;
    pin 98:  signal inout;
    pin 99:  signal inout;
    pin 100: signal inout;
    pin 101: signal inout;
    pin 102: signal inout;
    pin 103: signal inout;
    pin 104: signal inout;
    pin 105: signal inout;
    pin 106: signal inout;
    pin 107: signal inout;
    pin 108: signal inout;
    pin 109: signal inout;
    pin 110: signal inout;
    pin 111: signal inout;
    pin 112: signal inout;
    pin 113: signal inout;
    pin 114: signal inout;
    pin 115: signal inout;
    pin 116: signal inout;
    pin 117: signal inout;
    pin 118: signal inout;
    pin 119: signal inout;
    pin 120: signal inout;
    pin 121: signal inout;
    pin 122: signal inout;
    pin 123: signal inout;
    pin 124: signal inout;
    pin 125: signal inout;
    pin 126: signal inout;
    pin 127: signal inout;
    pin 128: signal inout;
}

// Aliases for entity names the importer's mapping registry
// points at but for which no parser-compatible stdlib entity
// exists yet. Each alias makes `Bead`, `Fuse`, `MOSFET`, etc.
// resolvable as a symbol in the global scope so component
// instances of those types parse and analyze cleanly; they
// behave as opaque passthroughs at the netlist layer. Each
// alias drops away when a real entity ships in stdlib.
// Bead: now a real typed entity in passives/inline_passives.bhdl with
// A/B pins; the mapping registry routes Device:FerriteBead directly.
// Fuse: a canonical current-rated entity in protection/tvs.bhdl; its
// physical part is chosen through the supplier plugins like any other
// component (no KiCad-specific part-number passthrough).
// MOSFET: now has a real entity in actives/mosfet_simple.bhdl
// with proper G/D/S pins. The alias was dropping the pin
// distinction (passthrough's 1..64 → no G/D/S), so
// emitter-applied pin_map translation produced unresolvable
// connections like Q1.G.
alias BJT           = kicad_passthrough;
alias SchottkyDiode = kicad_passthrough;
alias TVSDiode      = kicad_passthrough;
alias TestPoint     = kicad_passthrough;
