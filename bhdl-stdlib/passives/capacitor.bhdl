// Capacitor — v2 canonical passive.
//
// `voltage` is an OPTIONAL second positional param (the voltage rating). A
// bare `Cap(100nF)` keeps the historical 50V default; `Cap(22µF, 25V)` (or
// the `Capacitor` alias, kept for the older generic-style call sites) declares
// the real datasheet rating, which the sign-off voltage margin reads. Making
// the rating caller-supplied rather than hardcoded is the Real-Data-Policy
// improvement that motivated folding the old passives/ generics into here.

entity Cap(value: capacitance, voltage: voltage = 50V) {
    pin 1: signal inout;
    pin 2: signal inout;

    attribute component_class = "capacitor";
    attribute capacitance = value;
    // MLCC class ESR — X7R/X5R 0402-0805 typ 10 mΩ at 1 MHz (Murata
    // GRM18 series characteristic data). The regulator-stability
    // sign-off consumes `esr`; before this it saw NOTHING on
    // ceramic instances.
    attribute esr = 0.01Ω;
    attribute voltage_rating = voltage;
    attribute tolerance = 0.10;
    attribute kicad_symbol = "Device:C";
}

alias Capacitor = Cap;

entity ElectrolyticCap(value: capacitance, voltage: voltage) {
    pin pos: signal inout;
    pin neg: signal inout;

    attribute component_class = "capacitor";
    attribute capacitance = value;
    attribute voltage_rating = voltage;
    attribute tolerance = 0.20;
    attribute polarized = true;
    // General-purpose aluminium class: tan δ 0.10 at 120 Hz for the
    // 100 µF/25 V point (Nichicon VZ datasheet) → ESR ≈ 1.3 Ω; low-ESR
    // series override at the instance.
    attribute esr = 1.3Ω;
    attribute kicad_symbol = "Device:CP";
}
