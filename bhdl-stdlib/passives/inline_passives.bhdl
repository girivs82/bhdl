// Ferrite bead — a 2-pin in-line passive that shares the resistor
// shape but carries its own electrical semantics (lossy inductor for
// HF noise damping), with no inherent polarity. KiCad's
// `Device:FerriteBead` symbol maps to it (in kicad_passthrough) so
// the analyzer can reason about pin connectivity.
//
// The canonical over-current Fuse lives in protection/tvs.bhdl —
// `Fuse(current)`, carrying the real current rating so its physical
// part is chosen through the supplier plugins like any other
// component. There is no KiCad-specific part-number Fuse passthrough.
//
// Grammar discipline: parser-compatible v2.0 subset.

entity Bead(part_no: string = "") {
    pin A: signal inout;     //                                 (pin 1)
    pin B: signal inout;     //                                 (pin 2)

    attribute component_class = "ferrite-bead";
    attribute role            = "hf-noise-damping";
    attribute part_number     = part_no;
}
