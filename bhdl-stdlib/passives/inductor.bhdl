// Inductor — v2 canonical passive.
//
// `rated_current` is an OPTIONAL second positional param (the saturation/RMS
// current rating). 0A is the UNDECLARED sentinel: a bare `Ind(10µH)` makes
// NO rating claim, and the sign-off current margin honestly reads NO DATA
// until either the author declares one (`Ind(4.7µH, 3A)`, or the named
// `rated_current = …` form the sized regulators use) or part selection
// binds a real MPN whose catalog rating takes over. The old 1A default
// was a phantom claim: two 10 µH inductors differ 10× in saturation
// current, and a made-up rating silently blessed saturating bucks.

entity Ind(value: inductance, rated_current: current = 0A) {
    pin 1: signal inout;
    pin 2: signal inout;

    attribute component_class = "inductor";
    attribute inductance = value;
    // INDUCTOR DATA DOCTRINE: unlike resistors and MLCCs, inductors
    // have no meaningful "class typical" — two 10 µH parts differ 20×
    // in DCR and have opposite saturation characters. So:
    //   - dcr ships as an explicitly LABELED class point (IR-drop math
    //     needs something physical early);
    //   - i_sat and srf are DELIBERATELY ABSENT until a real MPN is
    //     bound (part files / chooser write-back supply them) — a
    //     wrong Isat default silently blesses a saturating buck, and
    //     absence beats invention. The stress sign-off grades the
    //     saturation margin only against MPN-bound data.
    attribute dcr         = 0.045Ω;  // class point: SRN6045-100M
    attribute data_source = "class-point: Bourns SRN6045-100M (dcr only)";
    attribute current_rating = rated_current;
    attribute kicad_symbol = "Device:L";
    // Reliability class (spec §2.8): §11.2 fixed coil, class B model.
    // Hot spot needs the winding rise — declare `attribute temp_rise =
    // <°C>;` (from the part's temperature-rise test data), else the
    // FIT stays uncomputed.
    safety {
        handbook class="coil_fixed" per="MILHDBK217F" source="MIL-HDBK-217F §11.2 fixed coil (class B model)";
    }
}

alias Inductor = Ind;
