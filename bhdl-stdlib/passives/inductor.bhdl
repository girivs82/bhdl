// Inductor — v2 canonical passive.
//
// `rated_current` is an OPTIONAL second positional param (the saturation/RMS
// current rating). A bare `Ind(10µH)` keeps a 1A default; `Ind(4.7µH, 3A)`
// (or the `Inductor` alias, kept for the older generic-style call sites), or
// the named `Ind(l_value, rated_current = …)` form the sized regulators use,
// declares the real rating, which the sign-off current margin reads.

entity Ind(value: inductance, rated_current: current = 1A) {
    pin 1: signal inout;
    pin 2: signal inout;

    attribute component_class = "inductor";
    attribute inductance = value;
    attribute current_rating = rated_current;
    attribute kicad_symbol = "Device:L";
}

alias Inductor = Ind;
