// Simplified Capacitor Component Module
// Compatible with current BHDL parser

entity Capacitor(value: capacitance, voltage: voltage = 50V) {
    pin 1: signal inout;  // Terminal 1 
    pin 2: signal inout;  // Terminal 2
    
    // Component attributes
    attribute component_class = "capacitor";
    attribute capacitance = value;
    attribute voltage_rating = voltage;
    
    // Determine capacitor type based on value
    attribute capacitor_type = value >= 10uF ? "electrolytic" : "ceramic";
    
    // ESR approximation (simplified without sqrt)
    attribute esr = value >= 10uF ? 0.5 : 0.01;
    
    // SPICE model parameters
    attribute spice_model = "capacitor";
    attribute spice_capacitance = value;
    attribute spice_voltage_rating = voltage;
}