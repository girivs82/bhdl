// Simplified Capacitor — v0.2 generic form.
//
// Four part-defining axes: capacitance, voltage rating, dielectric
// (X7R/X5R/C0G/Y5V/electrolytic/tantalum), package. Every distinct
// generic tuple monomorphises to a distinct class.
//
// Use sites pass the value at the type level:
//
//     C1: Capacitor<100nF>;                          // defaults
//     C2: Capacitor<10µF, 25V>;                      // override V_MAX
//     C3: Capacitor<22µF, 25V, "X7R", "0805">;       // all four
//
// Parser-compatible v2.0 subset.

entity Capacitor<C: capacitance, V_MAX: voltage = 50V, DIEL: string = "X7R", PKG: string = "0603">() {
    pin 1: signal inout;
    pin 2: signal inout;

    attribute component_class = "capacitor";
    attribute capacitance     = C;
    attribute voltage_rating  = V_MAX;
    attribute dielectric      = DIEL;
    attribute pkg             = PKG;
}
