// Simplified Diode - v2.0 compatible

// Generic small-signal defaults = the 1N4148 (the industry generic):
// Is/N from Vishay's published 1N4148 SPICE model (Is = 2.52 nA,
// N = 1.752), Cj0 4 pF, trr 4 ns, 300 mA / 100 V ratings — all from
// the Vishay 1N4148 datasheet (doc 81857). Rectifier instances (M7 /
// 1N4007 class) override vf and ratings at the call site as they
// already do; the junction defaults still beat the previous state of
// NO junction data at all.
entity Diode(vf: voltage = 0.7V) {
    // Passive two-terminal conduction path — NOT a driven pin pair. `in`/
    // `out` here made ERC001 read a catch diode's cathode on a switch node
    // as a contending push-pull driver, and ERC006 read a floating anode
    // as a floating CMOS input.
    pin A: signal inout;
    pin K: signal inout;

    attribute component_class = "diode";
    attribute forward_voltage = vf;
    attribute spice_is        = 2.52e-9;  // saturation current (A)
    attribute spice_n         = 1.752;    // ideality factor
    attribute c_junction_pf   = 4.0;      // Cj0 at 0 V
    attribute t_rr_ns         = 4.0;      // reverse recovery
    attribute i_f_max         = 300mA;    // continuous forward
    attribute v_r_max         = 100V;     // repetitive reverse
    attribute data_source     = "class-point: 1N4148 (Vishay 81857)";
    attribute kicad_symbol = "Device:D";
}

// Schottky is NOT a silicon junction — aliasing it to Diode silently
// inherited 1N4148 parameters (Is 2.5nA, n 1.75) that are orders of
// magnitude wrong for a Schottky barrier. Own entity, own class
// point: the 1N5819 (the ubiquitous small Schottky, Vishay
// datasheet + published SPICE model: Is 31.7µA, n 1.373, no reverse
// recovery, Vf 0.32V at 100mA).
entity SchottkyDiode(vf: voltage = 0.32V) {
    pin A: signal inout;
    pin K: signal inout;

    attribute component_class = "diode";
    attribute forward_voltage = vf;
    attribute spice_is        = 3.17e-5;
    attribute spice_n         = 1.373;
    attribute c_junction_pf   = 110.0;  // Schottky barriers are FAT
    attribute i_f_max         = 1A;
    attribute v_r_max         = 40V;
    attribute data_source     = "class-point: 1N5819 (Vishay)";
    attribute kicad_symbol = "Device:D_Schottky";
}
