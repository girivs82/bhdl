// Simplified Inductor — v0.2 generic form.
//
// Three part-defining axes: inductance, current rating, package.
// Every distinct generic tuple monomorphises to a distinct class.
//
// Use sites pass the value at the type level:
//
//     L1: Inductor<10µH>;                  // defaults I_MAX=1A, PKG="0805"
//     L2: Inductor<33µH, 3A>;              // override current
//     L3: Inductor<100µH, 2A, "1210">;     // all three
//
// Parser-compatible v2.0 subset.

entity Inductor<L: inductance, I_MAX: current = 1A, PKG: string = "0805">() {
    pin 1: signal inout;
    pin 2: signal inout;

    attribute component_class = "inductor";
    attribute inductance      = L;
    attribute current_rating  = I_MAX;
    attribute pkg             = PKG;
}
