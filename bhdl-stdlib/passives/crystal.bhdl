// Crystals and crystal resonators.
//
// Three variants matching KiCad's `Device:Crystal*` family:
//   - Crystal         : 2-terminal piezoelectric resonator
//   - Crystal_GND2    : 3-terminal (terminal + case-ground on pin 2)
//   - Crystal_GND24   : 4-terminal SMD package (pins 1+3 are the
//                       quartz terminals, pins 2+4 are case ground)
//
// Used on every Arduino board as the MCU clock source
// (typically 16 MHz). The mapping registry binds the KiCad
// lib_ids to these entities by pin number.
//
// Grammar discipline: parser-compatible v2.0 subset.

entity Crystal(part_no: string = "", freq_mhz: float = 16.0) {
    pin A: signal inout;     //                                 (pin 1)
    pin B: signal inout;     //                                 (pin 2)

    attribute component_class = "crystal";
    attribute terminals       = 2;
    attribute part_number     = part_no;
    // Electrical identity — AT-cut fundamental, HC-49/SMD & 3225-class
    // typicals (ECS ECS-160-18-4X, NDK NX3225GA, Abracon ABM8G
    // datasheets). ESR is the MAX spec (oscillator margin math wants
    // the worst case); load capacitance is the 18 pF class shipped on
    // the Uno-style MCU boards this library grew up with. Instances
    // override for other cuts/loads.
    attribute frequency_mhz   = freq_mhz;
    attribute c_load_pf       = 18.0;   // specified load capacitance
    attribute c_shunt_pf      = 5.0;    // C0 shunt (max 7 pF on ABM8G)
    attribute esr             = 80Ω;    // max, HC-49/SMD 16 MHz class
    attribute drive_level_max_mw = 0.1; // 100 µW class drive limit
}

entity Crystal_GND2(part_no: string = "", freq_mhz: float = 16.0) {
    pin A:    signal inout;  // terminal 1                      (pin 1)
    pin GND2: signal inout;  // case ground                     (pin 2)
    pin B:    signal inout;  // terminal 2                      (pin 3)

    attribute component_class = "crystal";
    attribute terminals       = 3;
    attribute part_number     = part_no;
    // Same electrical identity as Crystal (see above); ceramic
    // RESONATORS bound to these shells (CSTCE16M0V53) carry their
    // built-in load caps — instances override c_load_pf to 0 there.
    attribute frequency_mhz   = freq_mhz;
    attribute c_load_pf       = 18.0;
    attribute c_shunt_pf      = 5.0;
    attribute esr             = 80Ω;
    attribute drive_level_max_mw = 0.1;
}

entity Crystal_GND24(part_no: string = "", freq_mhz: float = 16.0) {
    pin A:    signal inout;  // terminal 1                      (pin 1)
    pin GND2: signal inout;  // case ground (lower-left pad)    (pin 2)
    pin B:    signal inout;  // terminal 2                      (pin 3)
    pin GND4: signal inout;  // case ground (upper-right pad)   (pin 4)

    attribute component_class = "crystal";
    attribute terminals       = 4;
    attribute part_number     = part_no;
    // Same electrical identity as Crystal (see above); ceramic
    // RESONATORS bound to these shells (CSTCE16M0V53) carry their
    // built-in load caps — instances override c_load_pf to 0 there.
    attribute frequency_mhz   = freq_mhz;
    attribute c_load_pf       = 18.0;
    attribute c_shunt_pf      = 5.0;
    attribute esr             = 80Ω;
    attribute drive_level_max_mw = 0.1;
}
