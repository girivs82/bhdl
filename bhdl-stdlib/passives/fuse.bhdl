// Fuse Component Module
// Overcurrent protection device

import { ImpedanceCharacteristics } from "../types/electrical_types.bhdl";

// Fuse characteristics
type FuseParams = {
    rated_current: current,      // Nominal current rating
    rated_voltage: voltage,      // Maximum voltage rating
    breaking_capacity: current,  // Maximum fault current it can interrupt
    melting_time: time?,        // Time to blow at 200% rated current
    cold_resistance: resistance, // Resistance when not blown
    impedance: ImpedanceCharacteristics,
};

module Fuse(current: current, voltage: voltage = 250V) {
    pin 1: signal inout;  // Terminal 1
    pin 2: signal inout;  // Terminal 2
    
    // Fuse parameters - resistance scales inversely with current rating
    const params: FuseParams = {
        rated_current: current,
        rated_voltage: voltage,
        breaking_capacity: 35A,  // Typical for small fuses
        melting_time: 5s,
        cold_resistance: 0.1Ω * (1A / current),  // Resistance scales inversely with current rating
        impedance: {
            dc_resistance: 0.1Ω * (1A / current),
            output_impedance: null,
            input_impedance: null,
            can_source_current: false,
            can_sink_current: false,
            max_source_current: null,
            max_sink_current: null,
            power_domain_isolation: false,  // Fuses propagate power domains
            voltage_drop: null,  // I*R drop, depends on current
            current_limiting: true,  // Opens circuit on overcurrent
            transient_response: null,
            inrush_current: null
        }
    };
    
    // Electrical specifications
    attribute current_rating = params.rated_current;
    attribute voltage_rating = params.rated_voltage;
    attribute breaking_capacity = params.breaking_capacity;
    attribute response_time = "fast";  // fast, slow, medium
    attribute cold_resistance = params.cold_resistance;
    attribute melting_time = params.melting_time;
    
    // Impedance characteristics - important for power domain propagation
    attribute dc_resistance = params.impedance.dc_resistance;
    attribute current_limiting = params.impedance.current_limiting;
    attribute power_domain_isolation = params.impedance.power_domain_isolation;
    
    // Component metadata
    attribute component_class = "fuse";
    attribute protection_type = "overcurrent";
    
    // SPICE model parameters
    attribute spice_model = "fuse";
    attribute spice_resistance = params.cold_resistance;
    attribute spice_current_rating = params.rated_current;
    
    // KiCad symbol mapping
    attribute kicad_symbol = "Device:Fuse";
    
    // Available packages based on current rating
    attribute packages = 
        current <= 3A ? "5x20mm,SMD_1206,SMD_1812" :
        current <= 10A ? "5x20mm,6.3x32mm" :
        "6.3x32mm,10x38mm";
    attribute default_package = current <= 3A ? "5x20mm" : "6.3x32mm";
    
    // Safety ratings
    attribute safety_standard = "IEC 60127";
    attribute has_indicator = false;
    attribute replaceable = true;
}

// Common aliases
alias F = Fuse;