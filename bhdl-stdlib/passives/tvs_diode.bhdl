// TVS (Transient Voltage Suppressor) Diode Module
// Provides overvoltage protection from transients and spikes

module TVSDiode(voltage: voltage) {
    pin 1: signal inout;  // Terminal 1 (bidirectional)
    pin 2: signal inout;  // Terminal 2 (bidirectional)
    
    // Electrical specifications
    attribute standoff_voltage = voltage;  // Normal operating voltage
    attribute breakdown_voltage = voltage * 1.1;  // Voltage at which it starts conducting
    attribute clamping_voltage = voltage * 1.4;   // Maximum voltage during surge
    attribute peak_power = "600W";  // Standard for DO-214AA (SMC) package
    attribute response_time = "< 1ns";
    
    // Component metadata
    attribute component_class = "tvs_diode";
    attribute protection_type = "bidirectional";  // bidirectional or unidirectional
    attribute diode_type = "transient_suppressor";
    
    // KiCad symbol mapping
    attribute kicad_symbol = "Device:D_TVS";
    
    // Available packages
    attribute packages = "DO-214AA,DO-214AB,DO-214AC,DO-15,DO-201";
    attribute default_package = "DO-214AA";  // SMC package
    
    // Compliance and ratings
    attribute iec_standard = "IEC 61000-4-2";
    attribute esd_rating = "15kV";
    attribute surge_rating = "8/20µs";
}

// Common aliases
module TVS = TVSDiode;
module TransientSuppressor = TVSDiode;