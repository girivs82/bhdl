// Light Emitting Diode Component Module
// Supports LED(red), LED(green, 3mm) style instantiation

import { ImpedanceCharacteristics } from "../types/electrical_types.bhdl";

// LED-specific electrical characteristics type
type LEDParams = {
    forward_voltage: voltage,      // Typical Vf at nominal current
    forward_current: current,      // Nominal operating current
    max_current: current,          // Absolute maximum current
    max_reverse_voltage: voltage,  // Maximum reverse voltage
    dynamic_resistance: resistance, // Small signal resistance
    wavelength: float?,            // Peak wavelength in nm
    luminous_intensity: float?,    // Brightness in mcd
    viewing_angle: float?,         // Viewing angle in degrees
    impedance: ImpedanceCharacteristics, // Impedance and power characteristics
};

module LED(color: string = "red", size: string = "5mm") {
    pin A: signal in @metadata(
        function="Anode",
        description="Positive terminal (Anode)",
        electrical_type="passive"
    );   // Anode (+)
    pin K: signal out @metadata(
        function="Cathode",
        description="Negative terminal (Cathode)",
        electrical_type="passive"
    );  // Cathode (-)
    
    // LED parameters by color - kept local to this module
    const LED_PARAMS_RED: LEDParams = {
        forward_voltage: 2.0V,
        forward_current: 20mA,
        max_current: 30mA,
        max_reverse_voltage: 5V,
        dynamic_resistance: 10Ω,
        wavelength: 630,
        luminous_intensity: 500,
        viewing_angle: 30,
        impedance: {
            dc_resistance: null,  // Non-linear device
            output_impedance: null,
            input_impedance: null,
            can_source_current: false,
            can_sink_current: true,  // LEDs sink current
            max_source_current: null,
            max_sink_current: 30mA,
            power_domain_isolation: false,
            voltage_drop: 2.0V,  // Forward voltage drop
            current_limiting: false,  // Does not limit current
            transient_response: 100ns,
            inrush_current: null
        }
    };
    
    const LED_PARAMS_GREEN: LEDParams = {
        forward_voltage: 2.2V,
        forward_current: 20mA,
        max_current: 30mA,
        max_reverse_voltage: 5V,
        dynamic_resistance: 12Ω,
        wavelength: 525,
        luminous_intensity: 300,
        viewing_angle: 30,
        impedance: {
            dc_resistance: null,
            output_impedance: null,
            input_impedance: null,
            can_source_current: false,
            can_sink_current: true,
            max_source_current: null,
            max_sink_current: 30mA,
            power_domain_isolation: false,
            voltage_drop: 2.2V,
            current_limiting: false,
            transient_response: 100ns,
            inrush_current: null
        }
    };
    
    const LED_PARAMS_BLUE: LEDParams = {
        forward_voltage: 3.2V,
        forward_current: 20mA,
        max_current: 30mA,
        max_reverse_voltage: 5V,
        dynamic_resistance: 15Ω,
        wavelength: 470,
        luminous_intensity: 200,
        viewing_angle: 30,
        impedance: {
            dc_resistance: null,
            output_impedance: null,
            input_impedance: null,
            can_source_current: false,
            can_sink_current: true,
            max_source_current: null,
            max_sink_current: 30mA,
            power_domain_isolation: false,
            voltage_drop: 3.2V,
            current_limiting: false,
            transient_response: 100ns,
            inrush_current: null
        }
    };
    
    const LED_PARAMS_WHITE: LEDParams = {
        forward_voltage: 3.3V,
        forward_current: 20mA,
        max_current: 30mA,
        max_reverse_voltage: 5V,
        dynamic_resistance: 16Ω,
        wavelength: null,  // White LEDs don't have single wavelength
        luminous_intensity: 1000,
        viewing_angle: 120,
        impedance: {
            dc_resistance: null,
            output_impedance: null,
            input_impedance: null,
            can_source_current: false,
            can_sink_current: true,
            max_source_current: null,
            max_sink_current: 30mA,
            power_domain_isolation: false,
            voltage_drop: 3.3V,
            current_limiting: false,
            transient_response: 100ns,
            inrush_current: null
        }
    };
    
    const LED_PARAMS_YELLOW: LEDParams = {
        forward_voltage: 2.1V,
        forward_current: 20mA,
        max_current: 30mA,
        max_reverse_voltage: 5V,
        dynamic_resistance: 11Ω,
        wavelength: 590,
        luminous_intensity: 400,
        viewing_angle: 30,
        impedance: {
            dc_resistance: null,
            output_impedance: null,
            input_impedance: null,
            can_source_current: false,
            can_sink_current: true,
            max_source_current: null,
            max_sink_current: 30mA,
            power_domain_isolation: false,
            voltage_drop: 2.1V,
            current_limiting: false,
            transient_response: 100ns,
            inrush_current: null
        }
    };
    
    const LED_PARAMS_IR: LEDParams = {
        forward_voltage: 1.4V,
        forward_current: 50mA,  // IR LEDs often use higher current
        max_current: 100mA,
        max_reverse_voltage: 5V,
        dynamic_resistance: 5Ω,
        wavelength: 940,
        luminous_intensity: null,  // Not visible
        viewing_angle: 20,
        impedance: {
            dc_resistance: null,
            output_impedance: null,
            input_impedance: null,
            can_source_current: false,
            can_sink_current: true,
            max_source_current: null,
            max_sink_current: 100mA,
            power_domain_isolation: false,
            voltage_drop: 1.4V,
            current_limiting: false,
            transient_response: 100ns,
            inrush_current: null
        }
    };
    
    // Get electrical parameters based on color
    const params: LEDParams = 
        color == "red" ? LED_PARAMS_RED :
        color == "yellow" ? LED_PARAMS_YELLOW :
        color == "green" ? LED_PARAMS_GREEN :
        color == "blue" ? LED_PARAMS_BLUE :
        color == "white" ? LED_PARAMS_WHITE :
        color == "ir" ? LED_PARAMS_IR :
        LED_PARAMS_RED;  // Default to red
    
    // Metadata for component database
    attribute component_class = "led";
    attribute color = color;
    attribute size = size;
    
    // Electrical characteristics from parameter structure
    attribute forward_voltage = params.forward_voltage;
    attribute forward_current = params.forward_current;
    attribute max_current = params.max_current;
    attribute max_reverse_voltage = params.max_reverse_voltage;
    attribute dynamic_resistance = params.dynamic_resistance;
    attribute wavelength = params.wavelength;
    attribute luminous_intensity = params.luminous_intensity;
    attribute viewing_angle = params.viewing_angle;
    
    // Impedance characteristics
    attribute can_sink_current = params.impedance.can_sink_current;
    attribute max_sink_current = params.impedance.max_sink_current;
    attribute voltage_drop = params.impedance.voltage_drop;
    attribute transient_response = params.impedance.transient_response;
    attribute power_domain_isolation = params.impedance.power_domain_isolation;
    attribute current_limiting = params.impedance.current_limiting;
    
    // SPICE model parameters (LED as special diode)
    attribute spice_model = "diode";
    attribute spice_type = "led";
    attribute spice_is = params.forward_current / exp(params.forward_voltage / (2.0 * 0.026));  // Shockley equation
    attribute spice_n = 2.0;  // Emission coefficient for LEDs
    attribute spice_rs = params.dynamic_resistance;
    attribute spice_cjo = 10e-12;  // Junction capacitance
    attribute spice_vj = params.forward_voltage;
    attribute spice_tt = params.impedance.transient_response;
    attribute spice_bv = params.max_reverse_voltage;
    attribute spice_ibv = 10e-6;  // Breakdown current
    attribute spice_tnom = 27;  // Nominal temperature
    
    // KiCad symbol mapping
    attribute kicad_symbol = "Device:LED";
    
    // Package based on size
    attribute package = 
        size == "3mm" ? "LED_THT:LED_D3.0mm" :
        size == "5mm" ? "LED_THT:LED_D5.0mm" :
        size == "0603" ? "LED_SMD:LED_0603_1608Metric" :
        size == "0805" ? "LED_SMD:LED_0805_2012Metric" :
        size == "1206" ? "LED_SMD:LED_1206_3216Metric" :
        size == "smd" ? "LED_SMD:LED_0805_2012Metric" :
        "LED_THT:LED_D5.0mm";
}