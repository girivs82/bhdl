// Resistor — v2 canonical passive.
//
// `tolerance` is an OPTIONAL second positional param. A bare `Res(10kΩ)` keeps
// the historical 5% default; `Res(22kΩ, 1%)` (or the `Resistor` alias, kept
// for the older generic-style call sites) declares a tighter grade, which the
// part-selection grade gate reads.

entity Res(value: resistance, tolerance: percentage = 5%) {
    pin 1: signal inout;
    pin 2: signal inout;

    attribute component_class = "resistor";
    attribute resistance = value;
    attribute tolerance = tolerance;
    attribute power_rating = 0.25W;
    attribute kicad_symbol = "Device:R";
}

alias Resistor = Res;
