// Resistor — v2 canonical passive.
//
// `tolerance` is an OPTIONAL second positional param. A bare `Res(10kΩ)` keeps
// the historical 5% default; `Res(22kΩ, 1%)` (or the `Resistor` alias, kept
// for the older generic-style call sites) declares a tighter grade, which the
// part-selection grade gate reads.
//
// `wattage` is the power rating (third optional param); a bare `Res(10kΩ)`
// keeps the 0.25 W chip-resistor default, `Res(2.5Ω, wattage=10W)` declares a
// power resistor. It feeds `power_rating`, which part selection reads against
// the resistor's dissipation — so the "10 W" now reaches the part instead of
// being silently swallowed as an unknown argument.

entity Res(value: resistance, tolerance: percentage = 5%, wattage: power = 0.25W) {
    pin 1: signal inout;
    pin 2: signal inout;

    attribute component_class = "resistor";
    attribute resistance = value;
    attribute tolerance = tolerance;
    attribute power_rating = wattage;
    attribute kicad_symbol = "Device:R";

    // Reliability class (docs/spec/Functional_Safety.md §2.8): the FIT
    // is COMPUTED per instance from the named standard's equations, the
    // board's mission profile and the sim-derived power stress ratio.
    // Default standard = MIL-HDBK-217F (public domain — the shipped
    // bhdl-stdlib/safety/milhdbk217f.toml carries the REAL §9.2
    // constants, verified against the handbook's printed λ_b tables).
    // Swap the standard per project by overriding `per=` or by editing
    // your gitignored <std>.local.toml overlay.
    safety {
        handbook class="res_fixed_film" per="MILHDBK217F" source="MIL-HDBK-217F §9.2 fixed film (RL/RLR model)";
    }
}

alias Resistor = Res;
