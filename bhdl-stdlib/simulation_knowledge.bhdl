// Example of how to use thermal data in junction temperature calculation
// Tj = Ta + (Pd × θJA)  -- simple model
// Tj = Tc + (Pd × θJC)  -- when case temp is known
// Tj = Tb + (Pd × ΨJB)  -- when board temp is measured

// Function to calculate junction temperature
function calculate_junction_temp(
    power_dissipation: power,
    ambient_temp: temperature,
    thermal_model: ThermalModel,
    mounting: string              // "free_air", "heatsink", "pcb_mounted"
): temperature {
    
    // Select appropriate thermal resistance based on mounting
    const theta = switch mounting {
        "free_air" => thermal_model.theta_ja,
        "heatsink" => thermal_model.theta_jc,  // Assumes perfect heatsink
        "pcb_mounted" => {
            // Account for PCB thermal vias if present
            const via_contribution = thermal_model.package_thermal_data?.thermal_vias_required ?
                (thermal_model.package_thermal_data.via_thermal_resistance / 
                 thermal_model.package_thermal_data.thermal_vias_required) : 0;
            
            // Use theta_jb if available, otherwise theta_ja with via improvement
            thermal_model.theta_jb ?? (thermal_model.theta_ja - via_contribution)
        },
        _ => thermal_model.theta_ja  // Default to worst case
    };
    
    return ambient_temp + (power_dissipation * theta);
}

// Export enhanced components with simulation knowledge
export {
    SimulationFeedback, OperatingPointConstraints, NonlinearModel, ThermalModel,
    FrequencyResponseModel, NoiseModel, DynamicModel, StressDerating, SelectionConstraints,
