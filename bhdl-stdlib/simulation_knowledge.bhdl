// BHDL Standard Library - Simulation Knowledge Integration
// This file defines how components provide knowledge back to simulation engines
// Enables bidirectional information flow between components and simulators

import { ElectricalLimits, ImpedanceCharacteristics, LEDParams, ResistorParams, CapacitorParams } from "electrical_params.bhdl";

// Simulation feedback interface - what each component reports to simulators
type SimulationFeedback = {
    // DC analysis feedback
    operating_point_constraints: OperatingPointConstraints?,
    nonlinear_model: NonlinearModel?,
    thermal_model: ThermalModel?,
    
    // AC analysis feedback  
    frequency_response: FrequencyResponseModel?,
    noise_model: NoiseModel?,
    
    // Transient analysis feedback
    dynamic_model: DynamicModel?,
    
    // Component stress feedback for safety analysis
    stress_derating: StressDerating?,
    
    // Component selection feedback for synthesis
    selection_constraints: SelectionConstraints?
};

// Operating point constraints that components enforce during DC analysis
type OperatingPointConstraints = {
    // Voltage constraints
    min_node_voltage: voltage?,      // Minimum voltage this component requires
    max_node_voltage: voltage?,      // Maximum voltage this component can handle
    voltage_drop_model: string?,     // "linear", "diode", "zener", "constant"
    
    // Current constraints
    min_current: current?,           // Minimum current to operate (e.g., LED threshold)
    max_current: current?,           // Maximum current before damage
    current_limiting: bool,          // Does this component limit current flow
    
    // Power constraints
    max_power_dissipation: power?,   // Thermal limit
    efficiency: percentage?,         // For power conversion components
    
    // Convergence hints for SPICE solver
    convergence_aid: ConvergenceAid?
};

// Nonlinear component modeling for SPICE integration
type NonlinearModel = {
    model_type: string,              // "diode", "bjt", "mosfet", "linear", "ideal"
    
    // Diode/LED model parameters (Shockley equation)
    saturation_current: current?,    // Is - reverse saturation current
    emission_coefficient: float?,    // n - ideality factor
    series_resistance: resistance?,  // Rs - series resistance
    parallel_resistance: resistance?, // Rp - parallel resistance
    
    // Linear model parameters
    small_signal_resistance: resistance?, // For small signal analysis
    transconductance: float?,        // gm for active components
    
    // Nonlinear equation form for DC solver
    equation_form: string?           // "exponential", "piecewise", "lookup_table"
};

// Thermal modeling for temperature-dependent behavior
type ThermalModel = {
    // Thermal resistance parameters (critical for ICs)
    theta_ja: float?,                // θJA: Junction-to-Ambient (°C/W) - still air
    theta_jc: float?,                // θJC: Junction-to-Case (°C/W) - top of package
    theta_jb: float?,                // θJB: Junction-to-Board (°C/W) - through PCB
    psi_jt: float?,                  // ΨJT: Junction-to-Top characterization parameter
    psi_jb: float?,                  // ΨJB: Junction-to-Board characterization parameter
    
    // Legacy single value (for simple components)
    thermal_resistance: float?,      // °C/W - junction to ambient (legacy/simple)
    
    // Temperature limits
    max_junction_temp: temperature?, // Maximum safe junction temperature (Tj max)
    max_case_temp: temperature?,     // Maximum case temperature
    storage_temp_range: (temperature, temperature)?, // Storage temperature range
    
    // Package-specific thermal data
    package_thermal_data: PackageThermalData?,
    
    // Temperature coefficients
    temp_coefficient: float?,        // Change per °C (ppm/°C for resistors)
    
    // Self-heating calculations
    self_heating_enabled: bool,      // Does power dissipation affect temperature
    thermal_time_constant: time?,    // Time to reach thermal equilibrium
    thermal_capacitance: float?,     // Thermal capacitance for transient analysis
    
    // Operating temperature effects
    parameter_temp_models: TempParameterModels?
};

// Package-specific thermal characteristics
type PackageThermalData = {
    package_type: string,            // "QFN", "SOIC", "BGA", "TO220", etc.
    exposed_pad: bool,               // Has exposed thermal pad
    exposed_pad_area: float?,        // mm² - for thermal calculations
    
    // Multi-die packages
    die_count: int?,                 // Number of dies in package
    die_thermal_coupling: float?,    // Thermal coupling between dies
    
    // Board mounting considerations
    recommended_pcb_copper: float?,  // Recommended copper area (mm²)
    thermal_vias_required: int?,     // Number of thermal vias recommended
    via_thermal_resistance: float?   // Additional thermal resistance per via
};

type TempParameterModels = {
    resistance_temp_coeff: float?,   // For resistors: ppm/°C
    forward_voltage_temp_coeff: float?, // For diodes/LEDs: mV/°C  
    capacitance_temp_coeff: string?  // For caps: "NPO", "X7R", etc.
};

// Frequency response modeling for AC analysis
type FrequencyResponseModel = {
    // Basic frequency limits
    bandwidth: frequency?,           // -3dB bandwidth
    unity_gain_frequency: frequency?, // For active components
    
    // Parasitic elements
    parasitic_capacitance: capacitance?, // Junction/stray capacitance
    parasitic_inductance: inductance?,   // Lead/bond wire inductance
    
    // ESR modeling for capacitors
    esr_frequency_model: ESRFrequencyModel?
};

type ESRFrequencyModel = {
    esr_at_1khz: resistance,        // ESR at 1kHz reference
    esr_frequency_slope: float?,     // How ESR changes with frequency
    self_resonant_freq: frequency?   // Frequency where cap becomes inductive
};

// Noise modeling for noise analysis
type NoiseModel = {
    thermal_noise: bool,            // Johnson noise from resistance
    shot_noise: bool,               // Shot noise from current flow
    flicker_noise: bool,            // 1/f noise for active components
    noise_figure: float?            // Noise figure in dB for amplifiers
};

// Dynamic modeling for transient analysis
type DynamicModel = {
    // Energy storage elements
    energy_storage_type: string?,   // "capacitive", "inductive", "none"
    energy_storage_value: float?,   // C or L value for energy calculation
    
    // Switching behavior
    switching_time: time?,          // For digital components
    propagation_delay: time?,       // Signal propagation time
    
    // Inrush current modeling
    inrush_current_model: InrushCurrentModel?
};

type InrushCurrentModel = {
    peak_inrush_current: current,   // Maximum inrush current
    inrush_duration: time,          // Duration of inrush event
    charging_time_constant: time?   // RC/LC time constant
};

// Stress derating information for safety analysis
type StressDerating = {
    // Voltage derating
    voltage_derating_factor: percentage, // How much to derate voltage (e.g., 80%)
    voltage_derating_reason: string?,    // "peak_reverse", "breakdown", "corona"
    
    // Current derating
    current_derating_factor: percentage, // How much to derate current (e.g., 70%)
    current_derating_reason: string?,    // "thermal", "electromigration", "fusing"
    
    // Power derating
    power_derating_factor: percentage,   // How much to derate power (e.g., 50%)
    power_derating_reason: string?,      // "thermal", "junction_temp", "package"
    
    // Temperature derating
    temp_derating_curve: TempDeratingCurve?
};

type TempDeratingCurve = {
    reference_temp: temperature,     // Temperature at 100% rating (usually 25°C)
    max_temp: temperature,           // Temperature at 0% rating
    derating_type: string           // "linear", "exponential", "step"
};

// Component selection constraints for synthesis
type SelectionConstraints = {
    // Package constraints
    preferred_packages: [string]?,   // ["0805", "1206"] for SMD preference
    excluded_packages: [string]?,    // Packages to avoid
    
    // Tolerance constraints  
    required_tolerance: percentage?, // Minimum required tolerance
    preferred_tolerance: percentage?, // Preferred tolerance for cost optimization
    
    // Environmental constraints
    operating_temp_range: (temperature, temperature)?, // (min, max) operating range
    storage_temp_range: (temperature, temperature)?,   // (min, max) storage range
    humidity_rating: percentage?,    // Maximum humidity tolerance
    
    // Reliability constraints
    mtbf_requirement: time?,         // Mean time between failures
    quality_grade: string?,          // "consumer", "industrial", "military", "space"
    
    // Cost optimization hints
    cost_sensitivity: string?,       // "low_cost", "balanced", "premium"
    volume_sensitivity: bool         // Does price depend significantly on volume
};

// Convergence aid for difficult-to-solve circuits
type ConvergenceAid = {
    // Initial guess hints
    initial_voltage_guess: voltage?, // Good starting voltage for iteration
    initial_current_guess: current?, // Good starting current for iteration
    
    // Solver hints
    use_gmin_stepping: bool,        // Use conductance stepping for convergence
    use_source_stepping: bool,      // Use source stepping for convergence
    critical_convergence: bool,     // This component is critical for convergence
    
    // Linearization hints
    linearization_point: voltage?,  // Good point to linearize around
    max_iteration_step: float?      // Maximum change per Newton-Raphson step
};

