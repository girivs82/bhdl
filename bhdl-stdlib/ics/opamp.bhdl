// Operational Amplifier Component Module
// Generic op-amp with common parameters

import { ImpedanceCharacteristics } from "../types/electrical_types.bhdl";

// Op-amp electrical parameters
type OpAmpParams = {
    input_bias_current: current,       // Input bias current
    input_offset_voltage: voltage,     // Input offset voltage
    input_offset_current: current,     // Input offset current
    open_loop_gain: float,             // Open loop gain (V/V)
    gain_bandwidth_product: frequency, // GBW product
    slew_rate: float,                  // Slew rate (V/µs)
    input_impedance: resistance,       // Input impedance
    output_impedance: resistance,      // Output impedance
    supply_current: current,           // Supply current per amplifier
    cmrr: float,                       // Common-mode rejection ratio (dB)
    psrr: float,                       // Power supply rejection ratio (dB)
    impedance: ImpedanceCharacteristics,
};

entity OpAmp(type: string = "LM358", package: string = "DIP-8") {
    // Standard op-amp pinout
    pin V+: power in @metadata(
        function="PowerPositive",
        description="Positive supply voltage",
        electrical_type="power_input",
        voltage_range="3V-32V"
    );
    pin V-: power in @metadata(
        function="PowerNegative", 
        description="Negative supply voltage",
        electrical_type="power_input",
        voltage_range="-32V-0V"
    );
    pin IN+: signal in @metadata(
        function="NonInvertingInput",
        description="Non-inverting input",
        electrical_type="high_impedance_input"
    );
    pin IN-: signal in @metadata(
        function="InvertingInput",
        description="Inverting input", 
        electrical_type="high_impedance_input"
    );
    pin OUT: signal out @metadata(
        function="Output",
        description="Amplifier output",
        electrical_type="active_output"
    );
    
    // LM358 parameters (common dual op-amp)
    const LM358_PARAMS: OpAmpParams = {
        input_bias_current: 45nA,
        input_offset_voltage: 2mV,
        input_offset_current: 5nA,
        open_loop_gain: 100000,  // 100dB
        gain_bandwidth_product: 1MHz,
        slew_rate: 0.6,  // V/µs
        input_impedance: 1e12,  // Very high
        output_impedance: 20,   // 20Ω typical
        supply_current: 0.7mA,  // Per amplifier
        cmrr: 85,  // dB
        psrr: 100, // dB
        impedance: {
            dc_resistance: null,
            output_impedance: 20,
            input_impedance: 1e12,
            can_source_current: true,
            can_sink_current: true,
            max_source_current: 20mA,  // Typical output current
            max_sink_current: 10mA,
            power_domain_isolation: false,
            voltage_drop: null,
            current_limiting: false,
            transient_response: 1.6µs,  // Typical settling time
            inrush_current: null
        }
    };
    
    const params = LM358_PARAMS;  // Default to LM358
    
    // Electrical specifications
    attribute input_bias_current = params.input_bias_current;
    attribute input_offset_voltage = params.input_offset_voltage;
    attribute open_loop_gain = params.open_loop_gain;
    attribute gain_bandwidth_product = params.gain_bandwidth_product;
    attribute slew_rate = params.slew_rate;
    attribute supply_current = params.supply_current;
    attribute cmrr = params.cmrr;
    attribute psrr = params.psrr;
    
    // Component metadata
    attribute component_class = "operational_amplifier";
    attribute ic_type = type;
    attribute amplifier_count = package == "DIP-8" ? 2 : 1;
    
    // Impedance characteristics
    attribute input_impedance = params.impedance.input_impedance;
    attribute output_impedance = params.impedance.output_impedance;
    attribute can_source_current = params.impedance.can_source_current;
    attribute max_source_current = params.impedance.max_source_current;
    attribute can_sink_current = params.impedance.can_sink_current;
    attribute max_sink_current = params.impedance.max_sink_current;
    attribute transient_response = params.impedance.transient_response;
    
    // KiCad symbol mapping
    attribute kicad_symbol = 
        type == "LM358" ? "Amplifier_Operational:LM358" :
        type == "LM324" ? "Amplifier_Operational:LM324" :
        type == "TL072" ? "Amplifier_Operational:TL072" :
        type == "LM741" ? "Amplifier_Operational:LM741" :
        "Amplifier_Operational:LM358";
        
    // Package options
    attribute packages = "DIP-8,SOIC-8,MSOP-8,TSSOP-8";
    attribute default_package = package;
    
    // SPICE model parameters
    attribute spice_model = "opamp";
    attribute spice_gain = params.open_loop_gain;
    attribute spice_gbw = params.gain_bandwidth_product;
    attribute spice_slew_rate = params.slew_rate;
    attribute spice_rin = params.input_impedance;
    attribute spice_rout = params.output_impedance;
    attribute spice_vos = params.input_offset_voltage;
    attribute spice_ios = params.input_offset_current;
}

// Common op-amp aliases
alias LM358 = OpAmp;
alias LM324 = OpAmp;
alias TL072 = OpAmp;
alias LM741 = OpAmp;

// Generic aliases
alias Amplifier = OpAmp;
alias Amp = OpAmp;