// Voltage Regulator IC Module
// Supports fixed and adjustable voltage regulators with SPICE parameters

import { ImpedanceCharacteristics } from "../types/electrical_types.bhdl";

// Voltage regulator parameters including SPICE model
type VoltageRegulatorParams = {
    // Basic characteristics
    type: string,                      // "fixed" or "adjustable"
    vout_nominal: voltage,             // Nominal output voltage (fixed types)
    vout_min: voltage?,                // Minimum output voltage (adjustable)
    vout_max: voltage?,                // Maximum output voltage (adjustable)
    vref: voltage?,                    // Reference voltage (adjustable)
    vin_min: voltage,                  // Minimum input voltage
    vin_max: voltage,                  // Maximum input voltage
    dropout: voltage,                  // Dropout voltage
    iout_max: current,                 // Maximum output current
    iq: current,                       // Quiescent current
    
    // Regulation parameters
    load_regulation: percentage,       // Output change vs load
    line_regulation: percentage,       // Output change vs input
    ripple_rejection: float,          // PSRR in dB
    
    // SPICE behavioral parameters
    rout: resistance,                  // Output resistance
    ignd_ratio: float,                 // Ground current as ratio of Iout
    tc: float,                        // Temperature coefficient (V/°C)
    iadj: current?,                    // Adjustment pin current (LM317)
    iload_min: current?,               // Minimum load current
    vnoise: float,                    // Output noise (µV RMS)
    
    // Thermal parameters
    tj_max: temperature,              // Maximum junction temperature
    rth_ja: float,                    // Thermal resistance junction-ambient
    power_max: power,                 // Maximum power dissipation
    
    // Protection features
    current_limit: boolean,           // Has current limiting
    thermal_shutdown: boolean,        // Has thermal protection
    reverse_protection: boolean,      // Has reverse voltage protection
    
    impedance: ImpedanceCharacteristics,
};

// 78xx series fixed voltage regulator
entity VReg78xx(voltage: voltage = 5V, package: string = "TO-220") {
    pin IN: power in;
    pin OUT: power out;
    pin GND: ground;
    
    // Common parameters for 78xx series
    const VREG_7805: VoltageRegulatorParams = {
        type: "fixed",
        vout_nominal: 5V,
        vout_min: null,
        vout_max: null,
        vref: null,
        vin_min: 7V,
        vin_max: 25V,
        dropout: 2V,
        iout_max: 1A,
        iq: 5mA,
        load_regulation: 0.5%,        // 0.5% typical
        line_regulation: 0.01%,       // 0.01% typical
        ripple_rejection: 73,         // 73 dB typical
        rout: 0.017,                  // 17 mΩ
        ignd_ratio: 0.01,             // Ignd ≈ Iq + Iout/100
        tc: -1e-3,                    // -1 mV/°C
        iadj: null,
        iload_min: null,
        vnoise: 40,                   // 40 µV RMS
        tj_max: 125°C,
        rth_ja: 65,                   // °C/W for TO-220
        power_max: 15W,               // With heatsink
        current_limit: true,
        thermal_shutdown: true,
        reverse_protection: false,
        impedance: {
            dc_resistance: 0.017,
            output_impedance: 0.017,
            input_impedance: 1e6,
            can_source_current: true,
            can_sink_current: false,
            max_source_current: 1A,
            max_sink_current: null,
            power_domain_isolation: false,
            voltage_drop: 2V,
            current_limiting: true,
            transient_response: 10µs,
            inrush_current: null
        }
    };
    
    const VREG_7812: VoltageRegulatorParams = {
        type: "fixed",
        vout_nominal: 12V,
        vout_min: null,
        vout_max: null,
        vref: null,
        vin_min: 14.5V,
        vin_max: 30V,
        dropout: 2V,
        iout_max: 1A,
        iq: 5mA,
        load_regulation: 0.5%,
        line_regulation: 0.01%,
        ripple_rejection: 71,
        rout: 0.018,
        ignd_ratio: 0.01,
        tc: -1e-3,
        iadj: null,
        iload_min: null,
        vnoise: 75,
        tj_max: 125°C,
        rth_ja: 65,
        power_max: 15W,
        current_limit: true,
        thermal_shutdown: true,
        reverse_protection: false,
        impedance: {
            dc_resistance: 0.018,
            output_impedance: 0.018,
            input_impedance: 1e6,
            can_source_current: true,
            can_sink_current: false,
            max_source_current: 1A,
            max_sink_current: null,
            power_domain_isolation: false,
            voltage_drop: 2V,
            current_limiting: true,
            transient_response: 10µs,
            inrush_current: null
        }
    };
    
    const VREG_7809: VoltageRegulatorParams = {
        type: "fixed",
        vout_nominal: 9V,
        vout_min: null,
        vout_max: null,
        vref: null,
        vin_min: 11.5V,
        vin_max: 25V,
        dropout: 2V,
        iout_max: 1A,
        iq: 5mA,
        load_regulation: 0.5%,
        line_regulation: 0.01%,
        ripple_rejection: 72,
        rout: 0.017,
        ignd_ratio: 0.01,
        tc: -1e-3,
        iadj: null,
        iload_min: null,
        vnoise: 60,
        tj_max: 125°C,
        rth_ja: 65,
        power_max: 15W,
        current_limit: true,
        thermal_shutdown: true,
        reverse_protection: false,
        impedance: {
            dc_resistance: 0.017,
            output_impedance: 0.017,
            input_impedance: 1e6,
            can_source_current: true,
            can_sink_current: false,
            max_source_current: 1A,
            max_sink_current: null,
            power_domain_isolation: false,
            voltage_drop: 2V,
            current_limiting: true,
            transient_response: 10µs,
            inrush_current: null
        }
    };
    
    // Select parameters based on voltage
    const params: VoltageRegulatorParams = 
        voltage == 5V ? VREG_7805 :
        voltage == 9V ? VREG_7809 :
        voltage == 12V ? VREG_7812 :
        VREG_7805;  // Default to 7805
    
    // Component metadata
    attribute component_class = "voltage_regulator";
    attribute regulator_type = "fixed";
    attribute part_number = voltage == 5V ? "7805" : 
                          voltage == 9V ? "7809" :
                          voltage == 12V ? "7812" : "78xx";
    
    // Safety parameters for analysis
    attribute vout_nominal = params.vout_nominal;
    attribute dropout = params.dropout;
    attribute vin_max = params.vin_max;
    attribute iout_max = params.iout_max;
    attribute iq = params.iq;
    attribute power_max = params.power_max;
    attribute tj_max = params.tj_max;
    attribute rth_ja = params.rth_ja;
    
    // Already defined above in safety parameters
    
    // SPICE model parameters - all parameters provided explicitly
    attribute spice_model = "voltage_regulator";
    attribute spice_type = params.type;
    attribute spice_vout_nom = params.vout_nominal;
    attribute spice_vout_min = params.vout_min;
    attribute spice_vout_max = params.vout_max;
    attribute spice_vref = params.vref;
    attribute spice_dropout = params.dropout;
    attribute spice_iout_max = params.iout_max;
    attribute spice_iq = params.iq;
    attribute spice_load_reg = params.load_regulation;
    attribute spice_line_reg = params.line_regulation;
    attribute spice_rout = params.rout;
    attribute spice_ignd_ratio = params.ignd_ratio;
    attribute spice_tc = params.tc;
    attribute spice_iadj = params.iadj;
    attribute spice_iload_min = params.iload_min;
    attribute spice_psrr = params.ripple_rejection;
    attribute spice_vnoise = params.vnoise;
    attribute spice_rth = params.rth_ja;
    attribute spice_tj_max = params.tj_max;
    attribute spice_tnom = 27;
    
    // KiCad symbol
    attribute kicad_symbol = "Regulator_Linear:L7805";
    
    // Package selection
    attribute package = 
        package == "TO-220" ? "Package_TO_SOT_THT:TO-220-3_Vertical" :
        package == "TO-92" ? "Package_TO_SOT_THT:TO-92_Inline" :
        package == "DPAK" ? "Package_TO_SOT_SMD:TO-252-3_TabPin2" :
        package == "SOT-223" ? "Package_TO_SOT_SMD:SOT-223-3_TabPin2" :
        "Package_TO_SOT_THT:TO-220-3_Vertical";
}

// LM317 adjustable voltage regulator
entity LM317(package: string = "TO-220") {
    pin IN: power in;
    pin OUT: power out;
    pin ADJ: signal inout;
    
    const LM317_PARAMS: VoltageRegulatorParams = {
        type: "adjustable",
        vout_nominal: 1.25V,          // Vref
        vout_min: 1.25V,
        vout_max: 37V,
        vref: 1.25V,
        vin_min: 3V,                  // Vout + dropout
        vin_max: 40V,
        dropout: 3V,                  // Higher than 78xx
        iout_max: 1.5A,
        iq: 5mA,
        load_regulation: 0.1%,        // Better than 78xx
        line_regulation: 0.002%,      // Excellent
        ripple_rejection: 80,         // 80 dB
        rout: 0.028,
        ignd_ratio: 0.01,
        tc: -0.7e-3,                  // -0.7 mV/°C
        iadj: 50µA,                   // Adjustment pin current
        iload_min: 10mA,              // Minimum load
        vnoise: 0.003,                // 0.003% of Vout
        tj_max: 125°C,
        rth_ja: 65,
        power_max: 20W,
        current_limit: true,
        thermal_shutdown: true,
        reverse_protection: false,
        impedance: {
            dc_resistance: 0.028,
            output_impedance: 0.028,
            input_impedance: 1e6,
            can_source_current: true,
            can_sink_current: false,
            max_source_current: 1.5A,
            max_sink_current: null,
            power_domain_isolation: false,
            voltage_drop: 3V,
            current_limiting: true,
            transient_response: 25µs,
            inrush_current: null
        }
    };
    
    // Component metadata
    attribute component_class = "voltage_regulator";
    attribute regulator_type = "adjustable";
    attribute part_number = "LM317";
    
    // Electrical characteristics
    attribute vref = LM317_PARAMS.vref;
    attribute vout_min = LM317_PARAMS.vout_min;
    attribute vout_max = LM317_PARAMS.vout_max;
    attribute vin_max = LM317_PARAMS.vin_max;
    attribute dropout = LM317_PARAMS.dropout;
    attribute iout_max = LM317_PARAMS.iout_max;
    attribute iadj = LM317_PARAMS.iadj;
    
    // SPICE model parameters - all parameters provided explicitly
    attribute spice_model = "voltage_regulator";
    attribute spice_type = "adjustable";
    attribute spice_vref = LM317_PARAMS.vref;
    attribute spice_vout_min = LM317_PARAMS.vout_min;
    attribute spice_vout_max = LM317_PARAMS.vout_max;
    attribute spice_dropout = LM317_PARAMS.dropout;
    attribute spice_iout_max = LM317_PARAMS.iout_max;
    attribute spice_iq = LM317_PARAMS.iq;
    attribute spice_iadj = LM317_PARAMS.iadj;
    attribute spice_iload_min = LM317_PARAMS.iload_min;
    attribute spice_load_reg = LM317_PARAMS.load_regulation;
    attribute spice_line_reg = LM317_PARAMS.line_regulation;
    attribute spice_rout = LM317_PARAMS.rout;
    attribute spice_psrr = LM317_PARAMS.ripple_rejection;
    attribute spice_tc = LM317_PARAMS.tc;
    attribute spice_tnom = 27;
    
    // KiCad symbol
    attribute kicad_symbol = "Regulator_Linear:LM317_TO-220";
    
    // Package selection
    attribute package = 
        package == "TO-220" ? "Package_TO_SOT_THT:TO-220-3_Vertical" :
        package == "TO-92" ? "Package_TO_SOT_THT:TO-92_Inline" :
        package == "TO-263" ? "Package_TO_SOT_SMD:TO-263-3_TabPin2" :
        package == "SOT-223" ? "Package_TO_SOT_SMD:SOT-223-3_TabPin2" :
        "Package_TO_SOT_THT:TO-220-3_Vertical";
}

// Low dropout regulator
entity LDO(voltage: voltage = 3.3V, current: current = 800mA, package: string = "SOT-223") {
    pin IN: power in;
    pin OUT: power out;
    pin GND: ground;
    
    const LDO_PARAMS: VoltageRegulatorParams = {
        type: "fixed",
        vout_nominal: voltage,
        vout_min: null,
        vout_max: null,
        vref: null,
        vin_min: voltage + 1.2V,      // Low dropout
        vin_max: 15V,
        dropout: 1.2V,                // Much lower than standard
        iout_max: current,
        iq: 5mA,
        load_regulation: 0.2%,
        line_regulation: 0.05%,
        ripple_rejection: 75,
        rout: 0.2,                    // Higher than standard regs
        ignd_ratio: 0.01,
        tc: -0.5e-3,
        iadj: null,
        iload_min: null,
        vnoise: 30,
        tj_max: 125°C,
        rth_ja: 50,                   // Better thermal for SMD
        power_max: 2W,                // Limited by package
        current_limit: true,
        thermal_shutdown: true,
        reverse_protection: true,      // Many LDOs have this
        impedance: {
            dc_resistance: 0.2,
            output_impedance: 0.2,
            input_impedance: 1e6,
            can_source_current: true,
            can_sink_current: false,
            max_source_current: current,
            max_sink_current: null,
            power_domain_isolation: false,
            voltage_drop: 1.2V,
            current_limiting: true,
            transient_response: 50µs,
            inrush_current: null
        }
    };
    
    attribute component_class = "voltage_regulator";
    attribute regulator_type = "ldo";
    attribute part_number = voltage == 3.3V ? "LM1117-3.3" :
                          voltage == 5V ? "LM1117-5.0" :
                          voltage == 2.5V ? "LM1117-2.5" : "LM1117";
    
    // SPICE parameters - all parameters provided explicitly
    attribute spice_model = "voltage_regulator";
    attribute spice_type = "fixed";
    attribute spice_vout_nom = voltage;
    attribute spice_dropout = LDO_PARAMS.dropout;
    attribute spice_iout_max = current;
    attribute spice_iq = LDO_PARAMS.iq;
    attribute spice_rout = LDO_PARAMS.rout;
    attribute spice_psrr = LDO_PARAMS.ripple_rejection;
    
    attribute kicad_symbol = "Regulator_Linear:LM1117-3.3";
    attribute package = 
        package == "SOT-223" ? "Package_TO_SOT_SMD:SOT-223-3_TabPin2" :
        package == "TO-252" ? "Package_TO_SOT_SMD:TO-252-3_TabPin2" :
        package == "SOT-89" ? "Package_TO_SOT_SMD:SOT-89-3" :
        "Package_TO_SOT_SMD:SOT-223-3_TabPin2";
}

// Aliases for common parts
alias 7805 = VReg78xx(5V);
alias 7809 = VReg78xx(9V);
alias 7812 = VReg78xx(12V);
alias LM1117_3V3 = LDO(3.3V, 800mA);
alias LM1117_5V0 = LDO(5V, 800mA);