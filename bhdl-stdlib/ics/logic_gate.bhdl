// Digital Logic Gate Module
// Demonstrates different logic family pin characteristics and drive capabilities

import { ImpedanceCharacteristics } from "../types/electrical_types.bhdl";

// Logic family drive characteristics
type LogicDriveType = {
    type: string,           // "cmos", "ttl", "hct", "lvds", "ecl"
    input_high_threshold: voltage,    // VIH
    input_low_threshold: voltage,     // VIL
    output_high_voltage: voltage,     // VOH
    output_low_voltage: voltage,      // VOL
    input_leakage: current,           // Input leakage current
    output_drive_high: current,       // IOH max
    output_drive_low: current,        // IOL max
    propagation_delay: time,          // Typical tpd
    rise_time: time,                  // tr
    fall_time: time,                  // tf
    power_per_gate: power,            // Static power consumption
    impedance: ImpedanceCharacteristics,
};

module LogicGate(
    gate_type: string = "NAND",       // "NAND", "NOR", "AND", "OR", "NOT", "XOR", "XNOR"
    logic_family: string = "HC",       // "HC", "HCT", "AHC", "AHCT", "LVC", "LVT"
    num_inputs: int = 2,
    package: string = "SO14"
) {
    // Dynamic pin generation based on gate type and input count
    generate for i in 0..num_inputs {
        pin inputs[i]: signal in @metadata(
            function="LogicInput",
            description=f"Logic input {i+1}",
            electrical_type="digital_input",
            drive_model=get_input_model(logic_family),
            synthesis_hints=["schmitt_trigger", "can_float", "pullup_if_unused"]
        );
    }
    
    pin output: signal out @metadata(
        function="LogicOutput",
        description="Logic gate output",
        electrical_type="digital_output",
        drive_model=get_output_model(logic_family),
        synthesis_hints=["can_drive_logic", "fan_out_capable", "short_circuit_protected"]
    );
    
    // Power supply pins
    pin VCC: power in @metadata(
        function="PowerPositive",
        voltage=get_supply_voltage(logic_family),
        current=get_supply_current(logic_family)
    );
    
    pin GND: ground @metadata(
        function="Ground"
    );
    
    // Logic family parameters
    const HC_FAMILY: LogicDriveType = {
        type: "cmos",
        input_high_threshold: 3.15V,    // 70% of VCC at 4.5V
        input_low_threshold: 1.35V,     // 30% of VCC at 4.5V
        output_high_voltage: 4.4V,      // VOH at VCC=5V, IOH=-20µA
        output_low_voltage: 0.1V,       // VOL at VCC=5V, IOL=20µA
        input_leakage: 1μA,             // Maximum input leakage
        output_drive_high: 20mA,        // Source current capability
        output_drive_low: 20mA,         // Sink current capability
        propagation_delay: 10ns,        // Typical at VCC=5V
        rise_time: 6ns,
        fall_time: 6ns,
        power_per_gate: 10nW,           // CMOS static power
        impedance: {
            dc_resistance: 1MΩ,         // High input impedance
            output_impedance: 100Ω,     // Typical CMOS output
            input_impedance: 1MΩ,
            can_source_current: true,
            can_sink_current: true,
            max_source_current: 20mA,
            max_sink_current: 20mA,
            power_domain_isolation: false,
            voltage_drop: null,
            current_limiting: true,      // CMOS has current limiting
            transient_response: 10ns,
            inrush_current: null
        }
    };
    
    const HCT_FAMILY: LogicDriveType = {
        type: "cmos_ttl_compatible",
        input_high_threshold: 2.0V,     // TTL compatible thresholds
        input_low_threshold: 0.8V,
        output_high_voltage: 4.4V,
        output_low_voltage: 0.1V,
        input_leakage: 1μA,
        output_drive_high: 20mA,
        output_drive_low: 20mA,
        propagation_delay: 16ns,        // Slightly slower than HC
        rise_time: 7ns,
        fall_time: 7ns,
        power_per_gate: 10nW,
        impedance: {
            dc_resistance: 1MΩ,
            output_impedance: 100Ω,
            input_impedance: 1MΩ,
            can_source_current: true,
            can_sink_current: true,
            max_source_current: 20mA,
            max_sink_current: 20mA,
            power_domain_isolation: false,
            voltage_drop: null,
            current_limiting: true,
            transient_response: 16ns,
            inrush_current: null
        }
    };
    
    const AHC_FAMILY: LogicDriveType = {
        type: "advanced_cmos",
        input_high_threshold: 3.15V,
        input_low_threshold: 1.35V,
        output_high_voltage: 4.4V,
        output_low_voltage: 0.1V,
        input_leakage: 0.1μA,           // Lower leakage
        output_drive_high: 50mA,        // Higher drive capability
        output_drive_low: 50mA,
        propagation_delay: 4.1ns,       // Much faster
        rise_time: 2.9ns,
        fall_time: 2.9ns,
        power_per_gate: 10nW,
        impedance: {
            dc_resistance: 10MΩ,        // Higher input impedance
            output_impedance: 50Ω,      // Lower output impedance
            input_impedance: 10MΩ,
            can_source_current: true,
            can_sink_current: true,
            max_source_current: 50mA,
            max_sink_current: 50mA,
            power_domain_isolation: false,
            voltage_drop: null,
            current_limiting: true,
            transient_response: 4ns,
            inrush_current: null
        }
    };
    
    const LVC_FAMILY: LogicDriveType = {
        type: "low_voltage_cmos",
        input_high_threshold: 2.0V,     // 3.3V logic levels
        input_low_threshold: 0.8V,
        output_high_voltage: 2.8V,      // VOH at VCC=3.3V
        output_low_voltage: 0.2V,       // VOL at VCC=3.3V
        input_leakage: 0.1μA,
        output_drive_high: 24mA,        // Good drive at 3.3V
        output_drive_low: 24mA,
        propagation_delay: 3.2ns,       // Very fast
        rise_time: 2.1ns,
        fall_time: 2.1ns,
        power_per_gate: 5nW,            // Lower power at 3.3V
        impedance: {
            dc_resistance: 10MΩ,
            output_impedance: 75Ω,
            input_impedance: 10MΩ,
            can_source_current: true,
            can_sink_current: true,
            max_source_current: 24mA,
            max_sink_current: 24mA,
            power_domain_isolation: false,
            voltage_drop: null,
            current_limiting: true,
            transient_response: 3ns,
            inrush_current: null
        }
    };
    
    // Get parameters based on logic family
    const params: LogicDriveType = 
        logic_family == "HC" ? HC_FAMILY :
        logic_family == "HCT" ? HCT_FAMILY :
        logic_family == "AHC" ? AHC_FAMILY :
        logic_family == "AHCT" ? AHC_FAMILY :  // Same as AHC but TTL thresholds
        logic_family == "LVC" ? LVC_FAMILY :
        logic_family == "LVT" ? LVC_FAMILY :   // Similar to LVC
        HC_FAMILY;  // Default
    
    // Helper functions for pin metadata
    function get_input_model(family: string) -> PinElectricalModel {
        return family.contains("LV") ? PIN_MODEL_3V3_INPUT : PIN_MODEL_5V_INPUT;
    }
    
    function get_output_model(family: string) -> PinElectricalModel {
        return family.contains("LV") ? PIN_MODEL_3V3_OUTPUT : PIN_MODEL_5V_OUTPUT;
    }
    
    function get_supply_voltage(family: string) -> voltage {
        return family.contains("LV") ? "3.3V" : "5V";
    }
    
    function get_supply_current(family: string) -> current {
        return "10mA";  // Conservative estimate per package
    }
    
    // Component metadata
    attribute component_class = "logic_gate";
    attribute gate_type = gate_type;
    attribute logic_family = logic_family;
    attribute num_inputs = num_inputs;
    attribute package_type = package;
    
    // Electrical characteristics from parameter structure
    attribute input_high_threshold = params.input_high_threshold;
    attribute input_low_threshold = params.input_low_threshold;
    attribute output_high_voltage = params.output_high_voltage;
    attribute output_low_voltage = params.output_low_voltage;
    attribute input_leakage = params.input_leakage;
    attribute output_drive_high = params.output_drive_high;
    attribute output_drive_low = params.output_drive_low;
    attribute propagation_delay = params.propagation_delay;
    attribute rise_time = params.rise_time;
    attribute fall_time = params.fall_time;
    attribute power_per_gate = params.power_per_gate;
    
    // Impedance characteristics
    attribute input_impedance = params.impedance.input_impedance;
    attribute output_impedance = params.impedance.output_impedance;
    attribute can_source_current = params.impedance.can_source_current;
    attribute can_sink_current = params.impedance.can_sink_current;
    attribute max_source_current = params.impedance.max_source_current;
    attribute max_sink_current = params.impedance.max_sink_current;
    attribute current_limiting = params.impedance.current_limiting;
    
    // SPICE model parameters
    attribute spice_model = "digital_gate";
    attribute spice_family = logic_family;
    attribute spice_gate_type = gate_type;
    attribute spice_vcc = get_supply_voltage(logic_family);
    attribute spice_vih = params.input_high_threshold;
    attribute spice_vil = params.input_low_threshold;
    attribute spice_voh = params.output_high_voltage;
    attribute spice_vol = params.output_low_voltage;
    attribute spice_tpd = params.propagation_delay;
    attribute spice_tr = params.rise_time;
    attribute spice_tf = params.fall_time;
    attribute spice_icc = params.power_per_gate / get_supply_voltage_numeric(logic_family);
    
    function get_supply_voltage_numeric(family: string) -> voltage {
        return family.contains("LV") ? 3.3V : 5.0V;
    }
    
    // KiCad symbol mapping based on gate type
    attribute kicad_symbol = 
        gate_type == "NAND" ? "74xx:74LS00" :
        gate_type == "NOR" ? "74xx:74LS02" :
        gate_type == "AND" ? "74xx:74LS08" :
        gate_type == "OR" ? "74xx:74LS32" :
        gate_type == "NOT" ? "74xx:74LS04" :
        gate_type == "XOR" ? "74xx:74LS86" :
        gate_type == "XNOR" ? "74xx:74LS266" :
        "74xx:74LS00";
    
    // Package footprint mapping
    attribute package_footprint = 
        package == "DIP14" ? "Package_DIP:DIP-14_W7.62mm" :
        package == "SO14" ? "Package_SO:SOIC-14_3.9x8.7mm_P1.27mm" :
        package == "TSSOP14" ? "Package_SO:TSSOP-14_5x4.4mm_P0.65mm" :
        package == "DIP16" ? "Package_DIP:DIP-16_W7.62mm" :
        package == "SO16" ? "Package_SO:SOIC-16_3.9x9.9mm_P1.27mm" :
        "Package_SO:SOIC-14_3.9x8.7mm_P1.27mm";
    
    // Virtual pins for automatic support circuits
    virtual_pin supply_decoupling: signal passive @metadata(
        function="SupplyDecoupling",
        description="Supply decoupling capacitor",
        component_type="Cap",
        component_value="100nF",
        connection_high="VCC",
        connection_low="GND",
        placement_distance="<5mm",
        synthesis_trigger="digital_power_decoupling"
    );
    
    virtual_pin unused_input_pullup: signal passive when has_unused_inputs @metadata(
        function="UnusedInputPullup", 
        description="Pull-up for unused inputs",
        component_type="Res",
        component_value="10kΩ",
        connection_high="VCC",
        connection_inputs="unused_inputs",
        synthesis_trigger="unused_input_termination"
    );
    
    virtual_pin output_series_resistor: signal passive when high_speed_application @metadata(
        function="SeriesTermination",
        description="Output series termination resistor",
        component_type="Res",
        component_value="params.impedance.output_impedance",
        connection_series="output",
        synthesis_trigger="high_speed_termination"
    );
}

// Common logic gate aliases with specific characteristics
alias NAND2_HC = LogicGate(gate_type="NAND", logic_family="HC", num_inputs=2);
alias NOR4_HCT = LogicGate(gate_type="NOR", logic_family="HCT", num_inputs=4);
alias AND2_AHC = LogicGate(gate_type="AND", logic_family="AHC", num_inputs=2);
alias XOR2_LVC = LogicGate(gate_type="XOR", logic_family="LVC", num_inputs=2);
alias NOT_HC = LogicGate(gate_type="NOT", logic_family="HC", num_inputs=1);