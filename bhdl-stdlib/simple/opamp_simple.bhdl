// Simplified Op-Amp - v2.0 compatible
// Generic entity with parameterized channel count

entity OpAmp<CHANNELS: integer = 1> {
    pin INP[CHANNELS]: signal in;
    pin INM[CHANNELS]: signal in;
    pin OUT[CHANNELS]: signal out;
    pin VCC: power in;
    pin GND: ground;

    attribute component_class = "opamp";
    attribute gain_bandwidth = 1MHz;
    attribute slew_rate = 0.5V;
}

alias LM741 = OpAmp<1>;
alias LM358 = OpAmp<2>;
alias LM324 = OpAmp<4>;
