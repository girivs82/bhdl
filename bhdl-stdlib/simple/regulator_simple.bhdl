// Simplified Linear Regulator - v2.0 compatible

entity LM7805 {
    pin IN: power in;
    pin OUT: power out;
    pin GND: ground;

    attribute component_class = "voltage_regulator";
    attribute output_voltage = 5V;
    attribute max_input_voltage = 35V;
    attribute max_output_current = 1A;
    attribute dropout_voltage = 2V;
    attribute kicad_symbol = "Regulator_Linear:L7805";
}
