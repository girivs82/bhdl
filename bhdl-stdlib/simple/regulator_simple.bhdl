// Simplified Linear Regulators - v2.0 compatible
// Generic entity with alias specializations for common regulators
// Supports conditional enable pin via HAS_EN bool parameter

entity LinearRegulator<V_OUT: voltage, HAS_EN: bool = false>(dropout: voltage = 2V) {
    pin VI: power in;
    pin VO: power out;
    pin GND: ground;
    pin EN: signal in when HAS_EN;

    attribute component_class = "voltage_regulator";
    attribute output_voltage = V_OUT;
    attribute dropout_voltage = dropout;
}

alias LM7805 = LinearRegulator<5V>;
alias LM1117_33 = LinearRegulator<3.3V>;
alias LM1117_33_EN = LinearRegulator<3.3V, true>;
