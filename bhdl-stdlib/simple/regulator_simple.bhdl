// Simplified Linear Regulators - v2.0 compatible
// Generic entity with alias specializations for common regulators
// Supports conditional enable pin via HAS_EN bool parameter

entity LinearRegulator<V_OUT: voltage, HAS_EN: bool = false>(
    dropout: voltage = 2V,
    i_quiescent: current = 5mA
) {
    pin VI: power in;
    pin VO: power out;
    pin GND: ground;
    pin EN: signal in when HAS_EN;

    attribute component_class = "voltage_regulator";
    attribute output_voltage = V_OUT;
    attribute dropout_voltage = dropout;
    attribute i_quiescent = i_quiescent;
}

alias LM7805 = LinearRegulator<5V>;
alias LM1117_33 = LinearRegulator<3.3V>;
alias LM1117_18 = LinearRegulator<1.8V>;
alias LM1117_33_EN = LinearRegulator<3.3V, true>;

// Simplified Buck (Switching) Regulators - v2.0 compatible
// Uses expansion block to declaratively specify inductor, catch diode, and output cap

entity BuckRegulator<V_OUT: voltage>(
    dropout: voltage = 0.5V,
    f_sw: frequency = 500kHz,
    rds_on: resistance = 200mΩ,
    t_sw: time = 80ns,
    i_quiescent: current = 5mA,
    l_value: inductance = 33µH,
    c_out: capacitance = 470µF,
    diode_vf: voltage = 0.5V,
    has_diode: bool = true
) {
    pin VIN: power in;
    pin VOUT: power out;
    pin GND: ground;

    attribute component_class = "switching_regulator";
    attribute output_voltage = V_OUT;
    attribute f_sw = f_sw;
    attribute rds_on = rds_on;
    attribute t_sw = t_sw;
    attribute i_quiescent = i_quiescent;

    expansion {
        internal sw: net;
        VOUT -> L: Ind(l_value).1; L.2 -> sw;
        sw -> D: Diode(diode_vf).K; D.A -> GND;
        VOUT -> C_out: Cap(c_out).1; C_out.2 -> GND;
    }
}

// LM2596: 150kHz fixed, Rds_on ~200mΩ, t_sw ~80ns, I_q ~5mA
alias LM2596_5V = BuckRegulator<5V>;
alias LM2596_3V3 = BuckRegulator<3.3V>;

// TPS54331: TI 3A step-down converter (SLVSA86)
// Adds FB voltage divider resistors to standard buck expansion children
// R_fb_top/R_fb_bot set V_OUT via internal 0.8V reference: V_OUT = 0.8V × (1 + R_top/R_bot)

entity TPS54331<V_OUT: voltage>(
    dropout: voltage = 0.5V,
    f_sw: frequency = 570kHz,
    rds_on: resistance = 90mΩ,
    t_sw: time = 20ns,
    i_quiescent: current = 3.4mA,
    l_value: inductance = 10µH,
    c_out: capacitance = 22µF,
    diode_vf: voltage = 0.45V,
    r_fb_top: resistance = 31.6kΩ,
    r_fb_bot: resistance = 10kΩ
) {
    pin VIN: power in;
    pin VOUT: power out;
    pin GND: ground;
    pin EN: signal in;

    attribute component_class = "switching_regulator";
    attribute output_voltage = V_OUT;
    attribute f_sw = f_sw;
    attribute rds_on = rds_on;
    attribute t_sw = t_sw;
    attribute i_quiescent = i_quiescent;

    expansion {
        internal sw: net;
        internal fb_int: net;

        VOUT -> L_out: Ind(l_value).1; L_out.2 -> sw;
        sw -> D_catch: Diode(diode_vf).K; D_catch.A -> GND;
        VOUT -> C_out: Cap(c_out).1; C_out.2 -> GND;
        VOUT -> R_top: Res(r_fb_top).1; R_top.2 -> fb_int;
        fb_int -> R_bot: Res(r_fb_bot).1; R_bot.2 -> GND;
    }
}

alias TPS54331_3V3 = TPS54331<3.3V>;
alias TPS54331_5V = TPS54331<5V>;
