// Domain Crossing and Connection Conflict Detection Rules
// Automatically inserts level shifters and detects illegal connections

import { PowerDomain } from "../pin_characteristics_advanced.bhdl";

/// Connection type analysis result
type ConnectionAnalysis = {
    connection_type: string,      // "legal", "needs_level_shifter", "conflict", "forbidden"
    source_pin: PinInfo,
    target_pin: PinInfo,
    issue: string?,              // Description of any issue
    solution: string?,           // Recommended solution
    auto_insert: ComponentInsert?, // Component to automatically insert
};

type PinInfo = {
    pin_name: string,
    pin_direction: string,       // "input", "output", "inout", "power", "ground"
    voltage_domain: string,      // e.g., "VDDIO1", "VDDCORE", "VDDA"
    voltage_level: voltage,      // Nominal voltage of domain
    drive_type: string?,         // "push-pull", "open-drain", "tri-state", etc.
    can_be_tri_stated: bool,     // True if pin can go high-Z
};

type ComponentInsert = {
    component_type: string,      // "level_shifter", "buffer", "resistor", etc.
    component_model: string,     // Specific part or model
    connections: ConnectionMap,  // How to connect the component
    parameters: ParameterMap,    // Component parameters
    placement_hint: string,      // Where to place it
};

// === CONNECTION CONFLICT DETECTION ===

// Rule: Two outputs cannot be connected together (unless open-drain/tri-state)
const RULE_OUTPUT_CONFLICT: ConnectionRule = {
    rule_name: "output_conflict_detection",
    description: "Detect and prevent connecting two outputs together",
    applies_to: "all_connections",
    
    check: function(source: PinInfo, target: PinInfo) -> ConnectionAnalysis {
        // Both pins are outputs
        if (source.pin_direction == "output" && target.pin_direction == "output") {
            
            // Check if both can be tri-stated or are open-drain
            const both_can_tristate = source.can_be_tri_stated && target.can_be_tri_stated;
            const both_open_drain = source.drive_type == "open-drain" && target.drive_type == "open-drain";
            const one_open_drain = source.drive_type == "open-drain" || target.drive_type == "open-drain";
            
            if (both_open_drain) {
                // Open-drain outputs can be connected (wired-OR/AND)
                return {
                    connection_type: "legal",
                    source_pin: source,
                    target_pin: target,
                    issue: null,
                    solution: "Open-drain outputs can be wired together (needs pull-up)",
                    auto_insert: {
                        component_type: "resistor",
                        component_model: "pullup",
                        connections: {
                            "high": determine_pullup_rail(source, target),
                            "low": "net"
                        },
                        parameters: { "value": "4.7kΩ" },
                        placement_hint: "near_connection_point"
                    }
                };
            }
            
            if (both_can_tristate) {
                // Tri-state outputs can be connected with proper control
                return {
                    connection_type: "legal",
                    source_pin: source,
                    target_pin: target,
                    issue: "Both outputs must have mutually exclusive enable signals",
                    solution: "Ensure output enables are never active simultaneously",
                    auto_insert: null  // Cannot auto-fix, needs design review
                };
            }
            
            if (one_open_drain) {
                // Mixed push-pull and open-drain is problematic
                return {
                    connection_type: "conflict",
                    source_pin: source,
                    target_pin: target,
                    issue: "Cannot connect push-pull output to open-drain output",
                    solution: "Push-pull will overdrive open-drain - add series resistor or change to open-drain",
                    auto_insert: null
                };
            }
            
            // Two push-pull outputs - this is a short circuit!
            return {
                connection_type: "forbidden",
                source_pin: source,
                target_pin: target,
                issue: "SHORT CIRCUIT: Two push-pull outputs connected together",
                solution: "This will cause excessive current and damage! Use tri-state or multiplexer",
                auto_insert: null
            };
        }
        
        return {
            connection_type: "legal",
            source_pin: source,
            target_pin: target,
            issue: null,
            solution: null,
            auto_insert: null
        };
    }
};

// === VOLTAGE DOMAIN CROSSING DETECTION ===

// Rule: Different voltage domains need level shifters
const RULE_DOMAIN_CROSSING: ConnectionRule = {
    rule_name: "voltage_domain_crossing",
    description: "Insert level shifters for cross-domain signals",
    applies_to: "signal_connections",
    
    check: function(source: PinInfo, target: PinInfo) -> ConnectionAnalysis {
        // Skip if same domain
        if (source.voltage_domain == target.voltage_domain) {
            return {
                connection_type: "legal",
                source_pin: source,
                target_pin: target,
                issue: null,
                solution: null,
                auto_insert: null
            };
        }
        
        // Get voltage levels
        const source_v = source.voltage_level;
        const target_v = target.voltage_level;
        const voltage_diff = abs(source_v - target_v);
        
        // Small voltage differences might be OK
        if (voltage_diff < 0.3V) {
            return {
                connection_type: "legal",
                source_pin: source,
                target_pin: target,
                issue: f"Small voltage difference ({voltage_diff}V) - verify thresholds",
                solution: "Check VIH/VIL compatibility",
                auto_insert: null
            };
        }
        
        // Determine level shifter type needed
        const level_shifter = select_level_shifter(source, target);
        
        return {
            connection_type: "needs_level_shifter",
            source_pin: source,
            target_pin: target,
            issue: f"Voltage domain crossing: {source_v}V to {target_v}V",
            solution: f"Insert {level_shifter.component_model} level shifter",
            auto_insert: level_shifter
        };
    }
};

// Select appropriate level shifter based on requirements
function select_level_shifter(source: PinInfo, target: PinInfo) -> ComponentInsert {
    const source_v = source.voltage_level;
    const target_v = target.voltage_level;
    const is_bidirectional = source.pin_direction == "inout" || target.pin_direction == "inout";
    const is_high_speed = false;  // Would check signal frequency if available
    
    // Bidirectional level shifter (e.g., for I2C)
    if (is_bidirectional) {
        return {
            component_type: "level_shifter",
            component_model: "TXS0108E",  // 8-bit bidirectional level shifter
            connections: {
                "VCCA": source.voltage_domain,
                "VCCB": target.voltage_domain,
                "A1": "source_signal",
                "B1": "target_signal",
                "OE": "VCC",  // Always enabled (could be controlled)
                "GND": "GND"
            },
            parameters: {
                "channels_used": "1",
                "voltage_a": f"{source_v}V",
                "voltage_b": f"{target_v}V",
                "max_data_rate": "100Mbps"
            },
            placement_hint: "between_domains"
        };
    }
    
    // Unidirectional level shifter for simple signals
    if (source_v > target_v) {
        // Down-shifting (e.g., 3.3V to 1.8V)
        return {
            component_type: "level_shifter",
            component_model: "SN74LVC1T45",  // Single-bit level shifter
            connections: {
                "VCCA": source.voltage_domain,
                "VCCB": target.voltage_domain,
                "A": "source_signal",
                "B": "target_signal",
                "DIR": "VCC",  // A to B direction
                "GND": "GND"
            },
            parameters: {
                "direction": "down_shift",
                "voltage_a": f"{source_v}V",
                "voltage_b": f"{target_v}V"
            },
            placement_hint: "near_domain_boundary"
        };
    } else {
        // Up-shifting (e.g., 1.8V to 3.3V)
        return {
            component_type: "level_shifter",
            component_model: "SN74LVC1T45",
            connections: {
                "VCCA": source.voltage_domain,
                "VCCB": target.voltage_domain,
                "A": "source_signal",
                "B": "target_signal",
                "DIR": "GND",  // A to B direction
                "GND": "GND"
            },
            parameters: {
                "direction": "up_shift",
                "voltage_a": f"{source_v}V",
                "voltage_b": f"{target_v}V"
            },
            placement_hint: "near_domain_boundary"
        };
    }
}

// === SPECIAL CASES ===

// Rule: 5V tolerant inputs
const RULE_5V_TOLERANT: ConnectionRule = {
    rule_name: "5v_tolerant_check",
    description: "Check if 5V signal can connect to 3.3V input",
    applies_to: "signal_connections",
    
    check: function(source: PinInfo, target: PinInfo) -> ConnectionAnalysis {
        const source_v = source.voltage_level;
        const target_v = target.voltage_level;
        
        // 5V driving 3.3V input
        if (source_v >= 5.0V && target_v <= 3.3V) {
            // Check if target is 5V tolerant
            if (target.has_attribute("5V_tolerant")) {
                return {
                    connection_type: "legal",
                    source_pin: source,
                    target_pin: target,
                    issue: null,
                    solution: "Target is 5V tolerant - direct connection OK",
                    auto_insert: null
                };
            } else {
                // Need protection
                return {
                    connection_type: "needs_level_shifter",
                    source_pin: source,
                    target_pin: target,
                    issue: "5V signal to 3.3V non-tolerant input",
                    solution: "Insert level shifter or series resistor with clamp",
                    auto_insert: {
                        component_type: "protection",
                        component_model: "resistor_divider",
                        connections: {
                            "in": "source_signal",
                            "out": "target_signal",
                            "gnd": "GND"
                        },
                        parameters: {
                            "r1": "2.2kΩ",  // 5V to 3.3V divider
                            "r2": "3.3kΩ"
                        },
                        placement_hint: "near_3v3_device"
                    }
                };
            }
        }
        
        return {
            connection_type: "legal",
            source_pin: source,
            target_pin: target,
            issue: null,
            solution: null,
            auto_insert: null
        };
    }
};

// Rule: Analog domain isolation
const RULE_ANALOG_ISOLATION: ConnectionRule = {
    rule_name: "analog_domain_isolation",
    description: "Ensure analog signals are properly isolated",
    applies_to: "analog_connections",
    
    check: function(source: PinInfo, target: PinInfo) -> ConnectionAnalysis {
        const source_is_analog = source.voltage_domain.contains("VDDA") || 
                                source.voltage_domain.contains("ANALOG");
        const target_is_analog = target.voltage_domain.contains("VDDA") || 
                                target.voltage_domain.contains("ANALOG");
        const source_is_digital = !source_is_analog;
        const target_is_digital = !target_is_analog;
        
        // Digital to analog crossing
        if (source_is_digital && target_is_analog) {
            return {
                connection_type: "needs_level_shifter",
                source_pin: source,
                target_pin: target,
                issue: "Digital to analog domain crossing",
                solution: "Insert buffer or filter for isolation",
                auto_insert: {
                    component_type: "buffer",
                    component_model: "analog_buffer",
                    connections: {
                        "VDD": target.voltage_domain,
                        "VSS": "VSSA",
                        "IN": "source_signal",
                        "OUT": "target_signal"
                    },
                    parameters: {
                        "bandwidth": "1MHz",
                        "isolation": "60dB"
                    },
                    placement_hint: "analog_digital_boundary"
                }
            };
        }
        
        return {
            connection_type: "legal",
            source_pin: source,
            target_pin: target,
            issue: null,
            solution: null,
            auto_insert: null
        };
    }
};

// === COMPREHENSIVE CONNECTION VALIDATOR ===

function validate_connection(
    source: PinInfo,
    target: PinInfo,
    connection_rules: ConnectionRule[]
) -> ConnectionAnalysis[] {
    const results: ConnectionAnalysis[] = [];
    
    // Check all rules
    for rule in connection_rules {
        const result = rule.check(source, target);
        if (result.connection_type != "legal" || result.issue != null) {
            results.push(result);
        }
    }
    
    // Sort by severity
    results.sort((a, b) => {
        const severity_order = {
            "forbidden": 0,
            "conflict": 1,
            "needs_level_shifter": 2,
            "legal": 3
        };
        return severity_order[a.connection_type] - severity_order[b.connection_type];
    });
    
    return results;
}

