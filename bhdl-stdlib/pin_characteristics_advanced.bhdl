// FPGA-style configurable I/O with selectable standards
type ConfigurableIO = {
    pin_name: string,
    available_standards: string[],   // e.g., ["LVCMOS33", "LVCMOS25", "LVCMOS18", "LVDS"]
    current_standard: string,
    drive_strength_options: current[], // e.g., [4mA, 8mA, 12mA, 16mA]
    current_drive_strength: current,
    slew_rate_options: string[],     // e.g., ["slow", "fast"]
    current_slew_rate: string,
    power_domain: PowerDomain,
    pullup_available: bool,
    pulldown_available: bool,
    keeper_available: bool,          // Weak keeper to maintain last state
    schmitt_trigger_available: bool,
};

// Helper function to determine pull-up rail for a pin
function get_pullup_rail_for_pin(
    pin_drive: DriveTypeAdvanced,
    chip_architecture: ChipPowerArchitecture
) -> string? {
    // If explicitly specified, use that
    if (pin_drive.pullup_to_domain != null) {
        return pin_drive.pullup_to_domain;
    }
    
    // Otherwise, use the pin's power domain supply
    return pin_drive.power_domain.supply_pin;
}

// Helper function to determine if level shifter needed
function needs_level_shifter(
    source_domain: PowerDomain,
    target_domain: PowerDomain,
    chip_architecture: ChipPowerArchitecture
) -> bool {
    // Check cross-domain rules
    for rule in chip_architecture.cross_domain_rules {
        if (rule.from_domain == source_domain.name && 
            rule.to_domain == target_domain.name) {
            return rule.connection_type == "level_shifter";
        }
    }
    
    // Default: level shifter needed if voltages differ by >0.5V
    const voltage_diff = abs(source_domain.nominal_voltage - target_domain.nominal_voltage);
    return voltage_diff > 0.5V;
}

// Export advanced pin characteristics
export {
    PowerDomain, DriveTypeAdvanced, ChipPowerArchitecture, CrossDomainRule,
    ConfigurableIO,
    
    // Example architectures
    MCU_POWER_ARCHITECTURE,
    
    // Example drive types
    DRIVE_I2C_MULTI_DOMAIN, DRIVE_SPI_BANK_B,
    
    // Helper functions
    get_pullup_rail_for_pin, needs_level_shifter
};