// Advanced Pin Electrical Characteristics with Multi-Rail Support
// Handles chips with multiple power domains and complex I/O banks

import { DriveType, SParameters, PinElectricalModel } from "./pin_characteristics.bhdl";
import { ImpedanceCharacteristics } from "./electrical_params.bhdl";

/// Power domain specification for pins
type PowerDomain = {
    name: string,                    // Domain name (e.g., "IO_BANK_A", "CORE", "ANALOG")
    supply_pin: string,              // Which supply pin powers this domain (e.g., "VDDIO1", "VDDCORE")
    ground_pin: string,              // Which ground pin for this domain (e.g., "VSSIO1", "VSS")
    nominal_voltage: voltage,        // Nominal voltage for this domain
    voltage_range_min: voltage,      // Minimum operating voltage
    voltage_range_max: voltage,      // Maximum operating voltage
    io_standard: string?,            // I/O standard (e.g., "LVCMOS33", "LVDS", "SSTL")
    bank_number: int?,               // I/O bank number for FPGAs/complex chips
};

/// Enhanced drive type with explicit power domain specification
type DriveTypeAdvanced = {
    base_drive: DriveType,           // Base drive characteristics
    power_domain: PowerDomain,       // Which power domain this pin belongs to
    pullup_to_domain: string?,       // Explicit domain name for pull-up (overrides base)
    pulldown_to_domain: string?,     // Explicit domain name for pull-down (overrides base)
    level_shift_required: bool,      // True if level shifting needed to other domains
    compatible_domains: string[],    // List of domains this can directly connect to
};

/// Multi-domain chip specification
type ChipPowerArchitecture = {
    domains: PowerDomain[],          // All power domains in the chip
    default_io_domain: string,       // Default domain for I/O pins
    default_core_domain: string,     // Default domain for core logic
    cross_domain_rules: CrossDomainRule[], // Rules for cross-domain connections
};

/// Rules for cross-domain connections
type CrossDomainRule = {
    from_domain: string,
    to_domain: string,
    connection_type: string,         // "direct", "level_shifter", "isolation", "forbidden"
    level_shifter_type: string?,     // Type of level shifter needed
    isolation_type: string?,         // Type of isolation needed
    max_frequency: frequency?,       // Maximum frequency for cross-domain signals
};

