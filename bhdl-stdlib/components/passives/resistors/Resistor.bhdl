// Generic Resistor - Complete Component Knowledge
// Fixed, variable, and specialized resistors

import { resistance, power, voltage, current, temperature, frequency } from "../../../units.bhdl";

// ==================== COMPONENT DEFINITION ====================
entity Resistor(
    value: resistance,                  // Resistance value
    tolerance: float = 5%,              // Tolerance percentage
    power_rating: power = 0.25W,        // Power rating
    temp_coef: float = 100              // ppm/°C
) {
    pin 1: signal inout {
        description: "Terminal 1"
    };
    
    pin 2: signal inout {
        description: "Terminal 2"
    };
}

// Common aliases
entity Res = Resistor;
entity R = Resistor;

