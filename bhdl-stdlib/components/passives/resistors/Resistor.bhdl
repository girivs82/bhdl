// ==================== SELECTION FUNCTIONS ====================
export function select_led_resistor(
    vsupply: voltage,
    vf_led: voltage,
    if_led: current
): ResistorSpec {
    // Calculate resistance
    const R = (vsupply - vf_led) / if_led;
    
    // Find nearest standard value (round up for safety)
    const R_std = find_nearest_standard(R, true);
    
    // Calculate actual current with standard value
    const I_actual = (vsupply - vf_led) / R_std;
    
    // Calculate power
    const P = (vsupply - vf_led) * I_actual;
    
    // Select power rating (2× margin)
    const P_rating = select_power_rating(P * 2);
    
    return {
        resistance: R_std,
        power_rating: P_rating,
        tolerance: 5%,
        package: select_package_for_power(P_rating),
        actual_current: I_actual
    };
}

export function select_pullup_resistor(
    voltage: voltage,
    sink_current: current = 0.5mA,
    speed_requirement: string = "normal"
): ResistorSpec {
    // Select value based on speed requirement
    let R: resistance;
    switch(speed_requirement) {
        case "fast":
            R = 1000;    // 1kΩ for fast edges
            break;
        case "slow":
            R = 100000;  // 100kΩ for low power
            break;
        default:
            R = 10000;   // 10kΩ standard
    }
    
    // Verify sink current capability
    const I_max = voltage / R;
    if (I_max < sink_current) {
        R = voltage / sink_current;
        R = find_nearest_standard(R, false);  // Round down
    }
    
    // Power is typically negligible
    const P = voltage * voltage / R;
    
    return {
        resistance: R,
        power_rating: 0.125,  // 1/8W is plenty
        tolerance: 5%,
        package: "0603",     // Standard SMD
        pull_current: voltage / R
    };
}

function find_nearest_standard(value: float, round_up: bool): float {
    // Determine decade
    const decade = Math.pow(10, Math.floor(Math.log10(value)));
    const normalized = value / decade;
    
    // Find in E24 series
    const series = RESISTOR_ELECTRICAL.e24_series;
    let nearest: float;
    
    if (round_up) {
        nearest = series.find(v => v >= normalized) || series[0] * 10;
    } else {
        nearest = series.reverse().find(v => v <= normalized) || series[series.length - 1] / 10;
    }
    
    return nearest * decade;
}

function select_power_rating(power: power): power {
    const ratings = RESISTOR_ELECTRICAL.standard_power_ratings;
    return ratings.find(p => p >= power) || ratings[ratings.length - 1];
}

function select_package_for_power(power: power): string {
    if (power <= 0.063) return "0402";
    if (power <= 0.1) return "0603";
    if (power <= 0.125) return "0805";
    if (power <= 0.25) return "1206";
    if (power <= 0.5) return "1210";
    if (power <= 1.0) return "2512";
    return "TO220";  // High power
}

// ==================== EXPORT ====================
export {
    Resistor,
    Res,
    R,
    RESISTOR_ELECTRICAL,
    RESISTOR_TYPES,
    RESISTOR_PACKAGES,
    RESISTOR_SIMULATION,
    RESISTOR_APPLICATIONS,
    RESISTOR_THERMAL,
    select_led_resistor,
    select_pullup_resistor
};