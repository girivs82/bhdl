const RESISTOR_SIMULATION = {
    // Basic model
    ideal_model: {
        resistance: "R",
        voltage: "V = I × R",
        power: "P = I² × R = V²/R"
    },
    
    // Practical model with parasitics
    practical_model: {
        resistance: "R",
        inductance: "L_parasitic ≈ 0.002 × length_mm nH",
        capacitance: "C_parasitic ≈ 0.5pF",
        
        // Temperature dependence
        temp_model: "R(T) = R0 × (1 + α × (T - T0))",
        
        // Voltage dependence
        voltage_model: "R(V) = R0 × (1 + β × V)",
        
        // Noise
        thermal_noise: "V_noise = √(4kTRΔf)",
        current_noise: "Excess noise in carbon types"
    },
    
    // SPICE model
    spice_model: {
        simple: "R{ref} {1} {2} {value}",
        with_temp: "R{ref} {1} {2} {value} TC={tempco}",
        subcircuit: ".subckt R_{ref} 1 2\nR1 1 n1 {value}\nL1 n1 n2 {L_parasitic}\nC1 n2 2 {C_parasitic}\n.ends"
    },
    
    // Power derating
    power_derating: {
        curve: "P(T) = P_rated × (1 - (T - 70)/(T_max - 70))",
        start_temp: 70°C,               // Start derating
