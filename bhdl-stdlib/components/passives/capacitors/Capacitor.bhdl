// Function to generate synthesis requirements for capacitors
export function get_capacitor_synthesis_requirements(
    application: string,
    value: capacitance,
    voltage: voltage,
    current: current = null
): SynthesisRequirements {
    // Determine voltage rating with derating
    const v_rating = select_voltage_rating(voltage * 1.5);
    
    // Determine dielectric based on application
    let dielectric = "X7R";  // Default
    if (application === "timing") {
        dielectric = "C0G";
    } else if (value > 10e-6 && application === "power_supply") {
        dielectric = "Electrolytic";
    }
    
    const req = {
        value: value,
        voltage_rating: v_rating,
        dielectric: dielectric,
        
        // Get connection pattern
        connections: CAPACITOR_SYNTHESIS[application + "_connections"],
        
        // Determine package
        package: select_package_for_capacitor(value, v_rating),
        
        // Part selection hints
        search_hints: {
            keywords: ["capacitor", value.toString(), v_rating.toString() + "V"],
            series: dielectric === "Electrolytic" ? 
                CAPACITOR_SYNTHESIS.part_number_patterns.electrolytic_caps :
                CAPACITOR_SYNTHESIS.part_number_patterns.ceramic_caps,
            parameters: {
                "capacitance": value,
                "voltage_rating": v_rating,
                "dielectric": dielectric,
                "esr_max": application === "power_supply" ? 0.1 : null,
                "ripple_current_min": current
            }
        },
        
        // Special requirements
        special: {
            placement: application === "bypass" ? "< 5mm from IC" : null,
            quantity: application === "bypass" ? "cascade multiple values" : null,
            thermal: value > 100e-6 ? "consider ripple heating" : null
        }
    };
    
    return req;
}

function select_package_for_capacitor(value: capacitance, voltage: voltage): string {
    // Ceramic packages
    if (value <= 0.1e-6 && voltage <= 50) return "0603";
    if (value <= 1e-6 && voltage <= 50) return "0805";
    if (value <= 10e-6 && voltage <= 50) return "1206";
    if (value <= 22e-6 && voltage <= 50) return "1210";
    
    // Electrolytic packages  
    if (value <= 10e-6) return "SMD_A";
    if (value <= 47e-6) return "SMD_B";
    if (value <= 100e-6) return "SMD_C";
    if (value <= 220e-6) return "SMD_D";
    
    return "radial";  // Large values
}

// ==================== SELECTION FUNCTIONS ====================
export function select_input_capacitor(
    vin_max: voltage,
    iin_max: current,
    ripple_voltage: voltage = 0.1V
): CapacitorSpec {
    // Calculate minimum capacitance for ripple
    const C_min = (iin_max * 0.01) / (120 * ripple_voltage);  // Assuming 120Hz ripple
    
    // Select standard value (round up)
    const C_uF = Math.ceil(C_min * 1e6 / 47) * 47;  // Round to 47uF multiples
    
    // Voltage rating with derating
    const V_rating = select_voltage_rating(vin_max * 1.5);
    
    return {
        capacitance: C_uF * 1e-6,
        voltage_rating: V_rating,
        type: "Electrolytic",
        esr_max: ripple_voltage / (iin_max * 0.1),
        ripple_current_min: iin_max * 0.5,
        quantity: C_uF > 470 ? 2 : 1  // Use multiple for large values
    };
}

export function select_output_capacitor(
    vout: voltage,
    iout: current,
    fsw: frequency,
    ripple_current: current,
    ripple_voltage: voltage = 0.05V
): CapacitorSpec {
    // Calculate minimum capacitance
    const C_min = ripple_current / (8 * fsw * ripple_voltage);
    
    // Calculate maximum ESR
    const esr_max = ripple_voltage / ripple_current;
    
    // Determine type based on requirements
    const use_ceramic = fsw > 300e3 || esr_max < 0.01;
    
    if (use_ceramic) {
        // Use multiple ceramic caps in parallel
        const C_per_cap = 22e-6;  // 22uF standard
        const num_caps = Math.ceil(C_min / C_per_cap);
        
        return {
            capacitance: C_per_cap,
            voltage_rating: select_voltage_rating(vout * 2),
            type: "Ceramic X7R",
            package: "1206",
            quantity: num_caps,
            esr_per_cap: esr_max * num_caps
        };
    } else {
        // Use electrolytic
        const C_uF = Math.ceil(C_min * 1e6 / 47) * 47;
        
        return {
            capacitance: C_uF * 1e-6,
            voltage_rating: select_voltage_rating(vout * 1.5),
            type: "Electrolytic",
            esr_max: esr_max,
            ripple_current_min: ripple_current
        };
    }
}

function select_voltage_rating(v_min: voltage): voltage {
    const standard = CAPACITOR_ELECTRICAL.standard_voltages;
    return standard.find(v => v >= v_min) || standard[standard.length - 1];
}

// ==================== EXPORT ====================
export {
    Capacitor,
    Cap,
    ElectrolyticCap,
    CeramicCap,
    CAPACITOR_ELECTRICAL,
    CAPACITOR_DIELECTRICS,
    CAPACITOR_PACKAGES,
    CAPACITOR_SIMULATION,
    CAPACITOR_POWER_APPLICATIONS,
    CAPACITOR_RELIABILITY,
    CAPACITOR_LAYOUT,
    select_input_capacitor,
    select_output_capacitor
};