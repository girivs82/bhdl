// Generic Capacitor - Complete Component Knowledge  
// Electrolytic, Ceramic, Film, and Tantalum capacitors

import { capacitance, voltage, resistance, frequency, temperature, current, time } from "../../../units.bhdl";

// ==================== COMPONENT DEFINITION ====================
module Capacitor(
    value: capacitance,                 // Capacitance value
    voltage_rating: voltage = 50V,      // Rated voltage
    tolerance: float = 20%,             // Capacitance tolerance
    esr: resistance = 100mΩ,           // Equivalent series resistance
    dielectric: string = "X7R"          // Dielectric type
) {
    pin 1: signal inout {
        description: "Terminal 1 (positive for polarized)"
    };
    
    pin 2: signal inout {
        description: "Terminal 2 (negative for polarized)"
    };
}

// Shortcuts for common capacitor types
module Cap = Capacitor;
module ElectrolyticCap(value: capacitance, voltage: voltage) = 
    Capacitor(value, voltage, 20%, 50mΩ, "Electrolytic");
module CeramicCap(value: capacitance, voltage: voltage, dielectric: string = "X7R") = 
    Capacitor(value, voltage, 10%, 10mΩ, dielectric);

