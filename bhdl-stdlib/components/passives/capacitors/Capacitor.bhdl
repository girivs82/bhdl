// ==================== SIMULATION MODEL ====================
const CAPACITOR_SIMULATION = {
    // Ideal capacitor
    ideal_model: {
        capacitance: "C",
        impedance: "Z = 1/(jωC)",
        energy: "E = 0.5 × C × V²"
    },
    
    // Practical model with parasitics
    practical_model: {
        capacitance: "C",
        esr: "ESR in series",
        esl: "ESL in series (typ 1-10nH)",
        leakage: "R_leak in parallel (typ > 1MΩ)",
        
        // Total impedance
        impedance: "Z = ESR + j(ωL - 1/ωC)",
        
        // Self-resonant frequency
        srf: "f_res = 1/(2π√(LC))",
        
        // Dissipation factor
        dissipation_factor: "DF = ESR × ωC"
    },
    
    // SPICE model
    spice_model: {
        simple: "C{ref} {1} {2} {value}",
        with_esr: ".subckt C_{ref} 1 2\nC1 1 n1 {value}\nR1 n1 2 {esr}\n.ends",
        full: ".subckt C_{ref} 1 2\nL1 1 n1 {esl}\nR1 n1 n2 {esr}\nC1 n2 n3 {value}\nR2 n3 2 {r_leak}\n.ends"
    },
    
    // Temperature and voltage effects
    derating: {
        voltage_derating: "C(V) = C0 × (1 + kv × V/Vrated)",
        temp_derating: "C(T) = C0 × (1 + kt × (T - 25))",
        combined: "C(V,T) = C0 × (1 + kv × V/Vr) × (1 + kt × ΔT)"
    }
};

