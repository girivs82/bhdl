        inductance: "L",
        series_resistance: "DCR",
        parallel_capacitance: "C_parasitic",
        core_losses: "R_core parallel",
        
        // Frequency-dependent inductance
        inductance_vs_frequency: "L(f) = L0 / (1 + (f/f_cutoff)²)",
        
        // Current-dependent inductance (saturation)
        inductance_vs_current: "L(I) = L0 × (1 - (I/Isat)²)"
    },
    
    // SPICE subcircuit model
    spice_model: {
        basic: "L{ref} {1} {2} {value}",
        with_dcr: ".subckt L_{ref} 1 2\nL1 1 n1 {value}\nR1 n1 2 {dcr}\n.ends",
        with_saturation: "Requires behavioral model with current sensing"
    },
    
    // Saturation modeling
    saturation_model: {
        soft_saturation: "L = L0 × tanh(Isat/I)",
        hard_saturation: "L = I < Isat ? L0 : L0 × (Isat/I)",
        rolloff_factor: 0.7,            // L drops to 70% at Isat
        thermal_derating: "Isat(T) = Isat(25°C) × (1 - 0.004 × (T - 25))"
    }
};

