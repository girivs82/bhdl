    // Current rating factors
    saturation_current_factor: 1.3,     // Isat = 1.3 × Irated typically
    rms_current_factor: 1.0,            // Irms = Irated
    
    // Temperature characteristics
    temp_coefficient: 100,              // ppm/°C typical
    temp_rise_per_watt: 40,            // °C/W for self-heating
    
    // Frequency characteristics
