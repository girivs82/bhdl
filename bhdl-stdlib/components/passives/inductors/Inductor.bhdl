// Generic Inductor - Complete Component Knowledge
// Power inductors for switching regulators and filters

import { inductance, current, resistance, frequency, temperature, voltage } from "../../../units.bhdl";

// ==================== COMPONENT DEFINITION ====================
entity Inductor(
    value: inductance,                  // Inductance value
    current_rating: current = 1A,       // Rated continuous current
    dcr: resistance = 100mΩ,           // DC resistance
    tolerance: float = 20%              // Inductance tolerance
) {
    pin 1: signal inout {
        description: "Terminal 1"
    };
    
    pin 2: signal inout {
        description: "Terminal 2"
    };
}

