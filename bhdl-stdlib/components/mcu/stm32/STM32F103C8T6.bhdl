// Helper to calculate total MCU power consumption
export function calculate_stm32_power(
    frequency: frequency,
    active_peripherals: string[],
    io_current: current = 0mA
): power {
    // Base current vs frequency
    const base_current = (frequency / 1MHz) * 0.7mA;
    
    // Add peripheral currents
    let peripheral_current = 0mA;
    for (const peripheral of active_peripherals) {
        peripheral_current += STM32F103_ELECTRICAL.current_consumption[peripheral] ?? 0;
    }
    
    const total_current = base_current + peripheral_current + io_current;
    return total_current * 3.3V;
}