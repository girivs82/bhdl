// STM32F103C8T6 Microcontroller - Complete Component Knowledge Repository
// Popular "Blue Pill" MCU - All knowledge in one place

import { voltage, current, power, frequency, temperature, time, capacitance } from "../units.bhdl";
import { ThermalModel, SimulationFeedback, SelectionConstraints } from "../simulation_knowledge.bhdl";

// ==================== COMPONENT DEFINITION ====================
entity STM32F103C8T6() {
    // Power pins with detailed metadata
    pin VDD1: power in {
        voltage_range: (2.0V, 3.6V),
        nominal: 3.3V,
        current_typ: 50mA,              // Running at 72MHz
        description: "Digital power supply 1"
    };
    
    pin VDD2: power in {
        voltage_range: (2.0V, 3.6V),
        nominal: 3.3V,
        description: "Digital power supply 2"
    };
    
    pin VDD3: power in {
        voltage_range: (2.0V, 3.6V),
        nominal: 3.3V,
        description: "Digital power supply 3"
    };
    
    pin VDDA: power in {
        voltage_range: (2.0V, 3.6V),
        nominal: 3.3V,
        current_typ: 5mA,               // ADC/PLL power
        description: "Analog power supply"
    };
    
    pin VBAT: power in {
        voltage_range: (1.8V, 3.6V),
        nominal: 3.0V,
        current_typ: 2uA,               // RTC backup current
        description: "RTC backup power"
    };
    
    pin VSS1: ground inout;
    pin VSS2: ground inout;
    pin VSS3: ground inout;
    pin VSSA: ground inout {
        description: "Analog ground"
    };
    
    // Reset and boot pins
    pin NRST: signal inout {
        type: "open_drain",
        internal_pullup: 40kΩ,
        description: "System reset"
    };
    
    pin BOOT0: signal in {
        description: "Boot mode selection"
    };
    
    // Oscillator pins
    pin OSC_IN: signal in {
        frequency_range: (4MHz, 16MHz),
        description: "HSE oscillator input"
    };
    
    pin OSC_OUT: signal out {
        description: "HSE oscillator output"
    };
    
    pin OSC32_IN: signal in {
        frequency: 32.768kHz,
        description: "LSE oscillator input"
    };
    
    pin OSC32_OUT: signal out {
        description: "LSE oscillator output"
    };
    
    // GPIO Ports (simplified - actual has PA0-PA15, PB0-PB15, PC13-PC15)
    // This shows the pattern for a few pins
    pin PA0: signal inout {
        functions: ["GPIO", "ADC12_IN0", "TIM2_CH1", "USART2_CTS"],
        io_type: "FT",                  // 5V tolerant
        description: "Port A pin 0"
    };
    
    pin PA9: signal inout {
        functions: ["GPIO", "USART1_TX", "TIM1_CH2"],
        io_type: "FT",
        description: "Port A pin 9 - USART1 TX"
    };
    
    pin PA10: signal inout {
        functions: ["GPIO", "USART1_RX", "TIM1_CH3"],
        io_type: "FT",
        description: "Port A pin 10 - USART1 RX"
    };
    
    // ... (other GPIO pins follow same pattern)
}

