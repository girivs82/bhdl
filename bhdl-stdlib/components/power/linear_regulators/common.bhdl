// Common definitions for linear voltage regulators
// Shared types, parameters, and calculations for the linear regulator family

import { voltage, current, power, resistance, capacitance, temperature, time } from "../../../units.bhdl";

// ==================== LINEAR REGULATOR TYPES ====================

// Regulator topology
type RegulatorType = "fixed" | "adjustable" | "ldo" | "quasi-ldo";

// Protection features common to linear regulators
type ProtectionFeatures = {
    thermal_shutdown: bool,
    current_limiting: bool,
    safe_area_protection: bool,
    reverse_polarity: bool,
    overvoltage_protection: bool,
    short_circuit_protection: bool
};

// Thermal characteristics for linear regulators
type LinearRegulatorThermal = {
    // Standard thermal resistances by package
    theta_ja: float,                    // Junction to ambient (°C/W)
    theta_jc: float,                    // Junction to case (°C/W)
    theta_jb: float?,                   // Junction to board (°C/W) - SMD only
    
    // Operating limits
    tj_max: temperature,                 // Maximum junction temperature
    tj_shutdown: temperature,            // Thermal shutdown temperature
    tj_hysteresis: temperature,          // Shutdown hysteresis
    
    // Package specific
    package_type: string,
    heatsink_mountable: bool,
    exposed_pad: bool
};

// Common electrical specifications
type LinearRegulatorSpecs = {
    // Voltage specifications
    vin_min: voltage,
    vin_max: voltage,
    vout_nominal: voltage,
    vout_tolerance: float,               // % tolerance
    dropout_voltage: voltage,
    
    // Current specifications
    iout_max: current,
    iout_min: current,                   // Minimum load current
    iq_typ: current,                     // Quiescent current typical
    iq_max: current,                     // Quiescent current maximum
    
    // Regulation specifications
    line_regulation: voltage,            // mV/V typical
    load_regulation: voltage,            // mV/A typical
    
    // Dynamic specifications
    psrr: float,                         // dB @ frequency
    output_noise: voltage,               // µVrms
    transient_response: time            // Response time to load step
};

// Stability requirements
type StabilityRequirements = {
    cout_min: capacitance,              // Minimum output capacitance
    cout_max: capacitance?,             // Maximum output capacitance
    esr_min: resistance?,               // Minimum ESR (for older regulators)
    esr_max: resistance?,               // Maximum ESR
    stable_with_ceramic: bool,          // Stable with low-ESR ceramic caps
    compensation: string                 // "internal", "external", "adaptive"
};

// ==================== COMMON CALCULATIONS ====================

// Calculate power dissipation in linear regulator
function calculate_linear_power_dissipation(
    vin: voltage,
    vout: voltage,
    iout: current,
    iq: current = 5mA                   // Typical quiescent current
): power {
    return (vin - vout) * iout + vin * iq;
}

// Calculate required heatsink thermal resistance
function calculate_heatsink_requirement(
    power_dissipation: power,
    tj_max: temperature,
    ta_max: temperature,
    theta_jc: float,
    theta_cs: float = 0.5               // Case to sink interface (°C/W)
): float {
    const total_thermal_budget = (tj_max - ta_max) / power_dissipation;
    const theta_sa_required = total_thermal_budget - theta_jc - theta_cs;
    
    if (theta_sa_required < 0) {
        // Cannot achieve with any heatsink
        return -1;
    }
    
    return theta_sa_required;
}

// Check if regulator can operate without heatsink
function can_operate_without_heatsink(
    power_dissipation: power,
    tj_max: temperature,
    ta_max: temperature,
    theta_ja: float
): bool {
    const tj_rise = power_dissipation * theta_ja;
    return (ta_max + tj_rise) < tj_max;
}

// Calculate minimum input voltage for proper regulation
function calculate_min_vin(
    vout: voltage,
    dropout: voltage,
    margin: voltage = 0.5V               // Safety margin
): voltage {
    return vout + dropout + margin;
}

