// LM317 Adjustable Linear Voltage Regulator
// 1.25V to 37V adjustable output, 1.5A current capability

entity LM317(
    vout: voltage = 5V,     // Target output voltage
    iout: current = 500mA   // Expected output current
) {
    // Pin definitions
    pin VIN: power in {
        description: "Input voltage",
        voltage_range: (vout + 3V, 40V),  // Need 3V headroom minimum
        current_max: iout + 10mA          // Output plus adjustment current
    };
    
    pin ADJ: signal inout {
        description: "Adjustment terminal",
        voltage: 1.25V,                   // Reference voltage
        current_max: 100uA                // Adjustment pin current
    };
    
    // Virtual pin that expands to full voltage regulator circuit
    pin VOUT: power out virtual {
        description: "Virtual output - expands to feedback network and capacitors",
        voltage: vout,
        current_max: 1.5A,
        tolerance: 1%,  // With precision resistors
        supporting_components: {
            // Feedback resistor network
            R1: {
                type: "Resistor",
                connection_pattern: "VOUT -> self.1; self.2 -> ADJ",
                value: "240Ω",  // Standard value for R1
                tolerance: "1%",
                power_rating: "250mW",
                placement: "close_to_ic",
                intent: "voltage_reference(vref: 1.25V)"
            },
            R2: {
                type: "Resistor", 
                connection_pattern: "ADJ -> self.1; self.2 -> GND",
                value: "calculated",  // R2 = R1 * ((Vout/1.25) - 1)
                formula: "240 * ((vout/1.25) - 1)",
                tolerance: "1%",
                power_rating: "250mW",
                placement: "close_to_ic",
                intent: "voltage_setting(target: vout)"
            },
            // Protection diode
            D1: {
                type: "Diode",
                connection_pattern: "ADJ -> self.A; self.K -> VIN",
                value: "1N4002",
                placement: "close_to_ic",
                intent: "reverse_voltage_protection()"
            },
            D2: {
                type: "Diode",
                connection_pattern: "VOUT -> self.A; self.K -> VIN",
                value: "1N4002",
                placement: "close_to_ic",
                intent: "output_discharge_protection()"
            },
            // Input capacitor
            C_IN: {
                type: "Capacitor",
                connection_pattern: "VIN -> self.1; self.2 -> GND",
                value: "100nF",
                voltage_rating: "50V",
                dielectric: "ceramic",
                placement: "very_close_to_ic",
                intent: "input_bypass(stability: required)"
            },
            // Output capacitor
            C_OUT: {
                type: "Capacitor",
                connection_pattern: "VOUT -> self.1; self.2 -> GND",
                value: "1µF",
                voltage_rating: "calculated",
                formula_voltage: "vout * 1.5",
                dielectric: "tantalum",
                placement: "close_to_output",
                intent: "output_stability(improve_transient: true)"
            },
            // Adjustment bypass capacitor (improves ripple rejection)
            C_ADJ: {
                type: "Capacitor",
                connection_pattern: "ADJ -> self.1; self.2 -> GND",
                value: "10µF",
                voltage_rating: "25V",
                dielectric: "electrolytic",
                placement: "close_to_R2",
                intent: "ripple_rejection(improvement: 15dB)"
            }
        }
    };
    
    // Ground is implicit through the resistor network
    pin GND: ground virtual {
        description: "Virtual ground - connected through R2",
        note: "LM317 doesn't have a GND pin, ground reference is through ADJ resistor"
    };
    
    // Internal characteristics
    internal {
        reference_voltage: 1.25V,         // VOUT to ADJ voltage
        line_regulation: 0.01,           // %/V typical
        load_regulation: 0.1,            // % typical
        dropout_voltage: 3V,             // VIN - VOUT minimum at 1.5A
        quiescent_current: 10mA,         // Device consumption
        adjustment_current: 100uA,        // ADJ pin current
        ripple_rejection: 65,            // dB typical
        thermal_resistance: 5,           // °C/W junction to case (TO-220)
        max_junction_temp: 125,          // °C
        thermal_protection: true,        // Internal thermal shutdown
        current_limit: 2.2A,             // Internal current limiting
        safe_area_protection: true       // SOA protection
    };
    
    // Calculation helpers
    calculations {
        // Calculate R2 for desired output voltage
        r2_value: "R1 * ((Vout / Vref) - 1) where R1=240Ω, Vref=1.25V",
        
        // Output voltage formula
        vout_formula: "Vref * (1 + R2/R1) + (Iadj * R2) where Vref=1.25V",
        
        // Power dissipation
        power_dissipation: "(VIN - VOUT) * IOUT",
        
        // Heatsink requirement
        heatsink_required: "Pd > 2W",
        thermal_resistance_required: "(Tj_max - Ta_max) / Pd - Rjc"
    };
    
    // Application notes
    notes {
        minimum_load: "LM317 requires 10mA minimum load current",
        capacitor_distance: "Input capacitor must be within 3 inches",
        pcb_layout: "Keep feedback resistors close to minimize noise pickup",
        protection: "D1 and D2 protect against capacitor discharge",
        stability: "Output capacitor improves transient response",
        ripple: "C_ADJ significantly improves ripple rejection (15-20dB)"
    };
}