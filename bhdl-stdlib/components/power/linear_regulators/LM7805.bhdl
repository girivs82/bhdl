// ==================== EXPORT COMPLETE COMPONENT ====================
export {
    LM7805,                             // Module definition
    LM7805_ELECTRICAL,                  // Electrical characteristics
    LM7805_THERMAL,                     // Thermal model
    LM7805_SIMULATION,                  // Simulation parameters
    LM7805_SYNTHESIS,                   // Synthesis knowledge
    LM7805_SAFETY                       // Safety and reliability
};

// Helper function to calculate power dissipation (wraps common function)
export function calculate_lm7805_power_dissipation(
    vin: voltage,
    vout: voltage,
    iout: current,
    iquiescent: current = 6mA
): power {
    return calculate_linear_power_dissipation(vin, vout, iout, iquiescent);
}

// Helper function to determine heatsink requirement for LM7805
export function calculate_lm7805_heatsink_requirement(
    power_dissipation: power,
    ambient_temp: temperature,
    max_junction_temp: temperature = 125°C,
    package: string = "TO220"
): float {
    const theta_jc = LM7805_THERMAL.theta_jc[package];
    const theta_cs = 0.5; // Typical case-to-sink interface
    
    return calculate_heatsink_requirement(
        power_dissipation,
        max_junction_temp,
        ambient_temp,
        theta_jc,
        theta_cs
    );
}