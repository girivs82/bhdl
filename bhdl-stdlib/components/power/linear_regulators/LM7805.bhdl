            result: "Permanent damage",
            protection: "Input TVS diode"
        },
        thermal_overload: {
            threshold: 150°C,
            result: "Thermal shutdown (recoverable)",
            protection: "Internal protection"
        },
        output_short: {
            result: "Current limit activates",
            protection: "Internal current limiting"
        },
        reverse_voltage: {
            threshold: -0.3V,
            result: "Possible damage",
            protection: "Series diode on input"
        }
    },
    
    // Derating guidelines
    derating: {
        voltage: 0.8,                   // Use 80% of max voltage
        current: 0.7,                   // Use 70% of max current
        power: 0.5,                     // Use 50% of max power
        temperature: 0.8                // Use 80% of max junction temp
    },
    
    // MTBF data
    reliability: {
        mtbf_25c: 1000000,             // Hours at 25°C
