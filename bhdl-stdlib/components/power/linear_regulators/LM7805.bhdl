// LM7805 Linear Voltage Regulator - Complete Component Knowledge Repository
// This file contains ALL knowledge about the LM7805: pins, electrical, thermal, simulation, synthesis

import { voltage, current, power, resistance, temperature, capacitance, time } from "../../../units.bhdl";
import { 
    LinearRegulatorThermal, LinearRegulatorSpecs, StabilityRequirements,
    ProtectionFeatures, calculate_linear_power_dissipation, 
    calculate_heatsink_requirement, LINEAR_REGULATOR_PACKAGES
} from "./common.bhdl";

// ==================== COMPONENT DEFINITION ====================
module LM7805(
    enable: bool = true  // Optional enable for power control
) {
    // Pin definitions with complete metadata
    pin VIN: power in {
        voltage_range: (7V, 35V),       // Absolute maximum 35V
        recommended: (7.5V, 25V),       // Recommended operating range
        description: "Unregulated input voltage"
    };
    
    pin VOUT: power out virtual {
        voltage: 5V,
        tolerance: 4%,                   // ±4% over full range
        current_max: 1.5A,              // With heatsink
        description: "Regulated 5V output - expands to output capacitors",
        supporting_components: {
            C_OUT: {
                type: "Capacitor",
                connection_pattern: "VOUT -> self.1; self.2 -> GND",
                value: "100µF",
                voltage_rating: "10V",
                placement: "close_to_ic",
                intent: "output_stabilization(ripple_reduction: 60dB)"
            },
            C_BYPASS: {
                type: "Capacitor",
                connection_pattern: "VOUT -> self.1; self.2 -> GND", 
                value: "100nF",
                voltage_rating: "10V",
                placement: "very_close_to_ic",
                intent: "high_frequency_bypass(frequency: 1MHz)"
            }
        }
    };
    
    pin GND: ground inout {
        description: "Ground reference and heat sink connection"
    };
    
    // Optional pins for adjustable versions (LM7805C doesn't use these)
    pin ADJ: signal in when false {     // Only on adjustable variants
        description: "Output voltage adjustment"
    };
}

