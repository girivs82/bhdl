// SS34 — 3A 40V Schottky barrier rectifier (clean v2 entity).
//
// Regenerated to the current v2 standard: the prior file carried the entity
// followed by large pre-v2 `const … = { … }` knowledge blocks and embedded
// `export function`s that the current grammar doesn't parse, so importing it
// failed (→ "Undefined component type: SS34"). The catch-diode behaviour the
// buck converters need is the entity + its datasheet attributes; the narrative
// reference data is dropped.
//
// Common catch/freewheeling diode for non-synchronous buck converters.

entity SS34() {
    pin A: signal inout;   // Anode
    pin K: signal inout;   // Cathode (band)

    attribute component_class  = "diode";
    attribute family           = "SS34";
    // Datasheet (Vishay SS34) electrical characteristics, consumed by the
    // diode SPICE model + sign-off:
    attribute forward_voltage   = 0.55V;     // V_F typ at 3A, 25°C
    attribute forward_current   = 3A;        // I_F(AV) rated
    attribute reverse_voltage   = 40V;       // V_RRM
    attribute saturation_current = 4.352e-6; // SPICE IS (own model)
    attribute manufacturer      = "Vishay";
    attribute manufacturer_part = "SS34";
}

// Alternate name used by boards that wire a generic "Schottky" catch diode.
alias SchottkyDiode = SS34;
