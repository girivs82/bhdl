// Function to get synthesis requirements for SS34
export function get_ss34_synthesis_requirements(
    application: string,
    current: current,
    voltage: voltage
): SynthesisRequirements {
    // Verify SS34 is suitable
    if (voltage > 40) {
        console.warn("SS34 rated for 40V max, consider higher voltage diode");
    }
    if (current > 3) {
        console.warn("SS34 rated for 3A max, consider higher current diode");
    }
    
    // Select package based on current
    let package_type = "SMA";
    if (current > 1 && current <= 2) {
        package_type = "SMB";
    } else if (current > 2) {
        package_type = "SMC";
    }
    
    const req = {
        part_number: "SS34",
        package: package_type,
        
        // Get connection pattern
        connections: SS34_SYNTHESIS[application],
        
        // Thermal requirements
        thermal: {
            power_dissipation: current * 0.5,  // Assuming 0.5V drop
            thermal_resistance: SS34_THERMAL[package_type].theta_ja,
            copper_area: current > 1 ? Math.ceil(current) + " in²" : "standard"
        },
        
        // Alternatives if SS34 not available
        alternatives: SS34_SYNTHESIS.equivalent_parts,
        
        // Layout requirements
        layout: {
            placement: "Minimize loop area with switch",
            orientation: "Cathode band visible",
            thermal_pad: current > 2 ? "required" : "recommended"
        }
    };
    
    return req;
}

// ==================== SELECTION HELPERS ====================
export function calculate_power_dissipation(
    forward_current: current,
    duty_cycle: float = 0.5,        // For switching applications
    forward_voltage: voltage = 0.5V  // Typical VF
): power {
    return forward_current * forward_voltage * duty_cycle;
}

export function select_package_for_power(
    power_dissipation: power,
    ambient_temp: temperature = 50°C,
    copper_area: float = 1.0        // in²
): string {
    // Adjust thermal resistance based on copper area
    const thermal_factor = Math.sqrt(copper_area);
    
    if (power_dissipation < 1.0 / thermal_factor) {
        return "SMA";
    } else if (power_dissipation < 2.0 / thermal_factor) {
        return "SMB";
    } else {
        return "SMC";
    }
}

