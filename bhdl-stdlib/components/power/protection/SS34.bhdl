// SS34 3A 40V Schottky Diode - Complete Component Knowledge
// Common catch diode for buck converters

import { voltage, current, power, capacitance, temperature, time, resistance } from "../../../units.bhdl";

// ==================== COMPONENT DEFINITION ====================
module SS34() {
    pin A: signal inout {
        description: "Anode"
    };
    
    pin K: signal inout {  
        description: "Cathode"
    };
}

// Alternate name for better readability
module SchottkyDiode = SS34;

