// TPS54331 3A Step-Down Converter with Virtual Pin Support
// Complete component knowledge including virtual pin expansion

import { voltage, current, power, resistance, capacitance, inductance, frequency, temperature } from "../../../units.bhdl";

// ==================== COMPONENT DEFINITION WITH VIRTUAL PIN ====================
entity TPS54331(
    vout: voltage = 3.3V                // Target output voltage
) {
    // Physical pins
    pin VIN: power in {
        voltage_range: (3.5V, 28V),
        voltage_abs_max: 30V,
        description: "Input supply"
    };
    
    pin SW: switch out {
        current_max: 4A,                // Peak switch current
        voltage_max: 30V,
        switching_freq: 570kHz,
        description: "Switch node to inductor"
    };
    
    pin GND: ground inout {
        description: "Ground and thermal pad"
    };
    
    pin FB: feedback in {
        voltage_ref: 0.8V,               // Reference voltage
        input_impedance: 1MΩ,
        description: "Feedback input"
    };
    
    pin BOOT: signal inout {
        description: "Bootstrap capacitor connection"
    };
    
    pin EN: signal in {
        threshold_on: 1.25V,
        threshold_off: 1.15V,
        description: "Enable input"
    };
    
    pin SS: signal inout {
        description: "Soft-start capacitor"
    };
    
    pin COMP: signal inout {
        description: "Compensation network"
    };
    
    // VIRTUAL PIN - This expands to real components
    pin VOUT: power out virtual {
        voltage: vout,
        current_max: 3A,
        description: "Virtual output pin - expands to inductor, capacitors, and feedback"
    };
    
    // === BEHAVIORAL MODEL: ANALYTICAL (Level 0) ===
    @behavioral_model analytical {
        metadata: {
            name: "analytical",
            level: "ANALYTICAL",
            typical_runtime: 1ms,
            accuracy: 0.75,  // 75% accurate for initial design
            provides_outputs: ["L_min", "C_min", "efficiency_estimate", "ripple_estimate"],
        },
        
        // Analytical equations for TPS54331 design
        equations: {
            // Inductor sizing for 30% ripple current
            L_min: "(vout * (vin_nom - vout)) / (0.3 * iout_max * 570kHz * vin_nom)",
            
            // Output capacitor for 1% ripple voltage
            C_min: "(0.3 * iout_max) / (8 * 570kHz * 0.01 * vout)",
            
            // Efficiency estimate based on TI datasheet curves
            efficiency_estimate: "0.95 - (vin_nom - vout) * 0.02 / vin_nom",  // Rough estimate
            
            // Voltage ripple estimate
            ripple_voltage: "(0.3 * iout_max) / (8 * 570kHz * C_min)",
            
            // Current ripple 
            ripple_current: "(vin_nom - vout) * vout / (vin_nom * L_min * 570kHz)",
            
            // Duty cycle
            duty_cycle: "vout / vin_nom",
            
            // Bootstrap cap requirement
            bootstrap_cap: "100nF",  // Fixed for TPS54331
            
            // Compensation network starting values
            comp_r: "10kΩ",
            comp_c: "4.7nF",
            comp_c2: "100pF",
        },
        
        // Design constraints
        constraints: {
            vin_min: "3.5V",
            vin_max: "28V", 
            vout_min: "0.8V",
            vout_max: "25V",
            iout_max: "3A",
            duty_cycle_max: "0.9",  // Practical limit
            L_min_abs: "1uH",       // Practical minimum
            C_min_abs: "10uF",      // Practical minimum
        },
        
        use_when: "initial_sizing || component_selection || feasibility_check",
    }
    
    // === BEHAVIORAL MODEL: AVERAGED_SWITCHING (Level 1) ===
    @behavioral_model averaged_switching {
        metadata: {
            name: "averaged_switching", 
            level: "BEHAVIORAL_SWITCHING",
            typical_runtime: 50ms,
            accuracy: 0.88,  // 88% accurate for control loop design
            
            valid_conditions: {
                frequency_range: (0.1Hz, 57kHz),  // Valid below fsw/10
                duty_cycle_range: (0.1, 0.9),
            },
            
            provides_outputs: [
                "control_to_output_tf",
                "loop_gain",
                "phase_margin", 
                "crossover_frequency",
                "line_transient_response"
            ],
        },
        
        // State-space averaged model for TPS54331
        averaged_model: {
            // State variables: [iL, vC]
            // Control input: duty cycle d
            // Disturbance: vin
            
            // Continuous-time state-space: dx/dt = A*x + B*u + E*w
            A_matrix: [
                [-R_dcr/L,           -1/L],
                [1/C,                -1/(R_load*C)]
            ],
            
            B_matrix: [
                [vin_nom/L],         // Control input (duty cycle)
                [0]
            ],
            
            E_matrix: [
                [duty_cycle/L],      // Line disturbance
                [0]
            ],
            
            C_matrix: [
                [0,                  1]  // Output is capacitor voltage
            ],
            
            D_matrix: [0],
        },
        
        // Small-signal transfer functions
        transfer_functions: {
            // Control-to-output (duty cycle to output voltage)
            Gvd: {
                numerator: "vin_nom * (1 + s * R_esr * C)",
                denominator: "1 + s * (L/R_load + R_esr*C) + s² * L * C",
                dc_gain: vin_nom,
                zeros: [-1/(R_esr * C)],
                poles: "calculated_from_LC_network",
            },
            
            // Line-to-output (input voltage to output voltage)
            Gvi: {
                numerator: "duty_cycle * (1 + s * R_esr * C)",
                denominator: "1 + s * (L/R_load + R_esr*C) + s² * L * C",
                dc_gain: "duty_cycle",
            },
            
            // Output impedance
            Zout: {
                expression: "(s*L + R_dcr) || (1/(s*C) + R_esr)",
                dc_value: "R_dcr || R_esr",
                hf_asymptote: "L/C + R_esr",
            }
        },
        
        // TPS54331-specific control model
        control_model: {
            // Error amplifier (inside TPS54331)
            error_amp: {
                gain_dc: 1000,          // 60dB
                gbw: 10MHz,             // Gain-bandwidth product  
                phase_margin: 60°,      // Internal stability
                slew_rate: 10,          // V/μs
            },
            
            // PWM comparator
            pwm_modulator: {
                gain: "1/V_ramp",       // PWM gain
                ramp_amplitude: 2V,     // Internal ramp
                frequency: 570kHz,
                delay: 100ns,           // PWM delay
            },
            
            // Current sense and slope compensation
            current_sense: {
                gain: "R_sense * A_cs", // Current sense gain
                slope_compensation: 0.5, // Built-in slope comp
                current_limit: 4.5A,    // Peak current limit
            }
        },
        
        // Stability analysis
        stability_analysis: {
            // Overall loop gain calculation
            loop_gain: "error_amp_gain * pwm_gain * Gvd * feedback_divider",
            
            // Compensation network design
            compensation: {
                type: "type_III",       // Usually needed for buck
                pole_esr: "1/(2π * R_esr * C)",
                pole_lc: "1/(2π * √(L*C))",
                target_crossover: "57kHz",  // fsw/10
                target_phase_margin: 60°,
            },
            
            measurements: {
                crossover_frequency: "freq where |loop_gain| = 1",
                phase_margin: "180° + phase(loop_gain) @ crossover",
                gain_margin: "-|loop_gain|dB @ phase = -180°",
            }
        },
        
        use_when: "control_loop_design || stability_analysis || compensation_design",
    }
    
    // === BEHAVIORAL MODEL: DETAILED_SWITCHING (Level 2) ===
    @behavioral_model detailed_switching {
        metadata: {
            name: "detailed_switching",
            level: "SWITCHING_DETAILED",
            typical_runtime: 5s,
            accuracy: 0.95,  // 95% accurate for detailed analysis
            
            provides_outputs: [
                "switching_losses",
                "efficiency_vs_load",
                "thermal_analysis",
                "emi_estimate",
                "transient_response"
            ],
        },
        
        // Detailed switching model
        switching_model: {
            // High-side MOSFET model
            high_side_fet: {
                ron: 65mΩ,              // TPS54331 internal MOSFET
                gate_charge: 15nC,
                rise_time: 15ns,
                fall_time: 10ns,
                body_diode_vf: 0.7V,
                
                // Gate driver characteristics
                gate_driver: {
                    current_source: 1.5A,  // Peak drive current
                    current_sink: 2.5A,
                    propagation_delay: 50ns,
                }
            },
            
            // Synchronous rectifier (low-side FET)
            low_side_fet: {
                ron: 45mΩ,              // Lower Rds(on)
                gate_charge: 12nC,
                rise_time: 10ns,
                fall_time: 15ns,
                dead_time: 20ns,        // Prevent shoot-through
            },
            
            // Loss calculations
            loss_analysis: {
                conduction_loss_hs: "I_rms_hs² * ron_hs",
                conduction_loss_ls: "I_rms_ls² * ron_ls", 
                switching_loss_hs: "0.5 * vin * iout * (tr + tf) * fsw",
                switching_loss_ls: "0.5 * vf_diode * iout * tr * fsw",
                
                // Gate drive losses
                gate_loss: "(Qg_hs + Qg_ls) * vin * fsw",
                
                // Quiescent current loss
                quiescent_loss: "iq * vin",
            }
        },
        
        // Thermal model
        thermal_model: {
            // Junction to ambient thermal resistance
            theta_ja: 33.6,             // °C/W for SO-8 PowerPAD
            theta_jc: 10,               // °C/W junction to case
            
            // Thermal time constants
            thermal_time_constant: 15ms, // Thermal mass
            
            // Self-heating effects
            efficiency_vs_temp: {
                // Efficiency decreases with temperature
                temp_coefficient: -0.001, // per °C
                reference_temp: 25°C,
            },
            
            thermal_shutdown: 165°C,     // TPS54331 thermal limit
        },
        
        // Transient analysis
        transient_model: {
            // Startup sequence
            startup: {
                soft_start_time: "C_ss * 5V / 5μA",  // Determined by SS cap
                reference_startup: 200μs,
                inrush_current_limit: 1A,    // Soft-start current limit
            },
            
            // Load step response
            load_step_response: {
                bandwidth_limit: "loop_crossover_freq / (2π)",
                overshoot: "function_of_phase_margin",
                settling_time: "3 / bandwidth",
            },
            
            // Line step response
            line_step_response: {
                feedforward_gain: "duty_cycle",
                transient_time: "inductor_current_slew_limit",
            }
        },
        
        // EMI/noise analysis
        emi_model: {
            switching_noise: {
                fundamental: 570kHz,
                harmonics: "up_to_100MHz",
                amplitude: "function_of_dv_dt_and_di_dt",
            },
            
            input_noise: {
                switching_current_ripple: "function_of_input_capacitance",
                conducted_emissions: "requires_input_filter",
            }
        },
        
        use_when: "detailed_design || efficiency_optimization || thermal_design || emi_analysis",
    }
    
    // === OPTIMIZATION STRATEGY ===
    @optimization_strategy {
        phases: [
            // Phase 1: Initial component sizing
            {
                name: "component_sizing",
                model_level: "ANALYTICAL",
                parameters: ["L", "C_out", "feedback_resistors"],
                
                objectives: [
                    {metric: "ripple_voltage", goal: "minimize", weight: 0.4},
                    {metric: "component_cost", goal: "minimize", weight: 0.3},
                    {metric: "size", goal: "minimize", weight: 0.3},
                ],
                
                constraints: [
                    {metric: "ripple_voltage", condition: "<", value: "0.01 * vout", hard: true},
                    {metric: "current_ripple", condition: "<", value: "0.3 * iout_max", hard: true},
                    {metric: "L", condition: ">", value: "L_min", hard: true},
                    {metric: "C_out", condition: ">", value: "C_min", hard: true},
                    {metric: "inductor_saturation", condition: ">", value: "1.2 * peak_current", hard: true},
                ],
                
                algorithm: "grid_search",
            },
            
            // Phase 2: Control loop optimization
            {
                name: "control_loop_optimization",
                model_level: "BEHAVIORAL_SWITCHING",
                parameters: ["comp_network", "soft_start_cap"],
                
                objectives: [
                    {metric: "phase_margin", goal: "target", target_value: 60°, weight: 0.5},
                    {metric: "bandwidth", goal: "maximize", weight: 0.3},
                    {metric: "gain_margin", goal: "maximize", weight: 0.2},
                ],
                
                constraints: [
                    {metric: "phase_margin", condition: ">", value: 45°, hard: true},
                    {metric: "gain_margin", condition: ">", value: 10, hard: true},
                    {metric: "crossover_frequency", condition: "<", value: 57kHz, hard: true},
                    {metric: "stability", condition: "==", value: true, hard: true},
                ],
                
                algorithm: "nelder_mead",
            },
            
            // Phase 3: Efficiency optimization
            {
                name: "efficiency_optimization",
                model_level: "SWITCHING_DETAILED",
                parameters: ["switching_frequency", "inductor_dcr", "output_cap_esr"],
                
                objectives: [
                    {metric: "efficiency", goal: "maximize", weight: 0.7},
                    {metric: "thermal_performance", goal: "minimize", weight: 0.3},
                ],
                
                constraints: [
                    {metric: "efficiency", condition: ">", value: 0.85, hard: true},
                    {metric: "junction_temp", condition: "<", value: 125°C, hard: true},
                    {metric: "emi_compliance", condition: "==", value: true, hard: false},
                ],
                
                algorithm: "genetic_algorithm",  // Good for multiple objectives
            },
            
            // Phase 4: Final verification
            {
                name: "verification",
                model_level: "SWITCHING_DETAILED",
                parameters: [],  // No optimization
                
                objectives: [],  // Just verification
                
                constraints: [
                    {metric: "startup_overshoot", condition: "<", value: 0.05, hard: true},
                    {metric: "load_step_undershoot", condition: "<", value: 0.05, hard: true},
                    {metric: "line_regulation", condition: "<", value: 0.01, hard: true},
                    {metric: "efficiency_full_load", condition: ">", value: 0.90, hard: true},
                    {metric: "thermal_safe", condition: "==", value: true, hard: true},
                ],
                
                algorithm: "none",
            }
        ],
        
        convergence_criteria: {
            all_constraints_met: true,
            stability_verified: true,
            thermal_margin: 20°C,
            efficiency_target: 0.92,
        },
        
        max_iterations: 30,
        timeout: 10min,
    }
    
    // === COMPONENT KNOWLEDGE ===
    @component_knowledge {
        good_starting_points: [
            {
                conditions: "vout == 3.3V && iout_max <= 3A",
                values: {
                    L: 10μH,
                    C_out: "2×22μF ceramic",
                    C_out_esr: 5mΩ,
                    R_fb_top: 31.2kΩ,
                    R_fb_bot: 10kΩ,
                    C_ss: 10nF,
                    comp_network: "type_II",
                },
                expected_performance: {
                    efficiency: 92%,
                    ripple_voltage: 20mV,
                    phase_margin: 65°,
                    crossover_freq: 40kHz,
                }
            },
            {
                conditions: "vout == 5V && iout_max <= 3A",
                values: {
                    L: 15μH,
                    C_out: "2×22μF ceramic + 47μF electrolytic",
                    R_fb_top: 52.3kΩ,
                    R_fb_bot: 10kΩ,
                    C_ss: 22nF,
                    comp_network: "type_III",
                },
                expected_performance: {
                    efficiency: 94%,
                    ripple_voltage: 25mV,
                    phase_margin: 60°,
                    crossover_freq: 35kHz,
                }
            },
            {
                conditions: "vout >= 12V && iout_max <= 2A",
                values: {
                    L: 33μH,
                    C_out: "47μF + 2×100μF electrolytic",
                    R_fb_top: 140kΩ,
                    R_fb_bot: 10kΩ,
                    C_ss: 47nF,
                    comp_network: "type_III_advanced",
                },
                expected_performance: {
                    efficiency: 91%,
                    ripple_voltage: 60mV,
                    phase_margin: 55°,
                    crossover_freq: 25kHz,
                }
            }
        ],
        
        scaling_rules: {
            "Inductor value scales with output voltage for same ripple current",
            "Output capacitance scales with load current for same ripple voltage",
            "Crossover frequency should be fsw/10 to fsw/20 for stability",
            "Soft-start time scales with output capacitance",
            "Higher output voltages need more complex compensation",
        },
        
        coupled_parameters: [
            ["L", "ripple_current"],
            ["C_out", "ripple_voltage"],
            ["comp_network", "phase_margin"],
            ["R_fb_top", "R_fb_bot", "vout"],  // Feedback divider
        ],
        
        common_issues: [
            {
                name: "subharmonic_oscillation",
                detection_condition: "duty_cycle > 0.5 && slope_comp < 0.5",
                symptoms: ["alternating_pulse_widths", "audio_noise"],
                fixes: ["increase_slope_compensation", "reduce_duty_cycle"],
            },
            {
                name: "poor_load_transient",
                detection_condition: "bandwidth < 5kHz",
                symptoms: ["large_voltage_dip", "slow_recovery"],
                fixes: ["increase_bandwidth", "add_output_capacitance"],
            },
            {
                name: "instability",
                detection_condition: "phase_margin < 30°",
                symptoms: ["oscillation", "jitter"],
                fixes: ["redesign_compensation", "reduce_crossover_frequency"],
            },
            {
                name: "thermal_issues",
                detection_condition: "junction_temp > 125°C",
                symptoms: ["thermal_shutdown", "reduced_performance"],
                fixes: ["improve_thermal_design", "reduce_switching_frequency", "add_heatsink"],
            }
        ]
    }
    
    // === TEST SEQUENCES ===
    @test_sequences {
        startup_test: {
            name: "startup_sequence",
            description: "Verify soft-start and startup behavior",
            
            setup: {
                initial_conditions: {
                    vin: 12V,
                    enable: false,
                    all_caps_discharged: true,
                },
            },
            
            stimulus: {
                type: "step",
                parameters: {
                    enable_step: "false to true at t=0",
                    load_step: "no_load to full_load at t=5ms",
                },
            },
            
            measurements: {
                measure: ["vout", "vin_current", "sw_node", "inductor_current"],
                extract: ["startup_time", "overshoot", "inrush_current"],
                pass_criteria: {
                    startup_time: "< 1ms",
                    overshoot: "< 5%",
                    inrush_current: "< 1A",
                }
            }
        },
        
        load_step_test: {
            name: "load_transient",
            description: "Load step response verification",
            
            stimulus: {
                type: "step",
                parameters: {
                    load_step: "10% to 100% in 1μs",
                    step_back: "100% to 10% in 1μs",
                },
            },
            
            measurements: {
                measure: ["vout", "inductor_current"],
                extract: ["undershoot", "overshoot", "settling_time"],
                pass_criteria: {
                    undershoot: "< 3%",
                    overshoot: "< 2%",
                    settling_time: "< 50μs",
                }
            }
        },
        
        efficiency_test: {
            name: "efficiency_curve",
            description: "Efficiency measurement vs load and input voltage",
            
            stimulus: {
                type: "sweep",
                parameters: {
                    load_sweep: "0.1A to 3A in 0.1A steps",
                    vin_sweep: "4V to 24V in 2V steps",
                },
            },
            
            measurements: {
                measure: ["pin", "pout", "junction_temp"],
                extract: ["efficiency_curve", "max_efficiency", "thermal_profile"],
                pass_criteria: {
                    peak_efficiency: "> 92%",
                    efficiency_at_half_load: "> 90%",
                    junction_temp_max: "< 100°C",
                }
            }
        }
    }
}

// ==================== VIRTUAL PIN EXPANSION RULES ====================
const TPS54331_VIRTUAL_PIN_EXPANSION = {
    // Components that the virtual VOUT pin expands to
    VOUT_expansion: {
        // Output inductor from SW
        inductor: {
            connection: "SW -> L.1, L.2 -> VOUT_NET",
            value_formula: "L = (Vout × (Vin - Vout)) / (ΔI × f × Vin)",
            typical_values: {
                "3.3V": 10uH,
                "5V": 15uH,
                "12V": 33uH
            },
            current_rating: "1.3 × IOUT_MAX",
            dcr_max: 30mΩ,
            saturation_current: "> 4A"
        },
        
        // Bootstrap capacitor
        bootstrap_cap: {
            connection: "BOOT -> C_BOOT.1, C_BOOT.2 -> SW",
            value: 100nF,
            voltage_rating: 16V,
            type: "Ceramic X7R"
        },
        
        // Output capacitors
        output_caps: [
            {
                connection: "VOUT_NET -> C1.1, C1.2 -> GND",
                value: 22uF,
                voltage_rating: "VOUT × 2",
                type: "Ceramic X7R",
                quantity: 2  // Use 2x22uF for lower ESR
            },
            {
                connection: "VOUT_NET -> C2.1, C2.2 -> GND",
                value: 100nF,
                voltage_rating: "VOUT × 2",
                type: "Ceramic X7R",
                purpose: "High frequency bypass"
            }
        ],
        
        // Feedback divider
        feedback_network: {
            r_top: {
                connection: "VOUT_NET -> R1.1, R1.2 -> FB",
                value_formula: "R1 = R2 × (Vout/0.8 - 1)",
                recommended_r2: 10kΩ,
                tolerance: 1%
            },
            r_bottom: {
                connection: "FB -> R2.1, R2.2 -> GND",
                value: 10kΩ,
                tolerance: 1%
            },
            feedforward_cap: {
                connection: "Across R1",
                value: 22pF,
                type: "C0G",
                purpose: "Improve transient response"
            }
        },
        
        // Compensation network
        compensation: {
            r_comp: {
                connection: "COMP -> R_COMP.1, R_COMP.2 -> C_COMP.1",
                value: 10kΩ
            },
            c_comp1: {
                connection: "R_COMP.2 -> C_COMP1.1, C_COMP1.2 -> GND",
                value: 4.7nF
            },
            c_comp2: {
                connection: "COMP -> C_COMP2.1, C_COMP2.2 -> GND",
                value: 47pF
            }
        },
        
        // Soft-start capacitor
        soft_start: {
            connection: "SS -> C_SS.1, C_SS.2 -> GND",
            value: 10nF,
            soft_start_time: "5ms typical"
        }
    }
};

// ==================== ELECTRICAL CHARACTERISTICS ====================
const TPS54331_ELECTRICAL = {
    // Output specifications
    output_voltage_range: (0.8V, 25V),   // Adjustable range
    output_current_max: 3A,
    output_accuracy: 1%,                 // Reference accuracy
    
    // Efficiency
    efficiency_typical: {
        "12V_to_5V_1A": 89%,
        "12V_to_5V_3A": 85%,
        "24V_to_5V_1A": 87%,
        "24V_to_5V_3A": 83%,
        "12V_to_3.3V_1A": 87%,
        "12V_to_3.3V_3A": 82%
    },
    
    // Switching characteristics
    switching_frequency: 570kHz,
    frequency_tolerance: 20%,
    min_on_time: 130ns,
    min_off_time: 300ns,
    
    // Current limit
    peak_current_limit: 4.5A,
    valley_current_limit: 3.5A,
    
    // Quiescent current
    operating_current: 75uA,             // Not switching
    shutdown_current: 2uA
};

// ==================== THERMAL CHARACTERISTICS ====================
const TPS54331_THERMAL = {
    // SO-8 PowerPAD package
    SO8_PowerPAD: {
        theta_ja: 41.8,                  // °C/W with PowerPAD soldered
        theta_jc: 6.1,                   // °C/W junction to case
        theta_jb: 20.4,                  // °C/W junction to board
        
        max_junction_temp: 150°C,
        operating_range: (-40°C, 125°C),
        thermal_shutdown: 165°C,
        thermal_hysteresis: 15°C,
        
        // PowerPAD requirements
        powerpad_area: 6.45,             // mm²
        thermal_vias: 5,                 // Minimum recommended
        via_diameter: 0.33,              // mm
        copper_area: "1in² per 2W dissipation"
    }
};

