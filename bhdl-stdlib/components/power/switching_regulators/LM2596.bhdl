// ==================== COMPONENT EXPANSION FOR VIRTUAL PINS ====================
// If the module uses virtual pins, this is how they expand
export function expand_lm2596_virtual_pins(
    vout: voltage,
    iout_max: current
): ComponentList {
    const components = [];
    
    // Calculate inductor value
    const L = 33e-6; // 33uH for 5V typical
    components.push({
        type: "inductor",
        value: L,
        current_rating: iout_max * 1.5,
        part_number: "SRR1260-330M"
    });
    
    // Add catch diode
    components.push({
        type: "schottky_diode",
        voltage_rating: 45V,
        current_rating: iout_max,
        part_number: "SS34"
    });
    
    // Add output capacitor
    components.push({
        type: "capacitor",
        value: 470e-6,
        voltage_rating: vout * 1.5,
        esr_max: 0.1,
        type: "electrolytic"
    });
    
    // Add feedback resistors for adjustable version
    const R2 = 1000; // 1kΩ
    const R1 = R2 * (vout / 1.23 - 1);
    components.push(
        {
            type: "resistor",
            value: R1,
            tolerance: 1,
            package: "0603"
        },
        {
            type: "resistor",
            value: R2,
            tolerance: 1,
            package: "0603"
        }
    );
    
    return components;
}

