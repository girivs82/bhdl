// LM2596 — TI Simple Switcher 3A step-down (buck) regulator (SNVS124).
//
// Regenerated to the current v2 standard. The pre-v2 entity used struct-block
// pin definitions (`pin VIN: power in { voltage_range: (…), … }`), a
// `supporting_components: { … }` struct for the virtual-pin expansion, and a
// trailing pile of `const … = { … }` knowledge maps + `export function`s —
// none of which the current parser accepts, so it failed to load on import.
//
// Modelled on power/tps54331.bhdl: electrical targets are constructor params,
// a `design { }` block sizes the reactive support + feedback divider from the
// operating point, and an `expansion { }` materialises the datasheet's output
// power stage. The board supplies its own input bulk caps (the LM2596
// application circuit keeps C_IN external and close to VIN), so the expansion
// covers only the SW→VOUT side: catch diode, output inductor, output caps,
// feedback divider and feed-forward cap.
//
// Datasheet sizing (TI SNVS124, buck application equations):
//   - L_out : (V_IN−V_OUT)·D / (f_sw·ΔI_L),  ΔI_L = ripple_ratio·I_out
//   - C_out : ΔI_L / (8·f_sw·ΔV_out)            (ripple lower bound; sim grows it)
//   - R_top : R_bot·(V_OUT/V_REF − 1)           (V_REF = 1.23V internal)
// Fixed by datasheet: Schottky catch diode, 0.1µF output ceramic, 100pF
// feed-forward cap across R_top. These are STEADY-STATE SEED values — GLACIER
// + SPICE close the loop and refine where the closed form under-provisions
// (output cap in particular is transient/ESR-dominated, see tps54331 notes).
//
// Use site (board):  U1: LM2596(vout_target = 12V);  VIN -> U1.VIN; …;
//                    U1.VOUT -> @VOUT_12V;

entity LM2596(
    vout_target:  voltage     = 5V,      // regulated output (sets divider + duty)
    v_in:         voltage     = 12V,     // input rail (sets duty cycle)
    i_out_max:    current     = 3A,      // max load current
    f_sw:         frequency   = 150kHz,  // fixed internal oscillator
    ripple_ratio: float       = 0.3,     // ΔI_L / I_out (datasheet 0.2–0.4)
    ripple_v:     voltage      = 50mV,   // target output ripple
    r_fb_bot:     resistance   = 1kΩ,    // FB divider reference resistor (R2)
    diode_vf:     voltage      = 0.5V,   // Schottky catch-diode forward drop
    rds_on:       resistance   = 0.39,   // NPN switch effective on-resistance (V_SAT/I)
    t_sw:         time         = 50ns,   // transition class figure (loss estimate)
    i_quiescent:  current      = 5mA     // quiescent current, typ (no load)
) {
    pin VIN:  power in;
    pin VOUT: power out virtual;
    pin SW:   switch out;
    pin FB:   feedback in;
    pin EN:   signal in;
    pin GND:  ground;

    attribute component_class     = "switching_regulator";
    attribute topology            = "buck";
    attribute output_voltage      = vout_target;
    attribute output_current      = 3A;     // rated continuous
    attribute switching_frequency = f_sw;
    attribute feedback_voltage    = 1.23V;  // internal FB reference
    attribute rds_on              = rds_on;
    attribute t_sw                = t_sw;
    attribute i_quiescent         = i_quiescent;

    // Reactive + divider sizing — runs once per instance after constructor
    // binding, before expansion. One binary op per `const` (same discipline
    // as lm317/tps54331); all quantities in SI base units (V, A, Hz → H, F, Ω).
    design {
        const v_ref = 1.23;                      // LM2596 internal FB ref
        const vout  = self.vout_target;          // regulated output target
        require vout < self.v_in
            else "buck V_OUT must be below V_IN";

        const duty  = vout / self.v_in;          // D = V_OUT / V_IN
        const vdiff = self.v_in - vout;          // V_IN − V_OUT

        // L_out = (V_IN−V_OUT)·D / (f_sw·ΔI_L),  ΔI_L = ripple_ratio·I_out.
        const d_il  = self.ripple_ratio * self.i_out_max;
        const l_num = vdiff * duty;
        const l_den = self.f_sw * d_il;
        l_value     = l_num / l_den;

        // Inductor saturation-current requirement: I_peak = I_out + ΔI_L/2,
        // 1.3× headroom over peak → the supply provider's current gate.
        const il_half     = d_il / 2.0;
        const i_peak      = self.i_out_max + il_half;
        l_rated_current   = i_peak * 1.3;

        // C_out = ΔI_L / (8·f_sw·ΔV_out)  (ripple lower bound).
        const co_d0 = self.f_sw * self.ripple_v;
        const co_d  = co_d0 * 8.0;
        c_out_value = d_il / co_d;

        // FB divider: V_OUT = V_REF·(1 + R_top/R_bot) ⇒
        //   R_top = R_bot·(V_OUT − V_REF)/V_REF.
        const vov     = vout - v_ref;
        const r_scale = self.r_fb_bot / v_ref;
        r_top_value   = vov * r_scale;
    }

    // Computed values flow in by variable name; R_bot, the catch diode, the
    // 0.1µF output ceramic and the 100pF feed-forward cap are datasheet-fixed.
    expansion {
        SW -> L_out: Ind(l_value, rated_current = l_rated_current).1; L_out.2 -> VOUT;
        GND -> D_catch: Diode(diode_vf).A; D_catch.K -> SW;
        VOUT -> C_out: Cap(c_out_value).1; C_out.2 -> GND;
        VOUT -> C_out2: Cap(0.1µF).1; C_out2.2 -> GND;
        // Precision FB divider sets output-voltage accuracy — 1% graded parts.
        VOUT -> R_top: Res(r_top_value, tolerance = 1%, supply_profile = "grade").1; R_top.2 -> FB;
        FB -> R_bot: Res(r_fb_bot, tolerance = 1%, supply_profile = "grade").1; R_bot.2 -> GND;
        VOUT -> C_ff: Cap(100pF).1; C_ff.2 -> FB;
    }

    // §4 device-stress IP: buck stress on this part's own expansion children
    // at the solved operating point, against the SNAPPED values (the board
    // supplies its own input bulk caps, so there is no C_in axis here).
    simulation {
        stress {
            const duty = vout / vin;
            const d_il = (vin - vout) * duty / (self.switching_frequency * L_out.value);
            L_out.i_peak   = i_out + d_il / 2;
            C_out.v_ripple = d_il / (8 * self.switching_frequency * C_out.value);
        }
    }
}

symbol LM2596 {
    left   { VIN, EN }
    right  { SW, FB }
    bottom { GND }
}

layout LM2596 {
    package TO-263-5;
}
