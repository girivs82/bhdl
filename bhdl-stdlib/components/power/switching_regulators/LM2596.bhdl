// LM2596 Simple Switcher Buck Regulator - Complete Component Knowledge Repository
// 3A Step-Down Voltage Regulator with all knowledge in one file

import { voltage, current, power, resistance, capacitance, inductance, frequency, temperature, time } from "../../../units.bhdl";

// ==================== COMPONENT DEFINITION ====================
module LM2596(
    vout_target: voltage = 5V,          // Target output voltage for feedback
    enable: bool = true                 // Enable control
) {
    // Power pins
    pin VIN: power in {
        voltage_range: (4.5V, 40V),     // Wide input range
        voltage_abs_max: 45V,
        description: "Input supply voltage"
    };
    
    pin SW: switch out {
        current_max: 3A,                // Peak switch current
        voltage_max: 45V,
        switching_freq: 150kHz,
        description: "Switch output to inductor"
    };
    
    pin GND: ground inout {
        description: "Ground reference and heat sink"
    };
    
    pin FB: feedback in {
        voltage_ref: 1.23V,              // Internal reference voltage
        input_impedance: 100kΩ,
        description: "Feedback for output regulation"
    };
    
    pin EN: signal in {
        threshold_on: 1.5V,
        threshold_off: 0.8V,
        pull_up_current: 5uA,
        description: "Enable input (tie to VIN if not used)"
    };
}

