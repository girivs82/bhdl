// Base module for Linear Voltage Regulators
// Provides common types and base functionality for all linear regulators

import { ImpedanceCharacteristics } from "../types/electrical_types.bhdl";

// Linear regulator electrical characteristics
type LinearRegulatorParams = {
    output_voltage: voltage,
    output_current: current,
    dropout_voltage: voltage,
    quiescent_current: current,
    line_regulation: percentage,
    load_regulation: percentage,
    ripple_rejection: float,    // dB
    thermal_resistance: float,  // °C/W
    max_junction_temp: temperature,
    impedance: ImpedanceCharacteristics,
};

// Base module that specific regulators can extend
module LinearRegulatorBase(
    output_voltage: voltage,
    max_current: current = 1A,
    params: LinearRegulatorParams?
) {
    // Standard 3-pin regulator pinout
    pin VIN: power in;    // Input voltage
    pin VOUT: power out;  // Regulated output
    pin GND: ground;      // Ground reference
    
    // Common attributes for all linear regulators
    attribute component_class = "linear_regulator";
    attribute output_voltage = output_voltage;
    attribute max_output_current = max_current;
    
    // If params provided, expose impedance characteristics
    attribute can_source_current = params?.impedance.can_source_current;
    attribute max_source_current = params?.impedance.max_source_current;
    attribute power_domain_isolation = params?.impedance.power_domain_isolation;
    attribute voltage_drop = params?.impedance.voltage_drop;
    attribute current_limiting = params?.impedance.current_limiting;
    attribute output_impedance = params?.impedance.output_impedance;
}

// Export types for use by specific regulator implementations
export { LinearRegulatorParams, LinearRegulatorBase };