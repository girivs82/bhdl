// LM7805 Linear Voltage Regulator (Parser-compatible version)
// 5V 1A output with various package options

import { LinearRegulatorParams, LinearRegulatorBase } from "./linear_regulator_base.bhdl";

entity LM7805(package: string = "TO-220") {
    pin IN: power in @metadata(
        function="PowerIn",
        description="Input voltage (7-35V)",
        electrical_type="power_input",
        voltage_range="7V-35V"
    );     // Input voltage (7-35V)
    pin GND: ground @metadata(
        function="Ground",
        description="Ground reference",
        electrical_type="ground"
    );      // Ground
    pin OUT: power out @metadata(
        function="PowerOut",
        description="Regulated 5V output @ 1A",
        electrical_type="power_output",
        voltage="5V",
        current="1A"
    );   // Regulated 5V output @ 1A
    
    // Additional pins for enhanced versions
    pin EN: signal in when package == "TO-220-5" || package == "TO-263-5" @metadata(
        function="Enable",
        description="Enable input",
        electrical_type="control_input"
    );   // Enable pin
    pin ADJ: signal in when package == "TO-220-5" || package == "TO-263-5" @metadata(
        function="Adjust",
        description="Output voltage adjust",
        electrical_type="control_input"
    );  // Adjust pin
    
    // LM7805-specific parameters (simplified for parser compatibility)
    const OUTPUT_VOLTAGE: voltage = 5V;
    const OUTPUT_CURRENT: current = 1A;
    const DROPOUT_VOLTAGE: voltage = 2V;
    const QUIESCENT_CURRENT: current = 5mA;
    const LINE_REGULATION: percentage = 0.01%;
    const LOAD_REGULATION: percentage = 0.1%;
    const RIPPLE_REJECTION: float = 73;  // dB
    const THERMAL_RESISTANCE: float = 5;  // °C/W for TO-220
    const MAX_JUNCTION_TEMP: temperature = 125°C;
    
    // Simplified impedance characteristics
    const OUTPUT_IMPEDANCE: resistance = 30mΩ;
    const MAX_SOURCE_CURRENT: current = 1A;
    const VOLTAGE_DROP: voltage = 2V;
    const TRANSIENT_RESPONSE_US: float = 5;  // microseconds (workaround)
    
    // Electrical specifications
    attribute output_voltage = OUTPUT_VOLTAGE;
    attribute output_tolerance = "4%";  // ±4% typical
    attribute max_input_voltage = "35V";
    attribute min_input_voltage = "7V";  // 2V dropout
    attribute dropout_voltage = DROPOUT_VOLTAGE;
    attribute max_output_current = OUTPUT_CURRENT;
    attribute quiescent_current = QUIESCENT_CURRENT;
    attribute line_regulation = LINE_REGULATION;
    attribute load_regulation = LOAD_REGULATION;
    attribute ripple_rejection = RIPPLE_REJECTION;
    
    // Impedance characteristics
    attribute output_impedance = OUTPUT_IMPEDANCE;
    attribute can_source_current = true;
    attribute max_source_current = MAX_SOURCE_CURRENT;
    attribute power_domain_isolation = true;
    attribute voltage_drop = VOLTAGE_DROP;
    attribute current_limiting = true;
    attribute transient_response_us = TRANSIENT_RESPONSE_US;
    
    // Thermal specifications - package dependent
    attribute thermal_resistance = 
        package == "TO-220" ? 5 :      // °C/W
        package == "TO-263" ? 3 :
        package == "SOT-223" ? 15 :
        5;
    attribute max_junction_temp = MAX_JUNCTION_TEMP;
    
    // Component database mapping
    attribute component_class = "voltage_regulator";
    attribute regulator_type = "linear";
    attribute fixed_output = true;
    
    // KiCad symbol mapping
    attribute kicad_symbol = 
        package == "TO-220-5" ? "Regulator_Linear:LM7805_TO220_5pin" :
        "Regulator_Linear:LM7805_TO220";
    
    // Available packages
    attribute packages = "TO-220,TO-220-5,TO-263,TO-263-5,SOT-223";
    attribute default_package = "TO-220";
    
    // Protection features
    attribute has_thermal_protection = true;
    attribute has_current_limiting = true;
    attribute has_short_circuit_protection = true;
    
    // Recommended external components
    attribute input_capacitor_min = "0.33µF";   // Minimum input capacitor
    attribute output_capacitor_min = "0.1µF";   // Minimum output capacitor
    attribute input_capacitor_rec = "10µF";     // Recommended for ripple rejection
    attribute output_capacitor_rec = "1µF";     // Recommended for stability
    
    // SPICE model parameters
    attribute spice_model = "voltage_regulator";
    attribute spice_output_voltage = OUTPUT_VOLTAGE;
    attribute spice_dropout_voltage = DROPOUT_VOLTAGE;
    attribute spice_quiescent_current = QUIESCENT_CURRENT;
}

// Common aliases
alias 7805 = LM7805;
alias L7805 = LM7805;
alias UA7805 = LM7805;
alias MC7805 = LM7805;