// LM7805 Linear Voltage Regulator
// 5V 1A output with various package options

import { LinearRegulatorParams, LinearRegulatorBase } from "./linear_regulator_base.bhdl";

module LM7805(package: string = "TO-220") {
    pin IN: power in @metadata(
        function="PowerIn",
        description="Input voltage (7-35V)",
        electrical_type="power_input",
        voltage_range="7V-35V"
    );     // Input voltage (7-35V)
    pin GND: ground @metadata(
        function="Ground",
        description="Ground reference",
        electrical_type="ground"
    );      // Ground
    pin OUT: power out @metadata(
        function="PowerOut",
        description="Regulated 5V output @ 1A",
        electrical_type="power_output",
        voltage="5V",
        current="1A"
    );   // Regulated 5V output @ 1A
    
    // Additional pins for enhanced versions
    pin EN: signal in when package == "TO-220-5" || package == "TO-263-5" @metadata(
        function="Enable",
        description="Enable input",
        electrical_type="control_input"
    );   // Enable pin
    pin ADJ: signal in when package == "TO-220-5" || package == "TO-263-5" @metadata(
        function="Adjust",
        description="Output voltage adjust",
        electrical_type="control_input"
    );  // Adjust pin
    
    // LM7805-specific parameters
    const LM7805_PARAMS: LinearRegulatorParams = {
        output_voltage: 5V,
        output_current: 1A,
        dropout_voltage: 2V,
        quiescent_current: 5mA,
        line_regulation: 0.01%,
        load_regulation: 0.1%,
        ripple_rejection: 73,  // dB
        thermal_resistance: 5,  // °C/W for TO-220
        max_junction_temp: 125°C,
        impedance: {
            dc_resistance: null,
            output_impedance: 0.03Ω,  // 30mΩ typical
            input_impedance: null,
            can_source_current: true,
            can_sink_current: false,
            max_source_current: 1A,
            max_sink_current: null,
            power_domain_isolation: true,  // Regulates input to output
            voltage_drop: 2V,  // Dropout voltage
            current_limiting: true,  // Has internal current limiting
            transient_response: 5μs,
            inrush_current: null
        }
    };
    
    // Use parameters
    const params = LM7805_PARAMS;
    
    // Electrical specifications
    attribute output_voltage = params.output_voltage;
    attribute output_tolerance = "4%";  // ±4% typical
    attribute max_input_voltage = "35V";
    attribute min_input_voltage = "7V";  // 2V dropout
    attribute dropout_voltage = params.dropout_voltage;
    attribute max_output_current = params.output_current;
    attribute quiescent_current = params.quiescent_current;
    attribute line_regulation = params.line_regulation;
    attribute load_regulation = params.load_regulation;
    attribute ripple_rejection = params.ripple_rejection;
    
    // Impedance characteristics
    attribute output_impedance = params.impedance.output_impedance;
    attribute can_source_current = params.impedance.can_source_current;
    attribute max_source_current = params.impedance.max_source_current;
    attribute power_domain_isolation = params.impedance.power_domain_isolation;
    attribute voltage_drop = params.impedance.voltage_drop;
    attribute current_limiting = params.impedance.current_limiting;
    attribute transient_response = params.impedance.transient_response;
    
    // Thermal specifications - package dependent
    attribute thermal_resistance = 
        package == "TO-220" ? 5 :      // °C/W
        package == "TO-263" ? 3 :
        package == "SOT-223" ? 15 :
        5;
    attribute max_junction_temp = params.max_junction_temp;
    
    // Component database mapping
    attribute component_class = "voltage_regulator";
    attribute regulator_type = "linear";
    attribute fixed_output = true;
    
    // KiCad symbol mapping
    attribute kicad_symbol = 
        package == "TO-220-5" ? "Regulator_Linear:LM7805_TO220_5pin" :
        "Regulator_Linear:LM7805_TO220";
    
    // Available packages
    attribute packages = "TO-220,TO-220-5,TO-263,TO-263-5,SOT-223";
    attribute default_package = "TO-220";
    
    // Protection features
    attribute has_thermal_protection = true;
    attribute has_current_limiting = true;
    attribute has_short_circuit_protection = true;
    
    // Recommended external components
    attribute input_capacitor_min = "0.33µF";   // Minimum input capacitor
    attribute output_capacitor_min = "0.1µF";   // Minimum output capacitor
    attribute input_capacitor_rec = "10µF";     // Recommended for ripple rejection
    attribute output_capacitor_rec = "1µF";     // Recommended for stability
    
    // SPICE model parameters
    attribute spice_model = "voltage_regulator";
    attribute spice_output_voltage = params.output_voltage;
    attribute spice_dropout_voltage = params.dropout_voltage;
    attribute spice_quiescent_current = params.quiescent_current;
}

// Common aliases
alias 7805 = LM7805;
alias L7805 = LM7805;
alias UA7805 = LM7805;
alias MC7805 = LM7805;