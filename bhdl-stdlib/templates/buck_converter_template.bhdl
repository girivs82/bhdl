// Generic Buck Converter Schematic Template
// Professional layout template that can be inherited by any buck converter IC

// This template defines the standard buck converter topology layout
// Individual components can override or extend these positions

type BuckConverterTemplate = {
    // Standard buck converter component roles and positions
    // All positions are relative to IC center at (0, 0)
    
    // Input section (left side)
    input_filter: {
        primary_cap: { x: -70, y: 100, type: "capacitor", value_placeholder: true },
        secondary_cap: { x: -105, y: 100, type: "capacitor", value_placeholder: true },
        ceramic_cap: { x: -105, y: 140, type: "capacitor", optional: true }
    },
    
    // Power conversion section (center)
    power_stage: {
        inductor: { x: 80, y: 0, type: "inductor", value_placeholder: true },
        freewheeling_diode: { x: 20, y: 80, type: "diode", optional: true }, // For non-sync
        current_sense: { x: 60, y: -20, type: "resistor", optional: true }
    },
    
    // Output section (right side)  
    output_filter: {
        primary_cap: { x: 150, y: 100, type: "capacitor", value_placeholder: true },
        secondary_cap: { x: 185, y: 100, type: "capacitor", value_placeholder: true },
        ceramic_cap: { x: 185, y: 140, type: "capacitor", optional: true }
    },
    
    // Feedback network (below output)
    feedback: {
        top_resistor: { x: 200, y: 160, type: "resistor", value_placeholder: true },
        bottom_resistor: { x: 200, y: 200, type: "resistor", value_placeholder: true },
        compensation_cap: { x: 240, y: 180, type: "capacitor", optional: true }
    },
    
    // Control components
    control: {
        enable_pullup: { x: -40, y: -60, type: "resistor", optional: true },
        soft_start_cap: { x: 40, y: -60, type: "capacitor", optional: true },
        bootstrap_cap: { x: 0, y: -60, type: "capacitor", optional: true },
        compensation_network: { x: 80, y: -60, type: "rc_network", optional: true }
    },
    
    // Standard wire routing patterns
    routing_template: {
        power_flow: "left_to_right",
        input_path: "rail_to_caps_to_ic",
        switching_path: "ic_to_inductor_orthogonal",
        output_path: "inductor_to_rail_to_caps",
        feedback_path: "vout_divider_to_fb_orthogonal",
        ground_strategy: "star_at_ic"
    },
    
    // Layout constraints
    layout_rules: {
        min_input_cap_spacing: 5,      // Units between input caps
        inductor_clearance: 15,         // Clear area around inductor
        feedback_isolation: 10,         // Keep feedback away from SW node
        thermal_pad_keepout: 5,         // Area under IC for thermal pad
        via_fence_sw_node: true         // Via fence around switching node
    },
    
    // Professional appearance
    appearance: {
        show_current_flow: true,
        show_topology_label: "BUCK",
        highlight_switching_node: true,
        color_code_power_domains: true,
        wire_style: "orthogonal_only"
    }
};

// Export the template for use by specific buck converter components
export BuckConverterTemplate;

// Utility function to merge template with specific IC requirements
function apply_buck_template(ic_specific_overrides: any) -> any {
    // This would be called by specific ICs to customize the template
    return merge(BuckConverterTemplate, ic_specific_overrides);
}