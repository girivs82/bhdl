// Behavioral model of a complete buck converter with controller
// This allows system-level simulation beyond component SPICE models

import "../types/electrical_types.bhdl";

// Generic buck converter controller behavioral model
behavioral entity BuckControllerBehavioral(
    vin_min: voltage = 4.5V,
    vin_max: voltage = 28V,
    vout: voltage = 3.3V,
    iout_max: current = 3A,
    fsw: frequency = 500kHz,
    soft_start: time = 10ms
) {
    // Functional pins (not just electrical connections)
    pin VIN: power in;
    pin VOUT: power out @ regulated(vout);
    pin ENABLE: digital in;
    pin PGOOD: digital out @ open_drain;
    pin SYNC: clock in optional;  // External sync option
    
    // Current sensing/limiting
    pin ILIM: analog in optional @ range(0V, 0.2V);  // Current limit setting
    
    // Behavioral parameters
    param efficiency_model: table = [
        // Load%, Efficiency%
        [10, 82],
        [20, 88],
        [50, 92],
        [75, 91],
        [100, 89]
    ];
    
    // Internal state
    state {
        current_state: enum { OFF, SOFT_START, REGULATION, HICCUP, FAULT };
        vref_internal: voltage;
        inductor_current: current;
        duty_cycle: ratio;
        switch_node: voltage;
        pgood_delay: time;
    }
    
    // Behavioral description
    behavior {
        // Main state machine
        match current_state {
            OFF => {
                duty_cycle = 0;
                vref_internal = 0V;
                PGOOD = low;
                
                if (ENABLE == high && VIN > vin_min) {
                    current_state = SOFT_START;
                    pgood_delay = 0;
                }
            }
            
            SOFT_START => {
                // Ramp reference voltage
                vref_internal = min(vref_internal + vout/soft_start * dt, vout);
                
                // Simple PID control
                error = vref_internal - VOUT;
                duty_cycle = pid_control(error, kp=0.1, ki=0.01, kd=0.001);
                duty_cycle = clamp(duty_cycle, 0, 0.9);
                
                // Check for issues
                if (inductor_current > iout_max * 1.5) {
                    current_state = HICCUP;
                } else if (VOUT > 0.9 * vout) {
                    current_state = REGULATION;
                }
            }
            
            REGULATION => {
                // Closed-loop control
                error = vout - VOUT;
                duty_cycle = pid_control(error, kp=0.1, ki=0.01, kd=0.001);
                duty_cycle = clamp(duty_cycle, 0, (VIN - vout) / VIN);
                
                // Power good signal
                if (VOUT in range(0.95 * vout, 1.05 * vout)) {
                    pgood_delay = min(pgood_delay + dt, 2ms);
                    if (pgood_delay >= 2ms) {
                        PGOOD = high_z;  // Open drain release
                    }
                } else {
                    pgood_delay = 0;
                    PGOOD = low;
                }
                
                // Protection
                if (inductor_current > iout_max * 1.5) {
                    current_state = HICCUP;
                } else if (VIN < vin_min || junction_temp > 150°C) {
                    current_state = FAULT;
                }
            }
            
            HICCUP => {
                // Hiccup mode overcurrent protection
                duty_cycle = 0;
                PGOOD = low;
                
                // Wait and retry
                after (100ms) {
                    if (ENABLE == high) {
                        current_state = SOFT_START;
                    } else {
                        current_state = OFF;
                    }
                }
            }
            
            FAULT => {
                duty_cycle = 0;
                PGOOD = low;
                
                // Latch until ENABLE cycled
                if (ENABLE == low) {
                    current_state = OFF;
                }
            }
        }
        
        // Electrical behavior model
        continuous {
            // Switch node voltage
            switch_node = if (switch_on) VIN else 0V;
            
            // Inductor current (simplified)
            di_dt = (switch_node - VOUT) / inductance;
            inductor_current = integrate(di_dt);
            
            // Output current includes losses
            efficiency = interpolate(efficiency_model, load_percent);
            iout = inductor_current * efficiency / 100;
            
            // Current limit
            if (pin_connected(ILIM)) {
                current_limit = ILIM / 0.2V * iout_max;
            } else {
                current_limit = iout_max;
            }
        }
        
        // Timing
        switching {
            if (pin_connected(SYNC)) {
                // External sync
                fsw_actual = frequency(SYNC);
            } else {
                // Internal oscillator
                fsw_actual = fsw * (1 + temp_coefficient * (junction_temp - 25°C));
            }
            
            period = 1 / fsw_actual;
            switch_on = (phase < duty_cycle * period);
        }
    }
    
    // Automatic validation rules (run during synthesis)
    validation {
        // Input voltage range
        assert VIN.voltage in range(vin_min, vin_max) 
            : "Input voltage outside controller range";
        
        // Duty cycle achievable
        assert vout < VIN.voltage * 0.9 
            : "Output voltage too high for input voltage";
        
        // Power dissipation estimate
        power_loss = iout * vout * (100 - efficiency) / efficiency;
        assert power_loss < package.max_dissipation 
            : "Estimated power loss exceeds package rating";
        
        // Switching frequency vs inductor size
        ripple_current = vout * (1 - vout/VIN.voltage) / (inductance * fsw);
        assert ripple_current < 0.3 * iout_max 
            : "Inductor ripple current too high";
    }
    
    // Test access points for simulation
    monitor {
        export duty_cycle as "Duty Cycle";
        export inductor_current as "Inductor Current";
        export switch_node as "Switch Node";
        export efficiency as "Efficiency %";
        export junction_temp as "Junction Temperature";
    }
}

// Behavioral model of complete buck converter (controller + power stage)
behavioral entity BuckConverterComplete(
    vin_nominal: voltage = 12V,
    vout: voltage = 3.3V,
    iout_max: current = 2A,
    fsw: frequency = 500kHz
) {
    // External connections
    pin VIN: power in;
    pin VOUT: power out @ regulated(vout);
    pin ENABLE: digital in;
    pin PGOOD: digital out;
    pin GND: ground;
    
    // Component selection based on requirements
    components {
        // Input capacitor (calculated for RMS current)
        cin_value = calculate_input_cap(iout_max, fsw);
        cin_voltage = vin_nominal * 1.5;  // 50% derating
        
        // Output capacitor (calculated for ripple)
        cout_value = calculate_output_cap(vout, iout_max, fsw, ripple_target=20mV);
        cout_esr_max = 0.05Ω;  // For stability
        
        // Inductor (30% ripple current)
        l_value = vout * (1 - vout/vin_nominal) / (0.3 * iout_max * fsw);
        l_current_rating = iout_max * 1.3;  // 30% margin
        
        // MOSFET selection
        mosfet_vds_rating = vin_nominal * 1.5;
        mosfet_id_rating = iout_max * 1.5;
        mosfet_rds_on_max = 0.05Ω;  // For efficiency
    }
    
    // Internal structure with behavioral controller
    internal {
        controller: BuckControllerBehavioral(
            vin_max=vin_nominal * 1.2,
            vout=vout,
            iout_max=iout_max,
            fsw=fsw
        );
        
        // Connect controller
        VIN -> controller.VIN;
        controller.VOUT -> VOUT;
        ENABLE -> controller.ENABLE;
        controller.PGOOD -> PGOOD;
    }
    
    // System-level behavioral model
    behavior {
        // Startup sequence
        on (ENABLE rising) {
            log("Buck converter enabling...");
            
            // Check preconditions
            if (VIN < controller.vin_min) {
                log("ERROR: VIN too low for startup");
                fault();
            }
        }
        
        // Continuous monitoring
        continuous {
            // Efficiency calculation
            pin = VIN.voltage * VIN.current;
            pout = VOUT.voltage * VOUT.current;
            efficiency = pout / pin * 100;
            
            // Thermal model
            power_loss = pin - pout;
            junction_temp = ambient_temp + power_loss * thermal_resistance;
            
            // Stress monitoring
            peak_switch_voltage = VIN.voltage + spike_voltage;
            assert peak_switch_voltage < mosfet_vds_rating;
        }
    }
    
    // Automatic validation during synthesis
    validation {
        // Component stress validation
        validate_mosfet_soa(peak_voltage, peak_current, switching_time);
        validate_inductor_saturation(l_value, l_current_rating, peak_current);
        validate_capacitor_ripple(cin_value, input_rms_current);
        validate_thermal_design(power_loss, thermal_resistance, max_ambient);
        
        // Stability check
        validate_control_loop_stability(cout_value, cout_esr_max, l_value);
        
        // EMI estimate
        estimate_conducted_emissions(fsw, peak_current, rise_time);
    }
    
    // Built-in test scenarios
    test_scenarios {
        // Load step response
        load_step: {
            apply: load(VOUT) step from 0.1A to 0.9*iout_max at 1A/µs;
            measure: {
                undershoot = min(VOUT) - vout;
                overshoot = max(VOUT) - vout;
                settling_time = time_to_settle(VOUT, vout, 1%);
            }
            pass_if: {
                undershoot > -50mV;
                overshoot < 50mV;
                settling_time < 100µs;
            }
        }
        
        // Line transient
        line_transient: {
            apply: VIN step from vin_nominal*0.9 to vin_nominal*1.1;
            measure: output_deviation = max(abs(VOUT - vout));
            pass_if: output_deviation < 10mV;
        }
        
        // Startup
        startup: {
            apply: ENABLE from low to high with VIN=vin_nominal;
            measure: {
                startup_time = time_to_reach(VOUT, vout*0.9);
                inrush_current = max(VIN.current);
            }
            pass_if: {
                startup_time < soft_start * 1.2;
                inrush_current < iout_max * 2;
                no_oscillation(VOUT);
            }
        }
    }
}