// Multi-Domain Power Rail Synthesis Demo
// Demonstrates correct pull-up rail selection for chips with multiple power domains

import { MCU_MultiDomain } from "../ics/microcontroller_multi_domain.bhdl";
import { LED } from "../optoelectronic/led.bhdl";

board MultiDomainSynthesisDemo {
    // === MULTIPLE POWER SUPPLIES ===
    // Different voltage rails for different domains
    power VCC_1V2 = 1.2V @ 300mA;    // Core voltage
    power VCC_3V3 = 3.3V @ 500mA;    // I/O Bank A and analog
    power VCC_1V8 = 1.8V @ 200mA;    // I/O Bank B  
    power VCC_USB = 3.3V @ 100mA;    // USB supply (could be from different regulator)
    ground GND;
    
    // === MULTI-DOMAIN MICROCONTROLLER ===
    U1: MCU_MultiDomain(package="BGA256");
    
    // Connect all power domains to their respective supplies
    VCC_1V2 -> U1.VDDCORE;    // Core power
    VCC_3V3 -> U1.VDDIO1;     // I/O Bank A (3.3V)
    VCC_1V8 -> U1.VDDIO2;     // I/O Bank B (1.8V)
    VCC_3V3 -> U1.VDDA;       // Analog power
    VCC_USB -> U1.VDDUSB;     // USB PHY power
    
    // Connect all grounds (often shared in practice)
    GND -> U1.VSS;
    GND -> U1.VSSIO1;
    GND -> U1.VSSIO2;
    GND -> U1.VSSA;
    
    // === I2C BUS IN 3.3V DOMAIN ===
    // These will get pull-ups to VCC_3V3 (VDDIO1), NOT to VCC_1V2!
    U1.SCL_3V3 -> i2c_bus_clock;
    U1.SDA_3V3 -> i2c_bus_data;
    /* 
    AUTO-SYNTHESIS for I2C:
    - R_SCL: Res(4.7kΩ) from VCC_3V3 (VDDIO1) to U1.SCL_3V3
    - R_SDA: Res(4.7kΩ) from VCC_3V3 (VDDIO1) to U1.SDA_3V3
    
    CRITICAL: Pull-ups connect to VDDIO1 (3.3V), not VDDCORE (1.2V)!
    If they pulled to VDDCORE, the I2C bus would only reach 1.2V which
    wouldn't meet the VIH threshold for 3.3V I2C devices.
    */
    
    // === MIXED VOLTAGE GPIO ===
    // GPIOs in different banks with different voltages
    U1.PA[0] -> led_driver_3v3;      // 3.3V GPIO
    U1.PB[0] -> high_speed_signal;   // 1.8V GPIO
    
    // Connection between different voltage domains
    signal_3v3 -> U1.PA[1];           // 3.3V input
    U1.PB[1] -> signal_1v8;           // 1.8V output
    
    // Cross-domain connection (needs level shifter)
    U1.PA[2] -> U1.PB[2];  
    /* 
    AUTO-SYNTHESIS for cross-domain:
    - LEVEL_SHIFTER_1: Auto-bidirectional level shifter
      * VCCA connects to VCC_3V3 (VDDIO1)
      * VCCB connects to VCC_1V8 (VDDIO2)
      * Inserted between PA[2] (3.3V domain) and PB[2] (1.8V domain)
    */
    
    // === LED WITH CORRECT CURRENT LIMITING ===
    // LED driven from 3.3V GPIO
    VCC_3V3 -> D1: LED(red).A;
    D1.K -> U1.PA[3];
    /* 
    AUTO-SYNTHESIS for LED:
    - R_LED1: Res(65Ω) in series with D1.A
    - Calculation: (3.3V - 2.0V) / 20mA = 65Ω
    - Uses VCC_3V3 since that's the PA bank voltage
    */
    
    // === HIGH-SPEED DIFFERENTIAL IN 1.8V DOMAIN ===
    U1.USB_DP -> usb_connector.dp;
    U1.USB_DM -> usb_connector.dm;
    /* 
    AUTO-SYNTHESIS for USB:
    - No pull-ups needed (push-pull differential)
    - 90Ω differential impedance routing constraint
    - Length matching constraint
    - Powered by VDDUSB (3.3V) even though some I/O is 1.8V
    */
    
    // === ANALOG INPUTS ===
    sensor_output -> U1.ADC[0];
    /* 
    AUTO-SYNTHESIS for ADC:
    - Anti-aliasing filter: R(1kΩ) + C(calculated)
    - Reference to VDDA (3.3V analog supply)
    - Separate analog ground plane routing
    */
    
    // === POWER INTEGRITY COMPONENTS ===
    /* 
    AUTO-SYNTHESIS for power decoupling (one per domain):
    
    Core Domain (1.2V):
    - C_CORE_1: Cap(100nF) from VCC_1V2 (VDDCORE) to GND (VSS) - very close to U1
    - C_CORE_2: Cap(10µF) from VCC_1V2 to GND - bulk capacitance
    
    I/O Bank A (3.3V):
    - C_IO1_1: Cap(100nF) from VCC_3V3 (VDDIO1) to GND (VSSIO1)
    - C_IO1_2: Cap(10µF) from VCC_3V3 to GND
    
    I/O Bank B (1.8V):
    - C_IO2_1: Cap(100nF) from VCC_1V8 (VDDIO2) to GND (VSSIO2)
    - C_IO2_2: Cap(10µF) from VCC_1V8 to GND
    
    Analog Domain (3.3V):
    - C_ANA_1: Cap(1µF) from VCC_3V3 (VDDA) to GND (VSSA) - larger for analog
    - Ferrite bead in series with VDDA for noise isolation
    
    USB Domain (3.3V):
    - C_USB_1: Cap(100nF) from VCC_USB (VDDUSB) to GND
    - C_USB_2: Cap(4.7µF) from VCC_USB to GND - USB requires more bulk
    */
    
    /*
    SUMMARY OF POWER-AWARE SYNTHESIS:
    
    1. Pull-ups connect to the I/O supply, not core supply
       - I2C pulls to VDDIO1 (3.3V) not VDDCORE (1.2V)
    
    2. Each power domain gets separate decoupling
       - 5 domains = 5 sets of capacitors
    
    3. Cross-domain signals get level shifters
       - 3.3V to 1.8V needs bidirectional level shifter
    
    4. Current limiting uses the driving voltage
       - LED resistor calculated from 3.3V (PA bank voltage)
    
    5. Analog domain gets special treatment
       - Larger capacitors, ferrite beads, separate routing
    
    This automatic synthesis ensures:
    - Correct voltage levels on all buses
    - No voltage domain violations
    - Proper signal integrity
    - Optimal power integrity
    - Safety and reliability
    
    Total components auto-synthesized: ~20 components
    All with correct power rail connections!
    */
}