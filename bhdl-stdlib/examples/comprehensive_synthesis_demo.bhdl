// Comprehensive Intelligent Synthesis Demo
// Shows complete pin characteristics and virtual pin synthesis system
// This circuit will automatically generate many support components

import { MCU_GPIO } from "../ics/microcontroller.bhdl";
import { OpAmp, LM358 } from "../ics/operational_amplifier.bhdl";
import { LogicGate, NAND2_HC } from "../ics/logic_gate.bhdl";
import { LED } from "../passives/led.bhdl";
import { Res } from "../passives/resistor.bhdl";
import { Cap } from "../passives/capacitor.bhdl";

board ComprehensiveSynthesisDemo {
    // Power domains with different voltage levels
    power VCC_5V = 5V @ 1A;
    power VCC_3V3 = 3.3V @ 500mA;
    power VEE_NEG5V = -5V @ 100mA;
    ground GND;
    
    // === MICROCONTROLLER WITH AUTOMATIC PULL-UPS ===
    // MCU with intelligent pin models - will auto-generate pull-ups for I2C
    U1: MCU_GPIO(package="QFN-32");
    
    // Power connections - triggers power integrity synthesis
    VCC_3V3 -> U1.VDD;  // Will auto-insert 100nF + 10µF decoupling caps
    GND -> U1.VSS;
    
    // I2C connections - triggers automatic pull-up insertion
    // These open-drain pins will get 4.7kΩ pull-ups to VCC_3V3
    U1.SCL -> external_i2c_clock;    // Auto-synthesis: R_SCL_PULLUP: 4.7kΩ VCC_3V3 -> U1.SCL
    U1.SDA -> external_i2c_data;     // Auto-synthesis: R_SDA_PULLUP: 4.7kΩ VCC_3V3 -> U1.SDA
    
    // === ANALOG SECTION WITH OP-AMP ===
    // Precision op-amp with automatic support circuits
    U2: OpAmp(type="precision", package="SO8");
    
    // Dual supply for op-amp - triggers supply decoupling synthesis
    VCC_5V -> U2.VCC;   // Auto-synthesis: 100nF decoupling cap very close to pin
    VEE_NEG5V -> U2.VEE; // Auto-synthesis: 100nF decoupling cap very close to pin
    
    // Analog signal chain with automatic protection
    sensor_input -> U2.IN_P;         // Auto-synthesis: TVS diode input protection
    feedback_network -> U2.IN_N;     // Auto-synthesis: TVS diode input protection  
    U2.OUT -> analog_output;         // Auto-synthesis: Series resistance for protection
    
    // Offset adjustment - precision op-amps get automatic offset null network
    // Auto-synthesis: 10kΩ potentiometer between VCC and VEE, wiper to OFFSET_NULL_1
    
    // === DIGITAL LOGIC WITH TERMINATION ===
    // High-speed logic gates with automatic termination
    U3: LogicGate(gate_type="NAND", logic_family="AHC", num_inputs=2, package="SO14");
    
    VCC_5V -> U3.VCC;    // Auto-synthesis: 100nF decoupling cap for digital IC
    GND -> U3.GND;
    
    // High-speed digital signals - triggers termination synthesis
    U1.PA0 -> U3.inputs[0];          // Auto-synthesis: Series termination resistor
    high_speed_clock -> U3.inputs[1]; // Auto-synthesis: Series termination resistor  
    U3.output -> digital_output;      // Auto-synthesis: Series termination at output
    
    // === LED DRIVERS WITH CURRENT LIMITING ===
    // LEDs with automatic current limiting resistor calculation
    VCC_5V -> D1: LED(red).A;        // Auto-synthesis: (5V - 2.0V) / 20mA = 150Ω resistor
    D1.K -> U1.PA1;                  // GPIO sink connection
    
    VCC_3V3 -> D2: LED(blue).A;      // Auto-synthesis: (3.3V - 3.2V) / 20mA = 5Ω resistor  
    D2.K -> U1.PA2;                  // GPIO sink connection
    
    VCC_5V -> D3: LED(green).A;      // Auto-synthesis: (5V - 2.2V) / 20mA = 140Ω resistor
    D3.K -> external_led_sink;       // External connection
    
    // === MIXED SIGNAL INTERFACE ===
    // ADC input with anti-aliasing filter synthesis
    sensor_raw -> U1.ADC_IN;         // Auto-synthesis: R-C anti-aliasing filter
    
    // Reference voltage bypass
    voltage_ref -> U1.VREF;          // Auto-synthesis: 1µF bypass capacitor to ground
    
    // === EXTERNAL CONNECTIONS WITH PROTECTION ===
    // GPIO pins connected externally get protection circuits
    U1.PA3 -> external_gpio_1;       // Auto-synthesis: Series protection resistor + ESD diode
    U1.PA4 -> external_gpio_2;       // Auto-synthesis: Series protection resistor + ESD diode
    
    // === POWER SUPPLY SECTION ===
    // Buck converter input with bulk capacitance
    supply_12v: power_input -> bulk_storage: Cap(470μF).positive;  // Input bulk capacitor
    bulk_storage.negative -> GND;
    
    supply_12v -> switching_regulator.VIN;  // Will trigger input filtering
    switching_regulator.VOUT -> VCC_5V;     // Will trigger output filtering
    switching_regulator.GND -> GND;
    
    // LDO regulator with automatic filtering
    VCC_5V -> ldo_regulator.VIN;           // Auto-synthesis: Input capacitor
    ldo_regulator.VOUT -> VCC_3V3;         // Auto-synthesis: Output capacitor
    ldo_regulator.GND -> GND;
    
    /*
    SYNTHESIS SUMMARY:
    
    After processing through the synthesis engine, this circuit will automatically include:
    
    === I2C PULL-UPS (from open-drain pin detection) ===
    - R_SCL_PULLUP: Res(4.7kΩ) VCC_3V3 -> U1.SCL
    - R_SDA_PULLUP: Res(4.7kΩ) VCC_3V3 -> U1.SDA
    
    === POWER INTEGRITY (from power pin analysis) ===
    - C_MCU_DECP1: Cap(100nF) VCC_3V3 -> GND (very close to U1.VDD)
    - C_MCU_BULK: Cap(10µF) VCC_3V3 -> GND (within 10mm of U1)
    - C_OPAMP_VCC: Cap(100nF) VCC_5V -> VEE_NEG5V (very close to U2.VCC)
    - C_OPAMP_VEE: Cap(100nF) VCC_5V -> VEE_NEG5V (very close to U2.VEE)  
    - C_LOGIC_DECP: Cap(100nF) VCC_5V -> GND (very close to U3.VCC)
    
    === CURRENT LIMITING (from LED forward voltage analysis) ===
    - R_LED1: Res(150Ω) in series with D1.A (calculated: (5V-2.0V)/20mA)
    - R_LED2: Res(5Ω) in series with D2.A (calculated: (3.3V-3.2V)/20mA)  
    - R_LED3: Res(140Ω) in series with D3.A (calculated: (5V-2.2V)/20mA)
    
    === INPUT PROTECTION (from analog pin analysis) ===
    - TVS1: TVSDiode(6V) sensor_input -> VEE_NEG5V
    - TVS2: TVSDiode(6V) feedback_network -> VEE_NEG5V
    
    === HIGH-SPEED TERMINATION (from logic family analysis) ===
    - R_TERM1: Res(50Ω) in series with U3.inputs[0]
    - R_TERM2: Res(50Ω) in series with U3.inputs[1]
    - R_TERM3: Res(50Ω) in series with U3.output
    
    === GPIO PROTECTION (from external connection analysis) ===
    - R_PROT1: Res(100Ω) in series with U1.PA3
    - R_PROT2: Res(100Ω) in series with U1.PA4
    - ESD1: TVSDiode(4V) external_gpio_1 -> GND
    - ESD2: TVSDiode(4V) external_gpio_2 -> GND
    
    === ANALOG SIGNAL CONDITIONING ===
    - R_AA: Res(1kΩ) in series with U1.ADC_IN
    - C_AA: Cap(159pF) U1.ADC_IN -> GND (anti-aliasing filter)
    - C_VREF: Cap(1µF) U1.VREF -> GND (reference bypass)
    
    === PRECISION ANALOG SUPPORT ===  
    - POT_OFFSET: Potentiometer(10kΩ) VCC_5V -> VEE_NEG5V, wiper -> U2.OFFSET_NULL_1
    
    All component values calculated based on:
    - Actual supply voltages (5V, 3.3V, -5V)
    - Component electrical specifications (LED Vf, op-amp requirements)
    - Signal integrity requirements (impedance matching, termination)
    - Safety margins and derating factors
    
    Total additional components synthesized: ~25 components
    Design time saved: 2-3 hours of manual circuit design
    Error reduction: Eliminates calculation errors and missing support circuits
    */
}