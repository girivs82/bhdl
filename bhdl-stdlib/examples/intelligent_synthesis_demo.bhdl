// Intelligent Synthesis Demo
// Shows how pin characteristics enable automatic component insertion

import { MCU_GPIO } from "../ics/microcontroller.bhdl";
import { LED } from "../passives/led.bhdl";

board IntelligentSynthesisDemo {
    // Power domains
    power VDD = 3.3V @ 500mA;
    ground GND;
    
    // Microcontroller with intelligent pin models
    U1: MCU_GPIO(package="QFN-32");
    
    // Connect power - synthesizer will auto-insert decoupling caps
    VDD -> U1.VDD;  // Triggers: power_decoupling, bulk_capacitance
    GND -> U1.VSS;
    
    // I2C connection - synthesizer will auto-insert pull-ups
    // These are open-drain pins that need pull-ups
    U1.SCL -> external_scl;  // Triggers: i2c_pullup_insertion (4.7kΩ to VDD)
    U1.SDA -> external_sda;  // Triggers: i2c_pullup_insertion (4.7kΩ to VDD)
    
    // LED connections - synthesizer will auto-insert current limiting resistors
    VDD -> D1: LED(red).A;   // Triggers: led_current_limiting 
    D1.K -> U1.PA0;         // Calculated: (3.3V - 2.0V) / 20mA = 65Ω
    
    VDD -> D2: LED(green).A; // Triggers: led_current_limiting
    D2.K -> U1.PA1;         // Calculated: (3.3V - 2.2V) / 20mA = 55Ω
    
    // SPI high-speed connection - synthesizer may add termination
    U1.SCLK -> external_spi_clk;  // May trigger: high_speed_termination
    U1.MOSI -> external_spi_mosi;
    external_spi_miso -> U1.MISO; // May trigger: high_speed_termination
    
    // External GPIO connections - synthesizer adds protection
    U1.PA0 -> external_gpio;  // May trigger: gpio_current_protection, external_esd_protection
    
    /* 
    After synthesis, the circuit will automatically include:
    
    1. Power integrity components:
       - 100nF decoupling capacitor close to U1.VDD
       - 10µF bulk capacitor near power entry
       
    2. I2C pull-up resistors:
       - R_SCL: 4.7kΩ between VDD and U1.SCL
       - R_SDA: 4.7kΩ between VDD and U1.SDA
       
    3. LED current limiting resistors:
       - R_LED1: 65Ω in series with D1.A
       - R_LED2: 55Ω in series with D2.A
       
    4. Protection components:
       - Series resistance on external GPIO connections
       - ESD protection diodes on external connections
       
    5. High-speed signal conditioning:
       - Termination resistors on SPI lines if frequency > 50MHz
       - Length matching constraints for differential pairs
       
    All component values are calculated based on:
    - Pin electrical models (drive strength, impedance)
    - Supply voltage levels
    - Component specifications (LED forward voltage, current)
    - Signal integrity requirements (frequency, edge rates)
    */
}