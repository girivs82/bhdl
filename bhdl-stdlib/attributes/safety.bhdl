// ═══════════════════════════════════════════════════════════════════
// BHDL Standard Library - Safety Attributes
// ISO 26262 Functional Safety Support
// ═══════════════════════════════════════════════════════════════════

// ───────────────────────────────────────────────────────────────────
// ASIL LEVELS
// ───────────────────────────────────────────────────────────────────

attribute_type asil: enum {
    description: "Automotive Safety Integrity Level per ISO 26262";
    values: [QM, ASIL_A, ASIL_B, ASIL_C, ASIL_D];
    
    // Ordering for comparison
    ordering: QM < ASIL_A < ASIL_B < ASIL_C < ASIL_D;
}

// ───────────────────────────────────────────────────────────────────
// SAFETY METRICS
// ───────────────────────────────────────────────────────────────────

attribute_type spfm: percentage {
    description: "Single Point Fault Metric";
    range: 0%..100%;
    
    // ASIL requirements
    asil_b_min: 90%;
    asil_c_min: 97%;
    asil_d_min: 99%;
}

attribute_type lfm: percentage {
    description: "Latent Fault Metric";
    range: 0%..100%;
    
    // ASIL requirements
    asil_b_min: 60%;
    asil_c_min: 80%;
    asil_d_min: 90%;
}

attribute_type pmhf: failure_rate {
    description: "Probabilistic Metric for random Hardware Failures";
    unit: FIT;  // Failures In Time (per billion hours)
    range: 0..∞;
    
    // ASIL requirements
    asil_b_max: 100FIT;
    asil_c_max: 100FIT;
    asil_d_max: 10FIT;
}

attribute_type diagnostic_coverage: percentage {
    description: "Percentage of faults detected by diagnostics";
    range: 0%..100%;
    
    classifications: {
        low: 60%..90%;
        medium: 90%..99%;
        high: 99%..100%;
    }
}

// ───────────────────────────────────────────────────────────────────
// ISO 26262 HAZARD CLASSIFICATION
// ───────────────────────────────────────────────────────────────────

attribute_type severity: enum {
    description: "Severity of potential injury";
    values: [
        S0,  // No injuries
        S1,  // Light to moderate injuries
        S2,  // Severe to life-threatening injuries (survival probable)
        S3   // Life-threatening to fatal injuries (survival uncertain)
    ];
}

attribute_type exposure: enum {
    description: "Probability of exposure to hazard";
    values: [
        E0,  // Very low probability
        E1,  // Low probability
        E2,  // Medium probability
        E3,  // High probability
        E4   // Very high probability
    ];
}

attribute_type controllability: enum {
    description: "Ability to avoid harm through driver action";
    values: [
        C0,  // Controllable in general
        C1,  // Simply controllable
        C2,  // Normally controllable
        C3   // Difficult to control or uncontrollable
    ];
}

// ───────────────────────────────────────────────────────────────────
// SAFETY TIMING REQUIREMENTS
// ───────────────────────────────────────────────────────────────────

attribute_type fault_tolerance_time: time {
    description: "Time to detect fault and reach safe state";
    units: [µs, ms, s];
    range: 0..∞;
}

attribute_type diagnostic_test_interval: time {
    description: "Maximum time between diagnostic tests";
    units: [ms, s];
    range: 0..∞;
}

attribute_type proof_test_interval: time {
    description: "Interval for proof testing";
    units: [hours, days, months];
    range: 0..∞;
}

// ───────────────────────────────────────────────────────────────────
// FAILURE MODES
// ───────────────────────────────────────────────────────────────────

attribute_type failure_mode: struct {
    description: "Description of a failure mode";
    
    fields: {
        mode: string;           // What fails
        rate: FIT;             // Failure rate
        effect: string;        // Local effect
        detection: string;     // How detected
        coverage: percentage;  // Detection coverage
    }
}

attribute_type failure_rate: quantity {
    description: "Component or system failure rate";
    unit: FIT;
    range: 0..∞;
    
    // Typical ranges
    typical_resistor: 0.1FIT;
    typical_capacitor: 0.5FIT;
    typical_ic_simple: 10FIT;
    typical_ic_complex: 50FIT;
}

// ───────────────────────────────────────────────────────────────────
// SAFETY MECHANISMS
// ───────────────────────────────────────────────────────────────────

attribute_type safety_mechanism: struct {
    description: "Safety mechanism specification";
    
    fields: {
        type: enum[monitoring, protection, diagnostic, redundancy];
        coverage: percentage;
        response_time: time;
        test_interval: time;
    }
}

// ───────────────────────────────────────────────────────────────────
// SAFETY CAPABILITIES (What components can provide)
// ───────────────────────────────────────────────────────────────────

capability VoltageMonitoring {
    description: "Ability to monitor voltage levels";
    
    parameters: {
        monitored_rails: [voltage];
        undervoltage_threshold: voltage;
        overvoltage_threshold: voltage;
        accuracy: percentage;
        response_time: time;
    }
    
    provides: diagnostic_coverage;
}

capability OvervoltageProtection {
    description: "Ability to protect against overvoltage";
    
    parameters: {
        protected_rail: voltage;
        threshold: voltage;
        response_time: time;
        method: enum[shutdown, clamp, crowbar];
    }
    
    provides: safety_mechanism;
}

capability CurrentLimiting {
    description: "Ability to limit output current";
    
    parameters: {
        limit_current: current;
        response_time: time;
        retry_strategy: enum[hiccup, latch, continuous];
    }
    
    provides: safety_mechanism;
}

capability DiagnosticReadback {
    description: "Ability to report diagnostic status";
    
    parameters: {
        status_signals: [signal];
        update_rate: frequency;
        fault_types: [enum[open, short, overtemp, overvoltage]];
    }
    
    provides: diagnostic_coverage;
}

capability SafeStateControl {
    description: "Ability to enter defined safe state";
    
    parameters: {
        safe_states: [string];
        trigger_conditions: [string];
        response_time: time;
    }
    
    provides: safety_mechanism;
}

capability SelfTest {
    description: "Ability to perform self-testing";
    
    parameters: {
        test_coverage: percentage;
        test_interval: time;
        test_duration: time;
        online_testing: bool;
    }
    
    provides: diagnostic_coverage;
}

capability PowerSequencing {
    description: "Controlled power-up/down sequencing";
    
    parameters: {
        sequence_order: [string];
        timing_constraints: [time];
        fault_handling: enum[abort, continue, retry];
    }
    
    provides: safety_mechanism;
}

// ───────────────────────────────────────────────────────────────────
// SAFETY REQUIREMENT TYPES
// ───────────────────────────────────────────────────────────────────

attribute_type SafetyRequirement: struct {
    description: "Safety requirement specification";
    
    fields: {
        id: string;
        description: string;
        asil: asil;
        allocation: string;
        verification_method: enum[test, analysis, inspection, demonstration];
    }
}

attribute_type SafetyGoal: struct {
    description: "Top-level safety goal";
    
    fields: {
        id: string;
        description: string;
        hazard: string;
        asil: asil;
        safe_state: string;
        fault_tolerance_time: time;
    }
}

attribute_type Hazard: struct {
    description: "Hazard definition";
    
    fields: {
        id: string;
        description: string;
        severity: severity;
        exposure: exposure;
        controllability: controllability;
        asil: asil;  // Derived from S+E+C
    }
}

// ───────────────────────────────────────────────────────────────────
// VALIDATION ATTRIBUTES
// ───────────────────────────────────────────────────────────────────

attribute_type validation_evidence: struct {
    description: "Evidence of safety validation";
    
    fields: {
        test_report: string;
        test_date: string;
        coverage: percentage;
        pass_fail: bool;
    }
}

attribute_type field_data: struct {
    description: "Field reliability data";
    
    fields: {
        units_deployed: integer;
        operating_hours: integer;
        observed_failures: integer;
        calculated_fit: FIT;
        confidence_level: percentage;
    }
}