// BHDL Standard Library - Electrical Attributes
// This file defines standard electrical attributes used throughout BHDL

namespace stdlib.attributes.electrical {
    
    // ═══════════════════════════════════════════════════════════════
    // VOLTAGE ATTRIBUTES
    // ═══════════════════════════════════════════════════════════════
    
    attribute_type voltage: voltage {
        description: "Electric potential difference";
        units: [µV, mV, V, kV];
        default_unit: V;
        symbol: V;
        
        validation {
            typical_range: -1000V..1000V;  // Most electronics
            warn_if: >600V { message: "High voltage - special safety considerations required" }
        }
    }
    
    attribute_type voltage_range: range<voltage> {
        description: "Operating voltage range";
        format: "min..max";
        examples: ["3.0V..3.6V", "4.5V..5.5V", "-15V..+15V"];
        
        validation {
            min < max;
            span: max - min;
            center: (max + min) / 2;
        }
    }
    
    attribute_type threshold_voltage: voltage {
        description: "Voltage level that triggers a change";
        aliases: [vth, v_threshold];
        applications: [comparators, logic_gates, protection];
        
        subcategories {
            undervoltage_threshold: "Below this is a fault";
            overvoltage_threshold: "Above this is a fault";
            logic_threshold: "Digital transition point";
        }
    }
    
    attribute_type voltage_tolerance: tolerance {
        description: "Acceptable voltage variation";
        format: ["±percentage", "±absolute", "+upper/-lower"];
        examples: ["±5%", "±0.25V", "+5%/-3%"];
        
        validation {
            percentage_format: 0%..20%;  // Typical range
            warn_if: >10% { message: "Large tolerance may affect circuit performance" }
        }
    }
    
    attribute_type ripple_voltage: voltage {
        description: "Peak-to-peak AC component on DC voltage";
        aliases: [vripple, voltage_ripple];
        measurement: peak_to_peak;
        units: [µV, mV, V];
        default_unit: mV;
        
        validation {
            typical: <5% of nominal_voltage;
            good_practice: <1% of nominal_voltage;
        }
    }
    
    attribute_type offset_voltage: voltage {
        description: "DC offset from ideal value";
        aliases: [vos, v_offset];
        units: [µV, mV, V];
        default_unit: mV;
        applications: [op_amps, comparators, adc];
    }
    
    // ═══════════════════════════════════════════════════════════════
    // CURRENT ATTRIBUTES
    // ═══════════════════════════════════════════════════════════════
    
    attribute_type current: current {
        description: "Electric current flow";
        units: [nA, µA, mA, A, kA];
        default_unit: mA;
        symbol: I;
        
        validation {
            typical_range: 1nA..100A;  // Most electronics
            warn_if: >10A { message: "High current - consider trace width and thermal management" }
        }
    }
    
    attribute_type current_limit: current {
        description: "Maximum allowed current";
        aliases: [i_limit, i_max];
        applications: [protection, specification];
        
        validation {
            must_be: >0;
            safety_margin: typically 80% of absolute_max;
        }
    }
    
    attribute_type max_current: current {
        description: "Maximum continuous current rating";
        aliases: [i_max_continuous];
        note: "For continuous operation without damage";
        
        related {
            peak_current: "Short duration maximum";
            surge_current: "Very brief maximum";
        }
    }
    
    attribute_type min_current: current {
        description: "Minimum operating current";
        aliases: [i_min];
        applications: [current_sources, led_drivers];
        note: "Below this, operation not guaranteed";
    }
    
    attribute_type inrush_current: current {
        description: "Initial current spike at turn-on";
        aliases: [i_inrush, surge_current];
        measurement: peak;
        typical_duration: 1ms..100ms;
        
        validation {
            typical: 2x..10x * steady_state_current;
            warn_if: >50x * steady_state { message: "Excessive inrush may trip protection" }
        }
    }
    
    attribute_type quiescent_current: current {
        description: "Current draw with no load";
        aliases: [iq, i_quiescent, idle_current];
        units: [nA, µA, mA];
        default_unit: µA;
        applications: [regulators, op_amps, battery_powered];
        
        validation {
            low_power: <10µA;
            ultra_low_power: <1µA;
        }
    }
    
    attribute_type leakage_current: current {
        description: "Unwanted current flow";
        aliases: [i_leak, i_leakage];
        units: [pA, nA, µA];
        default_unit: nA;
        
        validation {
            good: <1µA;
            excellent: <100nA;
        }
    }
    
    attribute_type bias_current: current {
        description: "Input bias current";
        aliases: [ib, i_bias];
        units: [pA, nA, µA];
        default_unit: nA;
        applications: [op_amps, comparators];
    }
    
    // ═══════════════════════════════════════════════════════════════
    // POWER ATTRIBUTES
    // ═══════════════════════════════════════════════════════════════
    
    attribute_type power: power {
        description: "Electrical power";
        units: [µW, mW, W, kW];
        default_unit: W;
        symbol: P;
        formula: "P = V * I";
        
        validation {
            must_be: ≥0;  // No negative power in passive circuits
        }
    }
    
    attribute_type power_dissipation: power {
        description: "Power converted to heat";
        aliases: [pd, p_dissipated];
        thermal_consideration: "Requires adequate cooling";
        
        validation {
            must_be: <max_power_rating;
            derate: typically 70% at max_temp;
        }
    }
    
    attribute_type max_power: power {
        description: "Maximum power rating";
        aliases: [p_max, power_rating];
        conditions: "At 25°C unless specified";
        
        derating {
            linear: above 70°C;
            factor: -5mW/°C typical;
        }
    }
    
    attribute_type efficiency: percentage {
        description: "Power conversion efficiency";
        aliases: [η, eta];
        range: 0%..100%;
        formula: "efficiency = P_out / P_in * 100%";
        
        validation {
            must_be: ≤100%;  // Cannot exceed 100%
            typical_ranges {
                linear_regulator: 30%..60%;
                switching_regulator: 70%..95%;
                class_d_amplifier: 85%..95%;
            }
        }
    }
    
    // ═══════════════════════════════════════════════════════════════
    // RESISTANCE AND IMPEDANCE
    // ═══════════════════════════════════════════════════════════════
    
    attribute_type resistance: resistance {
        description: "DC resistance";
        units: [mΩ, Ω, kΩ, MΩ, GΩ];
        default_unit: Ω;
        symbol: R;
        
        validation {
            must_be: ≥0;  // No negative resistance in passive components
            typical_range: 0.001Ω..10GΩ;
        }
    }
    
    attribute_type impedance: impedance {
        description: "AC impedance (complex)";
        units: [Ω, kΩ, MΩ];
        default_unit: Ω;
        symbol: Z;
        representation: "magnitude @ frequency" | "R + jX";
        
        subcategories {
            input_impedance: "Zin";
            output_impedance: "Zout";
            characteristic_impedance: "Z0";
        }
    }
    
    attribute_type esr: resistance {
        description: "Equivalent series resistance";
        aliases: [equivalent_series_resistance];
        units: [mΩ, Ω];
        default_unit: mΩ;
        applications: [capacitors, inductors];
        
        validation {
            lower_is_better: true;
            typical_ranges {
                ceramic_cap: 5mΩ..100mΩ;
                electrolytic_cap: 50mΩ..1Ω;
                tantalum_cap: 50mΩ..500mΩ;
            }
        }
    }
    
    // ═══════════════════════════════════════════════════════════════
    // CAPACITANCE AND INDUCTANCE
    // ═══════════════════════════════════════════════════════════════
    
    attribute_type capacitance: capacitance {
        description: "Electrical capacitance";
        units: [pF, nF, µF, mF, F];
        default_unit: µF;
        symbol: C;
        
        validation {
            must_be: >0;
            typical_range: 1pF..10000µF;
        }
    }
    
    attribute_type inductance: inductance {
        description: "Electrical inductance";
        units: [nH, µH, mH, H];
        default_unit: µH;
        symbol: L;
        
        validation {
            must_be: >0;
            typical_range: 1nH..10H;
        }
    }
    
    attribute_type saturation_current: current {
        description: "Current at which inductor saturates";
        aliases: [i_sat];
        applications: [inductors, transformers];
        note: "Inductance drops significantly above this";
        
        validation {
            design_margin: use <70% of i_sat;
        }
    }
    
    // ═══════════════════════════════════════════════════════════════
    // FREQUENCY ATTRIBUTES
    // ═══════════════════════════════════════════════════════════════
    
    attribute_type frequency: frequency {
        description: "Signal frequency";
        units: [Hz, kHz, MHz, GHz];
        default_unit: MHz;
        symbol: f;
        
        validation {
            must_be: >0;
            warn_if: >1GHz { message: "High frequency - consider transmission line effects" }
        }
    }
    
    attribute_type frequency_range: range<frequency> {
        description: "Operating frequency range";
        format: "min..max";
        examples: ["10Hz..100kHz", "DC..1MHz"];
        
        special_values {
            DC: 0Hz;
            audio: 20Hz..20kHz;
            rf: >1MHz;
            microwave: >1GHz;
        }
    }
    
    attribute_type bandwidth: frequency {
        description: "Frequency range of operation";
        aliases: [bw, -3dB_bandwidth];
        measurement: "At -3dB points unless specified";
        
        subcategories {
            gain_bandwidth: "GBW product";
            power_bandwidth: "Full power bandwidth";
            small_signal_bandwidth: "Small signal -3dB";
        }
    }
    
    attribute_type switching_frequency: frequency {
        description: "Operating frequency of switcher";
        aliases: [fsw, f_switch];
        units: [kHz, MHz];
        default_unit: kHz;
        typical_range: 20kHz..2MHz;
        
        tradeoffs {
            higher: "Smaller components, more losses";
            lower: "Better efficiency, larger components";
        }
    }
    
    // ═══════════════════════════════════════════════════════════════
    // DIGITAL LEVELS
    // ═══════════════════════════════════════════════════════════════
    
    attribute_type logic_high: voltage {
        description: "Logic high voltage level";
        aliases: [vih, voh, high_level];
        
        subcategories {
            vih: "Input high minimum";
            voh: "Output high minimum";
        }
    }
    
    attribute_type logic_low: voltage {
        description: "Logic low voltage level";
        aliases: [vil, vol, low_level];
        
        subcategories {
            vil: "Input low maximum";
            vol: "Output low maximum";
        }
    }
    
    attribute_type logic_family: enum {
        description: "Digital logic family";
        values: [TTL, CMOS, LVTTL, LVCMOS, LVDS, CML, ECL];
        
        voltage_levels {
            TTL: { vcc: 5V, vih: 2V, vil: 0.8V }
            CMOS_5V: { vcc: 5V, vih: 3.5V, vil: 1.5V }
            CMOS_3V3: { vcc: 3.3V, vih: 2V, vil: 0.8V }
            CMOS_1V8: { vcc: 1.8V, vih: 1.17V, vil: 0.63V }
        }
    }
}

// ═══════════════════════════════════════════════════════════════════
// ELECTRICAL RELATIONSHIPS AND FORMULAS
// ═══════════════════════════════════════════════════════════════════

electrical_formulas {
    
    ohms_law {
        description: "Fundamental voltage-current-resistance relationship";
        formula: V = I * R;
    }
    
    power_formulas {
        from_vi: P = V * I;
        from_i2r: P = I² * R;
        from_v2r: P = V² / R;
    }
    
    rc_time_constant {
        description: "RC circuit time constant";
        formula: τ = R * C;
        charging: "V(t) = Vfinal * (1 - e^(-t/τ))";
    }
    
    lc_resonance {
        description: "LC resonant frequency";
        formula: f = 1 / (2π * √(L * C));
    }
    
    voltage_divider {
        description: "Resistive voltage divider";
        formula: Vout = Vin * (R2 / (R1 + R2));
    }
    
    current_divider {
        description: "Resistive current divider";
        formula: I2 = Itotal * (R1 / (R1 + R2));
    }
}