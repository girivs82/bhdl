// Export validation framework
export {
    PullUpValidationResult, ValidationIssue, SignalMeasurements,
    PULL_UP_VALIDATION_RULES,
    validate_pullup_in_simulation,
    generate_recommendations,
    EXAMPLE_VALIDATION_REPORT
};