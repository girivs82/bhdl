// Pull-up Validation Rules for Simulation
// These rules are checked during simulation to catch pull-up issues

import { OpenDrainSpiceModel } from "../spice/open_drain_models.bhdl";

// Validation result from simulation
type PullUpValidationResult = {
    pin_name: string,
    validation_passed: bool,
    issues: ValidationIssue[],
    measurements: SignalMeasurements,
    recommendations: string[],
};

type ValidationIssue = {
    severity: string,  // "error", "warning", "info"
    issue_type: string,
    description: string,
    measured_value: string?,
    expected_value: string?,
    simulation_time: time?,
};

type SignalMeasurements = {
    voh_achieved: voltage,      // Actual high voltage reached
    vol_achieved: voltage,      // Actual low voltage reached  
    rise_time: time,            // Measured 10-90% rise time
    fall_time: time,            // Measured 90-10% fall time
    steady_state_current: current,  // Current when stable
    power_consumption: power,   // Average power dissipation
};

// Validation rules that simulation would check
const PULL_UP_VALIDATION_RULES = [
    {
        rule_id: "PULLUP_001",
        name: "Open-drain requires pull-up",
        description: "All open-drain outputs must have pull-up resistors",
        check: function(pin, simulation) {
            if (pin.drive_type == "open-drain" && !pin.has_pullup) {
                return {
                    severity: "error",
                    issue_type: "missing_pullup",
                    description: "Open-drain pin has no pull-up resistor",
                    measured_value: "floating",
                    expected_value: "pull-up to VDD"
                };
            }
            return null;
        }
    },
    
    {
        rule_id: "PULLUP_002", 
        name: "Pull-up voltage sufficient",
        description: "Pull-up must reach valid high level",
        check: function(pin, simulation) {
            const voh = simulation.measure_voh(pin);
            const vih_min = pin.get_vih_threshold();
            
            if (voh < vih_min) {
                return {
                    severity: "error",
                    issue_type: "insufficient_pullup_voltage",
                    description: f"Signal only reaches {voh}V, needs {vih_min}V for logic high",
                    measured_value: f"{voh}V",
                    expected_value: f">= {vih_min}V"
                };
            }
            return null;
        }
    },
    
    {
        rule_id: "PULLUP_003",
        name: "Rise time acceptable",
        description: "Pull-up must meet timing requirements",
        check: function(pin, simulation) {
            const rise_time = simulation.measure_rise_time(pin);
            const max_rise_time = pin.get_max_rise_time();
            
            if (rise_time > max_rise_time) {
                return {
                    severity: "warning",
                    issue_type: "slow_rise_time",
                    description: f"Rise time {rise_time} exceeds maximum {max_rise_time}",
                    measured_value: f"{rise_time}",
                    expected_value: f"<= {max_rise_time}",
                    recommendation: "Use stronger pull-up (lower resistance)"
                };
            }
            return null;
        }
    },
    
    {
        rule_id: "PULLUP_004",
        name: "Pull-up to correct rail",
        description: "Pull-up connected to appropriate power rail",
        check: function(pin, simulation) {
            const pullup_rail = simulation.get_pullup_rail(pin);
            const expected_rail = pin.get_expected_pullup_rail();
            
            if (pullup_rail != expected_rail) {
                // Check if voltage is still acceptable
                const rail_voltage = simulation.get_rail_voltage(pullup_rail);
                const expected_voltage = simulation.get_rail_voltage(expected_rail);
                
                if (abs(rail_voltage - expected_voltage) > 0.5V) {
                    return {
                        severity: "error",
                        issue_type: "wrong_pullup_rail",
                        description: f"Pull-up connected to {pullup_rail} ({rail_voltage}V) instead of {expected_rail} ({expected_voltage}V)",
                        measured_value: f"{pullup_rail} ({rail_voltage}V)",
                        expected_value: f"{expected_rail} ({expected_voltage}V)"
                    };
                }
            }
            return null;
        }
    },
    
    {
        rule_id: "PULLUP_005",
        name: "Pull-up value in range",
        description: "Pull-up resistance within recommended range",
        check: function(pin, simulation) {
            const pullup_r = simulation.measure_pullup_resistance(pin);
            const (min_r, max_r) = pin.get_pullup_range();
            
            if (pullup_r < min_r) {
                return {
                    severity: "warning",
                    issue_type: "pullup_too_strong",
                    description: f"Pull-up {pullup_r} below minimum {min_r} - excessive power consumption",
                    measured_value: f"{pullup_r}",
                    expected_value: f"{min_r} to {max_r}"
                };
            }
            if (pullup_r > max_r) {
                return {
                    severity: "warning", 
                    issue_type: "pullup_too_weak",
                    description: f"Pull-up {pullup_r} above maximum {max_r} - slow rise time",
                    measured_value: f"{pullup_r}",
                    expected_value: f"{min_r} to {max_r}"
                };
            }
            return null;
        }
    },
    
    {
        rule_id: "PULLUP_006",
        name: "Bus contention check",
        description: "No bus contention with multiple drivers",
        check: function(pin, simulation) {
            const bus_signals = simulation.get_connected_signals(pin);
            const contention_current = simulation.check_bus_contention(bus_signals);
            
            if (contention_current > 100mA) {
                return {
                    severity: "error",
                    issue_type: "bus_contention",
                    description: f"Bus contention detected: {contention_current} current flow",
                    measured_value: f"{contention_current}",
                    expected_value: "< 100mA"
                };
            }
            return null;
        }
    }
];

// Simulation-based validation that would catch issues
function validate_pullup_in_simulation(
    pin_name: string,
    drive_model: OpenDrainSpiceModel,
    circuit_netlist: Netlist
) -> PullUpValidationResult {
    
    // Run DC simulation to find steady states
    const dc_result = simulate_dc(circuit_netlist);
    
    // Run transient simulation to measure timing
    const tran_result = simulate_transient(circuit_netlist, 0, 100ns);
    
    // Extract measurements
    const measurements: SignalMeasurements = {
        voh_achieved: tran_result.get_high_voltage(pin_name),
        vol_achieved: tran_result.get_low_voltage(pin_name),
        rise_time: tran_result.measure_rise_time(pin_name),
        fall_time: tran_result.measure_fall_time(pin_name),
        steady_state_current: dc_result.get_current(pin_name),
        power_consumption: dc_result.get_power(pin_name),
    };
    
    // Check all validation rules
    const issues: ValidationIssue[] = [];
    for rule in PULL_UP_VALIDATION_RULES {
        const issue = rule.check(pin_name, measurements);
        if (issue != null) {
            issues.push(issue);
        }
    }
    
    // Generate recommendations based on issues
    const recommendations = generate_recommendations(issues, measurements);
    
    return {
        pin_name: pin_name,
        validation_passed: issues.filter(i => i.severity == "error").length == 0,
        issues: issues,
        measurements: measurements,
        recommendations: recommendations,
    };
}

// Generate fix recommendations
function generate_recommendations(
    issues: ValidationIssue[],
    measurements: SignalMeasurements
) -> string[] {
    const recommendations: string[] = [];
    
    for issue in issues {
        switch (issue.issue_type) {
            case "missing_pullup":
                recommendations.push("Add pull-up resistor (4.7kΩ typical for I2C)");
                break;
                
            case "insufficient_pullup_voltage":
                recommendations.push("Connect pull-up to higher voltage rail (e.g., VDDIO instead of VDDCORE)");
                break;
                
            case "slow_rise_time":
                const current_r = extract_resistance(issue.measured_value);
                const new_r = current_r * 0.5;  // Halve resistance for faster rise
                recommendations.push(f"Reduce pull-up resistance to {new_r} for faster rise time");
                break;
                
            case "wrong_pullup_rail":
                const correct_rail = extract_rail(issue.expected_value);
                recommendations.push(f"Move pull-up connection from {extract_rail(issue.measured_value)} to {correct_rail}");
                break;
                
            case "pullup_too_strong":
                recommendations.push("Increase pull-up resistance to reduce power consumption");
                break;
                
            case "pullup_too_weak":
                recommendations.push("Decrease pull-up resistance for better signal integrity");
                break;
                
            case "bus_contention":
                recommendations.push("Check for multiple drivers enabled simultaneously");
                recommendations.push("Ensure proper tri-state control logic");
                break;
        }
    }
    
    // Add power optimization if no errors
    if (measurements.power_consumption > 10mW) {
        recommendations.push(f"Consider increasing pull-up resistance to reduce {measurements.power_consumption} power consumption");
    }
    
    return recommendations;
}

