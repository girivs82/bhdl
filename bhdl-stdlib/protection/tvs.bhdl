// Simplified Protection Components - v2.0 compatible

entity TVSDiode(voltage: voltage) {
    pin A: signal in;   // Anode (ground-side terminal)
    pin K: signal out;  // Cathode (protected-line terminal)

    attribute component_class = "tvs_diode";
    attribute breakdown_voltage = voltage;
    attribute forward_voltage = 1.1V;  // forward-conduction drop (unidirectional TVS, datasheet class)
    attribute max_current = 1A;
    attribute kicad_symbol = "Device:D_TVS";
}

// Aliases kept for the older generic-style call sites folded in from the
// retired passives/tvs_diode.bhdl.
alias TVS = TVSDiode;
alias TransientSuppressor = TVSDiode;

entity Fuse(current: current, resistance: resistance = 10mΩ) {
    pin 1: signal inout;
    pin 2: signal inout;

    attribute component_class = "fuse";
    attribute rated_current = current;
    attribute resistance = resistance;   // cold resistance (DC model); polyfuses run 30-500mΩ
    attribute voltage_rating = 250V;
    attribute kicad_symbol = "Device:Fuse";
}

// Alias kept for the older call sites folded in from the retired
// passives/fuse.bhdl.
alias F = Fuse;
