// ATmega328P — 8-bit AVR microcontroller, DIP-28 variant.
//
// Used by Arduino UNO (`ATMEGA328P-PU`). The chip's TQFP-32 and
// MLF-32 variants (used by Nano and others) have a 4-pin
// expansion with two additional ADC channels — they get their
// own entity in this file.
//
// Pin names follow the standard datasheet port nomenclature:
// PD0..PD7, PB0..PB7, PC0..PC6, plus the power/clock/reset
// pins (VCC, GND, AVCC, AREF, RESET, XTAL1, XTAL2).
//
// Grammar discipline: parser-compatible v2.0 subset. No
// `@metadata(...)`, no complex type expressions, no SPICE
// model. Those grow in a follow-up commit once the parser
// can handle them.

entity ATmega328P_DIP28(part_no: string = "ATMEGA328P-PU") {
    // ─── PD0..PD7: Port D (digital I/O) ─────────────────────
    pin PD0: signal inout;   // RXD / PCINT16          (pin 2)
    pin PD1: signal inout;   // TXD / PCINT17          (pin 3)
    pin PD2: signal inout;   // INT0 / PCINT18         (pin 4)
    pin PD3: signal inout;   // INT1 / OC2B / PCINT19  (pin 5)
    pin PD4: signal inout;   // T0 / XCK / PCINT20     (pin 6)
    pin PD5: signal inout;   // T1 / OC0B / PCINT21    (pin 11)
    pin PD6: signal inout;   // OC0A / AIN0 / PCINT22  (pin 12)
    pin PD7: signal inout;   // AIN1 / PCINT23         (pin 13)

    // ─── PB0..PB7: Port B (digital I/O + SPI + crystal) ────
    pin PB0: signal inout;   // ICP1 / CLKO / PCINT0   (pin 14)
    pin PB1: signal inout;   // OC1A / PCINT1          (pin 15)
    pin PB2: signal inout;   // SS / OC1B / PCINT2     (pin 16)
    pin PB3: signal inout;   // MOSI / OC2A / PCINT3   (pin 17)
    pin PB4: signal inout;   // MISO / PCINT4          (pin 18)
    pin PB5: signal inout;   // SCK / PCINT5           (pin 19)
    pin PB6: signal inout;   // XTAL1 / TOSC1 / PCINT6 (pin 9)
    pin PB7: signal inout;   // XTAL2 / TOSC2 / PCINT7 (pin 10)

    // ─── PC0..PC5: Port C (analog I/O + I2C) + RESET ──────
    pin PC0: signal inout;   // ADC0 / PCINT8          (pin 23)
    pin PC1: signal inout;   // ADC1 / PCINT9          (pin 24)
    pin PC2: signal inout;   // ADC2 / PCINT10         (pin 25)
    pin PC3: signal inout;   // ADC3 / PCINT11         (pin 26)
    pin PC4: signal inout;   // ADC4 / SDA / PCINT12   (pin 27)
    pin PC5: signal inout;   // ADC5 / SCL / PCINT13   (pin 28)
    pin PC6: signal inout;   // RESET / PCINT14        (pin 1)

    // ─── Power and analog reference ─────────────────────────
    // VCC is marked `virtual` to gate the entity's `expansion { }`
    // block (which adds the datasheet-recommended decoupling
    // network). The pin itself is still wired normally at the
    // board level; the `virtual` keyword is purely a synthesis-
    // time trigger for auto-expansion.
    pin VCC:  signal inout virtual;  // (pin 7)
    pin AVCC: signal inout;  // (pin 20) — analog VCC
    pin AREF: signal inout;  // (pin 21) — analog reference
    pin GND1: signal inout;  // (pin 8)  — digital ground
    pin GND2: signal inout;  // (pin 22) — analog ground

    // ─── Peripheral interfaces (v0.6 pinmux) ────────────────
    //
    // The peripherals share their physical pins; the board picks
    // which one to wire and the synthesizer enforces mutual
    // exclusion on the shared pins. The bindings here follow the
    // ATmega328P datasheet pinout.
    //
    // SPI on PB3..PB5 + PB2 (chip-select). Also serves as the
    // ICSP programming-header data path with RESET on PC6.
    interface SPI spi {
        MOSI = PB3;
        MISO = PB4;
        SCK  = PB5;
        CS   = PB2;
    }

    // Chip is the programming *target*, so use the ICSP slave
    // perspective explicitly — MOSI/SCK/RESET are inputs on this
    // side, MISO is the output. A USBasp / Atmel-ICE programmer
    // declared as `interface ICSP icsp` (default = master)
    // direction-matches us.
    interface ICSP:slave icsp {
        MOSI  = PB3;
        MISO  = PB4;
        SCK   = PB5;
        RESET = PC6;
    }

    // I2C on PC4/PC5 — also the ADC4/ADC5 pins, so a board that
    // wires `mcu.i2c` can't also read those ADC channels.
    interface I2C i2c {
        SDA = PC4;
        SCL = PC5;
    }

    // UART0 on PD0/PD1.
    interface UART uart {
        TX = PD1;
        RX = PD0;
    }

    // ─── Function aliases (v0.9a) ──────────────────────────
    // Logical pin names so board authors don't need to type
    // datasheet port names. Sequential numbering by physical
    // pin order across the DIP-28 layout. The Arduino board
    // personality remaps these further to D0..D13 / A0..A5
    // (handled at a higher abstraction layer).
    aliases {
        // GPIOs in physical pin-number order (DIP-28).
        // Pin 1 = PC6 (RESET), pin 2-6 = PD0..PD4, etc.
        gpio0  = PD0;   // pin 2  (RXD)
        gpio1  = PD1;   // pin 3  (TXD)
        gpio2  = PD2;   // pin 4
        gpio3  = PD3;   // pin 5
        gpio4  = PD4;   // pin 6
        gpio5  = PD5;   // pin 11
        gpio6  = PD6;   // pin 12
        gpio7  = PD7;   // pin 13
        gpio8  = PB0;   // pin 14
        gpio9  = PB1;   // pin 15
        gpio10 = PB2;   // pin 16 (SS)
        gpio11 = PB3;   // pin 17 (MOSI)
        gpio12 = PB4;   // pin 18 (MISO)
        gpio13 = PB5;   // pin 19 (SCK)
        // ADC inputs (PC0..PC5).
        adc0   = PC0;   // pin 23
        adc1   = PC1;   // pin 24
        adc2   = PC2;   // pin 25
        adc3   = PC3;   // pin 26
        adc4   = PC4;   // pin 27 (also SDA)
        adc5   = PC5;   // pin 28 (also SCL)
        // Special-function aliases.
        reset  = PC6;   // pin 1  /RESET
    }

    attribute component_class = "microcontroller";
    attribute i_supply        = 12mA;   // active, 16 MHz / 5 V (datasheet typ)
    attribute family          = "AVR";

    simulation {
        model {
            node VCC draws = 0.012;
        }
    }
    attribute architecture    = "8-bit RISC";
    attribute flash_kb        = 32;
    attribute sram_kb         = 2;
    attribute eeprom_kb       = 1;
    attribute max_clock_mhz   = 20;
    attribute part_number     = part_no;
    attribute kicad_symbol    = "Arduino UNO:ATMEGA328P-PU";

    // ─── Auto-expansion: datasheet-recommended support passives ─
    //
    // Triggered by the `virtual` keyword on `VCC`. Every board
    // that drops in an ATmega328P_DIP28 gets these caps for free,
    // matching the chip's datasheet "typical application" circuit:
    //
    //   - C_vcc  : 100nF ceramic VCC →GND1 (digital decoupling)
    //   - C_bulk :  10µF bulk    VCC →GND1 (low-freq reservoir)
    //   - C_avcc : 100nF ceramic AVCC→GND2 (analog supply decoupling)
    //   - C_aref : 100nF ceramic AREF→GND2 (analog reference filter)
    //
    // With Phase 4.5's conditional-expansion gating (per-pin-
    // connected, da3786a + #89), recipes that reference signal
    // pins like PC4/PC5 only fire when the board actually wires
    // them. So I²C pullups can now safely live in the chip
    // entity's expansion — they materialise iff the board uses
    // PC4/PC5 as I²C (the i2c interface field), and stay absent
    // when the board uses them as ADC inputs (ADC4/ADC5).
    //
    // The pullup rail is the chip's own VCC pin — which is the
    // rail the board wired to power *this* chip. Multi-rail
    // boards therefore avoid the I²C-backdrive risk automatically:
    // each chip's pullup tracks its own VCC.
    //
    // Still intentionally omitted (separate follow-ups):
    //   - SPI series-term : depends on clock rate / topology;
    //     belongs as an opt-in.
    //   - /RESET pullup + power-on RC : PC6 is dual-function; the
    //     QFN-32 variant or chips with a dedicated /RESET pin can
    //     grow this later.
    //   - Crystal load caps : PB6/PB7 are also port pins.
    expansion {
        // Always-on decoupling network (datasheet "Typical
        // Application"), annotated with P&R layout intents so the
        // placer puts each cap adjacent to its supply pin with a
        // tight rail→return loop. The intent rides on the standalone
        // component declaration; the wiring lines below reference the
        // instance it creates. (See intent_vocabulary_v0.md §5.)
        C_vcc:  Cap(100nF) for high_freq_bypass(rail: VCC,  return: GND1, loop_area_max: 1.5mm2);
        VCC -> C_vcc.1;  C_vcc.2 -> GND1;

        C_bulk: Cap(10µF) for bulk_reservoir(rail: VCC, return: GND1, proximity_max: 10mm);
        VCC -> C_bulk.1; C_bulk.2 -> GND1;

        C_avcc: Cap(100nF) for high_freq_bypass(rail: AVCC, return: GND2, loop_area_max: 1.5mm2);
        AVCC -> C_avcc.1; C_avcc.2 -> GND2;

        C_aref: Cap(100nF) for analog_ref_filter(ref_pin: AREF, return: GND2);
        AREF -> C_aref.1; C_aref.2 -> GND2;

        // I²C pullups on PC4 (SDA) and PC5 (SCL). Gated on the
        // board wiring those pins — see compute_live_children.
        PC4  -> R_pu_sda: Res(4.7kΩ).1;  R_pu_sda.2 -> VCC;
        PC5  -> R_pu_scl: Res(4.7kΩ).1;  R_pu_scl.2 -> VCC;
    }
}

// ATmega328P — QFN-32 / MLF-32 variant.
//
// Used by Arduino Nano (`Arduino Nano:ATMEGA328P-MU`). Same
// silicon as the DIP-28 above, in the smaller leadless package.
// The 32-pin layout exposes two extra ADC inputs (ADC6/ADC7,
// pins 19 and 22) that the DIP package doesn't bring out, and
// has dual VCC/GND pads for the same internal die rail.
//
// Pin name discipline mirrors the DIP-28 entity: datasheet
// port names (PB/PC/PD), then power/reference pins. The four
// duplicate ground/power pads get numbered suffixes
// (GND1/GND2/GND3 — analogous to DIP-28's GND1/GND2 — and
// VCC1/VCC2) so the entity preserves each physical pad.

entity ATmega328P_QFN32(part_no: string = "ATMEGA328P-MU") {
    // Row A — left edge (pins 1..8)
    pin PD3:  signal inout;  // INT1 / OC2B / PCINT19         (pin 1)
    pin PD4:  signal inout;  // T0 / XCK / PCINT20            (pin 2)
    pin GND1: signal inout;  //                                (pin 3)
    pin VCC1: signal inout;  //                                (pin 4)
    pin GND2: signal inout;  //                                (pin 5)
    pin VCC2: signal inout;  //                                (pin 6)
    pin PB6:  signal inout;  // XTAL1 / TOSC1 / PCINT6         (pin 7)
    pin PB7:  signal inout;  // XTAL2 / TOSC2 / PCINT7         (pin 8)
    // Row B — bottom edge (pins 9..16)
    pin PD5:  signal inout;  // T1 / OC0B / PCINT21            (pin 9)
    pin PD6:  signal inout;  // OC0A / AIN0 / PCINT22          (pin 10)
    pin PD7:  signal inout;  // AIN1 / PCINT23                 (pin 11)
    pin PB0:  signal inout;  // ICP1 / CLKO / PCINT0           (pin 12)
    pin PB1:  signal inout;  // OC1A / PCINT1                  (pin 13)
    pin PB2:  signal inout;  // SS / OC1B / PCINT2             (pin 14)
    pin PB3:  signal inout;  // MOSI / OC2A / PCINT3           (pin 15)
    pin PB4:  signal inout;  // MISO / PCINT4                  (pin 16)
    // Row C — right edge (pins 17..24)
    pin PB5:  signal inout;  // SCK / PCINT5                   (pin 17)
    pin AVCC: signal inout;  //                                (pin 18) — analog VCC
    pin ADC6: signal inout;  //                                (pin 19) — QFN-only
    pin AREF: signal inout;  //                                (pin 20)
    pin GND3: signal inout;  //                                (pin 21) — analog ground
    pin ADC7: signal inout;  //                                (pin 22) — QFN-only
    pin PC0:  signal inout;  // ADC0 / PCINT8                  (pin 23)
    pin PC1:  signal inout;  // ADC1 / PCINT9                  (pin 24)
    // Row D — top edge (pins 25..32)
    pin PC2:  signal inout;  // ADC2 / PCINT10                 (pin 25)
    pin PC3:  signal inout;  // ADC3 / PCINT11                 (pin 26)
    pin PC4:  signal inout;  // ADC4 / SDA / PCINT12           (pin 27)
    pin PC5:  signal inout;  // ADC5 / SCL / PCINT13           (pin 28)
    pin PC6:  signal inout;  // RESET / PCINT14                (pin 29)
    pin PD0:  signal inout;  // RXD / PCINT16                  (pin 30)
    pin PD1:  signal inout;  // TXD / PCINT17                  (pin 31)
    pin PD2:  signal inout;  // INT0 / PCINT18                 (pin 32)
    // Exposed thermal pad on the QFN package bottom. KiCad's
    // symbol exposes it as pin 33. Internally tied to GND on
    // most boards (acts as a thermal+electrical sink).
    pin PAD:  signal inout;  //                                 (pin 33)

    attribute component_class = "microcontroller";
    attribute family          = "AVR";
    attribute architecture    = "8-bit RISC";
    attribute flash_kb        = 32;
    attribute sram_kb         = 2;
    attribute eeprom_kb       = 1;
    attribute max_clock_mhz   = 20;
    attribute part_number     = part_no;
    attribute kicad_symbol    = "Arduino Nano:ATMEGA328P-MU";
}
