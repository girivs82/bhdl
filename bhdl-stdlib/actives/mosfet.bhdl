// MOSFET — 3-terminal discrete FET (gate/drain/source), N- or P-channel.
//
// Regenerated to the current v2 standard. The pre-v2 file selected a per-part
// parameter struct out of `const MOSFET_2N7000 = { … }` knowledge maps with
// ternary chains — none of which the current parser accepts, so the file
// failed to parse and the entity was only reachable through partial-parse
// tolerance. Same treatment as LM2596/LM7805: keep the datasheet data, express
// it in the parseable idiom.
//
// The electrical axes live as constructor params (defaults = 2N7000, the
// classic small-signal NFET); each SKU alias binds its real datasheet values
// positionally — so `MOSFET_IRF540()` carries 100V/33A/44mΩ without any map
// lookup. The body/bulk pin isn't modelled: discrete MOSFETs tie body to
// source internally, and 3-pin symbols are the norm.
//
// Datasheet sources: onsemi 2N7000 / BS250P, IR IRF540N / IRF9540N.
// P-channel ratings are stored as magnitudes with channel = "pmos" carrying
// the polarity (per-axis signs made every downstream magnitude comparison
// sign-aware for no analytical gain).

entity MOSFET(
    part_no: string     = "2N7000",
    channel: string     = "nmos",    // "nmos" | "pmos"
    vds_max: voltage    = 60V,       // drain-source breakdown (magnitude)
    id_max:  current    = 200mA,     // continuous drain current (magnitude)
    rds_on:  resistance = 5Ω,        // on-resistance at datasheet V_GS
    vgs_th_max: voltage = 3V,        // gate threshold, max (magnitude)
    power_rating: power = 400mW,     // package dissipation
    // Switching identity — 0 = UNDECLARED sentinel (the Ind
    // rated_current pattern): gate charge and input capacitance vary
    // per die, not per class, so there is NO class default. Declare
    // them from the part's datasheet at the instance (the uno's
    // FDN340P does) and the sign-off's gate-drive row lights up;
    // leave them 0 and it honestly doesn't exist. Coss/trr are not
    // even parameters yet — absence over invention until a board
    // needs them with a citation in hand.
    qg_nc: float   = 0.0,            // total gate charge, nC (datasheet typ)
    ciss_pf: float = 0.0             // input capacitance, pF (datasheet typ)
)
    where channel in ("nmos", "pmos")   // enum domain — reject e.g. "P"/"N"
{
    pin G: signal in;     // Gate
    pin D: signal inout;  // Drain
    pin S: signal inout;  // Source

    attribute component_class = "mosfet";
    attribute transistor_type = channel;
    attribute part_number     = part_no;
    attribute vds_max         = vds_max;
    attribute id_max          = id_max;
    attribute rds_on          = rds_on;
    attribute vgs_th_max      = vgs_th_max;
    attribute power_rating    = power_rating;
    attribute qg_nc           = qg_nc;
    attribute ciss_pf         = ciss_pf;
    attribute kicad_symbol    = "Device:Q_NMOS_GDS";
}

// SKU aliases bind the datasheet values positionally (same alias-with-
// constructor-args form as the regulator SKUs).
alias MOSFET_2N7000  = MOSFET("2N7000", "nmos", 60V, 200mA, 5Ω, 3V, 400mW);
alias MOSFET_BS250   = MOSFET("BS250", "pmos", 45V, 230mA, 14Ω, 3.5V, 700mW);
alias MOSFET_IRF540  = MOSFET("IRF540N", "nmos", 100V, 33A, 44mΩ, 4V, 130W);
alias MOSFET_IRF9540 = MOSFET("IRF9540N", "pmos", 100V, 19A, 200mΩ, 4V, 125W);
