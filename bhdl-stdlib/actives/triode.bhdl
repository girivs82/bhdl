// Vacuum Triode Component Module
// Koren triode model — the de-facto SPICE-standard tube model.
//
// Terminals: P (plate / anode), G (grid), K (cathode).
//
// The five Koren parameters are carried as `attribute`s. bhdl-spice reads
// them (`component_class = "triode"` → ComponentType::Triode) and emits a
// multi-terminal device, DeviceKind::Triode, which GLACIER stamps directly
// rather than decomposing into branches. The plate-current law and its
// small-signal conductances live in bhdl-spice/src/triode.rs.
//
// Per-tube values are nominal: a shipped Amaravani tube refines them with
// firmware per-tube calibration. Instance attributes override these — to
// roll in a calibrated tube, set mu/ex/kg1/kp/kvb on the instance.

// Nominal 6SN7 — medium-µ dual triode, the Amaravani signal-tube family.
entity Triode() {
    pin P: signal inout;  // Plate (anode)
    pin G: signal in;     // Grid
    pin K: signal inout;  // Cathode

    // `component_class` drives SPICE classification.
    attribute component_class = "triode";
    attribute part_number = "6SN7";

    // Koren model parameters — names match the keys bhdl-spice reads.
    attribute mu = 20.0;
    attribute ex = 1.4;
    attribute kg1 = 1180.0;
    attribute kp = 470.0;
    attribute kvb = 300.0;

    attribute kicad_symbol = "Device:Triode";
}

// Nominal 12AU7 / ECC82 — medium-µ dual triode, a common roll-in alternative.
entity Triode12AU7() {
    pin P: signal inout;  // Plate (anode)
    pin G: signal in;     // Grid
    pin K: signal inout;  // Cathode

    attribute component_class = "triode";
    attribute part_number = "12AU7";

    attribute mu = 21.5;
    attribute ex = 1.3;
    attribute kg1 = 1180.0;
    attribute kp = 84.0;
    attribute kvb = 300.0;

    attribute kicad_symbol = "Device:Triode";
}

// Common-cathode signal gain stage — a composite expanded by its `expansion`
// block, the tube analogue of the buck regulator's virtual-pin expansion. The
// OUT pin is `virtual`: it is not a real package pin, it is synthesized. At
// synthesis the block is interpreted and the stage is replaced by a triode
// plus its six obligatory common-cathode bias passives —
//
//   Rp   — plate load resistor      (B+ → plate)
//   Rk   — cathode bias resistor    (cathode → GND)
//   Ck   — cathode bypass capacitor (cathode → GND, in parallel with Rk)
//   Rg   — grid-leak resistor       (grid → GND)
//   Cin  — input coupling capacitor (IN → grid)
//   Cout — output coupling capacitor(plate → OUT)
//
// The stage self-biases: the grid sits at 0 V through Rg, while plate current
// through Rk lifts the cathode above it — so V_gk is the negative bias the
// triode needs, with no separate negative supply. Every passive value is an
// entity parameter, so the whole bias network is tunable from one line of HDL.
entity SignalTubeStage() {
    pin IN:  signal in;            // small-signal input (AC-coupled to the grid)
    pin VBB: power in;             // B+ plate supply
    pin GND: ground;
    pin OUT: signal out virtual;   // amplified output — `virtual`: not a real
                                   // package pin, it is synthesized by the
                                   // `expansion` block below

    attribute component_class = "tube_gain_stage";

    expansion {
        // Internal nodes of the common-cathode topology.
        internal plate:   net;
        internal grid:    net;
        internal cathode: net;

        // Rp 22 kΩ, Rk 820 Ω, Ck 100 µF, Rg 1 MΩ, Cin/Cout 100 nF.
        VBB -> Rp: Res(22000).1; Rp.2 -> plate;
        plate -> V: Triode().P;
        grid -> V.G;
        cathode -> V.K;
        cathode -> Rk: Res(820).1; Rk.2 -> GND;
        cathode -> Ck: Cap(0.0001).1; Ck.2 -> GND;
        grid -> Rg: Res(1000000).1; Rg.2 -> GND;
        IN -> Cin: Cap(0.0000001).1; Cin.2 -> grid;
        plate -> Cout: Cap(0.0000001).1; Cout.2 -> OUT;
    }
}

// Triode current source — a constant-current sink. The cathode resistor R_k
// is *unbypassed* (no bypass capacitor), so the negative feedback through it
// is fully active at signal frequencies, presenting a high output impedance
// at the plate. R_k sets the quiescent plate current.
//
// `for current_source(current: I)` on a net into OUT asks the designer to
// size R_k for I_p = I at a moderate operating V_pk; the actual V_pk is then
// determined by whatever the user wires above the OUT pin.
entity TubeCurrentSource() {
    pin OUT: signal out virtual;   // top of the current source — the plate
    pin K:   signal inout;          // cathode return (typically to ground)

    attribute component_class = "tube_current_source";

    expansion {
        // Internal nodes of the degenerated common-cathode topology.
        internal g_int: net;
        internal k_int: net;

        // Triode: plate at OUT, grid and cathode on internal nets.
        OUT    -> V: Triode().P;
        g_int  -> V.G;
        k_int  -> V.K;

        // Cathode degeneration (no bypass cap — that's the whole point);
        // grid-leak to the cathode return so V_g sits at K's potential.
        k_int  -> Rk: Res(800).1;     Rk.2 -> K;
        g_int  -> Rg: Res(1000000).1; Rg.2 -> K;
    }

    // Vendor-authored operating-point designer for the current_source intent.
    // The Rust reference designer in bhdl-spice/src/tube_bias.rs is still
    // shipped as the default; this `design { }` block — declared right next
    // to the entity that uses it — overrides the reference when the
    // synthesizer sees `for current_source(...)` on this entity.
    //
    // Method: pick V_pk = 100 V as the design point; invert the Koren
    // plate-current law for the V_gk that draws the target current there;
    // R_k follows from cathode self-bias V_k = I · R_k = -V_gk.
    design for current_source {
        const v_pk = 100.0;
        const i_target = intent.current;
        const i_max = plate_current(tube.mu, tube.ex, tube.kg1, tube.kp, tube.kvb, v_pk, 0.0);
        require i_target < i_max
            else "current target exceeds the tube's zero-bias current at V_pk = 100V";
        const v_gk = koren_inverse_vgk(tube.mu, tube.ex, tube.kg1, tube.kp, tube.kvb, v_pk, i_target);
        Rk = (0.0 - v_gk) / i_target;
    }
}

// Triode switch — operated hard between cutoff and saturation.
//
// `for switch()` on the IN net asks the designer to size the plate-load
// resistor R_p so the saturated state (V_gk ≈ 0) pulls the plate down to
// near ground; cutoff naturally leaves the plate at V_bb. No bypass cap,
// no coupling caps — DC drive in, DC level out.
entity TubeSwitch() {
    pin IN:  signal in;
    pin OUT: signal out virtual;   // plate — drives the next stage's input
    pin VBB: power in;
    pin GND: ground inout;

    attribute component_class = "tube_switch";

    expansion {
        // R_p from V_bb to the plate; the plate IS the OUT pin (DC-coupled).
        VBB -> Rp: Res(50000).1; Rp.2 -> OUT;
        // Triode: plate = OUT, grid driven by IN, cathode to GND.
        OUT -> V: Triode().P;
        IN  -> V.G;
        GND -> V.K;
    }
}
