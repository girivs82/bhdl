// Vacuum Triode Component Module
// Koren triode model — the de-facto SPICE-standard tube model.
//
// Terminals: P (plate / anode), G (grid), K (cathode).
//
// The five Koren parameters are carried as `attribute`s. bhdl-spice reads
// them (`component_class = "triode"` → ComponentType::Triode) and emits a
// multi-terminal device, DeviceKind::Triode, which GLACIER stamps directly
// rather than decomposing into branches. The plate-current law and its
// small-signal conductances live in bhdl-spice/src/triode.rs.
//
// Per-tube values are nominal: a shipped Amaravani tube refines them with
// firmware per-tube calibration. Instance attributes override these — to
// roll in a calibrated tube, set mu/ex/kg1/kp/kvb on the instance.

// Nominal 6SN7 — medium-µ dual triode, the Amaravani signal-tube family.
entity Triode() {
    pin P: signal inout;  // Plate (anode)
    pin G: signal in;     // Grid
    pin K: signal inout;  // Cathode

    // `component_class` drives SPICE classification.
    attribute component_class = "triode";
    attribute part_number = "6SN7";

    // Koren model parameters — names match the keys bhdl-spice reads.
    attribute mu = 20.0;
    attribute ex = 1.4;
    attribute kg1 = 1180.0;
    attribute kp = 470.0;
    attribute kvb = 300.0;

    attribute kicad_symbol = "Device:Triode";
}

// ECC83 / 12AX7 — high-µ dual triode, the classic preamp tube. One
// entity = ONE SECTION (the envelope holds two); heater is carried as
// data (see heater_* attrs) and modelled at board level as its V/I-
// derived load. Koren parameters from the FETCHED Norman Koren
// article Table 1 ("Improved vacuum tube models for SPICE",
// i-t.com mirror; normankoren.com bot-walls direct fetch):
//   12AX7: MU=100 EX=1.4 KG1=1060 KP=600 KVB=300.
// Same per-tube-calibration caveat as the entities above.
entity TriodeECC83() {
    pin P: signal inout;  // Plate (anode)
    pin G: signal in;     // Grid
    pin K: signal inout;  // Cathode

    attribute component_class = "triode";
    attribute part_number = "ECC83";

    attribute mu = 100.0;
    attribute ex = 1.4;
    attribute kg1 = 1060.0;
    attribute kp = 600.0;
    attribute kvb = 300.0;

    // Heater ratings (ECC83 datasheet standard): 6.3V/300mA with the
    // two heater halves in PARALLEL (whole envelope), 12.6V/150mA in
    // series. Board-level heater load derives from these.
    attribute heater_v = 6.3;
    attribute heater_i_a = 0.3;

    attribute kicad_symbol = "Device:Triode";
    attribute datasheet = "Koren Table 1 (i-t.com mirror) + ECC83 heater std";
}

// The ECC83 ENVELOPE — the physical 9-pin noval bottle the PCB
// actually solders (or sockets). Electrically transparent: the two
// TriodeECC83 SECTIONS carry the model (see ECC83Dual below), and
// this carrier holds the B9A footprint. Standard 12AX7 basing:
// 1=a1 2=g1 3=k1, 4+5=heater (parallel side), 6=a2 7=g2 8=k2,
// 9=heater center tap.
entity ValveECC83_Noval() {
    pin 1: signal inout;
    pin 2: signal inout;
    pin 3: signal inout;
    pin 4: signal inout;
    pin 5: signal inout;
    pin 6: signal inout;
    pin 7: signal inout;
    pin 8: signal inout;
    pin 9: signal inout;

    // SPICE-transparent (the tube_socket class marker): sections
    // provide the electrical model, the envelope provides the pads.
    attribute component_class = "tube_socket";
    attribute part_number = "ECC83";
    attribute kicad_symbol = "Valve:ECC83";
}

// `package` is a layout keyword, not an attribute name (the
// keyword-collision saga) — the entity's footprint binds here.
layout ValveECC83_Noval { package Valve-Noval; }

// One ECC83 bottle = one 9-pin footprint + TWO Koren sections, wired
// per the 12AX7 basing. The socket-composition machinery (see
// SocketedTriode_Octal below) suppresses the sections' own footprints
// — the envelope's B9A ring is the only copper. Heater pins are
// exposed as H45 (pins 4+5 tied: 6.3V parallel wiring) and H9; the
// heater element itself is inside the bottle (6.3V/300mA data rides
// the section attrs) and is not a board part.
entity ECC83Dual() {
    pin A1: signal inout virtual;
    pin G1: signal in    virtual;
    pin K1: signal inout virtual;
    pin A2: signal inout virtual;
    pin G2: signal in    virtual;
    pin K2: signal inout virtual;
    pin H45: signal inout virtual;
    pin H9:  signal inout virtual;

    attribute component_class = "tube_socketed_assembly";

    expansion {
        // Outer pins ARE the nets — no internal relay nets. (A relay
        // net merges in the PnR connectivity walk but NOT in the
        // SPICE netlist builder: the first cut put the sections on
        // u1_a1n while the board passives sat on auto_u1_A1, and the
        // SRPP silently solved as a resistor network — the
        // "converged in 1 iteration" tell, again.)
        A1 -> V: ValveECC83_Noval().1;
        G1 -> V.2;
        K1 -> V.3;
        H45 -> V.4;
        H45 -> V.5;
        A2 -> V.6;
        G2 -> V.7;
        K2 -> V.8;
        H9 -> V.9;

        A1 -> S1: TriodeECC83().P;
        G1 -> S1.G;
        K1 -> S1.K;
        A2 -> S2: TriodeECC83().P;
        G2 -> S2.G;
        K2 -> S2.K;

        socket S1 in V;
        socket S2 in V;
    }
}

// Nominal 12AU7 / ECC82 — medium-µ dual triode, a common roll-in alternative.
entity Triode12AU7() {
    pin P: signal inout;  // Plate (anode)
    pin G: signal in;     // Grid
    pin K: signal inout;  // Cathode

    attribute component_class = "triode";
    attribute part_number = "12AU7";

    attribute mu = 21.5;
    attribute ex = 1.3;
    attribute kg1 = 1180.0;
    attribute kp = 84.0;
    attribute kvb = 300.0;

    attribute kicad_symbol = "Device:Triode";
}

// Common-cathode signal gain stage — a composite expanded by its `expansion`
// block, the tube analogue of the buck regulator's virtual-pin expansion. The
// OUT pin is `virtual`: it is not a real package pin, it is synthesized. At
// synthesis the block is interpreted and the stage is replaced by a triode
// plus its six obligatory common-cathode bias passives —
//
//   Rp   — plate load resistor      (B+ → plate)
//   Rk   — cathode bias resistor    (cathode → GND)
//   Ck   — cathode bypass capacitor (cathode → GND, in parallel with Rk)
//   Rg   — grid-leak resistor       (grid → GND)
//   Cin  — input coupling capacitor (IN → grid)
//   Cout — output coupling capacitor(plate → OUT)
//
// The stage self-biases: the grid sits at 0 V through Rg, while plate current
// through Rk lifts the cathode above it — so V_gk is the negative bias the
// triode needs, with no separate negative supply. Every passive value is an
// entity parameter, so the whole bias network is tunable from one line of HDL.
entity SignalTubeStage() {
    pin IN:  signal in;            // small-signal input (AC-coupled to the grid)
    pin VBB: power in;             // B+ plate supply
    pin GND: ground;
    pin OUT: signal out virtual;   // amplified output — `virtual`: not a real
                                   // package pin, it is synthesized by the
                                   // `expansion` block below

    attribute component_class = "tube_gain_stage";

    expansion {
        // Internal nodes of the common-cathode topology.
        internal plate:   net;
        internal grid:    net;
        internal cathode: net;

        // Rp 22 kΩ, Rk 820 Ω, Ck 100 µF, Rg 1 MΩ, Cin/Cout 100 nF.
        VBB -> Rp: Res(22000).1; Rp.2 -> plate;
        plate -> V: Triode().P;
        grid -> V.G;
        cathode -> V.K;
        cathode -> Rk: Res(820).1; Rk.2 -> GND;
        cathode -> Ck: Cap(0.0001).1; Ck.2 -> GND;
        grid -> Rg: Res(1000000).1; Rg.2 -> GND;
        IN -> Cin: Cap(0.0000001).1; Cin.2 -> grid;
        plate -> Cout: Cap(0.0000001).1; Cout.2 -> OUT;
    }

    // Vendor-authored operating-point designer for the amplifier intent.
    // The Stage-5 escape hatch: a Rhai script ported directly from
    // bhdl-spice/src/tube_bias.rs::ReferenceTriodeDesigner::first_guess.
    //
    // The declarative (Stages 1–4) design surface cannot express this
    // designer because it iterates — 64-point log-grid peak find then
    // 80-step descending-flank bisection on the gain target. The body
    // hook gives the vendor a real scripting language for exactly this
    // class of calculation.
    //
    // Method:
    //   1. Pin V_p = V_bb / 2 (symmetric swing). R_p = V_p / I_p.
    //   2. Sweep I_p on a log grid; locate the gain peak.
    //   3. Bisect the descending flank for the target gain.
    //   4. R_k from cathode self-bias: R_k = −V_gk / I_p.
    //
    // The GLACIER refine loop runs after this guess (framework's job).
    design for amplifier {
        inputs  { tube; intent; supply; }
        outputs { Rp; Rk; }
        body rune r#"
            let v_p   = supply.VBB / 2.0;
            let i_lo  = 0.5e-3;
            let i_max = plate_current(tube, v_p, 0.0);
            let i_hi  = if 30e-3 < 0.85 * i_max { 30e-3 } else { 0.85 * i_max };

            // Log-grid peak find.
            let peak_i = i_lo;
            let peak_g = 0.0;
            for k in 0..64 {
                let frac  = (k as f64) / 63.0;
                let ratio = i_hi / i_lo;
                let i = i_lo * ratio.powf(frac);
                let g = small_signal_gain(tube, v_p, i);
                if g > peak_g { peak_g = g; peak_i = i; }
            }

            // Descending-flank bisection on the gain target.
            let lo = peak_i;
            let hi = i_hi;
            for _step in 0..80 {
                let mid = (lo * hi).sqrt();
                let g = small_signal_gain(tube, v_p, mid);
                if g > intent.gain { lo = mid; } else { hi = mid; }
            }
            let i_p  = (lo * hi).sqrt();
            let v_gk = koren_inverse_vgk(tube, v_p, i_p);
            #{ Rp: v_p / i_p, Rk: (-v_gk) / i_p }
        "#
    }
}

// 12AU7 / ECC82 variant of the common-cathode signal stage. Identical
// topology to `SignalTubeStage` (and an identical `design for amplifier`
// recipe — straight copy-paste) but the expansion instantiates the
// `Triode12AU7` device entity instead of `Triode`. Stage 6 of the
// vendor design-block work routes the right Koren parameters to the
// recipe automatically by scanning expansion children for the one
// tagged `component_class = "triode"`, so this entity demonstrates
// the actual tube-rolling workflow with zero bhdl-core changes.
//
// A vendor releasing a new tube family ships a new device entity
// (Koren attrs + `component_class = "triode"`) and a stage entity
// that instantiates it; the same shipped design recipes — amplifier,
// current_source, digital_switch — design correctly for the new tube.
entity SignalTubeStage12AU7() {
    pin IN:  signal in;
    pin VBB: power in;
    pin GND: ground;
    pin OUT: signal out virtual;

    attribute component_class = "tube_gain_stage";

    expansion {
        internal plate:   net;
        internal grid:    net;
        internal cathode: net;

        VBB -> Rp: Res(22000).1; Rp.2 -> plate;
        plate -> V: Triode12AU7().P;      // the only line that differs from SignalTubeStage
        grid -> V.G;
        cathode -> V.K;
        cathode -> Rk: Res(820).1; Rk.2 -> GND;
        cathode -> Ck: Cap(0.0001).1; Ck.2 -> GND;
        grid -> Rg: Res(1000000).1; Rg.2 -> GND;
        IN -> Cin: Cap(0.0000001).1; Cin.2 -> grid;
        plate -> Cout: Cap(0.0000001).1; Cout.2 -> OUT;
    }

    // Identical to SignalTubeStage's design block. Stage 6 routes the
    // right tube parameters via the expansion child's component_class.
    design for amplifier {
        inputs  { tube; intent; supply; }
        outputs { Rp; Rk; }
        body rune r#"
            let v_p   = supply.VBB / 2.0;
            let i_lo  = 0.5e-3;
            let i_max = plate_current(tube, v_p, 0.0);
            let i_hi  = if 30e-3 < 0.85 * i_max { 30e-3 } else { 0.85 * i_max };

            let peak_i = i_lo;
            let peak_g = 0.0;
            for k in 0..64 {
                let frac  = (k as f64) / 63.0;
                let ratio = i_hi / i_lo;
                let i = i_lo * ratio.powf(frac);
                let g = small_signal_gain(tube, v_p, i);
                if g > peak_g { peak_g = g; peak_i = i; }
            }

            let lo = peak_i;
            let hi = i_hi;
            for _step in 0..80 {
                let mid = (lo * hi).sqrt();
                let g = small_signal_gain(tube, v_p, mid);
                if g > intent.gain { lo = mid; } else { hi = mid; }
            }
            let i_p  = (lo * hi).sqrt();
            let v_gk = koren_inverse_vgk(tube, v_p, i_p);
            #{ Rp: v_p / i_p, Rk: (-v_gk) / i_p }
        "#
    }
}

// Triode current source — a constant-current sink. The cathode resistor R_k
// is *unbypassed* (no bypass capacitor), so the negative feedback through it
// is fully active at signal frequencies, presenting a high output impedance
// at the plate. R_k sets the quiescent plate current.
//
// `for current_source(current: I)` on a net into OUT asks the designer to
// size R_k for I_p = I at a moderate operating V_pk; the actual V_pk is then
// determined by whatever the user wires above the OUT pin.
entity TubeCurrentSource() {
    pin OUT: signal out virtual;   // top of the current source — the plate
    pin K:   signal inout;          // cathode return (typically to ground)

    attribute component_class = "tube_current_source";

    expansion {
        // Internal nodes of the degenerated common-cathode topology.
        internal g_int: net;
        internal k_int: net;

        // Triode: plate at OUT, grid and cathode on internal nets.
        OUT    -> V: Triode().P;
        g_int  -> V.G;
        k_int  -> V.K;

        // Cathode degeneration (no bypass cap — that's the whole point);
        // grid-leak to the cathode return so V_g sits at K's potential.
        k_int  -> Rk: Res(800).1;     Rk.2 -> K;
        g_int  -> Rg: Res(1000000).1; Rg.2 -> K;
    }

    // Vendor-authored operating-point designer for the current_source intent.
    // The Rust reference designer in bhdl-spice/src/tube_bias.rs is still
    // shipped as the default; this `design { }` block — declared right next
    // to the entity that uses it — overrides the reference when the
    // synthesizer sees `for current_source(...)` on this entity.
    //
    // Method: pick V_pk = 100 V as the design point; invert the Koren
    // plate-current law for the V_gk that draws the target current there;
    // R_k follows from cathode self-bias V_k = I · R_k = -V_gk.
    design for current_source {
        const v_pk = 100.0;
        const i_target = intent.current;
        const i_max = plate_current(tube.mu, tube.ex, tube.kg1, tube.kp, tube.kvb, v_pk, 0.0);
        require i_target < i_max
            else "current target exceeds the tube's zero-bias current at V_pk = 100V";
        const v_gk = koren_inverse_vgk(tube.mu, tube.ex, tube.kg1, tube.kp, tube.kvb, v_pk, i_target);
        Rk = (0.0 - v_gk) / i_target;
    }
}

// Triode switch — operated hard between cutoff and saturation.
//
// `for switch()` on the IN net asks the designer to size the plate-load
// resistor R_p so the saturated state (V_gk ≈ 0) pulls the plate down to
// near ground; cutoff naturally leaves the plate at V_bb. No bypass cap,
// no coupling caps — DC drive in, DC level out.
entity TubeSwitch() {
    pin IN:  signal in;
    pin OUT: signal out virtual;   // plate — drives the next stage's input
    pin VBB: power in;
    pin GND: ground inout;

    attribute component_class = "tube_switch";

    expansion {
        // R_p from V_bb to the plate; the plate IS the OUT pin (DC-coupled).
        VBB -> Rp: Res(50000).1; Rp.2 -> OUT;
        // Triode: plate = OUT, grid driven by IN, cathode to GND.
        OUT -> V: Triode().P;
        IN  -> V.G;
        GND -> V.K;
    }

    // Vendor-authored operating-point designer for the digital_switch intent.
    // Mirrors bhdl-spice/src/tube_bias.rs::design_switch and overrides it when
    // the synthesizer expands a `for digital_switch()` net into this entity.
    //
    // Method: at saturation V_gk = 0, so the plate current is the tube's
    // zero-bias current at the saturated plate voltage V_sat. Pick R_p so
    // that current pulls the plate from V_bb down to V_sat. At cutoff the
    // tube draws no current and the plate naturally rests at V_bb, giving
    // a clean rail-to-rail swing.
    design for digital_switch {
        const v_sat = 10.0;
        const v_bb = supply.VBB;
        require v_bb > v_sat
            else "switch needs V_bb > 10 V to leave headroom for saturation";
        const i_sat = plate_current(tube.mu, tube.ex, tube.kg1, tube.kp, tube.kvb, v_sat, 0.0);
        require i_sat > 0.0
            else "tube draws no current at zero bias near saturation — cannot pull the plate down";
        Rp = (v_bb - v_sat) / i_sat;
    }
}


// Socketed-tube composition entity. Wraps the canonical Triode
// (currently a 6SN7 — see actives/triode.bhdl entity above) in
// an octal chassis socket. The composition presents the same
// three electrical pins as a bare Triode (P / G / K), plus the
// two heater pins (H1 / H2) which the bare Triode entity doesn't
// expose. Vendors who want a different tube in the same socket
// write a parallel entity (e.g. `SocketedTriode6L6_Octal`) that
// instantiates `Triode6L6` instead.
//
// Architectural points:
//   - Two children: the SOCKET (physical, has its own SKU/footprint)
//     and the TUBE (electrical, no PCB footprint of its own — it
//     plugs into the socket).
//   - Shared internal nets join socket pin N to tube terminal X for
//     each electrical connection. Standard 6SN7 octal pinout:
//     pin 2 = H heater, pin 3 = P plate, pin 5 = G grid,
//     pin 7 = H heater, pin 8 = K cathode.
//   - The `socket V in S;` line tells the synthesizer that V is
//     held by S; after expansion the synthesizer stamps
//     `socketed_in = "<base>_S"` on V's attributes so downstream
//     PnR / KiCad export suppress V's footprint. The TUBE entity
//     itself doesn't carry "I have no footprint" — that's a
//     property of THIS composition, not the tube.
//   - SPICE sees only the tube (sockets carry component_class =
//     "tube_socket" which the converter skips silently). BOM sees
//     both rows (socket + tube), each with its own SKU.
entity SocketedTriode_Octal() {
    // All outer pins are `virtual` — the composition entity has no
    // physical package of its own; its package IS the socket's
    // (Belton VTB9-PT). The outer pin presented to the board is a
    // relay to the corresponding socket terminal, set up by the
    // expansion block below. Marking them virtual is what activates
    // the expansion interpreter for this composition.
    pin P:  signal inout virtual;   // plate (relays to socket pin 3)
    pin G:  signal in    virtual;   // grid  (relays to socket pin 5)
    pin K:  signal inout virtual;   // cathode (relays to socket pin 8)
    pin H1: signal inout virtual;   // heater (relays to socket pin 2)
    pin H2: signal inout virtual;   // heater (relays to socket pin 7)

    attribute component_class = "tube_socketed_assembly";

    expansion {
        // Internal nets: one per (socket pin, tube terminal) pair
        // we want to expose at the composition's outer pins.
        internal plate_net:   net;
        internal grid_net:    net;
        internal cathode_net: net;
        internal h1_net:      net;
        internal h2_net:      net;

        // Socket (mechanical / SKU / footprint).
        plate_net   -> S: TubeSocket_Octal().3;
        grid_net    -> S.5;
        cathode_net -> S.8;
        h1_net      -> S.2;
        h2_net      -> S.7;

        // Tube (electrical). Same internal nets — the socket pin
        // and the tube terminal are electrically the same node.
        plate_net   -> V: Triode().P;
        grid_net    -> V.G;
        cathode_net -> V.K;
        // (Heater pins not modelled on bare Triode entity yet —
        // they're informational on the socket side for layout.)

        // Forward outer pins to the SOCKET nets (PCB lands on the
        // socket terminals, not on the tube). The connection-walk
        // path naturally treats these as same-net per the existing
        // expansion machinery.
        P  -> plate_net;
        G  -> grid_net;
        K  -> cathode_net;
        H1 -> h1_net;
        H2 -> h2_net;

        // Socket-pairing declaration. Stamps `socketed_in = "<base>_S"`
        // on V's attributes after expansion — downstream consumers
        // (PnR, KiCad export) suppress V's footprint placement (the
        // socket is what gets soldered to the PCB).
        socket V in S;
    }
}
