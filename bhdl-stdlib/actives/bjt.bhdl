// Bipolar Junction Transistor Component Module
// Supports NPN and PNP transistors with SPICE parameters

import { ImpedanceCharacteristics } from "../types/electrical_types.bhdl";

// BJT electrical characteristics and SPICE parameters
type BJTParams = {
    // Basic characteristics
    type: string,                    // "npn" or "pnp"
    hfe_min: float,                 // Minimum DC current gain
    hfe_max: float,                 // Maximum DC current gain
    vceo: voltage,                  // Collector-emitter voltage (base open)
    vcbo: voltage,                  // Collector-base voltage
    vebo: voltage,                  // Emitter-base voltage
    ic_max: current,                // Maximum collector current
    power_dissipation: power,       // Maximum power dissipation
    ft: frequency,                  // Transition frequency
    
    // SPICE Ebers-Moll parameters
    is: float,                      // Saturation current
    bf: float,                      // Forward beta
    nf: float,                      // Forward emission coefficient
    vaf: voltage?,                  // Forward Early voltage
    ikf: current?,                  // Forward knee current
    ise: float?,                    // Base-emitter saturation current
    ne: float?,                     // Base-emitter emission coefficient
    br: float,                      // Reverse beta
    nr: float,                      // Reverse emission coefficient
    var: voltage?,                  // Reverse Early voltage
    ikr: current?,                  // Reverse knee current
    isc: float?,                    // Base-collector saturation current
    nc: float?,                     // Base-collector emission coefficient
    
    // Resistances
    rb: resistance,                 // Base resistance
    rc: resistance,                 // Collector resistance
    re: resistance,                 // Emitter resistance
    
    // Capacitances
    cje: capacitance,               // Base-emitter capacitance
    vje: voltage,                   // Base-emitter junction potential
    mje: float,                     // Base-emitter grading coefficient
    cjc: capacitance,               // Base-collector capacitance
    vjc: voltage,                   // Base-collector junction potential
    mjc: float,                     // Base-collector grading coefficient
    cjs: capacitance?,              // Substrate capacitance
    vjs: voltage?,                  // Substrate junction potential
    mjs: float?,                    // Substrate grading coefficient
    
    // Transit times
    tf: time,                       // Forward transit time
    tr: time,                       // Reverse transit time
    
    // Temperature parameters
    eg: voltage,                    // Energy gap
    xti: float,                     // Temperature exponent for IS
    xtb: float,                     // Temperature exponent for beta
    tnom: temperature,              // Nominal temperature
    
    impedance: ImpedanceCharacteristics,
};

module BJT(part: string = "2N2222", package: string = "TO-92") {
    pin C: signal inout;  // Collector
    pin B: signal inout;  // Base  
    pin E: signal inout;  // Emitter
    
    // Common BJT parameters
    const BJT_2N2222: BJTParams = {
        // Basic characteristics
        type: "npn",
        hfe_min: 100,
        hfe_max: 300,
        vceo: 40V,
        vcbo: 75V,
        vebo: 6V,
        ic_max: 600mA,
        power_dissipation: 625mW,
        ft: 250MHz,
        
        // SPICE parameters
        is: 14.34e-15,
        bf: 255.9,
        nf: 1.0,
        vaf: 74.03,
        ikf: 0.2847,
        ise: 14.34e-15,
        ne: 1.307,
        br: 6.092,
        nr: 1.0,
        var: 24,
        ikr: null,
        isc: null,
        nc: 2,
        
        // Resistances
        rb: 10,
        rc: 1,
        re: 0.1,
        
        // Capacitances
        cje: 22.01e-12,
        vje: 0.75,
        mje: 0.377,
        cjc: 7.306e-12,
        vjc: 0.75,
        mjc: 0.3416,
        cjs: 0,
        vjs: 0.75,
        mjs: 0,
        
        // Transit times
        tf: 397.1e-12,
        tr: 118.7e-9,
        
        // Temperature
        eg: 1.11,
        xti: 3.0,
        xtb: 1.5,
        tnom: 27°C,
        
        impedance: {
            dc_resistance: null,
            output_impedance: 1,  // rc
            input_impedance: 10,  // rb
            can_source_current: true,
            can_sink_current: true,
            max_source_current: 600mA,
            max_sink_current: 600mA,
            power_domain_isolation: false,
            voltage_drop: 0.7V,  // VBE
            current_limiting: false,
            transient_response: 397.1e-12,
            inrush_current: null
        }
    };
    
    const BJT_2N2907: BJTParams = {
        // Basic characteristics  
        type: "pnp",
        hfe_min: 100,
        hfe_max: 300,
        vceo: -60V,
        vcbo: -60V,
        vebo: -5V,
        ic_max: 600mA,
        power_dissipation: 625mW,
        ft: 200MHz,
        
        // SPICE parameters
        is: 650.6e-18,
        bf: 232.5,
        nf: 1.01,
        vaf: 115.7,
        ikf: 1.079,
        ise: 54.81e-15,
        ne: 1.58,
        br: 13.26,
        nr: 1.005,
        var: null,
        ikr: null,
        isc: null,
        nc: 2,
        
        // Resistances
        rb: 10,
        rc: 0.715,
        re: 0.1,
        
        // Capacitances
        cje: 29.01e-12,
        vje: 0.75,
        mje: 0.2805,
        cjc: 9.81e-12,
        vjc: 0.5,
        mjc: 0.3357,
        cjs: 0,
        vjs: 0.75,
        mjs: 0,
        
        // Transit times
        tf: 603.7e-12,
        tr: 111.3e-9,
        
        // Temperature
        eg: 1.11,
        xti: 3.0,
        xtb: 1.5,
        tnom: 27°C,
        
        impedance: {
            dc_resistance: null,
            output_impedance: 0.715,
            input_impedance: 10,
            can_source_current: true,
            can_sink_current: true,
            max_source_current: 600mA,
            max_sink_current: 600mA,
            power_domain_isolation: false,
            voltage_drop: -0.7V,
            current_limiting: false,
            transient_response: 603.7e-12,
            inrush_current: null
        }
    };
    
    const BJT_2N3904: BJTParams = {
        // Basic characteristics
        type: "npn",
        hfe_min: 100,
        hfe_max: 300,
        vceo: 40V,
        vcbo: 60V,
        vebo: 6V,
        ic_max: 200mA,
        power_dissipation: 625mW,
        ft: 300MHz,
        
        // SPICE parameters
        is: 1.03e-14,
        bf: 416.5,
        nf: 1.0,
        vaf: 74.03,
        ikf: 0.06678,
        ise: 6.734e-15,
        ne: 1.259,
        br: 0.7371,
        nr: 1.0,
        var: null,
        ikr: null,
        isc: null,
        nc: 2,
        
        // Resistances
        rb: 10,
        rc: 1,
        re: 0.1,
        
        // Capacitances
        cje: 4.493e-12,
        vje: 0.75,
        mje: 0.2593,
        cjc: 3.638e-12,
        vjc: 0.75,
        mjc: 0.3085,
        cjs: 0,
        vjs: 0.75,
        mjs: 0,
        
        // Transit times
        tf: 301.2e-12,
        tr: 239.5e-9,
        
        // Temperature
        eg: 1.11,
        xti: 3.0,
        xtb: 1.5,
        tnom: 27°C,
        
        impedance: {
            dc_resistance: null,
            output_impedance: 1,
            input_impedance: 10,
            can_source_current: true,
            can_sink_current: true,
            max_source_current: 200mA,
            max_sink_current: 200mA,
            power_domain_isolation: false,
            voltage_drop: 0.7V,
            current_limiting: false,
            transient_response: 301.2e-12,
            inrush_current: null
        }
    };
    
    const BJT_2N3906: BJTParams = {
        // Basic characteristics
        type: "pnp",
        hfe_min: 100,
        hfe_max: 300,
        vceo: -40V,
        vcbo: -40V,
        vebo: -5V,
        ic_max: 200mA,
        power_dissipation: 625mW,
        ft: 250MHz,
        
        // SPICE parameters
        is: 1.41e-14,
        bf: 180.7,
        nf: 1.005,
        vaf: 18.7,
        ikf: 0.08039,
        ise: 0,
        ne: 1.5,
        br: 4.977,
        nr: 1.0,
        var: null,
        ikr: null,
        isc: null,
        nc: 2,
        
        // Resistances
        rb: 2.756,
        rc: 0.5,
        re: 0.1,
        
        // Capacitances
        cje: 6.328e-12,
        vje: 0.75,
        mje: 0.2805,
        cjc: 5.5e-12,
        vjc: 0.5383,
        mjc: 0.3357,
        cjs: 0,
        vjs: 0.75,
        mjs: 0,
        
        // Transit times
        tf: 451.2e-12,
        tr: 171.3e-9,
        
        // Temperature
        eg: 1.11,
        xti: 3.0,
        xtb: 1.5,
        tnom: 27°C,
        
        impedance: {
            dc_resistance: null,
            output_impedance: 0.5,
            input_impedance: 2.756,
            can_source_current: true,
            can_sink_current: true,
            max_source_current: 200mA,
            max_sink_current: 200mA,
            power_domain_isolation: false,
            voltage_drop: -0.7V,
            current_limiting: false,
            transient_response: 451.2e-12,
            inrush_current: null
        }
    };
    
    // Get parameters based on part number
    const params: BJTParams = 
        part == "2N2222" || part == "2N2222A" ? BJT_2N2222 :
        part == "2N2907" || part == "2N2907A" ? BJT_2N2907 :
        part == "2N3904" ? BJT_2N3904 :
        part == "2N3906" ? BJT_2N3906 :
        BJT_2N2222;  // Default to 2N2222
    
    // Component metadata
    attribute component_class = "bjt";
    attribute transistor_type = params.type;
    attribute part_number = part;
    
    // Electrical characteristics
    attribute hfe_min = params.hfe_min;
    attribute hfe_max = params.hfe_max;
    attribute vceo = params.vceo;
    attribute vcbo = params.vcbo;
    attribute vebo = params.vebo;
    attribute ic_max = params.ic_max;
    attribute power_dissipation = params.power_dissipation;
    attribute transition_frequency = params.ft;
    
    // SPICE model parameters
    attribute spice_model = "bjt";
    attribute spice_type = params.type;
    attribute spice_is = params.is;
    attribute spice_bf = params.bf;
    attribute spice_nf = params.nf;
    attribute spice_vaf = params.vaf;
    attribute spice_ikf = params.ikf;
    attribute spice_ise = params.ise;
    attribute spice_ne = params.ne;
    attribute spice_br = params.br;
    attribute spice_nr = params.nr;
    attribute spice_var = params.var;
    attribute spice_ikr = params.ikr;
    attribute spice_isc = params.isc;
    attribute spice_nc = params.nc;
    attribute spice_rb = params.rb;
    attribute spice_rc = params.rc;
    attribute spice_re = params.re;
    attribute spice_cje = params.cje;
    attribute spice_vje = params.vje;
    attribute spice_mje = params.mje;
    attribute spice_cjc = params.cjc;
    attribute spice_vjc = params.vjc;
    attribute spice_mjc = params.mjc;
    attribute spice_cjs = params.cjs;
    attribute spice_vjs = params.vjs;
    attribute spice_mjs = params.mjs;
    attribute spice_tf = params.tf;
    attribute spice_tr = params.tr;
    attribute spice_eg = params.eg;
    attribute spice_xti = params.xti;
    attribute spice_xtb = params.xtb;
    attribute spice_tnom = params.tnom;
    
    // KiCad symbol
    attribute kicad_symbol = params.type == "npn" ? "Device:Q_NPN_BCE" : "Device:Q_PNP_BCE";
    
    // Package selection
    attribute package = 
        package == "TO-92" ? "Package_TO_SOT_THT:TO-92_Inline" :
        package == "SOT-23" ? "Package_TO_SOT_SMD:SOT-23" :
        package == "TO-18" ? "Package_TO_SOT_THT:TO-18-3" :
        package == "TO-220" ? "Package_TO_SOT_THT:TO-220-3_Vertical" :
        "Package_TO_SOT_THT:TO-92_Inline";
}

// Aliases for common parts
alias 2N2222 = BJT("2N2222");
alias 2N2907 = BJT("2N2907");
alias 2N3904 = BJT("2N3904");
alias 2N3906 = BJT("2N3906");