// BJT — 3-terminal bipolar junction transistor (collector/base/emitter),
// NPN or PNP.
//
// Regenerated to the current v2 standard. The pre-v2 file selected a per-part
// parameter struct out of `const BJT_2N2222 = { … }` knowledge maps with
// ternary chains — unparseable today, so the file was only reachable through
// partial-parse tolerance. Same treatment as mosfet.bhdl: keep the datasheet
// data, express it in the parseable idiom.
//
// Electrical axes are constructor params (defaults = 2N2222); each SKU alias
// binds its datasheet values positionally. PNP ratings are magnitudes with
// polarity = "pnp" carrying the sign. Note: actives/bjt_design.bhdl separately
// provides the designed-stage entities (NPN_2N3904 / NPN_2N2222 with bias
// design blocks); this file is the bare device.
//
// Datasheet sources: onsemi 2N2222A / 2N2907A / 2N3904 / 2N3906.

entity BJT(
    part_no: string     = "2N2222",
    polarity: string    = "npn",     // "npn" | "pnp"
    vceo: voltage       = 40V,       // collector-emitter breakdown (magnitude)
    ic_max: current     = 600mA,     // continuous collector current (magnitude)
    hfe_min: float      = 100,       // DC gain, min
    power_rating: power = 625mW      // package dissipation
) {
    pin C: signal inout;  // Collector
    pin B: signal inout;  // Base
    pin E: signal inout;  // Emitter

    attribute component_class = "bjt";
    attribute transistor_type = polarity;
    attribute part_number     = part_no;
    attribute vceo            = vceo;
    attribute ic_max          = ic_max;
    attribute hfe_min         = hfe_min;
    attribute power_rating    = power_rating;
    attribute kicad_symbol    = "Device:Q_NPN_BCE";
}

// SKU aliases bind the datasheet values positionally.
alias BJT_2N2222 = BJT("2N2222", "npn", 40V, 600mA, 100, 625mW);
alias BJT_2N2907 = BJT("2N2907", "pnp", 60V, 600mA, 100, 625mW);
alias BJT_2N3904 = BJT("2N3904", "npn", 40V, 200mA, 100, 625mW);
alias BJT_2N3906 = BJT("2N3906", "pnp", 40V, 200mA, 100, 625mW);
