// Simplified MOSFET — parser-compatible (v2.0 grammar subset).
//
// Three-terminal MOSFET: gate, drain, source. Covers both N-
// and P-channel devices (channel polarity comes from the
// part-number selection, not the entity itself). The
// 4th-terminal (bulk/body) variant isn't covered here — most
// discrete MOSFETs tie body internally to source. Pins are the
// gate/drain/source (G/D/S).

// `part` and `package` are reserved keywords in BHDL grammar
// (PART_KW / PACKAGE_KW), so the parameter names use the
// underscore-prefixed convention common in stdlib entities to
// dodge collisions.
entity MOSFET(part_no: string = "", pkg: string = "SOT-23") {
    pin G: signal inout;  // Gate
    pin D: signal inout;  // Drain
    pin S: signal inout;  // Source

    attribute component_class = "transistor";
    attribute transistor_type = "mosfet";
    attribute part_number     = part_no;
    attribute footprint       = pkg;
}
