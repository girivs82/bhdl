// Fiducial markers — board-edge alignment targets for pick-and-place
// optical recognition. Purely mechanical: no electrical role.
//
// Carries one pin so the fiducial gets a refdes (FID*); the pin is
// unused — it appears on no net.
//
// Grammar discipline: parser-compatible v2.0 subset.

entity Fiducial(part_no: string = "Fiducial") {
    pin K: signal inout;     // marker pad (unconnected)       (pin 1)

    attribute component_class = "fiducial";
    attribute electrical_role = "none";
    attribute part_number     = part_no;
}
