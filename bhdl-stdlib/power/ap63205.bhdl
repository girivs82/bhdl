// AP63205WU: Diodes Inc 2A synchronous step-down converter
// Wide input (3.8V-32V), fixed 5V output, integrated MOSFETs (no catch diode)
// Datasheet: AP63200/AP63201/AP63203/AP63205 series

entity AP63205(
    f_sw: frequency = 500kHz,
    rds_on: resistance = 120mΩ,
    t_sw: time = 15ns,
    i_quiescent: current = 22µA,
    l_value: inductance = 4.7µH,
    c_out: capacitance = 22µF,
    c_in: capacitance = 10µF
) {
    pin VIN:  power in;
    pin VOUT: power out virtual;
    pin EN:   signal in;
    pin BST:  signal inout;
    pin SW:   switch out;
    pin GND:  ground;

    attribute component_class = "switching_regulator";
    attribute output_voltage = 5V;
    attribute f_sw = f_sw;
    attribute rds_on = rds_on;
    attribute t_sw = t_sw;
    attribute i_quiescent = i_quiescent;
    attribute power_rating = 1.1W;  // TSOT-26 free-air ((125−25)°C / ~90°C/W with pad)

    expansion {
        // Synchronous — no catch diode (integrated low-side FET)
        SW -> L_out: Ind(l_value).1; L_out.2 -> VOUT;
        VOUT -> C_out: Cap(c_out).1; C_out.2 -> GND;
        VIN -> C_in: Cap(c_in).1; C_in.2 -> GND;
        BST -> C_bst: Cap(100nF).1; C_bst.2 -> SW;
    }

    // PCB layout from AP63205 datasheet Figure 5 (Typical Application)
    // Coordinates in mm relative to IC center
    // Reference: https://www.diodes.com/assets/Datasheets/AP63200-AP63201-AP63203-AP63205.pdf
    placement {
        reference "AP63205 Datasheet Fig.5";
        L_out at (0.0, -6.0) rot 0;
        C_out at (6.0, 0.0) rot 90;
        C_in  at (-6.0, 0.0) rot 90;
        C_bst at (3.5, -4.5) rot 0;
    }
    // §4 device-stress IP: buck stress on this part's expansion children at
    // the solved operating point, against the SNAPPED values.
    simulation {
        stress {
            const duty = vout / vin;
            const d_il = (vin - vout) * duty / (self.f_sw * L_out.value);
            L_out.i_peak   = i_out + d_il / 2;
            C_out.v_ripple = d_il / (8 * self.f_sw * C_out.value);
            C_in.v_ripple  = i_out * duty * (1 - duty) / (self.f_sw * C_in.value);
        }
    }
}

symbol AP63205 {
    left   { VIN, EN, BST }
    right  { SW }
    bottom { GND }
}

layout AP63205 {
    package TSOT-26;
}
