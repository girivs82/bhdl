// AP63205 — Diodes Inc. 3.8–32 V input, 2 A synchronous buck, fixed
// 5 V output, TSOT-26 (DS41326 Rev. 3, AP63200/01/03/05).
//
// Two-layer library model (docs/spec/Requirements_And_Resolution.md §1):
//   AP63205      as part    — vendor truth.
//   Buck_AP63205 as design  — the designer's subcircuit (the datasheet
//                             Fig. 5 application circuit: 4.7 µH, 22 µF
//                             out, 10 µF in, 100 nF BST), `impl
//                             BuckStage`. Fixed-voltage part: the block's
//                             v_out is the 5 V SKU only (envelope).
// Figures from DS41326 Rev. 3: fSW 1100 kHz typ for AP63203/AP63205 (the
// 500 kHz oscillator is the AP63200/AP63201's — the earlier 500 kHz here
// was wrong), RDS(on) HS 125 mΩ / LS 68 mΩ typ, IQ 22 µA typ, TA −40…85 °C
// ambient, θJA 89 °C/W TSOT26. t_sw is NOT in the datasheet and stays the
// carried-over switching-loss class estimate, stated.

// The block's children are the block's business: the library file
// imports what its application circuit instantiates (a board that
// states only a requirement imports nothing else).
import { Cap } from "bhdl-stdlib/passives/capacitor.bhdl";
import { Ind } from "bhdl-stdlib/passives/inductor.bhdl";

// ── Vendor truth ────────────────────────────────────────────────────
entity AP63205(
    f_sw: frequency = 1100kHz,      // DS41326: oscillator frequency, AP63203/AP63205, 1100 kHz typ
    rds_on: resistance = 125mΩ,     // DS41326: RDS(ON)1 high-side, 125 mΩ typ (low-side 68 mΩ)
    t_sw: time = 15ns,              // NOT in DS41326 — switching-loss class estimate, carried over
    i_quiescent: current = 22µA     // DS41326: IQ 22 µA typ
) as part {
    pin VIN:  power in;
    pin EN:   signal in;
    pin BST:  signal inout;
    pin SW:   switch out;
    pin GND:  ground;

    attribute component_class = "regulator_ic";
    attribute manufacturer    = "Diodes Incorporated";
    attribute part_number     = "AP63205";
    attribute output_voltage  = 5V;       // fixed-output SKU
    attribute output_current  = 2A;       // DS41326: 2 A continuous output current
    attribute vin_min         = 3.8V;     // DS41326: input voltage range 3.8 V to 32 V
    attribute vin_max         = 32V;
    attribute temp_min        = -40degC;  // DS41326 recommended operating: TA −40 °C to +85 °C (ambient)
    attribute temp_max        = 85degC;
    attribute tj_max          = 160degC;  // DS41326 absolute maximum junction temperature (thermal shutdown +160 °C)
    attribute theta_ja        = 89degC/W; // DS41326 junction-to-ambient, TSOT26
    attribute theta_jc        = 39degC/W; // DS41326 junction-to-case, TSOT26
    attribute f_sw            = f_sw;
    attribute rds_on          = rds_on;
    attribute t_sw            = t_sw;
    attribute i_quiescent     = i_quiescent;
    attribute power_rating    = 1.1W;     // class estimate ((125−25)°C / ~90 °C/W) — consistent with the datasheet θJA 89
}

symbol AP63205 {
    left   { VIN, EN, BST }
    right  { SW }
    bottom { GND }
}

layout AP63205 {
    package TSOT-26;
}

// ── The designer's subcircuit ───────────────────────────────────────
entity Buck_AP63205(
    v_out:     voltage     = 5V,      // fixed 5 V SKU
    i_out_max: current     = 1A,
    v_in:      voltage     = 12V,
    l_value:   inductance  = 4.7µH,   // datasheet Fig. 5
    c_out:     capacitance = 22µF,
    c_in:      capacitance = 10µF
) as design {
    pin VIN:  power in;
    pin VOUT: power out virtual;
    pin EN:   signal in;
    pin GND:  ground;

    attribute component_class = "switching_regulator";
    attribute output_voltage  = v_out;
    attribute v_in            = v_in;
    attribute i_out_max       = i_out_max;
    attribute output_current  = 2A;
    attribute vin_min         = 3.8V;
    attribute vin_max         = 32V;
    attribute temp_min        = -40degC;  // DS41326 (ambient)
    attribute temp_max        = 85degC;
    attribute tj_max          = 160degC;
    attribute theta_ja        = 89degC/W; // DS41326, TSOT26
    attribute f_sw            = 1100kHz;  // DS41326 (AP63203/AP63205)
    attribute rds_on          = 125mΩ;    // DS41326 HS typ
    attribute t_sw            = 15ns;     // class estimate (not in DS41326)
    attribute i_quiescent     = 22uA;

    design {
        const vout = self.v_out;
        require vout == 5.0
            else "Buck_AP63205 envelope: fixed 5V SKU — v_out must be 5V (AP63203 is the 3.3V part)";
        // 2 A rating × 0.8 derating; datasheet input range; buck headroom.
        require self.i_out_max <= 1.6
            else "Buck_AP63205 envelope: i_out_max exceeds 1.6A (2A rating × 0.8 derating)";
        require self.v_in >= 3.8
            else "Buck_AP63205 envelope: v_in below the 3.8V input minimum";
        require self.v_in <= 32.0
            else "Buck_AP63205 envelope: v_in above the 32V input maximum";
        require vout < self.v_in
            else "buck V_OUT must be below V_IN";
    }

    u: AP63205();
    VIN -> u.VIN;
    u.GND -> GND;
    // EN is OPTIONAL: unwired → tied to VIN (enabled); wired → board-driven.
    generate if (wired(EN)) {
        EN -> u.EN;
    } else {
        VIN -> u.EN;
    }
    u.SW -> L_out: Ind(l_value).1; L_out.2 -> VOUT;
    VOUT -> C_out: Cap(c_out).1; C_out.2 -> GND;
    VIN -> C_in: Cap(c_in).1; C_in.2 -> GND;
    u.BST -> C_bst: Cap(100nF).1; C_bst.2 -> u.SW;

    placement {
        reference "AP63205 Datasheet Fig.5";
        L_out at (0.0, -6.0) rot 0;
        C_out at (6.0, 0.0) rot 90;
        C_in  at (-6.0, 0.0) rot 90;
        C_bst at (3.5, -4.5) rot 0;
    }
    simulation {
        stress {
            const duty = vout / vin;
            const d_il = (vin - vout) * duty / (self.f_sw * L_out.value);
            L_out.i_peak   = i_out + d_il / 2;
            C_out.v_ripple = d_il / (8 * self.f_sw * C_out.value);
            C_in.v_ripple  = i_out * duty * (1 - duty) / (self.f_sw * C_in.value);
        }
    }
}

impl BuckStage for Buck_AP63205 {
    const vout  = v_out;
    const i_max = i_out_max;
    const vin   = v_in;
}

alias AP63205_5V = Buck_AP63205(5V);
