// Generic placeholder regulators — the power tree's emission targets.
//
// THE CONTRACT: all four entities share the SAME positional ctor
// (vin_nom, vout_nom, i_rating), the same pin names (VIN, VOUT, GND)
// and the same exported attributes. Committing a real part is a
// RENAME of the entity instantiation — the ctor args and wiring stay;
// real regulator entities in the library should keep this contract so
// the swap never touches the tree. The per-stage ASSUMPTIONS
// (efficiency, noise, phases) ride as scoped attributes on the
// instance — they are the acceptance test the real part must meet or
// beat at sign-off.
//
// These are placeholders: no expansion blocks, no vendor data — a
// board carrying them is a planned tree, not a finished design.
//
// NOISE CONVENTION for real regulators: `attribute output_noise =
// <µVrms>;` — the datasheet's RMS output-noise figure (state the
// bandwidth and bypass condition in the trailing comment). Declared
// ONLY where the datasheet states one: switching parts give ripple,
// not noise, and must not declare ripple here. ERC032 compares a
// committed part's output_noise against the tree's
// powertree_noise_assumed_uvrms; an undeclared figure is UNCHECKED
// and said so — never a pass.

entity GenericBuck(vin: voltage, vout: voltage, rated: current) {
    pin VIN: power in;
    pin VOUT: power out;
    pin GND: ground;
    pin EN: signal in;    // optional (chain input) — placeholder accepts the wiring the tree emits
    pin PG: signal inout;   // optional (chain output)
    attribute component_class = "regulator";
    attribute gated_pins = "EN,PG";
    attribute vin_nom = vin;
    attribute vout_nom = vout;
    attribute i_rating = rated;
    attribute topology = "buck";
    attribute kicad_symbol = "Regulator_Switching:Generic";
    attribute open_drain_pins = "PG";  // PG is open-drain (wired-AND legal; ERC037 wants the bus pull-up)
}

