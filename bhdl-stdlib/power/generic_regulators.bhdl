entity GenericPrereg(vin: voltage, vout: voltage, rated: current) {
    pin VIN: power in;
    pin VOUT: power out;
    pin GND: ground;
    attribute component_class = "protection";
    attribute vin_nom = vin;
    attribute vout_nom = vout;
    attribute i_rating = rated;
    attribute topology = "prereg";
    attribute kicad_symbol = "Power_Protection:Generic";
}
