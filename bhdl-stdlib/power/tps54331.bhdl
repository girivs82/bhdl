// TPS54331: TI 3A step-down (buck) converter (SLVS839H).
//
// THE TEMPLATE for the two-layer library model
// (docs/spec/Requirements_And_Resolution.md §1): this file carries two
// entities —
//
//   TPS54331      as part    — VENDOR TRUTH. The silicon: exact pins,
//                              package, datasheet attributes. No
//                              application circuit. Every figure cites
//                              the datasheet.
//   Buck_TPS54331 as design  — THE DESIGNER'S SUBCIRCUIT. Instantiates
//                              the part, adds the application circuit
//                              sized by TI's design procedure, exposes
//                              the contract pins (VIN / VOUT / GND / EN).
//                              Built once, reviewed against the
//                              datasheet, parameterized by the
//                              application's requirements, reused.
//
// The block is what the board sees as "the regulator": it carries the
// behavioral model attributes the solver/sign-off read (class
// switching_regulator, f_sw, rds_on, …) and the promises the power
// tree's acceptance check reads (output_current, efficiency). Committing
// a real part to a power-tree stage = renaming the Generic* placeholder
// to this block; wiring is untouched because the pin contract matches.
//
// Sized components (TI SLVS839H application equations):
//   - L_out : (V_IN−V_OUT)·D / (f_sw·ΔI_L),  ΔI_L = ripple_ratio·I_out
//   - C_out : ΔI_L / (8·f_sw·ΔV_out)
//   - C_in  : I_out·D·(1−D) / (f_sw·ΔV_in)
//   - R_top : R_bot·(V_OUT−V_REF)/V_REF   (V_REF = 0.8V internal)
// Fixed by datasheet: catch diode, 100nF bootstrap cap, R_bot reference.
//
// These are STEADY-STATE SEED values, not final BOM values. The point of
// computing them from the operating point (rather than copying a datasheet
// table) is to hand simulation a principled, board-specific starting
// point; GLACIER/SPICE then closes the loop and refines where the closed
// form under-provisions. In particular the FB divider (R_top) lands on the
// datasheet value to E96 rounding, and L_out is the true ripple minimum
// (a real BOM rounds up for margin). C_out/C_in from the ripple-only
// equations are LOWER BOUNDS — real output-cap selection is dominated by
// load-transient droop and ESR, which only simulation captures, so expect
// the sim-refined C_out to grow well above this seed.
//
// Full sizing pipeline (this entity is stage 1 only; rest is Glacier +
// catalog-side, see docs spec simulation_in_the_loop):
//   1. seed         — these closed-form values
//   2. simulate     — refine to the real-valued requirement
//   3. snap         — nearest E-series (real part)
//   4. simulate     — validate the ON-GRID value vs base spec
//   5. margin       — derate for ageing/reliability, in the SIM-DETERMINED
//                     safe direction; additive on the grid, never absorbed
//                     by rounding
//   6. simulate     — sign off on the as-built, margined, on-grid value
//
// Use site (board):  buck: TPS54331_3V3();  or  Buck_TPS54331(v_out=5V, v_in=12V).
//
// `v_out` is a regular constructor parameter, NOT a generic `<…>`: it
// changes computed values (divider ratio, L/C via duty cycle), not the
// block's structure (same pins, same topology), so it belongs in the
// `design { }` self-readable parameter set. Generics are reserved for
// structural parameters (bus width, lane count). The SKU aliases below
// bind it as a positional arg.

// The block's children are the block's business: the library file
// imports what its application circuit instantiates (a board that
// states only a requirement imports nothing else).
import { Cap } from "bhdl-stdlib/passives/capacitor.bhdl";
import { Ind } from "bhdl-stdlib/passives/inductor.bhdl";
import { Res } from "bhdl-stdlib/passives/resistor.bhdl";
import { Diode } from "bhdl-stdlib/passives/diode.bhdl";

// ── Vendor truth ────────────────────────────────────────────────────
entity TPS54331 as part {
    pin VIN:  power in;
    pin SW:   switch out;
    pin FB:   feedback in;
    pin BOOT: signal inout;
    pin EN:   signal in;
    pin GND:  ground;

    attribute component_class   = "regulator_ic";   // the silicon, not "a regulator the board sees"
    attribute manufacturer      = "Texas Instruments";
    attribute part_number       = "TPS54331";
    attribute output_current    = 3A;       // SLVS839H: 3A continuous output current
    attribute vin_min           = 3.5V;     // SLVS839H: operating input voltage range 3.5 V to 28 V
    attribute vin_max           = 28V;
    // Operating JUNCTION range (SLVS839H §6.3) — the datasheet states no
    // ambient range. The ambient requirement is met THERMALLY via θ_JA:
    // T_J = T_A + P·θ_JA ≤ T_J,max (docs/spec/Requirements_And_Resolution.md).
    attribute tj_min            = -40degC;
    attribute tj_max            = 150degC;
    attribute theta_ja          = 116.3degC/W;  // SLVS839H §6.4, D (SOIC-8): RθJA — JEDEC-standard board metric (SPRA953), board-dependent
    attribute theta_jc          = 53.7degC/W;   // SLVS839H §6.4, D: RθJC(top)
    attribute f_sw              = 570kHz;   // internal fixed-frequency oscillator
    attribute rds_on            = 90mΩ;     // high-side MOSFET, typ
    attribute t_sw              = 20ns;     // switching transition class
    attribute i_quiescent       = 3.4mA;    // operating quiescent current, typ
    attribute dropout_voltage   = 0.5V;     // minimum V_IN − V_OUT for regulation (application class)
    // Datasheet SLVS839H efficiency curves: ~89% typical mid-load for the
    // 12V→3.3V application (Fig. 1).
    attribute efficiency        = 89%;
    // 0.8V internal reference (SLVS839H §7.3.2) + the sheet's display form
    // of the FB relation (datasheet Eq. 1).
    attribute feedback_voltage  = 0.8V;
    attribute fb_equation       = "VOUT = {VREF}*(1 + {R1}/{R2})";

    // §4 device-stress IP: the IC's OWN dissipation at the solved
    // operating point — conduction at the duty cycle + switching
    // transitions + quiescent (the same physics loss model the supply
    // chooser and the resolver's thermal gate use). Feeds the
    // junction-temperature sign-off row through θ_JA. Needs the rail's
    // declared `@ I` load; without it the recipe skips (UNCHECKED).
    simulation {
        stress {
            self.p_diss = i_out * i_out * self.rds_on * (vout / vin) + vin * i_out * self.f_sw * self.t_sw + vin * self.i_quiescent;
        }
    }
}

symbol TPS54331 {
    left   { VIN, EN, BOOT }
    right  { SW, FB }
    bottom { GND }
}

layout TPS54331 {
    package SOIC-8;   // SLVS839H: D (SOIC) — the DDA (HSOIC PowerPAD) variant has RθJA 48.7 °C/W
}

// ── The designer's subcircuit ───────────────────────────────────────
entity Buck_TPS54331(
    v_out:        voltage     = 3.3V,    // regulated output (sets divider + duty)
    v_in:         voltage     = 12V,     // input rail (sets duty cycle)
    i_out_max:    current     = 2A,      // max load current
    f_sw:         frequency   = 570kHz,  // internal oscillator (fixed-freq part)
    ripple_ratio: float       = 0.3,     // ΔI_L / I_out (datasheet 0.2–0.4)
    ripple_v:     voltage     = 30mV,    // target output ripple
    ripple_v_in:  voltage     = 150mV,   // target input ripple
    r_fb_bot:     resistance  = 10kΩ,    // FB divider reference resistor
    diode_vf:     voltage     = 0.45V,
    dropout:      voltage     = 0.5V,
    rds_on:       resistance  = 90mΩ,
    t_sw:         time        = 20ns,
    i_quiescent:  current     = 3.4mA
) as design
  // VALIDITY ENVELOPE (docs/spec/Requirements_And_Resolution.md §2.4):
  // the block's generality, enforced — lowered to `require`s at the
  // front of design { } so the resolver's trial-instantiation and
  // synthesis evaluate the same predicate. 3A rating × 0.8 derating
  // policy; SLVS839H input range.
  where i_out_max <= 2.4A, v_in >= 3.5V, v_in <= 28V
{
    // Contract pins (the regulator pin contract): the board wires
    // these and nothing else. VOUT is virtual — the block's children
    // (L_out, C_out, the divider) ARE its copper.
    pin VIN:  power in;
    pin VOUT: power out virtual;
    pin EN:   signal in;
    pin GND:  ground;

    // What the board sees: the regulator. The solver's regulator
    // decomposition and the sign-off ripple/input-draw models read these
    // from the block (the silicon underneath has no switching model of
    // its own). Figures mirror the part's datasheet attributes above —
    // the block's PROMISES, which ERC032 checks a power-tree stage
    // against.
    attribute component_class = "switching_regulator";
    attribute output_voltage = v_out;
    // The block's OPERATING POINT, exported: the elaboration emitter
    // reconstructs constructor args only from exported attributes — a
    // sizing input that is not exported would silently re-size to its
    // default on the round trip.
    attribute v_in = v_in;
    attribute i_out_max = i_out_max;
    attribute output_current = 3A;        // promise = the part's rating (SLVS839H)
    attribute vin_min = 3.5V;             // promise = the part's input range (SLVS839H)
    attribute vin_max = 28V;
    attribute tj_min = -40degC;             // SLVS839H §6.3 (junction; no ambient rating — thermal path via θ_JA)
    attribute tj_max = 150degC;
    attribute theta_ja = 116.3degC/W;       // SLVS839H §6.4, D (SOIC-8), JEDEC board metric
    attribute f_sw = f_sw;
    attribute rds_on = rds_on;
    attribute t_sw = t_sw;
    attribute i_quiescent = i_quiescent;
    attribute efficiency = 89%;           // SLVS839H Fig. 1, 12V→3.3V mid-load
    attribute feedback_voltage = 0.8V;
    attribute fb_equation = "VOUT = {VREF}*(1 + {R1}/{R2})";

    // Reactive + divider sizing. Runs once per instance, after
    // constructor binding, before the children materialise. Each line
    // is a single binary op into a `const` because `parse_expression`
    // currently mishandles chained mixed-precedence binops (same
    // discipline as lm317.bhdl). All quantities evaluate in SI base
    // units (V, A, Hz → H, F, Ω), so the outputs are henries/farads/ohms.
    design {
        const v_ref = 0.8;                       // TPS54331 internal FB ref
        const vout  = self.v_out;                // regulated output target
        require vout < self.v_in
            else "buck V_OUT must be below V_IN";
        // (rating / input-range envelope: the `where` clause above)

        const duty  = vout / self.v_in;          // D = V_OUT / V_IN
        const vdiff = self.v_in - vout;          // V_IN − V_OUT

        // L_out = (V_IN−V_OUT)·D / (f_sw·ΔI_L),  ΔI_L = ripple_ratio·I_out.
        const d_il  = self.ripple_ratio * self.i_out_max;
        const l_num = vdiff * duty;
        const l_den = self.f_sw * d_il;
        l_value     = l_num / l_den;

        // Inductor SATURATION-CURRENT requirement from the operating
        // point: I_peak = I_out + ΔI_L/2, with 1.6× headroom over peak
        // (sign-off derates I_pk by 1.25× and wants 1.2× margin on top,
        // so 1.5× is the policy floor — 1.6× leaves slack for the
        // GLACIER-refined peak exceeding this closed form). Flows to the
        // inductor as `rated_current` → the supply provider's current gate.
        const il_half     = d_il / 2.0;
        const i_peak      = self.i_out_max + il_half;
        l_rated_current   = i_peak * 1.6;

        // C_out = ΔI_L / (8·f_sw·ΔV_out).
        const co_d0 = self.f_sw * self.ripple_v;
        const co_d  = co_d0 * 8.0;
        c_out_value = d_il / co_d;

        // C_in = I_out·D·(1−D) / (f_sw·ΔV_in).
        const inv_d  = 1.0 - duty;
        const ci_n0  = self.i_out_max * duty;
        const ci_num = ci_n0 * inv_d;
        const ci_den = self.f_sw * self.ripple_v_in;
        c_in_value   = ci_num / ci_den;

        // FB divider: V_OUT = V_REF·(1 + R_top/R_bot) ⇒
        //   R_top = R_bot·(V_OUT − V_REF)/V_REF.
        const vov     = vout - v_ref;
        const r_scale = self.r_fb_bot / v_ref;
        r_top_value   = vov * r_scale;
    }

    // The application circuit — FIRM children (plain-body composition):
    // the designer asked for exactly these. The computed values flow in
    // by variable name (`Ind(l_value)` etc.); R_bot, the catch diode and
    // the bootstrap cap are datasheet-fixed.
    u: TPS54331();
    VIN -> u.VIN;
    u.GND -> GND;
    // EN is an OPTIONAL contract pin: wired → the board drives it;
    // left unwired → the stage is always enabled (EN tied to VIN, the
    // datasheet's default). The board's wiring is the configuration.
    generate if (wired(EN)) {
        EN -> u.EN;
    } else {
        VIN -> u.EN;
    }

    // The input cap carries the switching_input_filter intent so the
    // placer keeps the hot V_IN→C_in→GND loop tight (the EMC-critical
    // loop); the intent rides the standalone decl, the wiring references
    // the instance.
    C_in: Cap(c_in_value) for switching_input_filter(rail: VIN, return: GND, loop_area_max: 2.0mm2, switch_node_keepaway: 1.0mm);
    VIN -> C_in.1; C_in.2 -> GND;

    u.SW -> L_out: Ind(l_value, rated_current = l_rated_current).1; L_out.2 -> VOUT;
    GND -> D_catch: Diode(diode_vf).A; D_catch.K -> u.SW;
    VOUT -> C_out: Cap(c_out_value).1; C_out.2 -> GND;
    // DC ACCURACY (SLVSB09: EC-table voltage reference 0.772/0.8/0.828 V
    // = ±3.5%; the text states ±2% initial, ±3.5% over temperature —
    // the over-temperature band is the sign-off number). Consumed by
    // the DC accuracy budget with the FB divider tolerances.
    attribute v_ref     = 0.8V;
    attribute v_ref_tol = 3.5%;
    // FB divider sets V_OUT = V_REF·(1 + R_top/R_bot); its ratio
    // accuracy and temperature stability set the output-voltage
    // accuracy, so these are PRECISION parts — stated as part attributes
    // on the ordinary `Res`: tolerance 1% (hard grade gate) and the
    // "grade" supply profile (prefer tight tolerance + low drift). A bare
    // `bhdl bom` resolves these to thin-film, low-TC parts automatically.
    VOUT -> R_top: Res(r_top_value, tolerance = 1%, supply_profile = "grade").1; R_top.2 -> u.FB;
    u.FB -> R_bot: Res(r_fb_bot, tolerance = 1%, supply_profile = "grade").1; R_bot.2 -> GND;
    u.BOOT -> C_boot: Cap(100nF).1; C_boot.2 -> u.SW;

    // §4 device-stress IP: how this stage stresses its own children at
    // the solved operating point (child references are the local names
    // above — sign-off maps them onto the prefixed refdes, buck_L_out …).
    // Same TI application forms the design block sizes with, but run
    // against the SNAPPED values, so the margins reflect the as-built
    // parts.
    simulation {
        stress {
            const duty = vout / vin;
            const d_il = (vin - vout) * duty / (self.f_sw * L_out.value);
            L_out.i_peak   = i_out + d_il / 2;
            C_out.v_ripple = d_il / (8 * self.f_sw * C_out.value);
            C_in.v_ripple  = i_out * duty * (1 - duty) / (self.f_sw * C_in.value);
            // capacitor RMS ripple current, standard buck forms:
            // output cap carries the inductor ripple (triangular ->
            // /sqrt(12)); input cap chops the full load current
            C_out.i_ripple_applied = d_il / sqrt(12);
            C_in.i_ripple_applied  = i_out * sqrt(duty * (1 - duty));
        }
    }
}

// The block SATISFIES the BuckStage requirement interface
// (bhdl-stdlib/power/stages.bhdl). The body is the requirement → ctor
// mapping the resolver uses to trial-instantiate the block: each const
// names the block parameter that receives the requirement value. The
// block's validity envelope (the `require` lines in design { }) and its
// boundary promises (output_current, vin_min/max, efficiency) are the
// acceptance predicate; nothing is restated here.
impl BuckStage for Buck_TPS54331 {
    const vout  = v_out;
    const i_max = i_out_max;
    const vin   = v_in;
}

// SKU aliases bind `v_out` positionally (first param) — same alias-with-
// constructor-arg form as `alias 2N2222 = BJT("2N2222")`. They name the
// BLOCK: a board asking for a 3.3V TPS54331 stage gets the reviewed
// application circuit, never the bare silicon.
alias TPS54331_3V3 = Buck_TPS54331(3.3V);
alias TPS54331_5V = Buck_TPS54331(5V);
