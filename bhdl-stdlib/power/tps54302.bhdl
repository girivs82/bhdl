// TPS54302 3A Synchronous Buck Converter - Simplified
// High-efficiency step-down converter with integrated FETs

entity TPS54302() {
    // Power pins
    pin VIN: power in;
    pin GND: ground;
    pin SW: power out;
    
    // Control pins
    pin FB: signal in;
    pin EN: signal in;
    
    // Bootstrap and internal supply pins
    pin BOOT: signal inout;
    pin PH: signal out;
    
    // Component attributes
    attribute component_class = "voltage_regulator";
    attribute regulator_type = "synchronous_buck";
    attribute topology = "buck";
    // NOTE: `package` is a reserved keyword (it heads the `layout { package
    // <Footprint>; }` block) and cannot be an `attribute` name — using it as
    // one is a hard parse error that drops every following attribute. The
    // footprint lives in the `layout TPS54302` block below.

    // Electrical specifications
    attribute output_current = 3A;
    attribute input_voltage_min = 4.5V;
    attribute input_voltage_max = 28V;
    attribute switching_frequency = 500kHz;
    attribute efficiency = 92%;
    attribute dropout_voltage = 0.5V;
    attribute feedback_voltage = 0.6V;

    // Control-loop stability constants (datasheet SLVSDG6C). The part is
    // INTERNALLY COMPENSATED — TI does not publish the internal comp R/C, so
    // the loop is characterised by TI's published closed-form equations:
    //   crossover  f_co = loop_crossover_k / (V_out · C_out)        [Eq 14]
    //   target     f_co < f_sw · loop_crossover_max_ratio  (= f_sw/10)
    //   ceramic C_out → low phase margin unless a feedforward cap
    //     C_ff = 1 / (2π · f_co · R_top)                            [Eq 16]
    // `loop_crossover_k` (the "5.1") bundles the error-amp gm (240µA/V), the
    // current-sense/modulator gain and the internal compensation into one
    // datasheet-characterised constant.
    attribute loop_crossover_k = 5.1;
    attribute loop_crossover_max_ratio = 0.1;

    // Loss-model constants (datasheet SLVSDG6) — see tps54302.bhdl.
    attribute i_quiescent = 85uA;   // non-switching operating quiescent (typ)
    attribute rds_on = 98mΩ;      // high-side FET on-resistance (typ; LS 49mohm)
    attribute t_sw = 20ns;          // SW transition time for switching-loss estimate
    // Inductor ripple-current ratio K_IND (datasheet §7.2.3.5.1, Eq 8 design
    // example): ΔI_L / I_out. Drives the sign-off inductor value-stepping.
    attribute ripple_ratio = 0.35;

    // Protection features
    attribute has_thermal_protection = true;
    attribute has_current_limiting = true;
    attribute has_undervoltage_lockout = true;
    attribute has_overvoltage_protection = true;
    attribute has_soft_start = true;
    
    // External component requirements
    attribute inductor_value_min = "2.2uH";
    attribute inductor_value_rec = "4.7uH";
    attribute inductor_value_max = "10uH";
    attribute input_capacitor_min = "10uF";
    attribute input_capacitor_rec = "22uF";
    attribute output_capacitor_min = "22uF";
    attribute output_capacitor_rec = "47uF";
    attribute bootstrap_capacitor = "100nF";
    
    // No external diode required - synchronous rectification
    attribute catch_diode_required = false;
    attribute synchronous_rectification = true;
    
    // SPICE model parameters
    attribute spice_model = "synchronous_buck_regulator";
    attribute spice_topology = "synchronous_buck";
    attribute spice_switching_frequency = 500kHz;
    attribute spice_duty_cycle = "variable";
    attribute spice_feedback_reference = 0.6V;

    // §4 device-stress IP (docs/spec/Vendor_Simulation_Blocks.md), authored in
    // HDL so the part's device-level stress model travels with the part — the
    // datasheet limits stay attached to it the way its electrical attributes
    // do, instead of living only in the sign-off's hardcoded reference model.
    //
    // How THIS synchronous buck stresses its support parts at the solved
    // operating point. Resolves the operating point (vin / vout / i_out), the
    // part's own attributes (`self.switching_frequency`), and each support
    // part's snapped value by board instance name — l_out / c_out1 / c_in1,
    // the TI SLVSDG6C application-circuit designators. Writes the per-part
    // stress axes the sign-off derate gate compares against the selected
    // catalogue rating. A board that names its support parts differently just
    // doesn't match these references: the eval is skipped and those parts keep
    // the generic stress model (no error).
    //
    // Buck application forms (SLVSDG6C §7.2.3.5):
    //   duty = V_OUT / V_IN
    //   ΔI_L = (V_IN − V_OUT)·duty / (f_sw·L)
    //   inductor peak current  = I_out + ΔI_L/2
    //   output-cap ripple      = ΔI_L / (8·f_sw·C_out)
    //   input-cap ripple       = I_out·duty·(1−duty) / (f_sw·C_in)
    simulation {
        stress {
            const duty = vout / vin;
            const d_il = (vin - vout) * duty / (self.switching_frequency * l_out.value);
            l_out.i_peak    = i_out + d_il / 2;
            c_out1.v_ripple = d_il / (8 * self.switching_frequency * c_out1.value);
            c_in1.v_ripple  = i_out * duty * (1 - duty) / (self.switching_frequency * c_in1.value);
        }
    }
}

layout TPS54302 {
    package SOT-23-6;
}