// Simplified Buck Converter Module for testing
// Without behavioral model annotations that parser doesn't support yet

module BuckConverter(
    vin_nom: voltage,
    vout_target: voltage,
    iout_max: current,
    fsw: frequency = 500kHz
) {
    pin VIN: power in;
    pin VOUT: power out;
    pin GND: ground;
    pin EN: signal in;
    pin FB: signal out;
}