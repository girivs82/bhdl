// TPS65217 family — TI single-chip PMIC (AM335x-class companion),
// VQFN-48 (SLVSB64I – NOVEMBER 2011 – REVISED MARCH 2018).
//
// OTP-FRIENDLY multi-output block (docs/spec/
// Requirements_And_Resolution.md §8.4): ONE configurable entity
// carries ALL FOUR catalog OTP variants as data — voltages, strobe
// assignments and the per-variant SEQ5/SEQ6 register-reset delay
// schedules all come from the SAME datasheet — and the part number
// derives from the chosen variant (the LP2985 family-SKU precedent).
// `otp="custom"` takes a designer/tool-supplied OTP spec (the
// §8.3 custom-OTP proposal is exactly this shape); pass
// mpn="PENDING-CUSTOM-OTP" (or the vendor-assigned number once
// issued for their traceability) — an EMPTY string falls back to the
// ctor default by the language's empty-arg rule, so it cannot express
// "no MPN".
//
// SCOPE, STATED: the regulator subsystem only — charger/power-path,
// WLED and I2C are not modeled. TPS65217A's LS1/LS2 are LOAD SWITCHES
// (pass-through, no fixed voltage) and are NOT modeled as outputs in
// its row, stated.
//
// REAL-DATA PROVENANCE (all SLVSB64I):
//   Device-comparison table: per-variant default rail voltages +
//   strobe assignments. SEQ5 resets (§8.6.30 Table 30): A/B DLY1 =
//   10b = 5 ms, DLY2 = 00b = 1 ms; C/D DLY1 = 00b = 1 ms, DLY2 =
//   10b = 5 ms; DLY3/DLY4 = 00b = 1 ms; SEQ6 reset 0x00 ⇒ DLY5/6 =
//   1 ms. Delay codes 00b/01b/10b/11b = 1/2/5/10 ms. Strobe times
//   cumulative from STROBE15; the 15→14→1 spacing is approximated as
//   2×DLY6 = 2 ms (the figure labels only DLY6 in that span —
//   stated). LS-as-LDO ratings: A/B 200 mA, C/D 400 mA (EC table,
//   per-variant IOUT rows). Bucks: 1.2 A, ILIMIT 1.6 A typ, fSW
//   2.25 MHz, rDS 170/120 mΩ, tSS 750 µs, discharge 250 Ω. LDO1/2:
//   100 mA, VDO 200 mV @ 100 mA, discharge 430 Ω. Thermal θJA 30.4 /
//   θJC 16.4 (VQFN-48 RSL), characterized −40…105 °C. Supply BAT/SYS
//   2.75–5.5 V.

import { Cap } from "bhdl-stdlib/passives/capacitor.bhdl";
import { Ind } from "bhdl-stdlib/passives/inductor.bhdl";

// ── Vendor truth (regulator subsystem; scope stated above) ──────────
// The MPN is the FAMILY plus the OTP variant — passed in, so a custom
// OTP part (vendor-assigned number, or none yet) is representable.
entity TPS65217(
    mpn: string = "TPS65217B"
) as part {
    pin SYS:    power in;
    pin L1:     switch out;
    pin L2:     switch out;
    pin L3:     switch out;
    pin VDCDC1: power out;
    pin VDCDC2: power out;
    pin VDCDC3: power out;
    pin VLDO1:  power out;
    pin VLDO2:  power out;
    pin VLDO3:  power out;
    pin VLDO4:  power out;
    pin PWR_EN: signal in;
    pin GND:    ground;

    attribute component_class  = "pmic";
    attribute manufacturer     = "Texas Instruments";
    attribute part_number      = mpn;     // family + OTP variant (empty = custom, MPN pending — a stated BOM gap)
    attribute vin_min          = 2.75V;   // SLVSB64I recommended: supply voltage BAT/SYS
    attribute vin_max          = 5.5V;
    attribute f_sw             = 2.25MHz;
    attribute i_sw_limit       = 1.6A;    // SLVSB64I: DCDC current limit, typ
    attribute rds_on           = 170mΩ;   // buck HS (LS 120 mΩ)
    attribute t_ss             = 750us;   // buck soft-start, 5→95 %
    attribute r_discharge      = 250Ω;    // buck passive discharge (LDO 430 Ω)
    attribute i_quiescent      = 15uA;    // per converter, typ
    attribute temp_min         = -40degC;
    attribute temp_max         = 105degC;
    attribute theta_ja         = 30.4degC/W;
    attribute theta_jc         = 16.4degC/W;
}

symbol TPS65217 {
    left   { SYS, PWR_EN }
    right  { L1, VDCDC1, L2, VDCDC2, L3, VDCDC3, VLDO1, VLDO2, VLDO3, VLDO4 }
    bottom { GND }
}

layout TPS65217 {
    package VQFN-48;
}

// ── The designer's subcircuit — ONE block, variant-configured ───────
entity Pmic_TPS65217(
    otp:          string      = "B",
    mpn:          string      = "TPS65217B",
    otp_outputs:  string      = "",
    otp_seq:      string      = "",
    otp_strobe_t: string      = "",
    l_value:      inductance  = 2.2µH,
    c_buck:       capacitance = 22µF,
    c_ldo:        capacitance = 2.2µF
) as design {
    pin VIN:        power in;
    pin VOUT_DCDC1: power out virtual;
    pin VOUT_DCDC2: power out virtual;
    pin VOUT_DCDC3: power out virtual;
    pin VOUT_LDO1:  power out virtual;
    pin VOUT_LDO2:  power out virtual;
    pin VOUT_LDO3:  power out virtual;
    pin VOUT_LDO4:  power out virtual;
    pin PWR_EN:     signal in;
    pin GND:        ground;

    attribute component_class = "pmic";
    attribute vin_min         = 2.75V;
    attribute vin_max         = 5.5V;
    attribute temp_min        = -40degC;
    attribute temp_max        = 105degC;
    attribute theta_ja        = 30.4degC/W;
    attribute theta_jc        = 16.4degC/W;
    attribute i_quiescent     = 15uA;
    attribute t_ss            = 750us;    // SLVSB64I: buck soft-start (5→95 %)
    // the selected OTP configuration (ctor passthroughs — consumers
    // resolve the flat view via `pmic_view`); custom-OTP spec args
    // carry exactly the §8.3 proposal shape (the designer's data)
    attribute pmic_variant      = otp;
    attribute pmic_otp_outputs  = otp_outputs;
    attribute pmic_otp_seq      = otp_seq;
    attribute pmic_otp_strobe_t = otp_strobe_t;
    // family-level sequencing facts (identical for every variant)
    attribute pmic_seq_dly       = "1ms-10ms";
    attribute pmic_seq_dly_steps = "1ms,2ms,5ms,10ms";
    // THE CATALOG (SLVSB64I device-comparison table + SEQ5/6 resets):
    attribute pmic_variants = "A ~ mpn=TPS65217A ~ outputs=DCDC1:buck:1.8V:1.2A,DCDC2:buck:3.3V:1.2A,DCDC3:buck:1.1V:1.2A,LDO1:ldo:1.8V:0.1A,LDO2:ldo:3.3V:0.1A ~ seq=LDO1,DCDC1,DCDC2|LDO2,DCDC3 ~ strobe_t=LDO1:0ms,DCDC1:2ms,DCDC2:7ms,LDO2:7ms,DCDC3:8ms && B ~ mpn=TPS65217B ~ outputs=DCDC1:buck:1.8V:1.2A,DCDC2:buck:1.1V:1.2A,DCDC3:buck:1.1V:1.2A,LDO1:ldo:1.8V:0.1A,LDO2:ldo:3.3V:0.1A,LDO3:ldo:3.3V:0.2A,LDO4:ldo:3.3V:0.2A ~ seq=LDO1,DCDC1,LDO2,LDO3,LDO4,DCDC2|DCDC3 ~ strobe_t=LDO1:0ms,DCDC1:2ms,LDO2:7ms,LDO3:8ms,LDO4:9ms,DCDC2:10ms,DCDC3:10ms && C ~ mpn=TPS65217C ~ outputs=DCDC1:buck:1.5V:1.2A,DCDC2:buck:1.1V:1.2A,DCDC3:buck:1.1V:1.2A,LDO1:ldo:1.8V:0.1A,LDO2:ldo:3.3V:0.1A,LDO3:ldo:1.8V:0.4A,LDO4:ldo:3.3V:0.4A ~ seq=LDO1,DCDC1,LDO3,LDO2,LDO4,DCDC2|DCDC3 ~ strobe_t=LDO1:0ms,DCDC1:2ms,LDO3:3ms,LDO2:8ms,LDO4:9ms,DCDC2:10ms,DCDC3:10ms && D ~ mpn=TPS65217D ~ outputs=DCDC1:buck:1.35V:1.2A,DCDC2:buck:1.1V:1.2A,DCDC3:buck:1.1V:1.2A,LDO1:ldo:1.8V:0.1A,LDO2:ldo:3.3V:0.1A,LDO3:ldo:1.8V:0.4A,LDO4:ldo:3.3V:0.4A ~ seq=LDO1,DCDC1,LDO3,LDO2,LDO4,DCDC2|DCDC3 ~ strobe_t=LDO1:0ms,DCDC1:2ms,LDO3:3ms,LDO2:8ms,LDO4:9ms,DCDC2:10ms,DCDC3:10ms";

    u: TPS65217(mpn);
    VIN -> u.SYS;
    u.GND -> GND;
    PWR_EN -> u.PWR_EN;

    generate if (wired(VOUT_DCDC1)) {
        u.L1 -> L_dc1: Ind(l_value, rated_current = 1.6A).1; L_dc1.2 -> VOUT_DCDC1;
        u.VDCDC1 -> VOUT_DCDC1;
        VOUT_DCDC1 -> C_dc1: Cap(c_buck).1; C_dc1.2 -> GND;
    } else {
    }
    generate if (wired(VOUT_DCDC2)) {
        u.L2 -> L_dc2: Ind(l_value, rated_current = 1.6A).1; L_dc2.2 -> VOUT_DCDC2;
        u.VDCDC2 -> VOUT_DCDC2;
        VOUT_DCDC2 -> C_dc2: Cap(c_buck).1; C_dc2.2 -> GND;
    } else {
    }
    generate if (wired(VOUT_DCDC3)) {
        u.L3 -> L_dc3: Ind(l_value, rated_current = 1.6A).1; L_dc3.2 -> VOUT_DCDC3;
        u.VDCDC3 -> VOUT_DCDC3;
        VOUT_DCDC3 -> C_dc3: Cap(c_buck).1; C_dc3.2 -> GND;
    } else {
    }
    generate if (wired(VOUT_LDO1)) {
        u.VLDO1 -> VOUT_LDO1;
        VOUT_LDO1 -> C_l1: Cap(c_ldo).1; C_l1.2 -> GND;
    } else {
    }
    generate if (wired(VOUT_LDO2)) {
        u.VLDO2 -> VOUT_LDO2;
        VOUT_LDO2 -> C_l2: Cap(c_ldo).1; C_l2.2 -> GND;
    } else {
    }
    generate if (wired(VOUT_LDO3)) {
        u.VLDO3 -> VOUT_LDO3;
        VOUT_LDO3 -> C_l3: Cap(c_ldo).1; C_l3.2 -> GND;
    } else {
    }
    generate if (wired(VOUT_LDO4)) {
        u.VLDO4 -> VOUT_LDO4;
        VOUT_LDO4 -> C_l4: Cap(c_ldo).1; C_l4.2 -> GND;
    } else {
    }
}

// The catalog variants, nameable exactly as before — selection works
// "just as we do currently", enumerated from ONE block's data.
alias Pmic_TPS65217A = Pmic_TPS65217(otp="A", mpn="TPS65217A");
alias Pmic_TPS65217B = Pmic_TPS65217(otp="B", mpn="TPS65217B");
alias Pmic_TPS65217C = Pmic_TPS65217(otp="C", mpn="TPS65217C");
alias Pmic_TPS65217D = Pmic_TPS65217(otp="D", mpn="TPS65217D");
