// LM317 — adjustable 3-pin positive linear regulator, TO-220 (TI LM317).
//
// Two-layer library model (docs/spec/Requirements_And_Resolution.md §1):
//   LM317      as part    — vendor truth: VIN / VOUT / ADJ, the 1.25 V
//                           OUT–ADJ reference, ratings.
//   Ldo_LM317  as design  — the designer's subcircuit: the part plus the
//                           datasheet application circuit, with the
//                           OUT–ADJ divider SIZED from v_out in the
//                           block's `design { }` (the sizing that used
//                           to live on the conflated entity), `impl
//                           LdoStage`.
//
// Divider (datasheet): V_OUT = V_REF·(1 + R1/R2) + I_ADJ·R1, I_ADJ ≈ 50 µA
// neglected; R2 = 240 Ω (the datasheet's programming resistor, keeps the
// 10 mA minimum load), R1 = R2·(V_OUT − V_REF)/V_REF.

// The block's children are the block's business: the library file
// imports what its application circuit instantiates (a board that
// states only a requirement imports nothing else).
import { Cap } from "bhdl-stdlib/passives/capacitor.bhdl";
import { Res } from "bhdl-stdlib/passives/resistor.bhdl";

// ── Vendor truth ────────────────────────────────────────────────────
entity LM317() as part {
    pin VIN:  power in;
    pin VOUT: power out;
    pin ADJ:  signal inout;

    attribute component_class  = "regulator_ic";
    attribute family           = "LM317";
    attribute part_number      = "LM317";
    attribute role             = "adjustable-ldo";
    attribute feedback_voltage = 1.25V;  // V_REF between OUT and ADJ
    attribute i_quiescent      = 50uA;   // ADJ pin current, typ (ground-path quiescent)
    attribute output_current   = 1.5A;   // rated output
    attribute dropout_voltage  = 2V;     // V_IN−V_OUT for regulation at rated load
    attribute vout_min         = 1.25V;  // TI LM317: adjustable 1.25 V to 37 V
    attribute vout_max         = 37V;
    attribute vin_max          = 40V;    // TI LM317: V_IN − V_OUT differential up to 40 V; 40 V abs input here (V_OUT ≥ 1.25 V)
    attribute power_rating     = 2W;     // TO-220 free-air dissipation (no heatsink), datasheet class
    // Operating JUNCTION range per the datasheet — recorded for thermal
    // sign-off. The datasheet states no ambient range, so the stage
    // interface's temp_min/temp_max (ambient) stay UNDECLARED here:
    // a temperature requirement is UNCHECKED against this block, stated.
    attribute tj_min           = 0degC;   // SLVS044Z §6.3: operating virtual junction 0 °C to 125 °C (LM317A: −40 °C)
    attribute tj_max           = 125degC;
    attribute theta_ja         = 23.5degC/W; // SLVS044Z §6.4, KCS (TO-220): RθJA — JEDEC-standard board metric (SPRA953), board-dependent
    attribute theta_jc         = 15.9degC/W; // SLVS044Z §6.4, KCS: RθJC(top)
    // §4 device-stress IP: pass-element dissipation at the solved
    // operating point (the block's stress rows map onto this part).
    simulation {
        stress {
            self.p_diss = (vin - vout) * i_out + vin * self.i_quiescent;
        }
    }
}

symbol LM317 {
    left   { VIN }
    right  { VOUT }
    bottom { ADJ }
}

layout LM317 {
    package TO-220;
}

// ── The designer's subcircuit ───────────────────────────────────────
entity Ldo_LM317(
    v_out:     voltage     = 5V,
    i_out_max: current     = 500mA,
    v_in:      voltage     = 12V,
    c_in:      capacitance = 10µF,
    c_out:     capacitance = 22µF,
    r2_value:  resistance  = 240Ω     // datasheet programming resistor
) as design {
    // Contract pins. VOUT is virtual — the output cap and the divider
    // ARE the block's copper; ADJ is internal.
    pin VIN:  power in;
    pin VOUT: power out virtual;
    pin GND:  ground;

    attribute component_class  = "ldo";
    attribute output_voltage   = v_out;
    attribute v_in             = v_in;
    attribute i_out_max        = i_out_max;
    attribute output_current   = 1.5A;   // promise = the part's rating
    attribute vin_max          = 40V;
    attribute dropout_voltage  = 2V;
    attribute feedback_voltage = 1.25V;
    attribute i_quiescent      = 50uA;
    attribute tj_min           = 0degC;      // SLVS044Z (junction; thermal path via θ_JA)
    attribute tj_max           = 125degC;
    attribute theta_ja         = 23.5degC/W; // SLVS044Z, KCS TO-220, JEDEC board metric

    // Divider sizing + VALIDITY ENVELOPE. One binary op per `const`
    // (parse_expression mishandles chained mixed-precedence binops).
    design {
        const v_ref = 1.25;
        const vout  = self.v_out;
        require vout >= 1.35
            else "Ldo_LM317 envelope: minimum V_OUT is V_REF + headroom (~1.35V)";
        require vout <= 37.0
            else "Ldo_LM317 envelope: V_OUT above the 37V adjustable maximum";
        // 1.5 A rating × 0.8 derating policy.
        require self.i_out_max <= 1.2
            else "Ldo_LM317 envelope: i_out_max exceeds 1.2A (1.5A rating × 0.8 derating)";
        require self.v_in <= 40.0
            else "Ldo_LM317 envelope: v_in exceeds the 40V maximum";
        const v_need = vout + 2.0;
        require self.v_in >= v_need
            else "Ldo_LM317 envelope: v_in below v_out + 2V dropout";
        // R1 = R2·(V_OUT − V_REF)/V_REF
        const delta = vout - v_ref;
        const scale = self.r2_value / v_ref;
        r1_value = delta * scale;
    }

    // The application circuit — FIRM children.
    u: LM317();
    VIN -> u.VIN;
    VIN  -> C_in:  Cap(c_in).1;        C_in.2  -> GND;
    u.VOUT -> VOUT;
    VOUT -> C_out: Cap(c_out).1;       C_out.2 -> GND;
    VOUT -> R1:    Res(r1_value).1;    R1.2    -> u.ADJ;
    u.ADJ -> R2:   Res(r2_value).1;    R2.2    -> GND;
}

impl LdoStage for Ldo_LM317 {
    const vout  = v_out;
    const i_max = i_out_max;
    const vin   = v_in;
}

alias LM317_5V  = Ldo_LM317(5V);
alias LM317_3V3 = Ldo_LM317(3.3V);
