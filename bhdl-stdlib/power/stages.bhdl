// Power-stage REQUIREMENT interfaces (docs/spec/Requirements_And_Resolution.md §3).
//
// A designer does not start with "a TPS54331 here"; they start with "a
// buck here with these specifications". These traits are that
// statement: the contract pins every stage block exposes, plus the
// requirement vocabulary — application facts at the datasheet-procedure
// level (what every family block can be asked for), never a part value
// or a topology switch.
//
//   u1: BuckStage(vout=5V, i_max=2A, vin=12V);
//
// is a REQUIREMENT INSTANTIATION. Resolution (the `resolve` pass, run
// before synthesis) surveys every `impl BuckStage for <Block>` in the
// library, keeps the blocks whose validity envelope covers the
// requirement and whose promises meet it, ranks them, binds one, and
// records the binding in bhdl.lock. The requirement stays in the source;
// the bound block appears in the elaborated text; the binding is
// reversible (`resolve u1 = Buck_TPS54331;` pins it by hand) and is
// re-checked every build.
//
// Resolving to NOTHING is a first-class outcome: the requirement
// synthesizes as the Generic* placeholder, ERC032 says so every run, and
// the near-misses are printed ("Buck_TPS54331 fails i_max: 3A rating ×
// 0.8 = 2.4A < 4A"). Library coverage is visible, not assumed.
//
// RANKING (survivors only): real catalogue price of each block's silicon
// through the supplier provider (cheapest in-stock MPN with the part
// prefix) when EVERY survivor priced; otherwise least over-rating
// (smallest output_current that covers the load), ties by library
// order — the basis is stated in the survey note, never silent.
//
// PROJECT-WIDE FILTERS: a board may state requirements that apply to
// every stage on it — once, where they originate:
//   requirements { qual: "AEC-Q100"; asil: B; temp_min: -40degC; temp_max: 125degC; }
// The resolver merges them into each stage requirement (a stage's own
// value wins for a key it states) and stamps the MERGED text, so ERC032
// and the trace matrix see the same requirement. `asil` is also DERIVED
// per stage by the trace matrix from the safety goals whose effects
// reference the rail the stage drives — the matrix reports a stage
// serving an ASIL-B goal without an ASIL requirement / capable part.
//
// THERMAL: an ambient `temp_max` requirement is met by an ambient-rated
// part directly, or THERMALLY by a junction-rated part that declares
// `theta_ja` and `tj_max` — T_J = T_A,max + P·θ_JA ≤ T_J,max with P the
// stage's dissipation at the requirement's operating point (the resolver
// computes it from the block's class and promises; ERC032 from the
// sign-off). The same θ_JA feeds the FIT model (T_J for the handbook).
//
// The consts are the requirement PARAMETERS. The ones a block must
// accept are those its `impl` binds; `vin_min`/`vin_max` default to `vin`
// when the requirement gives only a nominal input; `noise` and
// `efficiency_min` are optional — when given, a block that does not
// DECLARE the matching promise is UNCHECKED and therefore not a
// candidate (never a pass).

trait BuckStage {
    pin VIN: power in;
    pin VOUT: power out;
    pin GND: ground;
    pin EN: signal in;              // optional — the sequencing chain input (wired ⇒ used; unwired ⇒ the block self-enables)
    pin PG: signal out;             // optional — power-good chain output (a block whose part has no PG cannot anchor a PG chain)
    const vout: voltage;            // regulated output
    const i_max: current;           // maximum load current (the block is derated against this)
    const vin: voltage;             // nominal input rail
    const vin_min: voltage;         // optional; defaults to vin
    const vin_max: voltage;         // optional; defaults to vin
    const noise: voltage;           // optional; output noise/ripple ceiling (RMS)
    const efficiency_min: float;    // optional; minimum declared efficiency
    // ── qualification (optional): a block that does not DECLARE the
    //    matching promise is UNCHECKED against it (never a pass)
    const temp_min: temperature;    // operating ambient minimum required
    const temp_max: temperature;    // operating ambient maximum required
    const qual: string;             // e.g. "AEC-Q100" — must appear in the part's `qualification`
    const asil: string;             // required ASIL capability (QM/A/B/C/D) vs the part's `asil_capable`
}

trait LdoStage {
    pin VIN: power in;
    pin VOUT: power out;
    pin GND: ground;
    pin EN: signal in;              // optional — the sequencing chain input (wired ⇒ used; unwired ⇒ the block self-enables)
    pin PG: signal out;             // optional — power-good chain output (a block whose part has no PG cannot anchor a PG chain)
    const vout: voltage;
    const i_max: current;
    const vin: voltage;
    const vin_min: voltage;         // optional; defaults to vin
    const vin_max: voltage;         // optional; defaults to vin
    const noise: voltage;           // optional; output-noise ceiling (RMS)
    // ── qualification (optional): a block that does not DECLARE the
    //    matching promise is UNCHECKED against it (never a pass)
    const temp_min: temperature;    // operating ambient minimum required
    const temp_max: temperature;    // operating ambient maximum required
    const qual: string;             // e.g. "AEC-Q100" — must appear in the part's `qualification`
    const asil: string;             // required ASIL capability (QM/A/B/C/D) vs the part's `asil_capable`
}

// A buck CONTROLLER + external power stage (the tree's `BuckExternal`
// topology: chosen when an integrated converter would run hotter than
// the thermal crossover, or the load needs phases). `phases` is part of
// the requirement: a single-phase block cannot cover a 3-phase stage.
// Today's only implementer is the generic `BuckController` TEMPLATE: it
// is listed by the survey but never auto-bound (it names no orderable
// controller and its FETs are placeholders) — commit it with an
// override that carries YOUR power stage:
//   resolve u1 = BuckController(hs_fet="BSC0902NS", ls_fet="BSC0902NS",
//                               fet_rds_on=2.3mΩ, fet_vds_max=30V);
trait BuckExtStage {
    pin VIN: power in;
    pin VOUT: power out;
    pin GND: ground;
    pin EN: signal in;              // optional — the sequencing chain input (wired ⇒ used; unwired ⇒ the block self-enables)
    pin PG: signal out;             // optional — power-good chain output (a block whose part has no PG cannot anchor a PG chain)
    const vout: voltage;
    const i_max: current;
    const vin: voltage;
    const vin_min: voltage;         // optional; defaults to vin
    const vin_max: voltage;         // optional; defaults to vin
    const phases: integer;          // optional; defaults to 1
    const noise: voltage;           // optional
    const efficiency_min: float;    // optional
    // ── qualification (optional): a block that does not DECLARE the
    //    matching promise is UNCHECKED against it (never a pass)
    const temp_min: temperature;    // operating ambient minimum required
    const temp_max: temperature;    // operating ambient maximum required
    const qual: string;             // e.g. "AEC-Q100" — must appear in the part's `qualification`
    const asil: string;             // required ASIL capability (QM/A/B/C/D) vs the part's `asil_capable`
}

// The protected FRONT END the tree puts between the input and every
// non-always-on rail (`Prereg` topology): the pass element (fuse /
// eFuse / ideal diode) plus input protection. Requirement vocabulary:
// the pass current, the input range, and the protection FUNCTIONS —
// distinct words for distinct behaviours, each checked against a block
// that DECLARES it (undeclared = UNCHECKED, never a pass):
//   ov_clamp  — a passive clamp (TVS) limits the line to ≤ this voltage
//   ov_trip   — an ACTIVE cutoff opens the path above this voltage
//   uv_trip   — an undervoltage lockout holds the path off below this
//   reverse_polarity — "true": the path blocks reversed input
// vout is the pass-through voltage (normally = vin).
trait PreregStage {
    pin VIN: power in;
    pin VOUT: power out;
    pin GND: ground;
    pin EN: signal in;              // optional — the sequencing chain input (wired ⇒ used; unwired ⇒ the block self-enables)
    pin PG: signal out;             // optional — power-good chain output (a block whose part has no PG cannot anchor a PG chain)
    const vout: voltage;
    const i_max: current;
    const vin: voltage;
    const vin_min: voltage;         // optional; defaults to vin
    const vin_max: voltage;         // optional; defaults to vin
    const ov_clamp: voltage;        // optional
    const ov_trip: voltage;         // optional
    const uv_trip: voltage;         // optional
    const reverse_polarity: string; // optional: "true"
    const temp_min: temperature;
    const temp_max: temperature;
    const qual: string;
    const asil: string;
}

// STEP-UP: the rail sits above its feed. Same vocabulary as BuckStage;
// the acceptance i_max gate still reads the block's promised OUTPUT
// current — a boost block must promise what it can DELIVER at the
// requirement's ratio (its switch limit × vin/vout × η is the vendor's
// arithmetic to state, not ours to invent).
trait BoostStage {
    pin VIN: power in;
    pin VOUT: power out;
    pin GND: ground;
    pin EN: signal in;              // optional — the sequencing chain input (wired ⇒ used; unwired ⇒ the block self-enables)
    pin PG: signal out;             // optional — power-good chain output (a block whose part has no PG cannot anchor a PG chain)
    const vout: voltage;
    const i_max: current;
    const vin: voltage;
    const vin_min: voltage;         // optional; defaults to vin
    const vin_max: voltage;         // optional; defaults to vin
    const noise: voltage;           // optional
    const efficiency_min: float;    // optional
    const temp_min: temperature;
    const temp_max: temperature;
    const qual: string;
    const asil: string;
}

// A feed RANGE that STRADDLES the output (battery discharge across
// vout — the classic 3.0–4.2 V Li-ion to 3.3 V rail): neither a buck
// nor a boost alone covers it. The requirement MUST state vin_min and
// vin_max (that straddle IS the requirement); the power tree carries
// only a nominal feed voltage and never emits this — noted in its
// boost path, stated here.
trait BuckBoostStage {
    pin VIN: power in;
    pin VOUT: power out;
    pin GND: ground;
    pin EN: signal in;              // optional — the sequencing chain input (wired ⇒ used; unwired ⇒ the block self-enables)
    pin PG: signal out;             // optional — power-good chain output (a block whose part has no PG cannot anchor a PG chain)
    const vout: voltage;
    const i_max: current;
    const vin: voltage;
    const vin_min: voltage;         // REQUIRED in practice: the straddle
    const vin_max: voltage;         //   is the reason this stage exists
    const noise: voltage;           // optional
    const efficiency_min: float;    // optional
    const temp_min: temperature;
    const temp_max: temperature;
    const qual: string;
    const asil: string;
}
