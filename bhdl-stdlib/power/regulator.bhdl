// Simplified Linear Regulators - v2.0 compatible
// Generic entity with alias specializations for common regulators
// Supports conditional enable pin via HAS_EN bool parameter

// Pin contract (power-tree swap-by-rename): VIN / VOUT / GND, VOUT
// virtual — the expansion mints the 78xx-class bypass caps, so a
// Generic* placeholder swaps to this part by renaming.
entity LinearRegulator<V_OUT: voltage, HAS_EN: bool = false>(
    dropout: voltage = 2V,
    i_quiescent: current = 5mA,
    // TI UA7805-class datasheet bypass: 0.33µF input, 0.1µF output.
    c_in: capacitance = 0.33µF,
    c_out: capacitance = 0.1µF
) {
    pin VIN: power in;
    pin VOUT: power out virtual;
    pin GND: ground;
    pin EN: signal in when HAS_EN;

    attribute component_class = "voltage_regulator";
    attribute output_voltage = V_OUT;
    attribute dropout_voltage = dropout;
    attribute i_quiescent = i_quiescent;
    // 78xx-class RMS output noise (TI µA7805: 40µV, 10Hz–100kHz) — the
    // same class the generic's dropout/Iq defaults come from
    attribute output_noise = 40uV;

    expansion {
        VIN -> C_in: Cap(c_in).1; C_in.2 -> GND;
        VOUT -> C_out: Cap(c_out).1; C_out.2 -> GND;
    }
}

// Alias data honesty (campaign fill): the generic's defaults
// (dropout 2 V, Iq 5 mA) are the 78xx class — CORRECT for LM7805
// (TI UA7805: dropout 2 V, bias current ~5 mA class). The LM1117's
// real dropout is 1.2 V typ at full load (TI LM1117 headline spec),
// but a type-arg alias cannot bind constructor params — bind it at
// the instantiation site: `reg: LM1117_33(dropout=1.2V)`. Boards
// that leave the default get graded against the CONSERVATIVE 2 V.
alias LM7805 = LinearRegulator<5V>;
alias LM1117_33 = LinearRegulator<3.3V>;
alias LM1117_18 = LinearRegulator<1.8V>;
alias LM1117_33_EN = LinearRegulator<3.3V, true>;

// Simplified Buck (Switching) Regulators - v2.0 compatible
// Uses expansion block to declaratively specify inductor, catch diode, and output cap

entity BuckRegulator<V_OUT: voltage>(
    dropout: voltage = 0.5V,
    // 150 kHz: the LM2596's fixed internal oscillator (TI LM2596
    // datasheet headline) — the only aliases of this generic are
    // LM2596 SKUs, and the old 500 kHz default contradicted the
    // alias comment below (ripple/loss sims ran 3.3× fast).
    f_sw: frequency = 150kHz,
    rds_on: resistance = 200mΩ,
    t_sw: time = 80ns,
    i_quiescent: current = 5mA,
    l_value: inductance = 33µH,
    c_out: capacitance = 470µF,
    diode_vf: voltage = 0.5V,
    has_diode: bool = true
) {
    pin VIN: power in;
    pin VOUT: power out virtual;
    pin GND: ground;

    attribute component_class = "switching_regulator";
    attribute output_voltage = V_OUT;
    attribute f_sw = f_sw;
    attribute rds_on = rds_on;
    attribute t_sw = t_sw;
    attribute i_quiescent = i_quiescent;

    expansion {
        internal sw: net;
        VOUT -> L: Ind(l_value).1; L.2 -> sw;
        sw -> D: Diode(diode_vf).K; D.A -> GND;
        VOUT -> C_out: Cap(c_out).1; C_out.2 -> GND;
    }
}

// LM2596: 150kHz fixed, Rds_on ~200mΩ, t_sw ~80ns, I_q ~5mA
alias LM2596_5V = BuckRegulator<5V>;
alias LM2596_3V3 = BuckRegulator<3.3V>;
