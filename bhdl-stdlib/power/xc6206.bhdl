// XC6206 — Torex 200mA ultra-low-Iq positive LDO, SOT-23 (3-pin, no EN).
//
// Two-layer library model (docs/spec/Requirements_And_Resolution.md §1):
//   XC6206      as part    — vendor truth: pins, package, datasheet attrs.
//   Ldo_XC6206  as design  — the designer's subcircuit (part + datasheet
//                            application circuit), `impl LdoStage`.
// The family is fixed-voltage by SKU (1.2–5.0 V in 0.1 V steps; ordering
// code XC6206Pxx2). The part carries the family number and
// `output_voltage`; the orderable suffix is the BOM/MPN path's to derive.


// The block's children are the block's business: the library file
// imports what its application circuit instantiates (a board that
// states only a requirement imports nothing else).
import { Cap } from "bhdl-stdlib/passives/capacitor.bhdl";

// ── Vendor truth ────────────────────────────────────────────────────
entity XC6206(v_out: voltage = 3.3V, dropout: voltage = 250mV, i_quiescent: current = 1µA) as part {
    pin VIN:  power in;
    pin VOUT: power out;
    pin GND:  ground;

    attribute component_class = "regulator_ic";
    attribute manufacturer    = "Torex";
    attribute family          = "XC6206";
    attribute part_number     = "XC6206";
    attribute output_voltage  = v_out;
    attribute dropout_voltage = dropout;
    attribute i_quiescent     = i_quiescent;
    attribute output_current  = 0.2A;    // Torex XC6206 rated output (datasheet headline)
    attribute vin_min         = 1.8V;    // Torex XC6206: operating voltage range 1.8 V to 6.0 V
    attribute vin_max         = 6V;
    attribute power_rating    = 250mW;   // SOT-23 free-air, datasheet allowable dissipation

    // §4 device-stress IP: linear pass-element dissipation at the solved
    // operating point — P = (V_IN − V_OUT)·I_out + V_IN·I_q, gated against
    // the package power_rating. Skips (UNCHECKED) without a declared load.
    simulation {
        stress {
            self.p_diss = (vin - vout) * i_out + vin * self.i_quiescent;
        }
    }
}

symbol XC6206 {
    left   { VIN }
    right  { VOUT }
    bottom { GND }
}

layout XC6206 {
    package SOT-23;
}

// ── The designer's subcircuit ───────────────────────────────────────
entity Ldo_XC6206(
    v_out:     voltage     = 3.3V,
    i_out_max: current     = 100mA,
    v_in:      voltage     = 5V,
    c_in:      capacitance = 1µF,
    c_out:     capacitance = 1µF
) as design {
    // Contract pins (the regulator pin contract). VOUT is virtual — the
    // output cap IS the block's copper.
    pin VIN:  power in;
    pin VOUT: power out virtual;
    pin GND:  ground;

    // What the board sees: an LDO. PROMISES mirrored from the part's
    // datasheet attributes — what the resolver and ERC032 check a
    // requirement against. The operating point is exported so the
    // elaboration emitter can reconstruct the constructor.
    attribute component_class = "ldo";
    attribute output_voltage  = v_out;
    attribute v_in            = v_in;
    attribute i_out_max       = i_out_max;
    attribute output_current  = 0.2A;    // Torex XC6206 headline
    attribute vin_min         = 1.8V;
    attribute vin_max         = 6V;
    attribute dropout_voltage = 250mV;
    attribute i_quiescent     = 1uA;

    // VALIDITY ENVELOPE — one binary op per `const`; SI base units.
    design {
        const vout = self.v_out;
        // Output-voltage range of the family (1.2–5.0 V, 0.1 V SKU steps).
        require vout >= 1.2
            else "Ldo_XC6206 envelope: v_out below the family's 1.2V minimum SKU";
        require vout <= 5.0
            else "Ldo_XC6206 envelope: v_out above the family's 5.0V maximum SKU";
        // 200 mA rating × 0.8 derating policy.
        require self.i_out_max <= 0.16
            else "Ldo_XC6206 envelope: i_out_max exceeds 160mA (200mA rating × 0.8 derating)";
        require self.v_in <= 6.0
            else "Ldo_XC6206 envelope: v_in exceeds the 6.0V operating maximum";
        const v_need = vout + 0.25;
        require self.v_in >= v_need
            else "Ldo_XC6206 envelope: v_in below v_out + 250mV dropout";
    }

    // The application circuit — FIRM children.
    u: XC6206(v_out);
    VIN -> u.VIN;
    u.GND -> GND;
    VIN -> C_in: Cap(c_in).1; C_in.2 -> GND;
    u.VOUT -> VOUT;
    VOUT -> C_out: Cap(c_out).1; C_out.2 -> GND;
}

// The block SATISFIES the LdoStage requirement interface
// (bhdl-stdlib/power/stages.bhdl): each const names the block parameter
// that receives the requirement value. The envelope and promises above
// are the acceptance predicate; nothing is restated here.
impl LdoStage for Ldo_XC6206 {
    const vout  = v_out;
    const i_max = i_out_max;
    const vin   = v_in;
}

// SKU aliases name the BLOCK (the reviewed application circuit).
alias XC6206P332 = Ldo_XC6206(3.3V);
alias XC6206P182 = Ldo_XC6206(1.8V);
