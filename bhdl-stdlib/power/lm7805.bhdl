// LM7805 — fixed 5 V 3-pin linear regulator, TO-220 (TI µA7805 class).
//
// Two-layer library model (docs/spec/Requirements_And_Resolution.md §1):
//   LM7805      as part    — vendor truth.
//   Ldo_LM7805  as design  — the designer's subcircuit (the datasheet's
//                            0.33µF input / 0.1µF output bypass),
//                            `impl LdoStage`.


// The block's children are the block's business: the library file
// imports what its application circuit instantiates (a board that
// states only a requirement imports nothing else).
import { Cap } from "bhdl-stdlib/passives/capacitor.bhdl";

// ── Vendor truth ────────────────────────────────────────────────────
entity LM7805(v_out: voltage = 5V) as part {
    pin VIN:  power in;
    pin VOUT: power out;
    pin GND:  ground;

    attribute component_class = "regulator_ic";
    attribute family          = "LM7805";
    attribute part_number     = "LM7805";
    attribute output_voltage  = v_out;
    attribute output_current  = 1.5A;    // rated output (with adequate heatsinking)
    attribute vin_min         = 7V;      // TI µA7805: input voltage range 7 V to 35 V (V_O = 5 V)
    attribute vin_max         = 35V;
    attribute output_noise    = 40uV;    // TI µA7805 datasheet RMS output noise, 10Hz–100kHz, V_O = 5V
    attribute dropout_voltage = 2V;      // V_IN − V_OUT required for regulation
    attribute i_quiescent     = 6mA;     // ground-pin (quiescent) current, typ
    attribute power_rating    = 2W;      // TO-220 free-air dissipation (no heatsink), datasheet class

    // §4 device-stress IP: linear pass-element dissipation at the solved
    // operating point — P = (V_IN − V_OUT)·I_out + V_IN·I_q, gated against
    // the package power_rating. Skips (UNCHECKED) without a declared load.
    simulation {
        stress {
            self.p_diss = (vin - vout) * i_out + vin * self.i_quiescent;
        }
    }
}

symbol LM7805 {
    left   { VIN }
    right  { VOUT }
    bottom { GND }
}

layout LM7805 {
    package TO-220;
}

// ── The designer's subcircuit ───────────────────────────────────────
entity Ldo_LM7805(
    v_out:     voltage     = 5V,
    i_out_max: current     = 500mA,
    v_in:      voltage     = 12V,
    c_in:      capacitance = 0.33µF,
    c_out:     capacitance = 0.1µF
) as design {
    // Contract pins (the regulator pin contract). VOUT is virtual — the
    // output cap IS the block's copper.
    pin VIN:  power in;
    pin VOUT: power out virtual;
    pin GND:  ground;

    // What the board sees: an LDO. PROMISES mirrored from the part's
    // datasheet attributes — what the resolver and ERC032 check a
    // requirement against. The operating point is exported so the
    // elaboration emitter can reconstruct the constructor.
    attribute component_class = "ldo";
    attribute output_voltage  = v_out;
    attribute v_in            = v_in;
    attribute i_out_max       = i_out_max;
    attribute output_current  = 1.5A;    // TI µA7805
    attribute vin_min         = 7V;
    attribute vin_max         = 35V;
    attribute output_noise    = 40uV;    // TI µA7805, 10Hz–100kHz
    attribute dropout_voltage = 2V;
    attribute i_quiescent     = 6mA;

    // VALIDITY ENVELOPE — one binary op per `const`; SI base units.
    design {
        const vout = self.v_out;
        const m0 = vout == 5.0;
        require m0 > 0
            else "Ldo_LM7805 envelope: v_out must be a LM7805 SKU voltage known to this library (5.0 V)";
        // 1.5 A rating × 0.8 derating policy.
        require self.i_out_max <= 1.2
            else "Ldo_LM7805 envelope: i_out_max exceeds 1.2A (1.5A rating × 0.8 derating)";
        require self.v_in <= 35.0
            else "Ldo_LM7805 envelope: v_in exceeds the 35V input maximum";
        const v_need = vout + 2.0;
        require self.v_in >= v_need
            else "Ldo_LM7805 envelope: v_in below v_out + 2V dropout (7V minimum)";
    }

    // The application circuit — FIRM children.
    u: LM7805(v_out);
    VIN -> u.VIN;
    u.GND -> GND;
    VIN -> C_in: Cap(c_in).1; C_in.2 -> GND;
    u.VOUT -> VOUT;
    VOUT -> C_out: Cap(c_out).1; C_out.2 -> GND;
}

// The block SATISFIES the LdoStage requirement interface
// (bhdl-stdlib/power/stages.bhdl): each const names the block parameter
// that receives the requirement value. The envelope and promises above
// are the acceptance predicate; nothing is restated here.
impl LdoStage for Ldo_LM7805 {
    const vout  = v_out;
    const i_max = i_out_max;
    const vin   = v_in;
}

// SKU aliases name the BLOCK (the reviewed application circuit).
alias LM7805_5V = Ldo_LM7805(5V);
