// Audio Modules - BHDL v2.0
// Reusable audio circuit modules

// Tone Control Module
entity ToneControl(
    type: string = "baxandall",
    bass_center: frequency = 100Hz,
    treble_center: frequency = 10kHz,
    bass_range: string = "±12dB",
    treble_range: string = "±12dB"
) {
    pin IN: signal in;
    pin OUT: signal out;
    pin VCC: power in;
    pin GND: ground;
    pin BASS_CTRL: signal in;    // Bass control input
    pin TREBLE_CTRL: signal in;  // Treble control input
    
    attribute module_type = "audio_tone_control";
    attribute topology = type;
}

// Audio Preamplifier Module
entity AudioPreamp(gain: string = "20dB") {
    pin IN: signal in;
    pin OUT: signal out;
    pin VCC: power in;
    pin VEE: power in;
    pin GND: ground;
    
    attribute module_type = "audio_preamp";
    attribute voltage_gain = gain;
    attribute input_impedance = "10kΩ";
    attribute output_impedance = "100Ω";
}

// Microphone Preamplifier Module
entity MicPreamp(phantom_power: bool = false) {
    pin MIC+: signal in;
    pin MIC-: signal in;
    pin OUT: signal out;
    pin GAIN: signal in;
    pin VCC: power in;
    pin GND: ground;
    pin PHANTOM: power out when phantom_power;
    
    attribute module_type = "mic_preamp";
    attribute gain_range = "20dB-60dB";
    attribute phantom_voltage = "48V" when phantom_power;
}

// Active Filter Module
entity ActiveFilter(
    type: string = "lowpass",
    frequency: frequency = 1kHz,
    order: int = 2
) {
    pin IN: signal in;
    pin OUT: signal out;
    pin VCC: power in;
    pin VEE: power in;
    pin GND: ground;
    
    attribute module_type = "active_filter";
    attribute filter_type = type;
    attribute cutoff_frequency = frequency;
    attribute filter_order = order;
    attribute topology = order <= 2 ? "Sallen-Key" : "Cascaded";
}

// Audio Mixer Module
entity AudioMixer(channels: int = 4) {
    pin IN[1:channels]: signal in;
    pin OUT: signal out;
    pin LEVEL[1:channels]: signal in;  // Level controls
    pin VCC: power in;
    pin VEE: power in;
    pin GND: ground;
    
    attribute module_type = "audio_mixer";
    attribute channel_count = channels;
    attribute topology = "active_summing";
}

// Headphone Amplifier Module
entity HeadphoneAmp(impedance: resistance = 32Ω) {
    pin IN_L: signal in;
    pin IN_R: signal in;
    pin OUT_L: signal out;
    pin OUT_R: signal out;
    pin VOLUME: signal in;
    pin VCC: power in;
    pin GND: ground;
    
    attribute module_type = "headphone_amp";
    attribute output_impedance = "0.1Ω";
    attribute load_impedance = impedance;
    attribute output_power = impedance <= 32Ω ? "100mW" : "50mW";
}

// VU Meter Driver Module
entity VUMeterDriver(type: string = "LED") {
    pin IN: signal in;
    pin LED[1:10]: signal out when type == "LED";
    pin METER+: signal out when type == "analog";
    pin METER-: signal out when type == "analog";
    pin VCC: power in;
    pin GND: ground;
    
    attribute module_type = "vu_meter_driver";
    attribute display_type = type;
    attribute scale = "-20dB to +3dB";
}

// Audio Compressor Module
entity AudioCompressor(ratio: string = "4:1") {
    pin IN: signal in;
    pin OUT: signal out;
    pin THRESHOLD: signal in;
    pin ATTACK: signal in;
    pin RELEASE: signal in;
    pin VCC: power in;
    pin VEE: power in;
    pin GND: ground;
    
    attribute module_type = "audio_compressor";
    attribute compression_ratio = ratio;
    attribute threshold_range = "-40dB to 0dB";
}

// Crossover Network Module
entity CrossoverNetwork(frequency: frequency = 3kHz) {
    pin IN: signal in;
    pin LOW_OUT: signal out;   // Low frequency output
    pin HIGH_OUT: signal out;  // High frequency output
    pin VCC: power in;
    pin VEE: power in;
    pin GND: ground;
    
    attribute module_type = "crossover";
    attribute crossover_frequency = frequency;
    attribute order = "24dB/octave";
    attribute topology = "Linkwitz-Riley";
}