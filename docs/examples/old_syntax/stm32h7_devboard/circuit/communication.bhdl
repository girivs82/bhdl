// STM32H7 Development Board - Communication Interfaces
// Board Designer: Sarah Johnson
// Date: 2024-12-30
// Version: 1.0

import "../system/requirements.bhdl";
import "power_management.bhdl";

circuit_implementation CommunicationInterfaces {
  implements STM32H7_DevBoard.connectivity;
  
  author = "Board Design Team";
  description = "All communication interface implementations";
  
  // Interface declarations
  interfaces {
    // Main I2C bus for sensors and peripherals
    main_i2c: I2C {
      voltage = 3.3V;
      frequency = 400kHz;
      pullups = 4.7kΩ;
      devices_max = 8;
    };
    
    // High-speed SPI for external flash and peripherals
    high_speed_spi: SPI {
      voltage = 3.3V;
      frequency = 50MHz;
      mode = 0;
      cs_count = 4;
    };
    
    // QSPI interface for external flash
    qspi_flash: QSPI {
      voltage = 3.3V;
      frequency = 104MHz;
      mode = quad_spi;
    };
    
    // USB device interface
    usb_device: USB2_FullSpeed {
      connector = USB_TypeC;
      speed = 12Mbps;
      power_consumption = 100mA;
    };
    
    // Debug interface
    debug_interface: SWD {
      voltage = 3.3V;
      connector = "2x5_pin_1.27mm";
    };
    
    // UART console
    console_uart: UART {
      voltage = 3.3V;
      baud_rate = 115200;
      flow_control = false;
    };
    
    // GPIO expansion header
    expansion_header: GPIO_Header {
      pins = 40;
      pitch = 2.54mm;
      assignment = raspberry_pi_compatible;
    };
    
    // DDR3 memory interface
    ddr_interface: DDR3 {
      width = 16bit;
      speed = 800MHz;  // DDR3-1600
      voltage = 1.5V;
      cas_latency = 11;
    };
  };
  
  // Main microcontroller
  components {
    mcu: STM32H743VIT6 {
      package = "LQFP100";
      frequency = 480MHz;
      flash = 2MB;
      ram = 1MB;
      
      // Power connections
      VDD -> PowerManagement.VCC_3V3;
      VDDA -> PowerManagement.VCC_ANALOG;
      VDD12 -> PowerManagement.VCC_1V2_CORE;
      VDD18 -> PowerManagement.VCC_1V8_IO;
      VSS.all -> GND;
      
      // Built-in interface assignments
      i2c1: I2C;
      spi1: SPI;
      qspi1: QSPI;
      usart1: UART;
      usb_otg_fs: USB2;
      swd: SWD;
      fmc: DDR3;  // Flexible Memory Controller for DDR
    };
    
    // External memory components
    ddr_ram: MT41K128M16JT {
      density = 256MB;  // 128M x 16bit
      speed = DDR3_1600;
      package = "BGA96";
      voltage = 1.5V;
    };
    
    qspi_flash: W25Q256JVEIQ {
      density = 32MB;
      interface = qspi;
      frequency_max = 104MHz;
      package = "SOIC8";
    };
    
    config_eeprom: AT24C32D {
      density = 4KB;
      interface = i2c;
      address = 0x50;
      package = "SOIC8";
    };
    
    // Communication interface components
    usb_connector: USB_TypeC_Receptacle {
      shell_grounding = true;
      esd_protection = integrated;
    };
    
    debug_connector: SWD_Header {
      pins = 10;
      pitch = 1.27mm;
      shrouded = true;
    };
    
    uart_header: Pin_Header {
      pins = 4;  // VCC, GND, TX, RX
      pitch = 2.54mm;
      rows = 1;
    };
    
    gpio_header: Pin_Header {
      pins = 40;
      pitch = 2.54mm;
      rows = 2;
      assignment = raspberry_pi_pinout;
    };
  };
  
  // Interface connections
  interface_connections {
    // I2C bus connections
    mcu.i2c1 <-> main_i2c;
    main_i2c <-> config_eeprom.i2c;
    
    // Expose I2C on expansion header
    expansion_header.I2C_SCL <-> main_i2c.SCL;
    expansion_header.I2C_SDA <-> main_i2c.SDA;
    
    // SPI connections
    mcu.spi1 <-> high_speed_spi;
    
    // QSPI flash connection
    mcu.qspi1 <-> qspi_flash_interface <-> qspi_flash.qspi;
    
    // USB device connection
    mcu.usb_otg_fs <-> usb_device_interface <-> usb_connector;
    
    // Debug interface
    mcu.swd <-> debug_interface <-> debug_connector;
    
    // UART console
    mcu.usart1 <-> console_uart <-> uart_header;
    
    // DDR3 memory interface
    mcu.fmc <-> ddr_interface <-> ddr_ram.ddr;
  };
  
  // Generate DDR3 connections (complex bus with many signals)
  generate ddr3_connections {
    // Data signals (16-bit width)
    for i in 0..15 {
      mcu.FMC_D[i] <-> ddr_ram.DQ[i];
    }
    
    // Data strobe signals (2 for 16-bit: DQS0, DQS1)
    for i in 0..1 {
      mcu.FMC_SDNWE -> ddr_ram.DQS[i];  // Simplified mapping
      mcu.FMC_SDNRAS -> ddr_ram.DQS_N[i];
    }
    
    // Address signals (14-bit for 256MB)
    for i in 0..13 {
      mcu.FMC_A[i] -> ddr_ram.A[i];
    }
    
    // Bank address signals
    for i in 0..2 {
      mcu.FMC_BA[i] -> ddr_ram.BA[i];
    }
    
    // Control signals
    mcu.FMC_SDCLK -> ddr_ram.CLK;
    mcu.FMC_SDCKE0 -> ddr_ram.CKE;
    mcu.FMC_SDNRAS -> ddr_ram.RAS_N;
    mcu.FMC_SDNCAS -> ddr_ram.CAS_N;
    mcu.FMC_SDNWE -> ddr_ram.WE_N;
    mcu.FMC_SDNE0 -> ddr_ram.CS_N;
    mcu.FMC_ODT -> ddr_ram.ODT;
    
    // Power connections for DDR
    PowerManagement.VCC_DDR -> ddr_ram.VDD.all;
    PowerManagement.VCC_DDR -> ddr_ram.VDDQ.all;
    GND -> ddr_ram.VSS.all;
  };
  
  // GPIO expansion connections
  generate gpio_expansion {
    // Power pins on expansion header
    expansion_header.VCC_5V[1:2] -> PowerManagement.USB_5V;
    expansion_header.VCC_3V3[1:2] -> PowerManagement.VCC_3V3;
    expansion_header.GND[1:8] -> GND;
    
    // GPIO pin assignments (Raspberry Pi compatible)
    gpio_assignments = [
      {pin: 3, signal: "I2C_SDA", mcu_pin: "PB9"},
      {pin: 5, signal: "I2C_SCL", mcu_pin: "PB8"},
      {pin: 7, signal: "GPIO4", mcu_pin: "PA4"},
      {pin: 8, signal: "UART_TX", mcu_pin: "PA9"},
      {pin: 10, signal: "UART_RX", mcu_pin: "PA10"},
      {pin: 11, signal: "GPIO17", mcu_pin: "PA5"},
      {pin: 12, signal: "GPIO18", mcu_pin: "PA6"},
      {pin: 13, signal: "GPIO27", mcu_pin: "PA7"},
      {pin: 15, signal: "GPIO22", mcu_pin: "PB0"},
      {pin: 16, signal: "GPIO23", mcu_pin: "PB1"},
      {pin: 18, signal: "GPIO24", mcu_pin: "PB2"},
      {pin: 19, signal: "SPI_MOSI", mcu_pin: "PA7"},
      {pin: 21, signal: "SPI_MISO", mcu_pin: "PA6"},
      {pin: 23, signal: "SPI_SCK", mcu_pin: "PA5"},
      {pin: 24, signal: "SPI_CS0", mcu_pin: "PA4"},
      {pin: 26, signal: "SPI_CS1", mcu_pin: "PB4"}
    ];
    
    for assignment in gpio_assignments {
      expansion_header.Pin[assignment.pin] <-> mcu.GPIO[assignment.mcu_pin];
    }
  };
  
  // Support circuits
  support_circuits {
    // Crystal oscillators
    main_crystal: CrystalOscillator {
      frequency = 25MHz;
      load_capacitance = 18pF;
      drive_level = 100µW;
      
      // Connect to MCU
      OSC_IN <-> mcu.OSC_IN;
      OSC_OUT <-> mcu.OSC_OUT;
      GND -> GND;
    };
    
    rtc_crystal: CrystalOscillator {
      frequency = 32.768kHz;
      load_capacitance = 12.5pF;
      drive_level = 1µW;
      
      // Connect to MCU
      OSC_IN <-> mcu.RTC_OSC_IN;
      OSC_OUT <-> mcu.RTC_OSC_OUT;
      GND -> GND;
    };
    
    // Reset circuit
    reset_circuit: PowerOnReset {
      reset_threshold = 2.9V;
      reset_delay = 200ms;
      manual_reset = true;
      
      VCC -> PowerManagement.VCC_3V3;
      RESET_OUT -> mcu.NRST;
      RESET_IN -> reset_button.output;
      GND -> GND;
    };
    
    // Boot mode control
    boot_control: {
      PowerManagement.VCC_3V3 -> boot_pullup: Res(10kΩ).1 -> mcu.BOOT0;
      boot_pullup.2 -> boot_switch: Switch(SPDT).COM;
      boot_switch.NO -> GND;  // Normal boot
      boot_switch.NC -> PowerManagement.VCC_3V3;  // DFU mode
    };
    
    // Status LEDs
    status_leds: {
      // Power indicator
      PowerManagement.VCC_3V3 -> power_led_res: Res(1kΩ).1 -> 
                                 power_led: LED(green, 2mA).A;
      power_led.K -> GND;
      
      // User RGB LED
      mcu.GPIO_PA8 -> rgb_led_r_res: Res(330Ω).1 -> rgb_led: LED(red).A;
      mcu.GPIO_PA9 -> rgb_led_g_res: Res(330Ω).1 -> rgb_led.G;  
      mcu.GPIO_PA10 -> rgb_led_b_res: Res(330Ω).1 -> rgb_led.B;
      rgb_led.K -> GND;
      
      // User activity LEDs
      generate for i in 0..3 {
        mcu.GPIO[user_led_pins[i]] -> user_led_res[i]: Res(330Ω).1 -> 
                                      user_led[i]: LED(colors[i]).A;
        user_led[i].K -> GND;
      }
    };
    
    // ESD protection
    esd_protection: {
      // USB ESD protection
      usb_connector.DP -> esd_usb: TVSArray("USBLC6-2SC6").IO1;
      usb_connector.DN -> esd_usb.IO2;
      esd_usb.GND -> GND;
      esd_usb.VCC -> PowerManagement.USB_5V;
      
      // GPIO header ESD protection (selected pins)
      generate for pin in critical_gpio_pins {
        expansion_header.Pin[pin] -> esd_gpio[pin]: TVS("PESD5V0S1BA").A;
        esd_gpio[pin].K -> GND;
      }
    };
  };
  
  // Level shifting for different voltage domains
  level_shifting {
    // All internal connections are 3.3V, no level shifting needed
    // External interfaces on expansion header are 3.3V compatible
    
    // Future expansion: if 5V or 1.8V devices are connected
    // they will be automatically level shifted by the tool
  };
  
  // Communication flow validation
  data_flows {
    // Sensor data flow
    sensor_data: external_sensors |> main_i2c |> mcu.i2c1 |> 
                 mcu.processing |> storage_or_usb_output;
    
    // Memory access flow  
    memory_access: mcu.core |> ddr_interface |> ddr_ram |>
                   high_bandwidth_storage(1GB/s);
    
    // Debug flow
    debug_access: debug_probe |> debug_interface |> mcu.debug_port |>
                  [firmware_download, real_time_debug, trace_data];
    
    // USB communication flow
    usb_data: mcu.usb_stack |> usb_device_interface |> usb_connector |>
              host_computer;
  };
}