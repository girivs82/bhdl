// DC-DC Switching Power Supply Example
// Demonstrates buck and boost converter implementations

board DCDCSwitchingSupply {
  // Import physical components from libraries
  import libraries.Passives.{Resistor, Capacitor, Inductor};
  import libraries.Semiconductors.{Diode, MOSFET};
  import libraries.ICs.{DCDCController};
  import libraries.Protection.{Fuse, TVSDiode};
  
  // Import circuit functions
  import PowerCircuits.{buck_converter, boost_converter, reverse_polarity_protection, tvs_protection};
  
  // Board metadata
  author: "BHDL Team";
  version: "1.0";
  description: "DC-DC switching power supply with buck and boost converters";
  
  // Board parameters
  parameters {
    input_voltage_range: 8V to 36V;
    output_voltage_5v0: 5.0V (±2%);
    output_voltage_12v0: 12.0V (±2%);
    output_current_5v0: 2A (max);
    output_current_12v0: 1A (max);
    switching_frequency: 500kHz;
    efficiency: >85%;
  }
  
  // External connections
  ports {
    VIN: in power(8V to 36V, 3A max);
    GND: ground;
    VOUT_5V0: out power(5.0V, 2A);
    VOUT_12V0: out power(12.0V, 1A);
    ENABLE: in signal(digital, active high);
    PG_5V0: out signal(digital, open drain);  // Power good for 5V rail
    PG_12V0: out signal(digital, open drain); // Power good for 12V rail
  }
  
  // Components instantiation
  components {
    // Input protection
    component Fuse F_IN {
      rating: 5A;
      type: slow_blow;
    }
  }
  
  // Connections using circuit functions
  connections {
    // Input protection
    VIN -[F_IN]-> VIN_FUSED;
    
    // Reverse polarity protection using MOSFET
    reverse_polarity_protection(
      VIN_FUSED,                      // Input power rail
      VIN_PROTECTED,                  // Protected output rail
      [Q_RPROT, MOSFET, "P-Channel", 40V, 10A, <30mΩ], // Protection MOSFET
      GND                             // Ground reference
    );
    
    // TVS protection on input
    tvs_protection(
      VIN_PROTECTED,                  // Protected signal
      VIN_FILTERED,                   // Signal after protection
      [TVS1, TVSDiode, 40V]           // TVS diode for protection
    );
    
    // 5V Buck converter implementation
    buck_converter(
      VIN_FILTERED,                   // Input voltage
      VOUT_5V0,                       // Output voltage
      GND,                            // Ground reference
      [U_BUCK, DCDCController, "Synchronous Buck", 500kHz], // Controller
      [L_BUCK, Inductor, 10µH, 5A, <20mΩ],                  // Inductor
      [C_IN_BUCK, Capacitor, 22µF, 50V, X7R],               // Input capacitor
      [C_OUT_BUCK, Capacitor, 100µF, 10V, Low ESR],         // Output capacitor
      [R_FB1_BUCK, Resistor, 10kΩ, 1%],                     // Feedback resistor 1
      [R_FB2_BUCK, Resistor, 2.2kΩ, 1%],                    // Feedback resistor 2
      ENABLE,                                                // Enable signal
      PG_5V0                                                 // Power good signal
    );
    
    // 12V Boost converter implementation
    boost_converter(
      VOUT_5V0,                       // Input voltage
      VOUT_12V0,                      // Output voltage
      GND,                            // Ground reference
      [U_BOOST, DCDCController, "Synchronous Boost", 500kHz], // Controller
      [L_BOOST, Inductor, 15µH, 3A, <30mΩ],                   // Inductor
      [C_IN_BOOST, Capacitor, 47µF, 10V, X7R],                // Input capacitor
      [C_OUT_BOOST, Capacitor, 47µF, 16V, Low ESR],           // Output capacitor
      [R_FB1_BOOST, Resistor, 10kΩ, 1%],                      // Feedback resistor 1
      [R_FB2_BOOST, Resistor, 920Ω, 1%],                      // Feedback resistor 2
      ENABLE,                                                  // Enable signal
      PG_12V0                                                  // Power good signal
    );
  }
  
  // Design validation
  validation {
    check output_voltage(VOUT_5V0, 5.0V ±2%);
    check output_voltage(VOUT_12V0, 12.0V ±2%);
    check output_ripple(VOUT_5V0, <50mVpp);
    check output_ripple(VOUT_12V0, <100mVpp);
    check efficiency(VIN to VOUT_5V0, >85% at 1A load);
    check efficiency(VIN to VOUT_12V0, >80% at 0.5A load);
    check transient_response(VOUT_5V0, <5% deviation for 50% load step);
    check transient_response(VOUT_12V0, <5% deviation for 50% load step);
  }
  
  // Design notes
  design_notes {
    notes: [
      "The 5V rail is generated directly from the input using a buck converter",
      "The 12V rail is derived from the 5V rail using a boost converter",
      "Input protection includes fuse, reverse polarity protection, and TVS diode",
      "Both converters share the same enable signal for synchronized startup"
    ];
  }
} 