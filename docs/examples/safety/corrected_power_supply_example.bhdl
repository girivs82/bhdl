// ═══════════════════════════════════════════════════════════════════

generated_fmea {
    system: "Automotive BCM Power Supply";
    asil_level: ASIL_B;
    
    fmea_entries: [
        {
            component: "U1 - LM2596";
            failure_mode: "No switching";
            failure_rate: 6FIT;
            
            // Effects generated from context analysis
            local_effect: "0V on 5V rail";
            system_effect: "Safety ECU power loss";  // Tool determined
            
            severity: 8;        // Tool calculated from ASIL context
            occurrence: 2;      // From FIT rate
            detection: 1;       // Monitor detects
            rpn: 16;
            
            safety_analysis: {
                diagnostic_coverage: 99%;
                residual_risk: 0.06FIT;
            }
        },
        // ... additional entries
    ];
}