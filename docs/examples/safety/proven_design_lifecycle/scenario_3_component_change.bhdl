        derived_from: "SoC_Core_Power_v1";
        reason: "TPS54360 obsolescence";
        designer: "John Smith";
        validated_by: "Safety Team A";
        status: "Production Released";
    }
    
    relationship_to_v1 {
        compatibility: "Form-fit compatible";
        
        can_use_v2_on_v1_boards: true;  // Drop-in replacement!
        
        improvements: [
            "Better efficiency (+1-2%)",
            "Better transient response",
            "Lower operating temperature",
            "Available for next 10 years"
        ];
    }
    
    migration_guide {
        for_existing_products: {
            option_1: "Continue with TPS54360 until last buy";
            option_2: "Drop in RT6150A (v2) immediately";
            
            no_requalification_needed: "Pin compatible";
        }
        
        for_new_designs: {
            recommendation: "Use v2 (RT6150A based)";
            reason: "Better performance and availability";
        }
    }
    
    // Full documentation like v1
    validated_configuration: {
        // ... same as v1 with RT6150A
    }
    
    validation_evidence: {
        // Delta validation reports
        test_reports: [
            "TR-2024-0021 - Delta functional validation",
            "TR-2024-0022 - Thermal comparison",
            "TR-2024-0023 - EMC verification",
            "TR-2024-0024 - Safety assessment"
        ];
    }
}

// ───────────────────────────────────────────────────────────────────
// LESSONS LEARNED: Managing Component Changes
// ───────────────────────────────────────────────────────────────────

change_management_insights {
    
    why_changes_happen: [
        "Component obsolescence (most common)",
        "Cost reduction initiatives",
        "Performance improvements",
        "Supply chain issues",
        "Quality issues discovered"
    ];
    
    impact_levels: {
        best_case: "Pin-compatible substitute (like RT6150A)";
        typical_case: "Same package, different pinout";
        worst_case: "Complete redesign needed";
    }
    
    proven_design_advantage: {
        without_proven_design: {
            impact: "Start validation from scratch";
            time: 6_months;
            cost: $180_000;
            risk: "HIGH - new unknowns";
        }
        
        with_proven_design: {
            impact: "Delta validation only";
            time: 6_weeks;
            cost: $15_000;
            risk: "LOW - most is known";
        }
    }
    
    key_success_factors: [
        "Good documentation of original design",
        "Clear understanding of what's critical",
        "Focused validation on changes",
        "Reuse of unchanged validation",
        "Version control and traceability"
    ];
}

// ═══════════════════════════════════════════════════════════════════
// THE REALITY OF HARDWARE DESIGN
// ═══════════════════════════════════════════════════════════════════

/*
This scenario shows the REALITY of hardware design:

1. COMPONENTS GO OBSOLETE REGULARLY
   - 5-7 year product lifecycles
   - 10-15 year automotive production
   - Components EOL every few years

2. PROVEN DESIGNS STILL VALUABLE
   - Even with changes, 75% is reusable
   - Delta validation much faster
   - Known baseline for comparison

3. SMART SUBSTITUTION STRATEGIES  
   - Look for pin-compatible first
   - Minimize changes
   - Validate only what changed

4. LIBRARY EVOLUTION
   - v1: Original TPS54360 design
   - v2: RT6150A substitution
   - v3: Future changes...
   - All versions documented and available

5. TIME/COST STILL DRAMATICALLY REDUCED
   - New design: 6 months, $180k
   - Reuse: 2 weeks, $3k  
   - Substitution: 6 weeks, $15k
   - Still 75% savings even with changes!

This is why proven design libraries are SO valuable
in real hardware development. They're not just 
"reference designs" - they're production-validated
solutions that save months and hundreds of thousands
of dollars, even when changes are required.
*/