// Passive Components Library - BHDL v2.0
// BHDL Standard Library - Passives

// Resistor Module
entity Resistor(
    value: resistance,
    power_rating: power = 250m,     // Default 250mW (1/4W) in EDA convention
    tolerance: real = 5.0,          // Default 5% tolerance
    voltage_rating: voltage = 0V    // 0V means auto-calculate
) {
    pin 1: signal inout;
    pin 2: signal inout;
    
    attribute component_class = "resistor";
    attribute tolerance = tolerance + "%";
    attribute temperature_coefficient = "100ppm/°C";
    
    // Power rating selection with proper derating
    attribute power_rating = power_rating;
    
    // Voltage rating: if not specified, calculate from sqrt(P*R) with derating
    attribute voltage_rating = if voltage_rating == 0V {
        sqrt(power_rating * value) * 0.7  // 70% derating factor
    } else {
        voltage_rating
    };
    
    // Package selection based on power rating (SMD)
    attribute package = match power_rating {
        p when p <= 63m => "0402",    // 1/16W
        p when p <= 125m => "0603",   // 1/8W
        p when p <= 250m => "0805",   // 1/4W  
        p when p <= 500m => "1206",   // 1/2W
        p when p <= 1.0 => "2010",    // 1W
        p when p <= 2.0 => "2512",    // 2W
        _ => "THT"  // Through-hole for high power
    };
}

// Alias for convenience
entity Res = Resistor;

// Capacitor Module (Non-polarized)
entity Capacitor(
    value: capacitance, 
    voltage_rating: voltage = 50V,
    tolerance: real = 20.0
) {
    pin 1: signal inout;
    pin 2: signal inout;
    
    attribute component_class = "capacitor";
    attribute tolerance = tolerance + "%";
    
    // Select dielectric based on capacitance value and requirements
    attribute dielectric = match value {
        c when c <= 100p => "C0G/NP0",    // Ultra-stable for small values
        c when c <= 10n => "X7R",         // Good temp stability
        c when c <= 1u => "X7R",          // Standard MLCC
        c when c <= 10u => "X5R",         // Higher cap MLCC
        _ => "Y5V"                        // High cap, less stable
    };
    
    // Voltage rating with derating (use 2x working voltage)
    attribute voltage_rating = voltage_rating;
    attribute recommended_working_voltage = voltage_rating * 0.5;
    
    // Package selection based on value and voltage
    attribute package = match (value, voltage_rating) {
        (c, v) when c <= 100p && v <= 50V => "0402",
        (c, v) when c <= 1n && v <= 50V => "0603",
        (c, v) when c <= 100n && v <= 50V => "0805",
        (c, v) when c <= 1u && v <= 50V => "1206",
        (c, v) when v > 50V => "1210",  // Higher voltage needs larger package
        _ => "1206"  // Default
    };
}

// Alias for convenience
entity Cap = Capacitor;

// Polarized Capacitor (Electrolytic)
entity ElectrolyticCapacitor(value: capacitance, voltage: voltage) {
    pin +: signal in;  // Positive terminal
    pin -: signal out; // Negative terminal
    
    attribute component_class = "capacitor_polarized";
    attribute tolerance = "20%";
    attribute type = "electrolytic";
}

// Inductor Module
entity Inductor(value: inductance) {
    pin 1: signal inout;
    pin 2: signal inout;
    
    attribute component_class = "inductor";
    attribute tolerance = "10%";
    attribute saturation_current = "1A";
}

// Alias for convenience
entity L = Inductor;

// LED Module
entity LED(
    color: string = "red",
    forward_current: current = 20m,  // Default 20mA in EDA convention
    power_rating: power = 100m       // Default 100mW
) {
    pin A: signal in;  // Anode
    pin K: signal out; // Cathode
    
    attribute component_class = "led";
    
    // Forward voltage depends on color
    attribute forward_voltage = match color {
        "red" => "2.0V",
        "yellow" => "2.1V", 
        "green" => "2.2V",
        "blue" => "3.2V",
        "white" => "3.3V",
        "infrared" => "1.5V",
        _ => "2.0V"  // Default
    };
    
    // These would ideally come from component database
    attribute forward_current = forward_current;
    attribute max_current = forward_current * 1.5;  // 50% safety margin
    attribute power_rating = power_rating;
}

// Diode Module
entity Diode(type: string = "1N4148") {
    pin A: signal in;  // Anode
    pin K: signal out; // Cathode
    
    attribute component_class = "diode";
    attribute forward_voltage = "0.7V";
    attribute reverse_voltage = "100V";
    attribute forward_current = "300mA";
}

// Zener Diode Module
entity ZenerDiode(voltage: voltage) {
    pin A: signal in;  // Anode
    pin K: signal out; // Cathode
    
    attribute component_class = "zener_diode";
    attribute zener_voltage = voltage;
    attribute tolerance = "5%";
    attribute power_rating = "500mW";
}

// Crystal Module
entity Crystal(frequency: frequency) {
    pin 1: signal inout;
    pin 2: signal inout;
    
    attribute component_class = "crystal";
    attribute tolerance = "50ppm";
    attribute load_capacitance = "12pF";
    attribute esr = "50Ω";
}

// Button/Switch Module
entity Button() {
    pin 1: signal inout;
    pin 2: signal inout;
    
    attribute component_class = "switch";
    attribute type = "momentary";
    attribute rating = "12V @ 50mA";
}

// Test Point Module
entity TestPoint() {
    pin 1: signal inout;
    
    attribute component_class = "test_point";
    attribute shape = "round";
    attribute diameter = "1mm";
}