// Control Components Library - BHDL v2.0
// User interface and control components

// Potentiometer Module
entity Potentiometer(value: resistance) {
    pin 1: signal inout;    // End terminal 1
    pin 2: signal inout;    // Wiper
    pin 3: signal inout;    // End terminal 2
    
    attribute component_class = "potentiometer";
    attribute taper = "linear";  // or "logarithmic"
    attribute tolerance = "20%";
    attribute power_rating = "0.25W";
}

// Alias for convenience
entity Pot = Potentiometer;

// Rotary Encoder Module
entity RotaryEncoder(pulses_per_revolution: int = 24) {
    pin A: signal out;      // Channel A
    pin B: signal out;      // Channel B
    pin SW: signal out;     // Push switch (if present)
    pin C: ground;          // Common
    pin VCC: power in;
    
    attribute component_class = "encoder";
    attribute type = "incremental";
    attribute ppr = pulses_per_revolution;
    attribute detents = pulses_per_revolution;
}

// Push Button Module
entity PushButton(type: string = "momentary") {
    pin 1: signal inout;
    pin 2: signal inout;
    pin 3: signal inout when type == "DPDT";
    pin 4: signal inout when type == "DPDT";
    
    attribute component_class = "switch";
    attribute action = type;
    attribute rating = "50mA @ 12V";
}

// Toggle Switch Module
entity ToggleSwitch(poles: int = 1, throws: int = 2) {
    pin COM[1:poles]: signal inout;
    pin NO[1:poles]: signal inout;
    pin NC[1:poles]: signal inout when throws == 2;
    
    attribute component_class = "switch";
    attribute type = "toggle";
    attribute configuration = "${poles}P${throws}T";
}

// DIP Switch Module
entity DIPSwitch(positions: int = 8) {
    pin SW[1:positions]: signal inout;
    pin COM[1:positions]: signal inout;
    
    attribute component_class = "switch";
    attribute type = "DIP";
    attribute positions = positions;
}

// Joystick Module
entity Joystick() {
    pin VRX: signal out;    // X-axis potentiometer
    pin VRY: signal out;    // Y-axis potentiometer
    pin SW: signal out;     // Push button
    pin VCC: power in;
    pin GND: ground;
    
    attribute component_class = "joystick";
    attribute type = "analog";
    attribute axes = "2";
}

// Touch Sensor Module
entity TouchSensor() {
    pin SIG: signal out;
    pin VCC: power in;
    pin GND: ground;
    
    attribute component_class = "sensor";
    attribute type = "capacitive_touch";
    attribute sensitivity = "adjustable";
}

// Slide Potentiometer
entity SlidePot(value: resistance, length: length = 60mm) {
    pin 1: signal inout;
    pin 2: signal inout;    // Wiper
    pin 3: signal inout;
    
    attribute component_class = "potentiometer";
    attribute type = "slide";
    attribute travel = length;
}

// Membrane Keypad
entity MembraneKeypad(rows: int = 4, cols: int = 4) {
    pin ROW[1:rows]: signal out;
    pin COL[1:cols]: signal in;
    
    attribute component_class = "keypad";
    attribute type = "membrane";
    attribute keys = "${rows}x${cols}";
}

// Thumbwheel Switch
entity ThumbwheelSwitch() {
    pin C: signal inout;    // Common
    pin 0-9: signal out;    // BCD outputs
    
    attribute component_class = "switch";
    attribute type = "thumbwheel";
    attribute encoding = "BCD";
}

// Limit Switch
entity LimitSwitch() {
    pin C: signal inout;    // Common
    pin NO: signal inout;   // Normally open
    pin NC: signal inout;   // Normally closed
    
    attribute component_class = "switch";
    attribute type = "limit";
    attribute actuator = "lever";
}