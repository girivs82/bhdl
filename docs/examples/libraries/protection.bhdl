// Protection Components Library - BHDL v2.0
// Circuit protection components

// TVS Diode Module
entity TVSDiode(voltage: voltage) {
    pin 1: signal inout;
    pin 2: ground;
    
    attribute component_class = "tvs_diode";
    attribute breakdown_voltage = voltage;
    attribute clamping_voltage = "120%";
    attribute response_time = "1ns";
    attribute power_rating = "600W";
}

// Fuse Module
entity Fuse(current: current, type: string = "fast") {
    pin 1: power inout;
    pin 2: power inout;
    
    attribute component_class = "fuse";
    attribute rating = current;
    attribute type = type;
    attribute voltage_rating = "250V";
}

// Resettable Fuse (PTC)
entity ResettableFuse(current: current) {
    pin 1: power inout;
    pin 2: power inout;
    
    attribute component_class = "ptc_fuse";
    attribute hold_current = current;
    attribute trip_current = "200%";
    attribute reset_time = "10s";
}

// Varistor (MOV) Module
entity Varistor(voltage: voltage) {
    pin 1: signal inout;
    pin 2: signal inout;
    
    attribute component_class = "varistor";
    attribute voltage_rating = voltage;
    attribute energy_rating = "10J";
    attribute response_time = "25ns";
}

// Gas Discharge Tube
entity GDT(voltage: voltage) {
    pin 1: signal inout;
    pin 2: signal inout;
    
    attribute component_class = "gdt";
    attribute dc_breakdown = voltage;
    attribute impulse_breakdown = "150%";
    attribute insulation_resistance = "10GΩ";
}

// Common Mode Choke
entity CommonModeChoke(inductance: inductance) {
    pin 1: signal in;
    pin 2: signal out;
    pin 3: signal in;
    pin 4: signal out;
    
    attribute component_class = "common_mode_choke";
    attribute inductance = inductance;
    attribute impedance = "100Ω @ 100MHz";
    attribute current_rating = "1A";
}

// Circuit Breaker Module
entity CircuitBreaker(current: current) {
    pin LINE: power in;
    pin LOAD: power out;
    
    attribute component_class = "circuit_breaker";
    attribute rating = current;
    attribute trip_curve = "C";
    attribute poles = "1";
}

// Spark Gap Module
entity SparkGap(voltage: voltage) {
    pin 1: signal inout;
    pin 2: signal inout;
    
    attribute component_class = "spark_gap";
    attribute breakdown_voltage = voltage;
    attribute arc_voltage = "25V";
}

// ESD Protection Module
entity ESDProtection() {
    pin IO: signal inout;
    pin VCC: power in;
    pin GND: ground;
    
    attribute component_class = "esd_protection";
    attribute clamping_voltage = "8V";
    attribute capacitance = "0.5pF";
    attribute iec_rating = "Level 4";
}

// Ferrite Bead Module
entity FerriteBead(impedance: resistance) {
    pin 1: signal inout;
    pin 2: signal inout;
    
    attribute component_class = "ferrite_bead";
    attribute impedance = impedance;
    attribute frequency = "100MHz";
    attribute dc_resistance = "0.05Ω";
    attribute current_rating = "3A";
}

// Crowbar Protection Module
entity CrowbarProtection(voltage: voltage) {
    pin IN: power in;
    pin OUT: power out;
    pin GND: ground;
    pin SENSE: signal in;
    
    attribute component_class = "crowbar";
    attribute trigger_voltage = voltage;
    attribute response_time = "1µs";
}

// Isolation Transformer Module
entity IsolationTransformer(ratio: string = "1:1") {
    pin PRI_L: signal in;
    pin PRI_N: signal in;
    pin SEC_L: signal out;
    pin SEC_N: signal out;
    pin SHIELD: ground;
    
    attribute component_class = "isolation_transformer";
    attribute turns_ratio = ratio;
    attribute isolation_voltage = "3kV";
    attribute leakage_inductance = "10µH";
}