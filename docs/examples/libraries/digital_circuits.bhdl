// ---------------------------------------------------------

// ---------------------------------------------------------
// Input Circuits
// ---------------------------------------------------------

// Module for Debounced Button Input (Active Low configuration)
entity DebouncedButtonActiveLow {
  ports {
    BUTTON_OUT: out signal; // Signal to the IC input pin
    BUTTON_IN_PORT: in signal; // Connection to the physical button switch
    VCC: in power;
    GND: ground;
  }
  parameters {
    pullup_res_value: resistance = 10kOhm;
    debounce_cap_value: capacitance = 100nF;
  }
  components {
    Resistor R_PULL { value: module.pullup_res_value; };
    Capacitor C_DEBOUNCE { value: module.debounce_cap_value; };
    // Switch is assumed external, connected to BUTTON_IN_PORT
  }
  connections {
    VCC -> R_PULL.1;
    R_PULL.2 -> BUTTON_OUT;

    BUTTON_OUT -> C_DEBOUNCE.1;
    C_DEBOUNCE.2 -> GND;

    // Connect the output signal to the external button port
    BUTTON_OUT -> BUTTON_IN_PORT;
  }
}

// Note: RC Filter module removed - simple enough to implement directly.

// ---------------------------------------------------------
// Output Circuits
// ---------------------------------------------------------

// Module for LED Output Driver (Active Low drive pin)
entity LedOutputActiveLow {
  ports {
    DRIVE_PIN: in signal; // Input signal from driver (e.g., MCU GPIO)
    VCC: in power;
  }
  parameters {
    led_color: string = "Green";
    current_limit_res_value: resistance = 330Ohm;
  }
  components {
    Resistor R_LED { value: module.current_limit_res_value; };
    LED D_LED { color: module.led_color; };
  }
  connections {
    VCC -> R_LED.1;
    R_LED.2 -> D_LED.A; // Anode
    D_LED.K -> DRIVE_PIN; // Cathode driven low by input pin
  }
}

// Module for LED Output Driver (Active High drive pin)
entity LedOutputActiveHigh {
  ports {
    DRIVE_PIN: in signal; // Input signal from driver (e.g., MCU GPIO)
    GND: ground;
  }
  parameters {
    led_color: string = "Green";
    current_limit_res_value: resistance = 330Ohm;
  }
  components {
    Resistor R_LED { value: module.current_limit_res_value; };
    LED D_LED { color: module.led_color; };
  }
  connections {
    DRIVE_PIN -> R_LED.1;
    R_LED.2 -> D_LED.A; // Anode
    D_LED.K -> GND; // Cathode to ground
  }
}

