// ---------------------------------------------------------
// Clock Circuits
// ---------------------------------------------------------

// Crystal oscillator module with load capacitors
entity CrystalOscillatorCircuit {
  ports {
    MCU_XTAL1: inout signal; // Connect to MCU XTAL1 pin
    MCU_XTAL2: inout signal; // Connect to MCU XTAL2 pin
    CRYSTAL_INSTANCE: component; // Pass the crystal instance
    GND: ground;
  }
  parameters {
    cap_load_value: capacitance = 22pF;
  }
  components {
    Capacitor C_LOAD1 { value: module.cap_load_value; type: ceramic; temp_coeff: "C0G"; }
    Capacitor C_LOAD2 { value: module.cap_load_value; type: ceramic; temp_coeff: "C0G"; }
  }
  connections {
    // Connect crystal to MCU pins via ports
    MCU_XTAL1 -> CRYSTAL_INSTANCE.X1; // Assume Crystal component has X1, X2 pins
    MCU_XTAL2 -> CRYSTAL_INSTANCE.X2;

    // Connect load capacitors
    CRYSTAL_INSTANCE.X1 -> C_LOAD1.1;
    C_LOAD1.2 -> GND;
    CRYSTAL_INSTANCE.X2 -> C_LOAD2.1;
    C_LOAD2.2 -> GND;
  }
}

// Note: RC oscillator module removed due to ambiguity in implementation detail.

// ---------------------------------------------------------
// Reset Circuits
// ---------------------------------------------------------

// Module for Power-on Reset using a Supervisor IC
entity PowerOnResetSupervisor {
  ports {
    RESET_OUT: out signal; // Output reset signal (active low/high depends on supervisor)
    VCC_MONITOR: in power;
    GND: ground;
  }
  parameters {
    supervisor_type: component_type = ResetSupervisor; // Specify supervisor component type
    bypass_cap_value: capacitance = 100nF;
  }
  components {
    ResetSupervisor U_RESET { type: module.supervisor_type; }; // Instantiate supervisor
    Capacitor C_BYPASS { value: module.bypass_cap_value; };
  }
  connections {
    VCC_MONITOR -> U_RESET.VCC;
    GND -> U_RESET.GND;
    U_RESET.RESET -> RESET_OUT; // Assume RESET pin on supervisor

    // Decoupling
    VCC_MONITOR -> C_BYPASS.1;
    C_BYPASS.2 -> GND;
  }
}

// Module for Manual Reset Button (Active Low configuration)
entity ManualResetActiveLow {
  ports {
    RESET_OUT: inout signal; // Connect to the IC's reset pin
    VCC: in power;
    GND: ground;
  }
  parameters {
    pullup_res_value: resistance = 10kOhm;
    debounce_cap_value: capacitance = 100nF;
  }
  components {
    Resistor R_PULL { value: module.pullup_res_value; };
    Capacitor C_DEBOUNCE { value: module.debounce_cap_value; };
    Switch SW_RESET { type: "SPST"; actuation: "Pushbutton"; default_state: "NO"; };
  }
  connections {
    VCC -> R_PULL.1;
    R_PULL.2 -> RESET_OUT;

    RESET_OUT -> C_DEBOUNCE.1;
    C_DEBOUNCE.2 -> GND;

    RESET_OUT -> SW_RESET.1;
    SW_RESET.2 -> GND;
  }
}

// Note: Active high version could be a separate module if needed.

// ---------------------------------------------------------
// Bus Termination Circuits
// ---------------------------------------------------------

// Module for standard I2C Pull-up Resistors
entity I2CPullups {
  ports {
    SCL: inout signal;
    SDA: inout signal;
    VCC: in power;
  }
  parameters {
    pullup_value: resistance = 4.7kOhm;
  }
  components {
    Resistor R_SCL { value: module.pullup_value; };
    Resistor R_SDA { value: module.pullup_value; };
  }
  connections {
    VCC -> R_SCL.1;
    R_SCL.2 -> SCL;
    VCC -> R_SDA.1;
    R_SDA.2 -> SDA;
  }
}

// Module for Series Termination
entity SeriesTermination {
  ports {
    SIGNAL_IN: in signal; // Driver output
    SIGNAL_OUT: out signal; // Trace input
  }
  parameters {
    resistance_value: resistance = required;
  }
  components {
    Resistor R_TERM { value: module.resistance_value; };
  }
  connections {
    SIGNAL_IN -> R_TERM.1;
    R_TERM.2 -> SIGNAL_OUT;
  }
}

// Module for Differential Termination (Resistor across pair)
entity DifferentialTermination {
  ports {
    SIGNAL_P: inout signal;
    SIGNAL_N: inout signal;
  }
  parameters {
    resistance_value: resistance = 100Ohm;
  }
  components {
    Resistor R_DIFF { value: module.resistance_value; };
  }
  connections {
    SIGNAL_P -> R_DIFF.1;
    SIGNAL_N -> R_DIFF.2;
  }
}

