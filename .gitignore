# Rust / Cargo build artifacts
/target/

# Editor / OS specific
.vscode/
.DS_Store 
# Ignore generated tree-sitter C code
bhdl-parser/tree-sitter-bhdl/src/

# DO NOT ignore scanner.c if it's hand-written!
!bhdl-parser/tree-sitter-bhdl/src/scanner.c

# Component database files
*.db
*.sqlite
*.sqlite3
bhdl-components/components.db
bhdl-components/test_*.db
**/components.db
**/test_components.db

# KiCad symbol cache
kicad_symbol_cache/
*.kicad_sym.cache
# Reference designator sidecar files (generated per-circuit)

# Test scratch directory
tests/scratch/

# Test outputs in root (should be in tests/)
/*.svg
/*.bhdl
/test_*.rs
/demo_*.rs
/debug_*.rs

# Research and summary documents (should be in docs/)
/*_SUMMARY.md
/*_ANALYSIS.md  
/*_IMPLEMENTATION*.md
/*_INTEGRATION*.md
/*_STATUS.md
/GPU_*.md
/GLACIER_*.md
/HYBRID_*.md
/IEEE_*.md
/*_summary.md
/*_analysis.md
/*_issue.md
/*_clarification.md
/*_achievements.md
/*_explanation.md

# Temporary executables and test files in root
/test_*
/analyze_*
/expose_*
/debug_*
/wave_*
/*_wave
/*_solver
/*_demo
/*_comparison
/package-lock.json
/test_*.txt
/test_*.csv
/solver_*.txt
/gradient_*.txt

# Build artifacts and temp files that may end up in root
/*.txt
/*.csv  
/*.sh
/*.json
!Cargo.toml
!package.json
!/scripts/*.sh
!/tests/**/*.txt
!/tests/**/*.csv
!/docs/**/*.txt

# Secrets / credentials — never commit
.env
*.env
!.env.example

# Local catalogue DBs (see data/README.md) — big binaries, never committed
/data/*.sqlite3*

# Vendor IBIS models — Atmel license permits use, not redistribution.
vendor/ibis/

# Reliability coefficient tables transcribed from licensed/registered
# standards (IEC 62380, FIDES, SN 29500, ...) are NOT redistributable —
# users supply their own. Only FIXTURE demo tables are committed.
bhdl-stdlib/safety/*.local.toml

# Local Claude Code permission settings — never publish
.claude/settings.local.json

# Local probe/working directory — never track (probes graduate to
# tests/circuits/ fixtures; generated sidecars and reports live here)
scratch/
*.dSYM/
